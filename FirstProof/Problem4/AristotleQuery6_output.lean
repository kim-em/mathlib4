/-
The truncated Gaussian is congruent to the truncated exponential of cX^2 modulo X^(n+1).
-/
def poly_exp (n : ℕ) (p : ℝ[X]) : ℝ[X] :=
  ∑ i ∈ range (n + 1), C (1 / (i.factorial : ℝ)) * p ^ i

theorem truncated_gaussian_eq_poly_exp_mod (n : ℕ) (c : ℝ) :
    (truncated_gaussian n c) % (X ^ (n + 1)) = (poly_exp n (C c * X ^ 2)) % (X ^ (n + 1)) := by
  -- By definition of polynomial congruence, we need to show that the polynomials differ by a multiple of $X^{n+1}$.
  suffices h_diff : ∃ Q : ℝ[X], poly_exp n (C c * X ^ 2) = (truncated_gaussian n c) + X ^ (n + 1) * Q by
    cases' h_diff with Q hQ; norm_num [ hQ, Polynomial.mod_def ] ;
    rw [ Polynomial.add_modByMonic ] ; norm_num;
  -- The terms for $k > n / 2$ in the sum for `poly_exp n (C c * X ^ 2)` are all divisible by $X^{n+1}$.
  have h_div : ∀ k > n / 2, X ^ (n + 1) ∣ C (c ^ k / k.factorial) * X ^ (2 * k) := by
    exact fun k hk => dvd_mul_of_dvd_right ( pow_dvd_pow _ ( by omega ) ) _;
  -- We can split the sum into two parts: one for $k \leq n / 2$ and one for $k > n / 2$.
  have h_split : poly_exp n (C c * X ^ 2) = (∑ k ∈ Finset.range (n / 2 + 1), C (c ^ k / k.factorial) * X ^ (2 * k)) + (∑ k ∈ Finset.Ico (n / 2 + 1) (n + 1), C (c ^ k / k.factorial) * X ^ (2 * k)) := by
    rw [ Finset.sum_range_add_sum_Ico _ ( by linarith [ Nat.div_mul_le_self n 2 ] ) ];
    exact Finset.sum_congr rfl fun i hi => by rw [ show C c * X ^ 2 = ( C c * X ^ 2 ) by rfl ] ; rw [ show ( C c * X ^ 2 ) ^ i = ( C c ^ i * X ^ ( 2 * i ) ) by ring ] ; simp +decide [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm, pow_mul', Nat.factorial_ne_zero ] ;
  -- The second sum is divisible by $X^{n+1}$.
  have h_second_sum_div : X ^ (n + 1) ∣ ∑ k ∈ Finset.Ico (n / 2 + 1) (n + 1), C (c ^ k / k.factorial) * X ^ (2 * k) := by
    exact Finset.dvd_sum fun k hk => h_div k <| Finset.mem_Ico.mp hk |>.1;
  exact h_split.symm ▸ by obtain ⟨ Q, hQ ⟩ := h_second_sum_div; exact ⟨ Q, by rw [ hQ ] ; rfl ⟩ ;

/-
The derivative of the truncated Gaussian is 2cX times the truncated Gaussian of degree n-2, for n >= 2.
-/
theorem derivative_truncated_gaussian (n : ℕ) (c : ℝ) (hn : 2 ≤ n) :
    (truncated_gaussian n c).derivative = 2 * C c * X * (truncated_gaussian (n - 2) c) := by
  rcases Nat.even_or_odd' n with ⟨ k, rfl | rfl ⟩ <;> simp_all +decide [ truncated_gaussian, Polynomial.derivative_pow ];
  · rcases k with ( _ | k ) <;> simp_all +decide [ Nat.mul_succ, Finset.sum_range_succ' ];
    norm_num [ Finset.mul_sum _ _ _, mul_assoc, mul_left_comm, mul_add, add_mul, pow_succ, Nat.factorial_succ ] ; ring;
    refine' congrArg₂ ( · + · ) _ ( Finset.sum_congr rfl fun x hx => _ ) <;> norm_num ; ring;
    · exact Polynomial.funext fun x => by norm_num; ring;
    · refine' Polynomial.funext fun x => _ ; norm_num ; ring;
      -- Combine and simplify the terms in the equation.
      field_simp
      ring;
  · rcases k with ( _ | k ) <;> simp_all +decide [ Nat.add_div, Nat.mul_succ, Finset.sum_range_succ' ];
    norm_num [ Finset.mul_sum _ _ _, mul_assoc, mul_left_comm, mul_add, add_mul, pow_succ, Nat.factorial_succ ] ; ring;
    refine' congrArg₂ ( · + · ) _ ( Finset.sum_congr rfl fun x hx => _ ) <;> norm_num ; ring;
    · exact Polynomial.funext fun x => by norm_num; ring;
    · refine' Polynomial.funext fun x => _ ; norm_num ; ring;
      -- Combine and simplify the terms in the equation.
      field_simp
      ring

/-
The formula for 1/Phi of a symmetric quartic in terms of cumulants is correct.
-/
def invPhi4_sym_formula (k2 k4 : ℝ) : ℝ :=
  (2 / 3) * (-k2) - (4 / 3) * k4 ^ 2 / (-k2 * (k2 ^ 2 + k4))

theorem invPhi_eq_formula_n4_sym (a b : ℝ)
    (ha : a < 0) (hb : 0 < b) (hdiscr : a ^ 2 > 4 * b) :
    let p := X ^ 4 + C a * X ^ 2 + C b
    let k2 := finite_free_cumulant 4 p 2
    let k4 := finite_free_cumulant 4 p 4
    invPhi p = invPhi4_sym_formula k2 k4 := by
  have h_invPhi : let p := X ^ 4 + C a * X ^ 2 + C b;
    let k2 := finite_free_cumulant 4 p 2;
    let k4 := finite_free_cumulant 4 p 4;
    invPhi p = -2 * b * (a^2 - 4 * b) / (a * (a^2 + 12 * b)) := by
      -- By definition of $p$, we know that its roots are $\pm \sqrt{y_1}$ and $\pm \sqrt{y_2}$, where $y_1$ and $y_2$ are the roots of $y^2 + ay + b = 0$.
      obtain ⟨y1, y2, hy1, hy2, hy_distinct⟩ : ∃ y1 y2 : ℝ, y1 ≠ y2 ∧ y1 + y2 = -a ∧ y1 * y2 = b ∧ y1 > 0 ∧ y2 > 0 := by
        exact ⟨ ( -a + Real.sqrt ( a^2 - 4 * b ) ) / 2, ( -a - Real.sqrt ( a^2 - 4 * b ) ) / 2, by nlinarith [ Real.mul_self_sqrt ( show 0 ≤ a^2 - 4 * b by linarith ) ], by ring, by linarith [ Real.mul_self_sqrt ( show 0 ≤ a^2 - 4 * b by linarith ) ], by nlinarith [ Real.sqrt_nonneg ( a^2 - 4 * b ), Real.mul_self_sqrt ( show 0 ≤ a^2 - 4 * b by linarith ) ], by nlinarith [ Real.sqrt_nonneg ( a^2 - 4 * b ), Real.mul_self_sqrt ( show 0 ≤ a^2 - 4 * b by linarith ) ] ⟩;
      -- The roots of $p$ are $\pm \sqrt{y_1}$ and $\pm \sqrt{y_2}$.
      have h_roots : Polynomial.roots (Polynomial.X ^ 4 + Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b) = {Real.sqrt y1, -Real.sqrt y1, Real.sqrt y2, -Real.sqrt y2} := by
        rw [ show ( Polynomial.X ^ 4 + Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt y1 ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt y1 ) ) * ( Polynomial.X - Polynomial.C ( Real.sqrt y2 ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt y2 ) ) from _ ];
        · rw [ Polynomial.roots_mul, Polynomial.roots_mul, Polynomial.roots_mul, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ];
          · rfl;
          · exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ );
          · exact mul_ne_zero ( mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ) ( Polynomial.X_sub_C_ne_zero _ );
          · apply_rules [ mul_ne_zero, Polynomial.X_sub_C_ne_zero ];
        · refine' Polynomial.funext fun x => _ ; norm_num ; ring;
          grind;
      -- Calculate the value of $\Phi$ for the polynomial $p$.
      have h_phi : Phi (Polynomial.X ^ 4 + Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b) = -a * (a ^ 2 + 12 * b) / (2 * b * (a ^ 2 - 4 * b)) := by
        have h_phi : Phi (Polynomial.X ^ 4 + Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b) = 2 * (1 / (Real.sqrt y1 - (-Real.sqrt y1)) ^ 2 + 1 / (Real.sqrt y1 - Real.sqrt y2) ^ 2 + 1 / (Real.sqrt y1 - (-Real.sqrt y2)) ^ 2 + 1 / ((-Real.sqrt y1) - Real.sqrt y2) ^ 2 + 1 / ((-Real.sqrt y1) - (-Real.sqrt y2)) ^ 2 + 1 / (Real.sqrt y2 - (-Real.sqrt y2)) ^ 2) := by
          convert phi_eq_sum_sq_diff 4 ( fun i => if i = 0 then Real.sqrt y1 else if i = 1 then -Real.sqrt y1 else if i = 2 then Real.sqrt y2 else -Real.sqrt y2 ) _ using 1;
          · convert Phi_eq_phi 4 _ _ using 2;
            · refine' Polynomial.eq_of_degree_sub_lt_of_eval_finset_eq _ _ _;
              exact { Real.sqrt y1, -Real.sqrt y1, Real.sqrt y2, -Real.sqrt y2 };
              · refine' lt_of_lt_of_le ( Polynomial.degree_sub_lt _ _ _ ) _;
                · norm_num [ Polynomial.degree_prod, Polynomial.degree_X_pow_sub_C ];
                  rw [ Polynomial.degree_add_C ] <;> rw [ Polynomial.degree_add_eq_left_of_degree_lt ] <;> norm_num [ ha.ne, hb.ne' ];
                · exact ne_of_apply_ne ( fun p => p.coeff 4 ) ( by norm_num [ Polynomial.coeff_eq_zero_of_natDegree_lt ] );
                · norm_num [ Polynomial.leadingCoeff_prod ];
                  rw [ Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ Polynomial.natDegree_X_pow, Polynomial.natDegree_C, ha.ne, hb.ne' ];
                · rw [ Finset.card_insert_of_notMem, Finset.card_insert_of_notMem, Finset.card_insert_of_notMem, Finset.card_singleton ] <;> norm_num [ Real.sqrt_ne_zero'.mpr hy_distinct.2.1, Real.sqrt_ne_zero'.mpr hy_distinct.2.2, hy1 ];
                  · rw [ Polynomial.degree_add_C ] <;> rw [ Polynomial.degree_add_eq_left_of_degree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
                  · linarith [ Real.sqrt_pos.2 hy_distinct.2.2 ];
                  · exact ⟨ by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ], by rw [ Real.sqrt_inj ] <;> cases lt_or_gt_of_ne hy1 <;> nlinarith ⟩;
                  · grind;
              · simp +decide [ Fin.prod_univ_four ];
                grind;
            · simp +decide [ Function.Injective, Fin.forall_fin_succ ];
              norm_num [ Real.sqrt_eq_cases, hy_distinct.2.1.le, hy_distinct.2.2.le ];
              exact ⟨ ⟨ hy_distinct.2.1, Ne.symm hy1, fun h => by linarith ⟩, ⟨ by linarith [ Real.sqrt_pos.2 hy_distinct.2.1 ], by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ], Ne.symm hy1 ⟩, ⟨ hy1, fun h => by linarith, hy_distinct.2.2 ⟩, by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ], hy1, by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ] ⟩;
          · simp +decide [ Fin.sum_univ_four, Finset.sum_filter ] ; ring;
          · simp +decide [ Function.Injective, Fin.forall_fin_succ ];
            norm_num [ Real.sqrt_eq_cases, hy_distinct.2.1.le, hy_distinct.2.2.le ];
            exact ⟨ ⟨ hy_distinct.2.1, Ne.symm hy1, fun h => by linarith ⟩, ⟨ by linarith [ Real.sqrt_pos.2 hy_distinct.2.1 ], by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ], Ne.symm hy1 ⟩, ⟨ hy1, fun h => by linarith, hy_distinct.2.2 ⟩, by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ], hy1, by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ] ⟩;
        rw [ h_phi ];
        rw [ ← hy2, ← hy_distinct.1 ] ; ring;
        rw [ show a = -y1 - y2 by linarith ] ; ring;
        field_simp;
        rw [ div_add_div, div_add_div, div_add_div, div_eq_div_iff ] <;> try nlinarith [ Real.mul_self_sqrt hy_distinct.2.1.le, Real.mul_self_sqrt hy_distinct.2.2.le ];
        · rw [ Real.sq_sqrt hy_distinct.2.1.le, Real.sq_sqrt hy_distinct.2.2.le ] ; ring;
          rw [ show Real.sqrt y1 ^ 4 = ( Real.sqrt y1 ^ 2 ) ^ 2 by ring, show Real.sqrt y2 ^ 2 = y2 by rw [ Real.sq_sqrt ( by linarith ) ] ] ; ring;
          rw [ show Real.sqrt y1 ^ 4 = ( Real.sqrt y1 ^ 2 ) ^ 2 by ring, Real.sq_sqrt ( by linarith ) ] ; ring;
        · simp_all +decide [ ne_of_gt, le_of_lt ];
          constructor <;> nlinarith only [ Real.mul_self_sqrt hy_distinct.2.1.le, Real.mul_self_sqrt hy_distinct.2.2.le, Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2, mul_self_pos.2 ( sub_ne_zero_of_ne hy1 ) ];
        · grind;
        · grind;
        · grind;
      convert congr_arg ( fun x => 1 / x ) h_phi using 1;
      · unfold invPhi;
        rw [ h_roots ] ; norm_num [ hy1, hy2, hy_distinct ];
        exact fun h => False.elim <| h ( by linarith [ Real.sqrt_pos.2 hy_distinct.2.1 ] ) ( by rw [ Real.sqrt_inj ] <;> cases lt_or_gt_of_ne hy1 <;> nlinarith ) ( by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ] ) ( by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ] ) ( by rw [ Real.sqrt_inj ] <;> cases lt_or_gt_of_ne hy1 <;> nlinarith ) |> fun h => by linarith [ Real.sqrt_pos.2 hy_distinct.2.1, Real.sqrt_pos.2 hy_distinct.2.2 ] ;
      · grind;
  -- By definition of $k2$ and $k4$, we know that $k2 = a / 12$ and $k4 = b / 24 - a^2 / 288$.
  have h_k2_k4 : finite_free_cumulant 4 (X ^ 4 + C a * X ^ 2 + C b) 2 = a / 12 ∧ finite_free_cumulant 4 (X ^ 4 + C a * X ^ 2 + C b) 4 = b / 24 - a^2 / 288 := by
    unfold finite_free_cumulant;
    unfold normalized_hat_poly poly_log;
    norm_num [ Finset.sum_range_succ', Polynomial.coeff_one, Polynomial.coeff_X, Polynomial.coeff_C, hat_poly ];
    norm_num [ Polynomial.coeff_one, Polynomial.coeff_X, pow_succ, mul_assoc, add_mul, sub_mul ] ; ring_nf ; norm_num;
  unfold invPhi4_sym_formula; norm_num [ h_invPhi, h_k2_k4 ] ; ring;
  rw [ show b * a * 12 + a ^ 3 = ( b * a * ( -1 / 288 ) + a ^ 3 * ( -1 / 3456 ) ) * ( -12 * 288 ) by ring ] ; norm_num ; ring;
  nlinarith [ inv_mul_cancel_left₀ ( show b * a * ( -1 / 288 ) + a ^ 3 * ( -1 / 3456 ) ≠ 0 by nlinarith [ pow_pos ( neg_pos.mpr ha ) 3 ] ) ( b * a ^ 2 ), inv_mul_cancel_left₀ ( show b * a * ( -1 / 288 ) + a ^ 3 * ( -1 / 3456 ) ≠ 0 by nlinarith [ pow_pos ( neg_pos.mpr ha ) 3 ] ) a ]

/-
The function f(x, y) = 2/3 x - 4/3 y^2/(x(x^2+y)) is superadditive on the domain x>0, -x^2/2 < y < x^2.
-/
theorem invPhi4_sym_superadditive (x1 y1 x2 y2 : ℝ)
    (hx1 : x1 > 0) (hy1_lower : y1 > -x1 ^ 2 / 2) (hy1_upper : y1 < x1 ^ 2)
    (hx2 : x2 > 0) (hy2_lower : y2 > -x2 ^ 2 / 2) (hy2_upper : y2 < x2 ^ 2) :
    let f := fun x y => (2 / 3) * x - (4 / 3) * y ^ 2 / (x * (x ^ 2 + y))
    f (x1 + x2) (y1 + y2) ≥ f x1 y1 + f x2 y2 := by
  -- Let's simplify the expression by cancelling out common terms.
  suffices h_simp : (y1 ^ 2 / (x1 * (x1 ^ 2 + y1))) + (y2 ^ 2 / (x2 * (x2 ^ 2 + y2))) ≥ ((y1 + y2) ^ 2 / ((x1 + x2) * ((x1 + x2) ^ 2 + (y1 + y2)))) by
    ring_nf at *; linarith;
  -- By Cauchy-Schwarz inequality, we have $\frac{y_1^2}{x_1(x_1^2 + y_1)} + \frac{y_2^2}{x_2(x_2^2 + y_2)} \geq \frac{(y_1 + y_2)^2}{x_1(x_1^2 + y_1) + x_2(x_2^2 + y_2)}$.
  have h_cauchy_schwarz : (y1^2 / (x1 * (x1^2 + y1))) + (y2^2 / (x2 * (x2^2 + y2))) ≥ (y1 + y2)^2 / (x1 * (x1^2 + y1) + x2 * (x2^2 + y2)) := by
    rw [ ge_iff_le, div_add_div, div_le_div_iff₀ ] <;> try nlinarith;
    · nlinarith [ sq_nonneg ( y1 * ( x2 * ( x2 ^ 2 + y2 ) ) - y2 * ( x1 * ( x1 ^ 2 + y1 ) ) ) ];
    · exact mul_pos ( mul_pos hx1 ( by nlinarith ) ) ( mul_pos hx2 ( by nlinarith ) );
  exact le_trans ( by exact div_le_div_of_nonneg_left ( by positivity ) ( by nlinarith ) ( by nlinarith [ sq_nonneg ( x1 - x2 ), mul_pos hx1 hx2 ] ) ) h_cauchy_schwarz

/-
The finite free additive convolution of two symmetric quartics is a symmetric quartic.
-/
def is_symmetric_quartic (p : ℝ[X]) : Prop :=
  p.Monic ∧ p.natDegree = 4 ∧ p.coeff 3 = 0 ∧ p.coeff 1 = 0

theorem boxplus_symmetric_quartic (p q : ℝ[X])
    (hp : is_symmetric_quartic p) (hq : is_symmetric_quartic q) :
    is_symmetric_quartic (boxplus 4 p q) := by
  -- By definition of $is_symmetric_quartic$, we know that $p$ and $q$ are of the form $X^4 + aX^2 + b$.
  obtain ⟨a1, b1, hp_def⟩ := hp
  obtain ⟨a2, b2, hq_def⟩ := hq;
  -- By definition of $boxplus$, we know that $p ⊞_4 q$ is also a polynomial of degree 4.
  have h_deg : (boxplus 4 p q).natDegree = 4 := by
    refine' Polynomial.natDegree_eq_of_degree_eq_some _;
    refine' Polynomial.degree_eq_of_le_of_coeff_ne_zero _ _;
    · refine' le_trans ( Polynomial.degree_sum_le _ _ ) _;
      norm_num [ Finset.sup_le_iff ];
      exact fun k hk => le_trans ( add_le_add ( Polynomial.degree_C_le ) le_rfl ) ( by interval_cases k <;> norm_num );
    · unfold boxplus; norm_num [ Finset.sum_range_succ', Polynomial.coeff_one, Polynomial.coeff_X, Polynomial.coeff_C, b1, b2, hp_def, hq_def ] ;
      unfold boxplus_coeff; norm_num [ Polynomial.coeff_eq_zero_of_natDegree_lt, b1, b2, hp_def, hq_def ] ;
      exact ⟨ by rw [ ← b1, a1.coeff_natDegree ] ; aesop, by rw [ ← b2, a2.coeff_natDegree ] ; aesop ⟩;
  -- By definition of $boxplus$, we know that $p ⊞_4 q$ is also a polynomial of degree 4 with coefficients zero for $X^3$ and $X^1$.
  have h_coeff : (boxplus 4 p q).coeff 3 = 0 ∧ (boxplus 4 p q).coeff 1 = 0 := by
    unfold boxplus; simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ] ;
    norm_num [ Finset.sum_range_succ, boxplus_coeff ] ; aesop;
  -- By definition of $boxplus$, we know that $p ⊞_4 q$ is also a polynomial of degree 4 with coefficients zero for $X^3$ and $X^1$, and leading coefficient 1.
  have h_monic : (boxplus 4 p q).Monic := by
    convert boxplus_centered_is_centered 4 p q _ _ |> And.left;
    · exact ⟨ a1, b1, by aesop ⟩;
    · exact ⟨ a2, b2, by aesop ⟩;
  unfold is_symmetric_quartic; aesop;

/-
Explicit formulas for the 2nd and 4th cumulants of a symmetric quartic.
-/
theorem symmetric_quartic_cumulants_explicit (a b : ℝ) :
    let p := X ^ 4 + C a * X ^ 2 + C b
    finite_free_cumulant 4 p 2 = a / 12 ∧ finite_free_cumulant 4 p 4 = b / 24 - a ^ 2 / 288 := by
  -- Let's compute the normalized hat polynomial of $p$.
  have h_normalized_hat : normalized_hat_poly 4 (X ^ 4 + C a * X ^ 2 + C b) = 1 + C (a / 12) * X ^ 2 + C (b / 24) * X ^ 4 := by
    unfold normalized_hat_poly hat_poly; norm_num [ Polynomial.coeff_one, Polynomial.coeff_X, Finset.sum_range_succ' ] ; ring;
    exact Polynomial.funext fun x => by norm_num; ring;
  unfold finite_free_cumulant;
  norm_num [ h_normalized_hat, poly_log ];
  norm_num [ Finset.sum_range_succ', Polynomial.coeff_one, Polynomial.coeff_X, pow_succ, mul_assoc, add_mul, sub_mul ] ; ring

/-
The finite free Stam inequality holds for symmetric quartics (using boxplus).
-/
theorem stam_inequality_n4_symmetric_boxplus (a1 b1 a2 b2 : ℝ)
    (ha1 : a1 < 0) (hb1 : 0 < b1) (hdiscr1 : a1 ^ 2 > 4 * b1)
    (ha2 : a2 < 0) (hb2 : 0 < b2) (hdiscr2 : a2 ^ 2 > 4 * b2) :
    let p1 := X ^ 4 + C a1 * X ^ 2 + C b1
    let p2 := X ^ 4 + C a2 * X ^ 2 + C b2
    let p3 := boxplus 4 p1 p2
    invPhi p3 ≥ invPhi p1 + invPhi p2 := by
  convert invPhi4_sym_superadditive ( - ( a1 / 12 ) ) ( b1 / 24 - a1 ^ 2 / 288 ) ( - ( a2 / 12 ) ) ( b2 / 24 - a2 ^ 2 / 288 ) _ _ _ _ _ _ using 1 <;> try nlinarith;
  constructor <;> intro h;
  · convert invPhi4_sym_superadditive ( - ( a1 / 12 ) ) ( b1 / 24 - a1 ^ 2 / 288 ) ( - ( a2 / 12 ) ) ( b2 / 24 - a2 ^ 2 / 288 ) _ _ _ _ _ _ using 1 <;> nlinarith;
  · have h_poly3 : ∃ a3 b3 : ℝ, boxplus 4 (X ^ 4 + C a1 * X ^ 2 + C b1) (X ^ 4 + C a2 * X ^ 2 + C b2) = X ^ 4 + C a3 * X ^ 2 + C b3 := by
      unfold boxplus;
      unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', Polynomial.coeff_one, Polynomial.coeff_X, Polynomial.coeff_C ] ; ring_nf ;
      exact ⟨ a1 + a2, b1 + b2 + a1 * a2 / 6, by exact Polynomial.funext fun x => by norm_num; ring ⟩;
    obtain ⟨ a3, b3, h ⟩ := h_poly3; simp_all +decide [ invPhi4_sym_formula ] ;
    convert ‹- ( 2 / 3 * ( a1 / 12 ) ) - 4 / 3 * ( b1 / 24 - a1 ^ 2 / 288 ) ^ 2 / - ( a1 / 12 * ( ( a1 / 12 ) ^ 2 + ( b1 / 24 - a1 ^ 2 / 288 ) ) ) + ( - ( 2 / 3 * ( a2 / 12 ) ) - 4 / 3 * ( b2 / 24 - a2 ^ 2 / 288 ) ^ 2 / - ( a2 / 12 * ( ( a2 / 12 ) ^ 2 + ( b2 / 24 - a2 ^ 2 / 288 ) ) ) ) ≤ 2 / 3 * ( - ( a1 / 12 ) + - ( a2 / 12 ) ) - 4 / 3 * ( b1 / 24 - a1 ^ 2 / 288 + ( b2 / 24 - a2 ^ 2 / 288 ) ) ^ 2 / ( ( - ( a1 / 12 ) + - ( a2 / 12 ) ) * ( ( - ( a1 / 12 ) + - ( a2 / 12 ) ) ^ 2 + ( b1 / 24 - a1 ^ 2 / 288 + ( b2 / 24 - a2 ^ 2 / 288 ) ) ) ) › using 1;
    · convert congr_arg₂ ( · + · ) ( invPhi_eq_formula_n4_sym a1 b1 ha1 hb1 hdiscr1 ) ( invPhi_eq_formula_n4_sym a2 b2 ha2 hb2 hdiscr2 ) using 1;
      rw [ symmetric_quartic_cumulants_explicit a1 b1 |>.1, symmetric_quartic_cumulants_explicit a1 b1 |>.2, symmetric_quartic_cumulants_explicit a2 b2 |>.1, symmetric_quartic_cumulants_explicit a2 b2 |>.2 ] ; unfold invPhi4_sym_formula ; ring;
    · convert invPhi_eq_formula_n4_sym a3 b3 _ _ _ using 1;
      · rw [ ← h ];
        rw [ finite_free_cumulant_additive, finite_free_cumulant_additive ] <;> norm_num [ symmetric_quartic_cumulants_explicit ];
        any_goals erw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ Polynomial.coeff_eq_zero_of_natDegree_lt ];
        any_goals rw [ Polynomial.natDegree_C_mul_X_pow ] <;> norm_num ; linarith;
        · unfold invPhi4_sym_formula; ring;
        · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ ha1.ne ];
        · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ Polynomial.natDegree_C_mul_X_pow, ha2.ne ];
        · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ ha1.ne ];
        · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ Polynomial.natDegree_C_mul_X_pow, ha2.ne ];
      · unfold boxplus at h; norm_num [ Finset.sum_range_succ', Polynomial.coeff_X, Polynomial.coeff_C ] at h;
        unfold boxplus_coeff at h; norm_num [ Finset.sum_range_succ', Polynomial.coeff_X, Polynomial.coeff_C ] at h;
        have := congr_arg ( Polynomial.eval 0 ) h; norm_num at this; ( have := congr_arg ( Polynomial.eval 1 ) h; norm_num at this; ( have := congr_arg ( Polynomial.eval ( -1 ) ) h; norm_num at this; nlinarith; ) );
      · unfold boxplus at h;
        norm_num [ Finset.sum_range_succ', boxplus_coeff ] at h;
        have := congr_arg ( Polynomial.eval 0 ) h; norm_num at this; ( have := congr_arg ( Polynomial.eval 1 ) h; norm_num at this; ( have := congr_arg ( Polynomial.eval ( -1 ) ) h; norm_num at this; nlinarith; ) );
      · unfold boxplus at h;
        norm_num [ Finset.sum_range_succ', boxplus_coeff ] at h;
        have h₁ := congr_arg ( Polynomial.eval 0 ) h; have h₂ := congr_arg ( Polynomial.eval 1 ) h; have h₃ := congr_arg ( Polynomial.eval ( -1 ) ) h; have h₄ := congr_arg ( Polynomial.eval ( -2 ) ) h; norm_num at h₁ h₂ h₃ h₄; nlinarith;

/-
Explicit formulas for the cumulants of a general centered quartic.
-/
theorem quartic_cumulants_general (a b c : ℝ) :
    let p := X ^ 4 + C a * X ^ 2 + C b * X + C c
    finite_free_cumulant 4 p 2 = a / 12 ∧
    finite_free_cumulant 4 p 3 = b / 24 ∧
    finite_free_cumulant 4 p 4 = c / 24 - a ^ 2 / 288 := by
  unfold finite_free_cumulant;
  unfold poly_log normalized_hat_poly hat_poly;
  norm_num [ Finset.sum_range_succ', Polynomial.coeff_one, Polynomial.coeff_X, Polynomial.coeff_C ];
  norm_num [ Polynomial.coeff_one, Polynomial.coeff_X, pow_succ, mul_assoc, sub_mul, add_mul ] ; ring_nf ; norm_num

/-
The condition for a symmetric quartic to have real distinct roots is equivalent to its cumulants lying in a specific domain.
-/
def cumulant_x (p : ℝ[X]) : ℝ := - finite_free_cumulant 4 p 2
def cumulant_y (p : ℝ[X]) : ℝ := finite_free_cumulant 4 p 4

theorem symmetric_quartic_roots_iff_cumulants_domain (a b : ℝ) :
    let p := X ^ 4 + C a * X ^ 2 + C b
    let x := cumulant_x p
    let y := cumulant_y p
    (a < 0 ∧ 0 < b ∧ a ^ 2 > 4 * b) ↔ (x > 0 ∧ y > -x ^ 2 / 2 ∧ y < x ^ 2) := by
  have h_x : cumulant_x ( X ^ 4 + C a * X ^ 2 + C b ) = -a / 12 := by
    convert congr_arg Neg.neg ( symmetric_quartic_cumulants_explicit a b |> And.left ) using 1 ; ring!;
  have h_y : cumulant_y ( X ^ 4 + C a * X ^ 2 + C b ) = b / 24 - a ^ 2 / 288 := by
    convert symmetric_quartic_cumulants_explicit a b |> And.right using 1
  simp [h_x, h_y];
  exact fun _ => ⟨ fun h => ⟨ by linarith, by linarith ⟩, fun h => ⟨ by linarith, by linarith ⟩ ⟩

/-
Generate data points for n=4.
-/
def get_quart_data (r1 r2 r3 r4 : ℚ) : (ℚ × ℚ × ℚ × ℚ) :=
  let s := (r1 + r2 + r3 + r4) / 4
  let x1 := r1 - s
  let x2 := r2 - s
  let x3 := r3 - s
  let x4 := r4 - s
  -- Coefficients of centered poly: X^4 + aX^2 + bX + c
  -- sum x_i = 0
  -- a = sum_{i<j} x_i x_j
  let a := x1*x2 + x1*x3 + x1*x4 + x2*x3 + x2*x4 + x3*x4
  -- b = - sum_{i<j<k} x_i x_j x_k
  let b := - (x1*x2*x3 + x1*x2*x4 + x1*x3*x4 + x2*x3*x4)
  -- c = x1 x2 x3 x4
  let c := x1*x2*x3*x4
  -- Cumulants
  let k2 := a / 12
  let k3 := b / 24
  let k4 := c / 24 - a^2 / 288
  -- Phi
  let phi := 2 * (1/(x1-x2)^2 + 1/(x1-x3)^2 + 1/(x1-x4)^2 + 1/(x2-x3)^2 + 1/(x2-x4)^2 + 1/(x3-x4)^2)
  (k2, k3, k4, 1/phi)

#eval get_quart_data 0 1 (-1) 0
#eval get_quart_data 1 (-1) 2 (-2)
#eval get_quart_data 1 2 3 (-6)
#eval get_quart_data 1 1 (-1) (-1)
#eval get_quart_data 1 2 4 (-7)

/-
Compute exact values.
-/
def compute_exact_values : ℚ × ℚ × ℚ × ℚ :=
  let roots : List ℚ := [-2, -1, 0, 3]
  let s := (roots.sum) / 4
  let centered := roots.map (fun r => r - s)
  let x1 := centered.get! 0
  let x2 := centered.get! 1
  let x3 := centered.get! 2
  let x4 := centered.get! 3
  let a := x1*x2 + x1*x3 + x1*x4 + x2*x3 + x2*x4 + x3*x4
  let b := - (x1*x2*x3 + x1*x2*x4 + x1*x3*x4 + x2*x3*x4)
  let c := x1*x2*x3*x4
  let k2 := a / 12
  let k3 := b / 24
  let k4 := c / 24 - a^2 / 288
  let phi := 2 * (1/(x1-x2)^2 + 1/(x1-x3)^2 + 1/(x1-x4)^2 + 1/(x2-x3)^2 + 1/(x2-x4)^2 + 1/(x3-x4)^2)
  (k2, k3, k4, 1/phi)

#eval compute_exact_values

/-
Gather data points.
-/
#eval get_quart_data (-2) (-1) 0 3
#eval get_quart_data (-3) (-2) 2 3
#eval get_quart_data (-5) 1 2 2
#eval get_quart_data (-1) 0 0 1
#eval get_quart_data (-2) 0 0 2

/-
The finite free Stam inequality holds for symmetric quartics.
-/
theorem stam_inequality_n4_symmetric_boxplus_v2 (a1 b1 a2 b2 : ℝ)
    (ha1 : a1 < 0) (hb1 : 0 < b1) (hdiscr1 : a1 ^ 2 > 4 * b1)
    (ha2 : a2 < 0) (hb2 : 0 < b2) (hdiscr2 : a2 ^ 2 > 4 * b2) :
    let p1 := X ^ 4 + C a1 * X ^ 2 + C b1
    let p2 := X ^ 4 + C a2 * X ^ 2 + C b2
    let p3 := boxplus 4 p1 p2
    invPhi p3 ≥ invPhi p1 + invPhi p2 := by
      convert stam_inequality_n4_symmetric_boxplus a1 b1 a2 b2 ha1 hb1 hdiscr1 ha2 hb2 hdiscr2 using 1