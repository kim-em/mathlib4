/-
The (2k)-th coefficient of the hat polynomial of the scaled Hermite polynomial is given by a specific formula involving factorials and powers of t.
-/
def scaled_hermite (n : ℕ) (t : ℝ) : ℝ[X] :=
  ∑ k ∈ range (n / 2 + 1), C ((-1 : ℝ) ^ k * (n.factorial : ℝ) / ((k.factorial : ℝ) * ((n - 2 * k).factorial : ℝ) * (2 : ℝ) ^ k) * t ^ k) * X ^ (n - 2 * k)

theorem coeff_hat_poly_scaled_hermite (n : ℕ) (t : ℝ) (k : ℕ) (hk : k ≤ n / 2) :
    (hat_poly n (scaled_hermite n t)).coeff (2 * k) =
    (-1 : ℝ) ^ k * (n.factorial : ℝ) / ((k.factorial : ℝ) * (2 : ℝ) ^ k) * t ^ k := by
  -- The coefficient of $X^{2k}$ in the hat polynomial is given by the coefficient of $X^{n-2k}$ in the original polynomial multiplied by $(n-2k)!$.
  have h_coeff : (hat_poly n (scaled_hermite n t)).coeff (2 * k) = ((Polynomial.coeff (scaled_hermite n t) (n - 2 * k)) * (n - 2 * k).factorial) := by
    unfold hat_poly;
    norm_num [ mul_assoc, Polynomial.coeff_C_mul_X_pow ];
    intros; omega;
  rw [ h_coeff, scaled_hermite ];
  norm_num [ Polynomial.coeff_sum, div_mul_eq_mul_div ];
  rw [ Finset.sum_eq_single_of_mem k ];
  · norm_num [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm, Nat.factorial_ne_zero ];
  · exact Finset.mem_range.mpr ( Nat.lt_succ_of_le hk );
  · grind

