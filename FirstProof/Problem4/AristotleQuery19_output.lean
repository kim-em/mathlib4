          rw [ Finset.sum_image <| by aesop ];
          exact Finset.sum_congr rfl fun x hx => by rw [ Finset.sum_image ( by aesop ) ] ; simp +decide [ sub_sub_sub_cancel_right ] ;
        · rw [ Multiset.nodup_iff_count_le_one ] at *;
          simp +zetaDelta at *;
          rename_i h₁ h₂; obtain ⟨ x, hx ⟩ := h₂; have := h₁; simp_all +decide [ Multiset.count_map ] ;
          contrapose! h₁;
          use x - c;
          simp_all +decide [ sub_eq_sub_iff_add_eq_add ];
          rw [ Multiset.filter_eq ] ; aesop;
      · -- By definition of polynomial composition, the roots of $p.comp (X + C c)$ are the roots of $p$ shifted by $-c$.
        ext x
        simp [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C];
        -- By definition of polynomial composition, the roots of $p.comp (X + C c)$ are the roots of $p$ shifted by $-c$. Therefore, the multiplicity of $x$ in $p.comp (X + C c)$ is the same as the multiplicity of $x + c$ in $p$.
