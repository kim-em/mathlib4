lemma sum_field_strengths_zero (s : Finset ℝ) :
    ∑ i ∈ s, ∑ j ∈ s.erase i, 1 / (i - j) = 0 := by
      -- By pairing each term $\frac{1}{i-j}$ with $\frac{1}{j-i}$, we can show that their sum is zero.
      have h_pair : ∑ i ∈ s, ∑ j ∈ s.erase i, (1 / (i - j)) = ∑ i ∈ s, ∑ j ∈ s.erase i, (-1 / (i - j)) := by
        rw [ Finset.sum_sigma', Finset.sum_sigma' ];
        apply Finset.sum_bij (fun x _ => ⟨x.snd, x.fst⟩);
        · aesop;
        · aesop;
        · aesop;
        · exact fun x hx => by rw [ ← neg_div_neg_eq ] ; ring;
      norm_num [ neg_div ] at * ; linarith

/-
Phi(p) is strictly positive if p has at least 2 distinct real roots.
-/
lemma Phi_pos (p : ℝ[X]) (h_splits : p.Splits (RingHom.id ℝ))
    (h_nodup : p.roots.Nodup) (h_card : p.roots.card ≥ 2) :
    Phi p > 0 := by
      -- By contradiction, assume that $\Phi(p) = 0$.
      by_contra h_zero
      have h_all_zero : ∀ r_i ∈ p.roots.toFinset, (∑ r_j ∈ p.roots.toFinset.erase r_i, (1 / (r_i - r_j))) = 0 := by
        exact fun r hr => sq_eq_zero_iff.mp ( le_antisymm ( le_of_not_gt fun h => h_zero <| lt_of_lt_of_le ( by positivity ) <| Finset.single_le_sum ( fun x _ => sq_nonneg <| ∑ y ∈ p.roots.toFinset.erase x, 1 / ( x - y ) ) hr ) <| sq_nonneg _ );
      -- Let $r_{\text{max}}$ be the largest root of $p$.
      obtain ⟨r_max, hr_max⟩ : ∃ r_max ∈ p.roots.toFinset, ∀ r ∈ p.roots.toFinset, r ≤ r_max := by
        exact ⟨ Finset.max' ( p.roots.toFinset ) ( Finset.nonempty_of_ne_empty ( by aesop_cat ) ), Finset.max'_mem _ _, fun r hr => Finset.le_max' _ _ hr ⟩;
      -- Since $r_{\text{max}}$ is the largest root, for any $r_j \in p.roots.toFinset$ with $r_j \neq r_{\text{max}}$, we have $r_{\text{max}} - r_j > 0$.
      have h_pos : ∀ r_j ∈ p.roots.toFinset.erase r_max, 0 < r_max - r_j := by
        grind;
      exact absurd ( h_all_zero r_max hr_max.1 ) ( ne_of_gt <| Finset.sum_pos ( fun x hx => one_div_pos.mpr <| h_pos x hx ) <| Finset.card_pos.mp <| by rw [ Finset.card_erase_of_mem hr_max.1 ] ; exact Nat.sub_pos_of_lt <| by simpa [ Multiset.toFinset_card_of_nodup h_nodup ] using h_card )

/-
invPhi(p) is strictly positive if p has at least 2 distinct real roots.
-/
lemma invPhi_pos (p : ℝ[X]) (h_splits : p.Splits (RingHom.id ℝ))
    (h_nodup : p.roots.Nodup) (h_card : p.roots.card ≥ 2) :
    invPhi p > 0 := by
      -- By definition, invPhi(p) = 1/Phi(p) if roots are distinct and card > 1.
      have h_invPhi : invPhi p = 1 / Phi p := by
        exact if_pos ⟨ h_nodup, h_card ⟩;
      exact h_invPhi.symm ▸ one_div_pos.mpr ( Phi_pos p h_splits h_nodup h_card )

/-
Formula for Phi of a reduced cubic polynomial X^3 + aX + b.
-/
lemma Phi_deg3_reduced_eq (a b : ℝ)
    (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
    (h_nodup : (X^3 + C a * X + C b).roots.Nodup) :
    Phi (X^3 + C a * X + C b) = (- (2 / 9) * a - (3 / 2) * (b / a) ^ 2)⁻¹ := by
      have h_roots : ∃ r1 r2 r3 : ℝ, r1 + r2 + r3 = 0 ∧ r1 * r2 + r1 * r3 + r2 * r3 = a ∧ r1 * r2 * r3 = -b ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3 := by
        -- Since the polynomial splits into linear factors and the roots are distinct, we can extract three distinct roots $r_1$, $r_2$, and $r_3$.
        obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3 ∧ r1 + r2 + r3 = 0 ∧ r1 * r2 + r1 * r3 + r2 * r3 = a ∧ r1 * r2 * r3 = -b := by
          have h_roots : ∃ r1 r2 r3 : ℝ, Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = {r1, r2, r3} := by
            have h_card : Multiset.card (Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 3 := by
              rw [ Polynomial.splits_iff_card_roots ] at h_real;
              rw [ h_real, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
            exact Multiset.card_eq_three.mp h_card
          obtain ⟨ r1, r2, r3, h ⟩ := h_roots; use r1, r2, r3; simp_all +decide [ Finset.ext_iff ] ;
          have h_vieta : Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) := by
            rw [ ← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq ( show Polynomial.Monic ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) from ?_ ) ];
            · simpa [ h ] using by ring;
            · rw [ Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
              · aesop;
              · aesop;
            · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
          have h₁ := congr_arg ( Polynomial.eval 0 ) h_vieta; have h₂ := congr_arg ( Polynomial.eval 1 ) h_vieta; have h₃ := congr_arg ( Polynomial.eval ( -1 ) ) h_vieta; norm_num at h₁ h₂ h₃; exact ⟨ by linarith, by linarith, by linarith ⟩ ;
        exact ⟨ r1, r2, r3, hr.2.2.2.1, hr.2.2.2.2.1, hr.2.2.2.2.2, hr.1, hr.2.1, hr.2.2.1 ⟩;
      obtain ⟨ r1, r2, r3, h1, h2, h3, h4, h5, h6 ⟩ := h_roots; rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r1 ) * ( Polynomial.X - Polynomial.C r2 ) * ( Polynomial.X - Polynomial.C r3 ) from _ ] ;
      · unfold Phi; norm_num [ Polynomial.roots_mul, Polynomial.X_sub_C_ne_zero, h4, h5, h6 ] ; ring;
        rw [ ← eq_sub_iff_add_eq' ] at h1; subst_vars; ring;
        grind;
      · exact Polynomial.funext fun x => by norm_num; linear_combination h1 * x^2 - h2 * x + h3;

/-
Formula for invPhi of a reduced cubic polynomial X^3 + aX + b.
-/
lemma invPhi_cubic_formula (a b : ℝ)
    (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
    (h_nodup : (X^3 + C a * X + C b).roots.Nodup) :
    invPhi (X^3 + C a * X + C b) = - (2 / 9) * a - (3 / 2) * (b / a) ^ 2 := by
      rw [ invPhi ];
      rw [ if_pos ];
      · convert congr_arg ( fun x : ℝ => x⁻¹ ) ( Phi_deg3_reduced_eq a b h_real h_nodup ) using 1 ; norm_num;
        norm_num;
      · simp_all +decide [ Polynomial.splits_iff_card_roots ];
        rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ]

/-
If X^3 + aX + b has 3 distinct real roots, then a < 0.
-/
lemma cubic_distinct_real_roots_implies_a_neg (a b : ℝ)
    (h_card : (X^3 + C a * X + C b).roots.toFinset.card = 3) :
    a < 0 := by
      -- By Vieta's formulas, we know that $r_1 + r_2 + r_3 = 0$ and $r_1 r_2 + r_2 r_3 + r_3 r_1 = a$.
      obtain ⟨r₁, r₂, r₃, hr⟩ : ∃ r₁ r₂ r₃ : ℝ, r₁ ≠ r₂ ∧ r₁ ≠ r₃ ∧ r₂ ≠ r₃ ∧ r₁^3 + a * r₁ + b = 0 ∧ r₂^3 + a * r₂ + b = 0 ∧ r₃^3 + a * r₃ + b = 0 := by
        obtain ⟨ r₁, r₂, r₃, h ⟩ := Finset.card_eq_three.mp h_card;
        exact ⟨ r₁, r₂, r₃, h.1, h.2.1, h.2.2.1, by replace h := Finset.ext_iff.mp h.2.2.2 r₁; aesop, by replace h := Finset.ext_iff.mp h.2.2.2 r₂; aesop, by replace h := Finset.ext_iff.mp h.2.2.2 r₃; aesop ⟩;
      -- By Vieta's formulas, we know that $r_1 + r_2 + r_3 = 0$ and $r_1 r_2 + r_2 r_3 + r_3 r_1 = a$ for the roots $r_1, r_2, r_3$ of $X^3 + aX + b$.
      have h_vieta_sum : r₁ + r₂ + r₃ = 0 := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne hr.1 ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne hr.2.1 ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne hr.2.2.1 ) <| by linear_combination hr.2.2.2.1 * ( r₂ - r₃ ) - hr.2.2.2.2.1 * ( r₁ - r₃ ) + hr.2.2.2.2.2 * ( r₁ - r₂ ) ;
      have h_vieta_prod_sum : r₁ * r₂ + r₂ * r₃ + r₃ * r₁ = a := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne hr.1 ) ( by ring_nf; nlinarith );
      cases lt_or_gt_of_ne hr.1 <;> cases lt_or_gt_of_ne hr.2.1 <;> cases lt_or_gt_of_ne hr.2.2.1 <;> nlinarith [ sq_nonneg r₁, sq_nonneg r₂, sq_nonneg r₃ ] ;

/-
Algebraic inequality for the n=3 case: square of weighted average is less than sum of squares.
-/
lemma algebraic_inequality_n3 (a1 b1 a2 b2 : ℝ)
    (ha1 : a1 < 0) (ha2 : a2 < 0) :
    ((b1 + b2) / (a1 + a2)) ^ 2 ≤ (b1 / a1) ^ 2 + (b2 / a2) ^ 2 := by
      rw [ div_pow, div_pow, div_pow ];
      -- By cross-multiplying, we can eliminate the denominators and work with a polynomial inequality.
      have h_cross : (b1 + b2)^2 * a1^2 * a2^2 ≤ (b1^2 * a2^2 + b2^2 * a1^2) * (a1 + a2)^2 := by
        nlinarith [ sq_nonneg ( b1 * a2^2 + b2 * a1^2 ), sq_nonneg ( b1 * a2 * ( a1 + a2 ) - b2 * a1 * ( a1 + a2 ) ), sq_nonneg ( b1 * a2 * ( a1 - a2 ) + b2 * a1 * ( a1 - a2 ) ), mul_pos ( neg_pos.mpr ha1 ) ( neg_pos.mpr ha2 ) ];
      rw [ div_add_div, div_le_div_iff₀ ] <;> nlinarith [ mul_pos ( neg_pos.mpr ha1 ) ( neg_pos.mpr ha2 ) ]

/-
The Finite Free Stam Inequality holds for reduced cubic polynomials.
-/
theorem conjecture_n_3_reduced (a1 b1 a2 b2 : ℝ)
    (h_real1 : (X^3 + C a1 * X + C b1).Splits (RingHom.id ℝ))
    (h_nodup1 : (X^3 + C a1 * X + C b1).roots.Nodup)
    (h_real2 : (X^3 + C a2 * X + C b2).Splits (RingHom.id ℝ))
    (h_nodup2 : (X^3 + C a2 * X + C b2).roots.Nodup)
    (h_real3 : (X^3 + C (a1+a2) * X + C (b1+b2)).Splits (RingHom.id ℝ))
    (h_nodup3 : (X^3 + C (a1+a2) * X + C (b1+b2)).roots.Nodup) :
    invPhi (X^3 + C (a1+a2) * X + C (b1+b2)) ≥
    invPhi (X^3 + C a1 * X + C b1) + invPhi (X^3 + C a2 * X + C b2) := by
      have h_a1_neg : a1 < 0 := by
        apply cubic_distinct_real_roots_implies_a_neg a1 b1;
        rw [ Multiset.toFinset_card_of_nodup ] <;> norm_num [ h_nodup1 ];
        rw [ Polynomial.splits_iff_card_roots ] at *;
        rw [ h_real1, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha1 : a1 = 0 <;> simp +decide [ ha1 ]
      have h_a2_neg : a2 < 0 := by
        apply cubic_distinct_real_roots_implies_a_neg;
        rw [ Polynomial.splits_iff_card_roots ] at *;
        rw [ Multiset.toFinset_card_of_nodup h_nodup2 ] ; erw [ h_real2 ] ; erw [ Polynomial.natDegree_add_C ] ; erw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha2 : a2 = 0 <;> simp +decide [ ha2 ]
      have h_cubic_ineq : ((b1 + b2) / (a1 + a2)) ^ 2 ≤ (b1 / a1) ^ 2 + (b2 / a2) ^ 2 := by
        exact?;
      rw [ invPhi_cubic_formula a1 b1 h_real1 h_nodup1, invPhi_cubic_formula a2 b2 h_real2 h_nodup2, invPhi_cubic_formula ( a1 + a2 ) ( b1 + b2 ) h_real3 h_nodup3 ] ; nlinarith

/-
Algebraic inequality for the n=3 case, derived from the invPhi formula.
-/
lemma invPhi_ineq_reduced_cubic_algebra (a1 b1 a2 b2 : ℝ)
    (ha1 : a1 < 0) (ha2 : a2 < 0) :
    (- (2 / 9) * (a1 + a2) - (3 / 2) * ((b1 + b2) / (a1 + a2)) ^ 2) ≥
    (- (2 / 9) * a1 - (3 / 2) * (b1 / a1) ^ 2) + (- (2 / 9) * a2 - (3 / 2) * (b2 / a2) ^ 2) := by
      have := @algebraic_inequality_n3 a1 b1 a2 b2 ha1 ha2; ring_nf at *; nlinarith;

/-
A centered monic cubic polynomial p is equal to X^3 + p.coeff(1)*X + p.coeff(0).
-/
lemma monic_cubic_centered_eq (p : ℝ[X])
    (hp_monic : p.Monic) (hp_deg : p.natDegree = 3) (hp_centered : p.coeff 2 = 0) :
    p = X^3 + C (p.coeff 1) * X + C (p.coeff 0) := by
      conv_lhs => rw [ p.as_sum_range_C_mul_X_pow ] ; norm_num [ Finset.sum_range_succ', hp_monic, hp_deg, hp_centered ] ;
      rw [ ← hp_deg, hp_monic.coeff_natDegree, Polynomial.C_1, one_mul ]

/-
For centered polynomials, the (n-2)-th coefficient is additive under boxplus.
-/
lemma boxplus_centered_coeff_add (n : ℕ) (p q : ℝ[X])
    (hp : is_centered n p) (hq : is_centered n q) :
    (boxplus n p q).coeff (n - 2) = p.coeff (n - 2) + q.coeff (n - 2) := by
      unfold is_centered at *; rcases n with ( _ | _ | n ) <;> simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ] ;
      · rw [ Polynomial.eq_C_of_natDegree_eq_zero hp.2.1 ] at hp ; aesop;
      · unfold boxplus;
        simp_all +decide [ Finset.sum_range_succ', boxplus_coeff ];
      · unfold boxplus; simp +decide [ *, Polynomial.coeff_eq_zero_of_natDegree_lt ] ; ring;
        rw [ Finset.sum_eq_single ( 2 : ℕ ) ] <;> norm_num;
        · unfold boxplus_coeff;
          norm_num [ Finset.sum_range_succ', hp, hq ];
          simp_all +decide [ add_comm 2, Nat.factorial_ne_zero, mul_comm, mul_assoc, mul_left_comm, div_eq_mul_inv ];
          have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; aesop;
        · omega;
        · intros; linarith;

/-
The boxplus of two reduced cubic polynomials sums their linear and constant coefficients.
-/
lemma boxplus_reduced_cubic (a1 b1 a2 b2 : ℝ) :
    boxplus 3 (X^3 + C a1 * X + C b1) (X^3 + C a2 * X + C b2) =
    X^3 + C (a1 + a2) * X + C (b1 + b2) := by
      convert Polynomial.ext _;
      unfold boxplus;
      norm_num [ Finset.sum_range_succ', boxplus_coeff ];
      intro n; norm_num [ mul_assoc, Polynomial.coeff_one, Polynomial.coeff_X, Polynomial.coeff_C ] ; ring;

/-
The boxplus convolution of two centered monic cubic polynomials with real distinct roots also has real distinct roots.
-/
lemma boxplus_n3_splits_nodup (p q : ℝ[X])
    (hp_monic : p.Monic) (hq_monic : q.Monic)
    (hp_deg : p.natDegree = 3) (hq_deg : q.natDegree = 3)
    (hp_nodup : p.roots.Nodup) (hq_nodup : q.roots.Nodup)
    (hp_splits : p.Splits (RingHom.id ℝ)) (hq_splits : q.Splits (RingHom.id ℝ))
    (hp_centered : is_centered 3 p) (hq_centered : is_centered 3 q) :
    (boxplus 3 p q).Splits (RingHom.id ℝ) ∧ (boxplus 3 p q).roots.Nodup := by
      -- By definition of $p$ and $q$, we know that they are of the form $X^3 + aX + b$ and $X^3 + cX + d$ respectively.
      obtain ⟨a1, b1, hp_eq⟩ : ∃ a1 b1 : ℝ, p = Polynomial.X^3 + Polynomial.C a1 * Polynomial.X + Polynomial.C b1 := by
        use p.coeff 1, p.coeff 0;
        convert monic_cubic_centered_eq p hp_monic hp_deg _ using 1;
        cases hp_centered ; aesop
      obtain ⟨a2, b2, hq_eq⟩ : ∃ a2 b2 : ℝ, q = Polynomial.X^3 + Polynomial.C a2 * Polynomial.X + Polynomial.C b2 := by
        use q.coeff 1, q.coeff 0;
        convert monic_cubic_centered_eq q hq_monic hq_deg hq_centered.2.2 using 1;
      have h_boxplus_eq : boxplus 3 p q = Polynomial.X^3 + Polynomial.C (a1 + a2) * Polynomial.X + Polynomial.C (b1 + b2) := by
        convert boxplus_reduced_cubic a1 b1 a2 b2 using 1 ; aesop;
      -- By the algebraic inequality, we have that the discriminant of the boxplus polynomial is positive.
      have h_discriminant_pos : -4 * (a1 + a2)^3 - 27 * (b1 + b2)^2 > 0 := by
        have h_discriminant_pos : -4 * a1^3 - 27 * b1^2 > 0 ∧ -4 * a2^3 - 27 * b2^2 > 0 := by
          have h_discriminant_pos : ∀ (a b : ℝ), (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots.toFinset.card = 3 → -4 * a^3 - 27 * b^2 > 0 := by
            intros a b h_card
            obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r1 ∧ r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a ∧ r1 * r2 * r3 = -b := by
              obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 ∈ Polynomial.roots (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) ∧ r2 ∈ Polynomial.roots (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) ∧ r3 ∈ Polynomial.roots (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) ∧ r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r1 := by
                obtain ⟨ r1, r2, r3, h ⟩ := Finset.card_eq_three.mp h_card;
                exact ⟨ r1, r2, r3, by replace h := Finset.ext_iff.mp h.2.2.2 r1; aesop, by replace h := Finset.ext_iff.mp h.2.2.2 r2; aesop, by replace h := Finset.ext_iff.mp h.2.2.2 r3; aesop, by tauto ⟩;
              use r1, r2, r3;
              norm_num at hr;
              grind;
            -- Substitute the values of $a$ and $b$ from Vieta's formulas into the discriminant expression.
            have h_discriminant_subst : -4 * (r1 * r2 + r2 * r3 + r3 * r1)^3 - 27 * (r1 * r2 * r3)^2 = (r1 - r2)^2 * (r2 - r3)^2 * (r3 - r1)^2 := by
              grind +ring;
            simp_all +decide [ sub_eq_iff_eq_add ];
            exact mul_pos ( mul_pos ( sq_pos_of_ne_zero ( sub_ne_zero.mpr hr.1 ) ) ( sq_pos_of_ne_zero ( sub_ne_zero.mpr hr.2.1 ) ) ) ( sq_pos_of_ne_zero ( sub_ne_zero.mpr hr.2.2.1 ) );
          have h_card_roots : p.roots.toFinset.card = 3 ∧ q.roots.toFinset.card = 3 := by
            rw [ Multiset.toFinset_card_of_nodup hp_nodup, Multiset.toFinset_card_of_nodup hq_nodup ];
            rw [ Polynomial.splits_iff_card_roots ] at hp_splits hq_splits ; aesop;
          aesop;
        -- By the algebraic inequality, we have that $a1 < 0$ and $a2 < 0$.
        have h_a1_neg : a1 < 0 := by
          nlinarith [ sq_nonneg ( a1^2 ) ]
        have h_a2_neg : a2 < 0 := by
          nlinarith [ sq_nonneg a2 ];
        nlinarith [ mul_pos ( neg_pos_of_neg h_a1_neg ) ( neg_pos_of_neg h_a2_neg ), pow_pos ( neg_pos_of_neg h_a1_neg ) 3, pow_pos ( neg_pos_of_neg h_a2_neg ) 3, mul_pos ( neg_pos_of_neg h_a1_neg ) ( pow_pos ( neg_pos_of_neg h_a2_neg ) 2 ), mul_pos ( neg_pos_of_neg h_a2_neg ) ( pow_pos ( neg_pos_of_neg h_a1_neg ) 2 ) ];
      -- Since the discriminant is positive, the polynomial has three distinct real roots.
      have h_distinct_real_roots : ∃ r1 r2 r3 : ℝ, r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r1 ∧ Polynomial.X^3 + Polynomial.C (a1 + a2) * Polynomial.X + Polynomial.C (b1 + b2) = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) := by
        obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a1 + a2 ∧ r1 * r2 * r3 = -(b1 + b2) := by
