    · rw [ inv_eq_iff_eq_inv ] ; norm_num ; ring;
      field_simp;
      rw [ div_add_div, div_add_div ] <;> try nlinarith [ mul_self_pos.2 ( sub_ne_zero.2 hr1 ), mul_self_pos.2 ( sub_ne_zero.2 hr2 ), mul_self_pos.2 ( sub_ne_zero.2 hr3 ) ];
      rw [ mul_div, div_eq_div_iff ];
      · grind +ring;
      · grind;
      · grind

/-
Algebraic identity for the sum of squared derivative quotients for a reduced cubic.
-/
lemma sum_sq_roots_frac (a b : ℝ) (roots : Finset ℝ)
  (h_roots : ∀ r ∈ roots, r^3 + a * r + b = 0)
  (h_card : roots.card = 3)
  (h_nodup : roots.toList.Nodup) -- Finset is always nodup, but this implies distinct roots in the multiset sense if we constructed it from roots
  (h_a_neg : a < 0)
  (h_disc : -4 * a^3 - 27 * b^2 > 0) :
  ∑ r ∈ roots, (3 * r / (3 * r^2 + a))^2 = 18 * a^2 / (-4 * a^3 - 27 * b^2) := by
    -- By Vieta's formulas, we know that for� the� roots $r_1 �,� r_2, r_�3�$ of the polynomial $x^3 + ax + b$, we� have�:
    -- $r_1� +� r_2 + r_3 = 0$, $�r�_1r_2 + r_1r_3 + r_2r_3 = a$, and $r_1r_2r_3 = -b$.
    have h_vieta : ∃ r1 r2 r3 : ℝ, r1 + r2 + r3 = 0 ∧ r1 * r2 + r1 * r3 + r2 * r3 = a ∧ r1 * r2 * r3 = -b ∧ roots = {r1, r2, r3} := by
      rw [ Finset.card_eq_three ] at h_card;
      obtain ⟨ x, y, z, hxy, hxz, hyz, rfl ⟩ := h_card;
      use x, y, z;
      have h_vieta_sum : x + y + z = 0 := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne hxy ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne hxz ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne hyz ) <| by linear_combination ( h_roots x ( by norm_num ) ) * ( y - z ) - ( h_roots y ( by norm_num ) ) * ( x - z ) + ( h_roots z ( by norm_num ) ) * ( x - y ) ;
      have h_vieta_prod_sum : x * y + x * z + y * z = a := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne hxy ) ( by ring_nf; nlinarith [ h_roots x ( by norm_num ), h_roots y ( by norm_num ), h_roots z ( by norm_num ) ] )
      have h_vieta_prod : x * y * z = -b := by
        nlinarith [ sq_nonneg x, sq_nonneg y, sq_nonneg z, h_roots x ( by norm_num ), h_roots y ( by norm_num ), h_roots z ( by norm_num ) ]
      exact ⟨h_vieta_sum, h_vieta_prod_sum, h_vieta_prod, rfl⟩;
    obtain ⟨ r1, r2, r3, h1, h2, h3, rfl ⟩ := h_vieta; rw [ Finset.sum_insert, Finset.sum_insert ] <;> norm_num ; ring ; simp_all +decide [ Finset.sum ] ;
    · field_simp;
      rw [ div_add_div, div_add_div ];
      · grind +ring;
      · grind;
      · grind;
      · grind;
      · grind;
    · grind;
    · grind

/-
Proving the relation between derivatives and reciprocal sums for a cubic polynomial.
-/
lemma cubic_deriv_quot_eq_sum_inv_diff (r1 r2 r3 : ℝ) (h_distinct : r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3) :
  let p := C 1 * (X - C r1) * (X - C r2) * (X - C r3)
  (p.derivative.derivative.eval r1) / (2 * p.derivative.eval r1) = 1 / (r1 - r2) + 1 / (r1 - r3) := by
    norm_num [ Polynomial.derivative_mul, Polynomial.derivative_sub, Polynomial.derivative_X, Polynomial.derivative_C ];
    grind

/-
Proving the conjecture for n=1.
-/
theorem conjecture_n_1 (p q : ℝ[X])
  (hp_monic : p.Monic) (hq_monic : q.Monic)
  (hp_deg : p.natDegree = 1) (hq_deg : q.natDegree = 1)
  (hp_real : p.Splits (RingHom.id ℝ)) (hq_real : q.Splits (RingHom.id ℝ)) :
  invPhi (boxplus 1 p q) ≥ invPhi p + invPhi q := by
    unfold invPhi;
    rw [ Polynomial.eq_X_add_C_of_natDegree_le_one ( le_of_eq hp_deg ), Polynomial.eq_X_add_C_of_natDegree_le_one ( le_of_eq hq_deg ) ] ; norm_num;
    unfold boxplus;
    norm_num [ Finset.sum_range_succ, boxplus_coeff ];
    simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
    erw [ show ( Polynomial.X + ( Polynomial.C ( q.coeff 0 ) + Polynomial.C ( p.coeff 0 ) ) ) = ( Polynomial.X - Polynomial.C ( - ( q.coeff 0 + p.coeff 0 ) ) ) by simpa using by ring, Polynomial.roots_X_sub_C ] at * ; aesop

/-
Proving the algebraic identity for n=3 using brute force with r3 elimination.
-/
lemma sum_sq_deriv_quot_cubic (r1 r2 r3 a b : ℝ)
  (h_sum : r1 + r2 + r3 = 0)
  (h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a)
  (h_prod : r1 * r2 * r3 = -b)
  (h_distinct : r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3)
  (h_denom : 3 * r1^2 + a ≠ 0 ∧ 3 * r2^2 + a ≠ 0 ∧ 3 * r3^2 + a ≠ 0) :
  (3 * r1 / (3 * r1^2 + a))^2 + (3 * r2 / (3 * r2^2 + a))^2 + (3 * r3 / (3 * r3^2 + a))^2 =
  18 * a^2 / (-4 * a^3 - 27 * b^2) := by
    rw [ div_pow, div_pow, div_pow, div_add_div, div_add_div ] <;> try { aesop };
    rw [ div_eq_div_iff ] <;> norm_num [ ← h_prod_sum, ← h_prod ];
    · rw [ ← eq_sub_iff_add_eq' ] at h_sum ; subst_vars ; ring;
      rw [ show b = r1 * r2 * ( r1 + r2 ) by linarith ] ; ring;
    · aesop;
    · grind

/-
Simplification of the derivative quotient for a cubic root.
