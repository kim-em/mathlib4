/-
Phi is translation invariant.
-/
lemma Phi_translation_invariant (p : ℝ[X]) (c : ℝ) :
  Phi (p.comp (X + C c)) = Phi p := by
    unfold Phi;
    rw [ show ( p.comp ( Polynomial.X + Polynomial.C c ) |> Polynomial.roots |> Multiset.toFinset ) = Finset.image ( fun x => x - c ) ( p.roots.toFinset ) from ?_ ];
    · rw [ Finset.sum_image, Finset.sum_congr rfl ];
      · intro x hx; rw [ show ( Finset.image ( fun x => x - c ) p.roots.toFinset ).erase ( x - c ) = Finset.image ( fun x => x - c ) ( p.roots.toFinset.erase x ) from ?_ ] ; rw [ Finset.sum_image ] ; aesop;
        · exact fun a ha b hb hab => by simpa using hab;
        · ext; aesop;
      · exact fun x hx y hy hxy => by simpa using hxy;
    · ext x; simp [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C];
      rw [ Polynomial.comp_eq_zero_iff ] ; aesop

