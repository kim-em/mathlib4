      have h_scale : (∏ i : Fin n, (Polynomial.X - Polynomial.C (c * r i))).roots.toFinset = Finset.image (fun r_j => c * r_j) ((∏ i : Fin n, (Polynomial.X - Polynomial.C (r i))).roots.toFinset) := by
