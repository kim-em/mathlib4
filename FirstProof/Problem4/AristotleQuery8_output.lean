set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Opening namespaces.
-/
open Polynomial BigOperators Finset Classical Real Nat

/-
Definition of boxplus coefficients.
-/
def boxplus_coeff (n : ℕ) (p q : ℝ[X]) (k : ℕ) : ℝ :=
  ∑ i ∈ range (k + 1),
    let j := k - i
    (Nat.factorial (n - i) * Nat.factorial (n - j) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) *
    (p.coeff (n - i)) * (q.coeff (n - j))

/-
Definition of boxplus convolution.
-/
def boxplus (n : ℕ) (p q : ℝ[X]) : ℝ[X] :=
  Finset.sum (range (n + 1)) (fun k => C (boxplus_coeff n p q k) * X ^ (n - k))

/-
Definition of the Phi functional.
-/
def Phi (p : ℝ[X]) : ℝ :=
  let roots := p.roots.toFinset
  ∑ r_i ∈ roots, (∑ r_j ∈ roots.erase r_i, 1 / (r_i - r_j))^2

/-
Definition of the inverse Phi functional.
-/
def invPhi (p : ℝ[X]) : ℝ :=
  if p.roots.Nodup ∧ p.roots.card > 1 then
    1 / Phi p
  else 0

/-
Definition of centered polynomials.
-/
def is_centered (n : ℕ) (p : ℝ[X]) : Prop :=
  p.Monic ∧ p.natDegree = n ∧ p.coeff (n - 1) = 0

/-
phi n r is the Phi functional applied to the polynomial with roots r.
-/
def phi (n : ℕ) (r : Fin n → ℝ) : ℝ :=
  Phi (∏ i, (Polynomial.X - Polynomial.C (r i)))

/-
Structure capturing the abstract interface for finite free cumulants and scaled Hermite polynomials.
-/
structure FiniteFreeCumulants where
  kappa : ℕ → ℝ[X] → ℕ → ℝ
  hermite : ℕ → ℝ → ℝ[X]
  kappa_additive : ∀ n p q k, kappa n (boxplus n p q) k = kappa n p k + kappa n q k
  hermite_kappa : ∀ n t k, kappa n (hermite n t) k = if k = 2 then t else 0

/-
Dummy definition of finite free cumulant to allow abstract reasoning.
-/
def finite_free_cumulant (n : ℕ) (p : ℝ[X]) (k : ℕ) : ℝ := 0

/-
Dummy definition of scaled Hermite polynomial to allow abstract reasoning.
-/
def scaled_hermite (n : ℕ) (t : ℝ) : ℝ[X] := 0

/-
Property: Finite free cumulants are additive under boxplus convolution.
-/
theorem finite_free_cumulant_additive (n : ℕ) (p q : ℝ[X]) (k : ℕ) :
  finite_free_cumulant n (boxplus n p q) k = finite_free_cumulant n p k + finite_free_cumulant n q k := by
    unfold finite_free_cumulant; aesop;

/-
Structure capturing the full abstract interface for finite free cumulants, including injectivity.
-/
structure FiniteFreeCumulantsSystem where
  kappa : ℕ → ℝ[X] → ℕ → ℝ
  hermite : ℕ → ℝ → ℝ[X]
  kappa_additive : ∀ n p q k, kappa n (boxplus n p q) k = kappa n p k + kappa n q k
  hermite_kappa : ∀ n t k, kappa n (hermite n t) k = if k = 2 then t else 0
  kappa_injective : ∀ n p q, (∀ k, kappa n p k = kappa n q k) → p = q

/-
The heat semigroup property: convolution with H_s and then H_t is equivalent to convolution with H_{s+t}. This follows from the additivity of cumulants.
-/
theorem heat_semigroup (sys : FiniteFreeCumulantsSystem) (n : ℕ) (p : ℝ[X]) (s t : ℝ) :
  boxplus n (boxplus n p (sys.hermite n s)) (sys.hermite n t) =
  boxplus n p (sys.hermite n (s + t)) := by
  apply sys.kappa_injective n
  intro k
  simp [sys.kappa_additive, sys.hermite_kappa]
  split_ifs <;> ring

