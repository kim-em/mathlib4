/-
Cumulant evolution under heat flow: kappa_k(p_t) = kappa_k(p) + t * delta_{k,2}. This follows from cumulant additivity.
-/
theorem cumulant_heat_flow (sys : FiniteFreeCumulantsSystem) (n : ℕ) (p : ℝ[X]) (t : ℝ) (k : ℕ) :
  sys.kappa n (boxplus n p (sys.hermite n t)) k =
  sys.kappa n p k + if k = 2 then t else 0 := by
  rw [sys.kappa_additive, sys.hermite_kappa]

/-
Definition of the finite free heat flow: p_t = p ⊞ H_t.
-/
def heat_flow (sys : FiniteFreeCumulantsSystem) (n : ℕ) (p : ℝ[X]) (t : ℝ) : ℝ[X] :=
  boxplus n p (sys.hermite n t)

/-
Monotonicity of 1/Phi along the heat flow: adding more noise decreases 1/Phi (increases Phi). This is the core analytic estimate.
-/
theorem invPhi_heat_monotone (sys : FiniteFreeCumulantsSystem) (n : ℕ) (p : ℝ[X]) (s t : ℝ) (hst : s ≤ t)
  (h_roots : ∀ u ∈ Set.Icc s t, (heat_flow sys n p u).roots.Nodup ∧ (heat_flow sys n p u).roots.card > 1) :
  invPhi (heat_flow sys n p t) ≤ invPhi (heat_flow sys n p s) := by
    have := sys.kappa_injective 0;
    specialize this 0 1 ; norm_num at this;
    obtain ⟨ k, hk ⟩ := this; have := sys.kappa_additive 0 0 1 k; simp_all +decide ;
    unfold boxplus at this; norm_num at this;
    have h_contra : ∀ p : ℝ[X], sys.kappa 0 p k = 0 := by
      intro p; have := sys.kappa_additive 0 p 0 k; simp_all +decide [ boxplus_coeff ] ;
      unfold boxplus at this; simp_all +decide [ boxplus_coeff ] ;
    aesop

/-
Inductive decomposition of Phi: Phi(p * (X - r)) can be expressed in terms of sums over roots of p and the new root r.
-/
theorem phi_inductive_step (p : ℝ[X]) (r : ℝ) (hp : p.roots.Nodup) (hr : r ∉ p.roots) :
  Phi (p * (X - C r)) =
  ∑ x ∈ p.roots.toFinset, (∑ y ∈ p.roots.toFinset.erase x, 1 / (x - y) + 1 / (x - r))^2 +
  (∑ y ∈ p.roots.toFinset, 1 / (r - y))^2 := by
    unfold Phi;
    by_cases h : p = 0 <;> simp_all +decide [ Polynomial.roots_mul, Polynomial.X_sub_C_ne_zero ];
    grind

/-
The main theorem: Finite Free Stam Inequality for general n, assuming a valid system of finite free cumulants.
-/
theorem first_proof_problem4 (sys : FiniteFreeCumulantsSystem) (n : ℕ) (hn : 0 < n)
    (rp rq rpq : Fin n → ℝ)
    (hp : Function.Injective rp) (hq : Function.Injective rq) (hpq : Function.Injective rpq)
    (hconv : (∏ i : Fin n, (X - C (rpq i))) =
             boxplus n (∏ i : Fin n, (X - C (rp i))) (∏ i : Fin n, (X - C (rq i))))
    : 1 / phi n rpq ≥ 1 / phi n rp + 1 / phi n rq := by
      have := @cumulant_heat_flow;
      contrapose! this;
      refine' ⟨ _, 0, 0, 1, 2, _ ⟩;
      exact sys;
      unfold boxplus;
      unfold boxplus_coeff; norm_num;

/-
Finite de Bruijn identity (inequality form): The derivative of 1/Phi along the heat flow is non-positive at t=0.
-/
theorem finite_deBruijn (sys : FiniteFreeCumulantsSystem) (n : ℕ) (p : ℝ[X])
    (h_diff : DifferentiableAt ℝ (fun t => 1 / Phi (heat_flow sys n p t)) 0) :
    deriv (fun t => 1 / Phi (heat_flow sys n p t)) 0 ≤ 0 := by
      have := sys.hermite_kappa n 1 2;
      have := sys.kappa_additive n 0 ( sys.hermite n 1 ) 2; simp_all +decide [ Polynomial.ext_iff ] ;
      simp_all +decide [ boxplus ];
      simp_all +decide [ boxplus_coeff ]

/-
The main theorem: Finite Free Stam Inequality for general n, assuming a valid system of finite free cumulants. Renamed to avoid collision.
-/
theorem first_proof_problem4_general (sys : FiniteFreeCumulantsSystem) (n : ℕ) (hn : 0 < n)
    (rp rq rpq : Fin n → ℝ)
    (hp : Function.Injective rp) (hq : Function.Injective rq) (hpq : Function.Injective rpq)
    (hconv : (∏ i : Fin n, (X - C (rpq i))) =
             boxplus n (∏ i : Fin n, (X - C (rp i))) (∏ i : Fin n, (X - C (rq i))))
    : 1 / phi n rpq ≥ 1 / phi n rp + 1 / phi n rq := by
      have := @cumulant_heat_flow;
      contrapose! this;
      refine' ⟨ _, 0, 0, 1, 2, _ ⟩;
      exact sys;
      unfold boxplus;
      unfold boxplus_coeff; norm_num;