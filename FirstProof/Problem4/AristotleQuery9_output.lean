/-
Vieta's formulas for a centered quartic polynomial.
-/
theorem vieta_quartic (A B C : ℝ) (r : Fin 4 → ℝ)
    (h_roots : ∀ i, r i ^ 4 + A * r i ^ 2 + B * r i + C = 0)
    (h_distinct : Function.Injective r)
    (h_sum : r 0 + r 1 + r 2 + r 3 = 0) :
    A = r 0 * r 1 + r 0 * r 2 + r 0 * r 3 + r 1 * r 2 + r 1 * r 3 + r 2 * r 3 ∧
    B = -(r 0 * r 1 * r 2 + r 0 * r 1 * r 3 + r 0 * r 2 * r 3 + r 1 * r 2 * r 3) ∧
    C = r 0 * r 1 * r 2 * r 3 := by
      simp_all +decide [ Fin.forall_fin_succ ];
      have h_vieta_prod_sum : r 0 * r 1 + r 0 * r 2 + r 0 * (-r 2 + (-r 1 + -r 0)) + r 1 * r 2 + r 1 * (-r 2 + (-r 1 + -r 0)) + r 2 * (-r 2 + (-r 1 + -r 0)) = A := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne <| h_distinct.ne <| show 0 ≠ 1 from by decide ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne <| h_distinct.ne <| show 0 ≠ 2 from by decide ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne <| h_distinct.ne <| show 1 ≠ 2 from by decide ) <| by nlinarith [ sq_nonneg ( r 0 - 1 ), sq_nonneg ( r 1 - 1 ), sq_nonneg ( r 2 - 1 ) ] ;
