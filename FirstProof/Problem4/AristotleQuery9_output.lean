/-
A predicate for a centered quartic polynomial X^4 + A*X^2 + B*X + C having 4 distinct real roots.
-/
def quartic_has_distinct_roots (A B C : ℝ) : Prop :=
  ∃ r : Fin 4 → ℝ, Function.Injective r ∧
    r 0 + r 1 + r 2 + r 3 = 0 ∧
    ∀ i, (r i) ^ 4 + A * (r i) ^ 2 + B * (r i) + C = 0

/-
Definition of the coefficient of the boxplus convolution.
-/
open Polynomial BigOperators Finset

def boxplus_coeff (n : ℕ) (p q : ℝ[X]) (k : ℕ) : ℝ :=
  ∑ i ∈ range (k + 1),
    let j := k - i
    (Nat.factorial (n - i) * Nat.factorial (n - j) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) *
    (p.coeff (n - i)) * (q.coeff (n - j))

/-
Definitions of Phi and invPhi functionals.
-/
open Polynomial BigOperators Finset Classical
open scoped BigOperators

def Phi (p : ℝ[X]) : ℝ :=
  let roots := p.roots.toFinset
  ∑ r_i ∈ roots, (∑ r_j ∈ roots.erase r_i, 1 / (r_i - r_j))^2

def invPhi (p : ℝ[X]) : ℝ :=
  if p.roots.Nodup ∧ p.roots.card > 1 then
    1 / Phi p
  else 0

