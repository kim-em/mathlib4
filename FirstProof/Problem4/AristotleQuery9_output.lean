/-
Feasibility condition for cumulants of a real-rooted quartic polynomial.
-/
def quartic_cumulant_feasible (k2 k3 k4 : ℝ) : Prop :=
  k2 < 0 ∧
  k2 ^ 2 + k4 > 0 ∧
  4 * k2 ^ 3 - 4 * k2 * k4 + 9 * k3 ^ 2 < 0

/-
Numerator and denominator polynomials for the explicit formula of 1/Phi_4 in cumulant coordinates.
-/
def N_quartic (k2 k3 k4 : ℝ) : ℝ :=
  16 * k2 ^ 6 + 72 * k2 ^ 3 * k3 ^ 2 - 48 * k2 ^ 2 * k4 ^ 2 + 216 * k2 * k3 ^ 2 * k4 - 81 * k3 ^ 4 + 32 * k4 ^ 3

def D_quartic (k2 k3 k4 : ℝ) : ℝ :=
  (k2 ^ 2 + k4) * (4 * k2 ^ 3 - 4 * k2 * k4 + 9 * k3 ^ 2)

/-
Proof that D_quartic is negative on the feasible domain.
-/
theorem D_quartic_neg (k2 k3 k4 : ℝ) (h : quartic_cumulant_feasible k2 k3 k4) :
    D_quartic k2 k3 k4 < 0 := by
  unfold D_quartic quartic_cumulant_feasible at *
  obtain ⟨h1, h2, h3⟩ := h
  nlinarith

/-
Definition of the polynomial representing the superadditivity condition.
-/
def poly_superadd (k2 k3 k4 k2' k3' k4' : ℝ) : ℝ :=
  let N1 := N_quartic k2 k3 k4
  let D1 := D_quartic k2 k3 k4
  let N2 := N_quartic k2' k3' k4'
  let D2 := D_quartic k2' k3' k4'
  let Ns := N_quartic (k2 + k2') (k3 + k3') (k4 + k4')
  let Ds := D_quartic (k2 + k2') (k3 + k3') (k4 + k4')
  Ns * D1 * D2 - N1 * Ds * D2 - N2 * Ds * D1

/-
Factorization of N in the symmetric case.
-/
theorem N_quartic_symmetric_eq (k2 k4 : ℝ) (hk2 : k2 ≠ 0) :
    N_quartic k2 0 k4 = 16 * k2 ^ 6 * (1 - k4 / k2 ^ 2) ^ 2 * (1 + 2 * (k4 / k2 ^ 2)) := by
      -- By definition of $N_quartic$, we have $N_quartic k2 0 k4 = 16 * k2 ^ 6 + 0 + 32 * k4 ^ 3 - 48 * k2 ^ 2 * k4 ^ 2$.
      simp [N_quartic];
      grind

/-
Factorization of D in the symmetric case.
-/
theorem D_quartic_symmetric_eq (k2 k4 : ℝ) (hk2 : k2 ≠ 0) :
    D_quartic k2 0 k4 = 4 * k2 ^ 5 * (1 - (k4 / k2 ^ 2) ^ 2) := by
      unfold D_quartic; ring;
      -- Combine like terms and simplify the expression.
      field_simp
      ring

/-
Simplified form of 1/Phi in the symmetric case.
-/
theorem invPhi_symmetric_eq (k2 k4 : ℝ) (h : quartic_cumulant_feasible k2 0 k4) :
