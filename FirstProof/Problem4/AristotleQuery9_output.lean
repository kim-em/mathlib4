-/
theorem poly_superadd_symmetric_nonneg (k2 k4 k2' k4' : ℝ)
    (h1 : quartic_cumulant_feasible k2 0 k4)
    (h2 : quartic_cumulant_feasible k2' 0 k4')
    (h3 : quartic_cumulant_feasible (k2 + k2') 0 (k4 + k4')) :
    poly_superadd k2 0 k4 k2' 0 k4' ≥ 0 := by
      unfold poly_superadd;
      -- Apply the symmetric ratio inequality to get q(x+x', y+y') ≤ q(x,y) + q(x',y').
      have h_ratio_ineq : let x := -k2; let y := k4; let x' := -k2'; let y' := k4'; let q := fun a b => b ^ 2 / (a * (a ^ 2 + b)); q (x + x') (y + y') ≤ q x y + q x' y' := by
        apply symmetric_ratio_inequality;
        · linarith [ h1.1 ];
        · cases abs_cases k4 <;> nlinarith [ h1.1, h1.2.1, h1.2.2 ];
        · linarith [ h2.1 ];
        · cases abs_cases k4' <;> nlinarith [ h2.1, h2.2.1, h2.2.2 ];
      -- Use invPhi_symmetric_eq to relate -N/6D to 2/3 x - 4/3 q(x,y).
      have h_invPhi_rel : let x := -k2; let y := k4; let x' := -k2'; let y' := k4'; let q := fun a b => b ^ 2 / (a * (a ^ 2 + b)); -N_quartic k2 0 k4 / (6 * D_quartic k2 0 k4) = 2 / 3 * x - 4 / 3 * q x y ∧ -N_quartic k2' 0 k4' / (6 * D_quartic k2' 0 k4') = 2 / 3 * x' - 4 / 3 * q x' y' ∧ -N_quartic (k2 + k2') 0 (k4 + k4') / (6 * D_quartic (k2 + k2') 0 (k4 + k4')) = 2 / 3 * (x + x') - 4 / 3 * q (x + x') (y + y') := by
        apply_rules [ And.intro, invPhi_symmetric_eq ];
        · convert invPhi_symmetric_eq k2 k4 h1 using 1;
          grind;
        · convert invPhi_symmetric_eq k2' k4' h2 using 1;
          grind;
        · convert invPhi_symmetric_eq ( k2 + k2' ) ( k4 + k4' ) h3 using 1 ; ring;
          rw [ show ( - ( k2 * k2' ^ 2 * 3 ) - k2 * k4 + ( - ( k2 * k4' ) - k2 ^ 2 * k2' * 3 ) + ( -k2 ^ 3 - k2' * k4 ) + ( - ( k2' * k4' ) - k2' ^ 3 ) ) = - ( k2 * k2' ^ 2 * 3 + k2 * k4 + k2 * k4' + k2 ^ 2 * k2' * 3 + k2 ^ 3 + k2' * k4 + k2' * k4' + k2' ^ 3 ) by ring, inv_neg ] ; ring;
      -- Use the fact that $D_quartic$ is negative on the feasible domain to simplify the inequality.
      have h_D_neg : D_quartic k2 0 k4 < 0 ∧ D_quartic k2' 0 k4' < 0 ∧ D_quartic (k2 + k2') 0 (k4 + k4') < 0 := by
        exact ⟨ D_quartic_neg _ _ _ h1, D_quartic_neg _ _ _ h2, D_quartic_neg _ _ _ h3 ⟩;
      norm_num [ div_eq_iff, h_D_neg.1.ne, h_D_neg.2.1.ne, h_D_neg.2.2.ne ] at *;
      nlinarith [ mul_pos ( neg_pos_of_neg h_D_neg.1 ) ( neg_pos_of_neg h_D_neg.2.1 ), mul_pos ( neg_pos_of_neg h_D_neg.1 ) ( neg_pos_of_neg h_D_neg.2.2 ), mul_pos ( neg_pos_of_neg h_D_neg.2.1 ) ( neg_pos_of_neg h_D_neg.2.2 ), mul_le_mul_of_nonneg_left h_ratio_ineq ( neg_nonneg.mpr h_D_neg.1.le ), mul_le_mul_of_nonneg_left h_ratio_ineq ( neg_nonneg.mpr h_D_neg.2.1.le ), mul_le_mul_of_nonneg_left h_ratio_ineq ( neg_nonneg.mpr h_D_neg.2.2.le ) ]

/-
Superadditivity of 1/Phi in the symmetric case.
-/
theorem invPhi_symmetric_superadditive (k2 k4 k2' k4' : ℝ)
    (h1 : quartic_cumulant_feasible k2 0 k4)
    (h2 : quartic_cumulant_feasible k2' 0 k4')
    (h3 : quartic_cumulant_feasible (k2 + k2') 0 (k4 + k4')) :
    let f := fun a b => -N_quartic a 0 b / (6 * D_quartic a 0 b)
    f (k2 + k2') (k4 + k4') ≥ f k2 k4 + f k2' k4' := by
      -- Apply the symmetric_ratio_inequality and invPhi_symmetric_eq to conclude the proof.
      have h_apply_ineq : -2 / 3 * (k2 + k2') + 4 / 3 * (k4 + k4') ^ 2 / ((k2 + k2') * ((k2 + k2') ^ 2 + (k4 + k4'))) ≥
                     (-2 / 3 * k2 + 4 / 3 * k4 ^ 2 / (k2 * (k2 ^ 2 + k4))) +
                     (-2 / 3 * k2' + 4 / 3 * k4' ^ 2 / (k2' * (k2' ^ 2 + k4'))) := by
                       have h_apply_ineq : (k4 + k4') ^ 2 / ((-k2 - k2') * ((-k2 - k2') ^ 2 + (k4 + k4'))) ≤
                                          k4 ^ 2 / ((-k2) * ((-k2) ^ 2 + k4)) + k4' ^ 2 / ((-k2') * ((-k2') ^ 2 + k4')) := by
                                            convert symmetric_ratio_inequality ( -k2 ) k4 ( -k2' ) k4' ( by linarith [ h1.1 ] ) ( by rw [ abs_lt ] ; constructor <;> nlinarith [ h1.1, h1.2.1, h1.2.2 ] ) ( by linarith [ h2.1 ] ) ( by rw [ abs_lt ] ; constructor <;> nlinarith [ h2.1, h2.2.1, h2.2.2 ] ) using 1;
                       norm_num [ div_eq_mul_inv ] at *;
                       rw [ show ( -k2 - k2' ) = - ( k2 + k2' ) by ring, inv_neg ] at h_apply_ineq ; ring_nf at * ; linarith;
      convert h_apply_ineq using 1;
      · convert invPhi_symmetric_eq ( k2 + k2' ) ( k4 + k4' ) h3 using 1;
      · congr! 1;
        · convert invPhi_symmetric_eq k2 k4 h1 using 1;
        · convert invPhi_symmetric_eq k2' k4' h2 using 1

/-
Additivity of cumulants under the boxplus convolution rule for coefficients.
-/
theorem quartic_boxplus_cumulants (A1 B1 C1 A2 B2 C2 : ℝ) :
    let k2_1 := A1 / 12
    let k3_1 := B1 / 24
    let k4_1 := C1 / 24 - A1 ^ 2 / 288
    let k2_2 := A2 / 12
    let k3_2 := B2 / 24
    let k4_2 := C2 / 24 - A2 ^ 2 / 288
    let A_sum := A1 + A2
    let B_sum := B1 + B2
    let C_sum := C1 + C2 + A1 * A2 / 6
    let k2_sum := A_sum / 12
    let k3_sum := B_sum / 24
    let k4_sum := C_sum / 24 - A_sum ^ 2 / 288
    k2_sum = k2_1 + k2_2 ∧ k3_sum = k3_1 + k3_2 ∧ k4_sum = k4_1 + k4_2 := by
      grind

/-
Non-negativity of the superadditivity polynomial in the symmetric case, derived from the functional inequality.
-/
theorem poly_superadd_symmetric_nonneg_v2 (k2 k4 k2' k4' : ℝ)
    (h1 : quartic_cumulant_feasible k2 0 k4)
    (h2 : quartic_cumulant_feasible k2' 0 k4')
    (h3 : quartic_cumulant_feasible (k2 + k2') 0 (k4 + k4')) :
    poly_superadd k2 0 k4 k2' 0 k4' ≥ 0 := by
      unfold poly_superadd;
      -- Apply the symmetric ratio inequality to get q(x+x', y+y') ≤ q(x,y) + q(x',y').
      have h_ratio_ineq : let x := -k2; let y := k4; let x' := -k2'; let y' := k4'; let q := fun a b => b ^ 2 / (a * (a ^ 2 + b)); q (x + x') (y + y') ≤ q x y + q x' y' := by
        apply symmetric_ratio_inequality;
        · linarith [ h1.1 ];
        · cases abs_cases k4 <;> nlinarith [ h1.1, h1.2.1, h1.2.2 ];
        · linarith [ h2.1 ];
        · cases abs_cases k4' <;> nlinarith [ h2.1, h2.2.1, h2.2.2 ];
      -- Use invPhi_symmetric_eq to relate -N/6D to 2/3 x - 4/3 q(x,y).
      have h_invPhi_rel : let x := -k2; let y := k4; let x' := -k2'; let y' := k4'; let q := fun a b => b ^ 2 / (a * (a ^ 2 + b)); -N_quartic k2 0 k4 / (6 * D_quartic k2 0 k4) = 2 / 3 * x - 4 / 3 * q x y ∧ -N_quartic k2' 0 k4' / (6 * D_quartic k2' 0 k4') = 2 / 3 * x' - 4 / 3 * q x' y' ∧ -N_quartic (k2 + k2') 0 (k4 + k4') / (6 * D_quartic (k2 + k2') 0 (k4 + k4')) = 2 / 3 * (x + x') - 4 / 3 * q (x + x') (y + y') := by
        apply_rules [ And.intro, invPhi_symmetric_eq ];
        · convert invPhi_symmetric_eq k2 k4 h1 using 1;
          grind;
        · convert invPhi_symmetric_eq k2' k4' h2 using 1;
          grind;
        · convert invPhi_symmetric_eq ( k2 + k2' ) ( k4 + k4' ) h3 using 1 ; ring;
          rw [ show ( - ( k2 * k2' ^ 2 * 3 ) - k2 * k4 + ( - ( k2 * k4' ) - k2 ^ 2 * k2' * 3 ) + ( -k2 ^ 3 - k2' * k4 ) + ( - ( k2' * k4' ) - k2' ^ 3 ) ) = - ( k2 * k2' ^ 2 * 3 + k2 * k4 + k2 * k4' + k2 ^ 2 * k2' * 3 + k2 ^ 3 + k2' * k4 + k2' * k4' + k2' ^ 3 ) by ring, inv_neg ] ; ring;
      -- Use the fact that $D_quartic$ is negative on the feasible domain to simplify the inequality.
      have h_D_neg : D_quartic k2 0 k4 < 0 ∧ D_quartic k2' 0 k4' < 0 ∧ D_quartic (k2 + k2') 0 (k4 + k4') < 0 := by
        exact ⟨ D_quartic_neg _ _ _ h1, D_quartic_neg _ _ _ h2, D_quartic_neg _ _ _ h3 ⟩;
      norm_num [ div_eq_iff, h_D_neg.1.ne, h_D_neg.2.1.ne, h_D_neg.2.2.ne ] at *;
      nlinarith [ mul_pos ( neg_pos_of_neg h_D_neg.1 ) ( neg_pos_of_neg h_D_neg.2.1 ), mul_pos ( neg_pos_of_neg h_D_neg.1 ) ( neg_pos_of_neg h_D_neg.2.2 ), mul_pos ( neg_pos_of_neg h_D_neg.2.1 ) ( neg_pos_of_neg h_D_neg.2.2 ), mul_le_mul_of_nonneg_left h_ratio_ineq ( neg_nonneg.mpr h_D_neg.1.le ), mul_le_mul_of_nonneg_left h_ratio_ineq ( neg_nonneg.mpr h_D_neg.2.1.le ), mul_le_mul_of_nonneg_left h_ratio_ineq ( neg_nonneg.mpr h_D_neg.2.2.le ) ]

/-
Bounds on k4 derived from feasibility conditions.
-/
theorem quartic_cumulant_bounds (k2 k3 k4 : ℝ) (h : quartic_cumulant_feasible k2 k3 k4) :
    k2 < 0 ∧ k2 ^ 2 + k4 > 0 ∧ k4 < k2 ^ 2 := by
      cases h ; exact ⟨ by linarith, by linarith, by nlinarith [ sq_nonneg k3 ] ⟩

/-
Decomposition of 1/Phi into a linear term and a remainder term.
-/
def rem_quartic (k2 k3 k4 : ℝ) : ℝ :=
  36 * k2 ^ 3 * k3 ^ 2 - 32 * k2 ^ 2 * k4 ^ 2 + 180 * k2 * k3 ^ 2 * k4 - 81 * k3 ^ 4 + 32 * k4 ^ 3

theorem invPhi_decomposition (k2 k3 k4 : ℝ) (h : D_quartic k2 k3 k4 ≠ 0) :
    -N_quartic k2 k3 k4 / (6 * D_quartic k2 k3 k4) = -2 / 3 * k2 + rem_quartic k2 k3 k4 / (-6 * D_quartic k2 k3 k4) := by
      field_simp;
      unfold N_quartic D_quartic rem_quartic; ring;

/-
Definition of the Q polynomial (numerator of the remainder term).
-/
def Q_quartic (k2 k3 k4 : ℝ) : ℝ :=
  -36 * k2 ^ 3 * k3 ^ 2 + 32 * k2 ^ 2 * k4 ^ 2 - 180 * k2 * k3 ^ 2 * k4 + 81 * k3 ^ 4 - 32 * k4 ^ 3

/-
Non-negativity of the Q polynomial on the feasible domain.
-/
theorem Q_quartic_nonneg (k2 k3 k4 : ℝ) (h : quartic_cumulant_feasible k2 k3 k4) :
    Q_quartic k2 k3 k4 ≥ 0 := by
      -- Let $P = k2^2 - k4$. From feasibility, $P > 0$.
      set P := k2^2 - k4
      have hP_pos : P > 0 := by
        exact sub_pos_of_lt ( by nlinarith [ h.1, h.2.1, h.2.2 ] );
      -- The quadratic expression in $X$ is minimized when $X$ is at its minimum value, which is $0$.
      have h_min : -4 * k2 ^ 3 * (9 * k3 ^ 2) + 32 * k2 ^ 2 * k4 ^ 2 - 20 * k2 * k4 * (9 * k3 ^ 2) + (9 * k3 ^ 2) ^ 2 - 32 * k4 ^ 3 ≥ 0 := by
        by_cases hX_pos : 9 * k3 ^ 2 ≤ -4 * k2 * P;
        · by_cases h_vertex_pos : 12 * k2 ^ 3 - 10 * k2 * P > 0;
          · -- Substitute $X = -4k2P$ into the quadratic expression and simplify.
            have h_sub : -4 * k2 ^ 3 * (-4 * k2 * P) + 32 * k2 ^ 2 * k4 ^ 2 - 20 * k2 * k4 * (-4 * k2 * P) + (-4 * k2 * P) ^ 2 - 32 * k4 ^ 3 ≥ 0 := by
              nlinarith [ sq_nonneg ( k2 ^ 2 - k4 - 2 * k4 ), sq_nonneg ( k2 ^ 2 - k4 + 2 * k4 ), h.1, h.2.1, h.2.2 ];
            by_contra h_contra;
            nlinarith only [ hX_pos, h_vertex_pos, h_sub, h_contra, h.1, h.2.1, h.2.2, sq_nonneg ( 9 * k3 ^ 2 - ( 12 * k2 ^ 3 - 10 * k2 * ( k2 ^ 2 - k4 ) ) ) ];
          · nlinarith [ sq_nonneg ( 12 * k2 ^ 3 - 10 * k2 * P + 2 * ( 9 * k3 ^ 2 ) ) ];
        · nlinarith [ sq_nonneg ( k2 ^ 2 - k4 - k2 ), sq_nonneg ( k2 ^ 2 - k4 + k2 ), h.2.2 ];
      exact h_min.trans_eq ( by unfold Q_quartic; ring )

/-
Algebraic identity relating Q to its substituted form.
-/
def Q_substituted (k2 P X : ℝ) : ℝ :=
  X ^ 2 + X * (20 * k2 * P - 24 * k2 ^ 3) + 32 * P * (k2 ^ 2 - P) ^ 2

theorem Q_quartic_eq_substituted (k2 k3 k4 : ℝ) :
    let P := k2 ^ 2 - k4
    let X := 9 * k3 ^ 2
    Q_quartic k2 k3 k4 = Q_substituted k2 P X := by
      unfold Q_quartic Q_substituted; ring;

/-
Non-negativity of the auxiliary polynomial h(u) on [1.2, 2].
-/
def h_aux (u : ℝ) : ℝ := 8 * u ^ 3 - 41 * u ^ 2 + 68 * u - 36

theorem h_aux_nonneg (u : ℝ) (h1 : 1.2 ≤ u) (h2 : u ≤ 2) : h_aux u ≥ 0 := by
  unfold h_aux;
  nlinarith [ sq_nonneg ( u - 2 ), sq_nonneg ( u - 1.7 ) ]

/-
Non-negativity of the substituted Q polynomial.
-/
theorem Q_substituted_nonneg (k2 P X : ℝ)
    (hk2 : k2 < 0) (hP : 0 < P) (hP_bound : P < 2 * k2 ^ 2)
    (hX : 0 ≤ X) (hX_bound : X < -4 * k2 * P) :
    Q_substituted k2 P X ≥ 0 := by
      by_cases hu : P / k2^2 ≤ 6 / 5;
      · unfold Q_substituted;
        rw [ div_le_iff₀ ] at hu <;> nlinarith [ mul_le_mul_of_nonneg_left hu hX ];
      · -- Since $u > 1.2$, we have $h_aux(u) \geq 0$.
        have h_h_aux_nonneg : 8 * (P / k2^2) ^ 3 - 41 * (P / k2^2) ^ 2 + 68 * (P / k2^2) - 36 ≥ 0 := by
          exact h_aux_nonneg _ ( by linarith ) ( by rw [ div_le_iff₀ ] <;> nlinarith );
        unfold Q_substituted;
        field_simp at h_h_aux_nonneg ⊢;
        rw [ div_sub', le_div_iff₀ ] at h_h_aux_nonneg <;> try nlinarith [ pow_pos ( neg_pos.mpr hk2 ) 6 ];
        nlinarith [ sq_nonneg ( X + k2 * ( P * 10 - k2 ^ 2 * 12 ) ) ]

/-
Proof of non-negativity of Q_quartic using the substituted form.
-/
theorem Q_quartic_nonneg' (k2 k3 k4 : ℝ) (h : quartic_cumulant_feasible k2 k3 k4) :
    Q_quartic k2 k3 k4 ≥ 0 := by
  rw [Q_quartic_eq_substituted]
  apply Q_substituted_nonneg
  · exact h.1
  · exact sub_pos_of_lt (quartic_cumulant_bounds k2 k3 k4 h).2.2
  · have h_bound := (quartic_cumulant_bounds k2 k3 k4 h).2.1
    nlinarith
  · nlinarith [sq_nonneg k3]
  · have h_feas := h.2.2
    nlinarith