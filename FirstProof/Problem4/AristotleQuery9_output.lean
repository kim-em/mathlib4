      field_simp;
      rw [ div_le_iff₀ ] <;> try nlinarith [ abs_lt.mp hy, abs_lt.mp hy' ] ;
      -- Apply the Cauchy-Schwarz inequality in its generalized form.
      have cauchy_schwarz : (y^2 * x' / (x^2 + y) + y'^2 * x / (x'^2 + y')) * ((x^2 + y) * x + (x'^2 + y') * x') ≥ (y + y')^2 * x * x' := by
        rw [ div_add_div, div_mul_eq_mul_div, ge_iff_le, le_div_iff₀ ];
        · nlinarith [ sq_nonneg ( y * x' * ( x' ^ 2 + y' ) - y' * x * ( x ^ 2 + y ) ) ];
        · exact mul_pos ( by nlinarith [ abs_lt.mp hy ] ) ( by nlinarith [ abs_lt.mp hy' ] );
        · nlinarith [ abs_lt.mp hy ];
        · nlinarith [ abs_lt.mp hy', abs_lt.mp hy ];
      refine le_trans cauchy_schwarz ?_;
      rw [ mul_right_comm ];
      rw [ mul_comm ] ; gcongr;
      · exact add_nonneg ( div_nonneg ( mul_nonneg ( sq_nonneg _ ) hx'.le ) ( by nlinarith only [ abs_lt.mp hy ] ) ) ( div_nonneg ( mul_nonneg ( sq_nonneg _ ) hx.le ) ( by nlinarith only [ abs_lt.mp hy' ] ) );
