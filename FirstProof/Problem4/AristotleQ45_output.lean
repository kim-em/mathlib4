`boxplus` is commutative.
-/
lemma boxplus_comm (n : ℕ) (p q : ℝ[X]) :
    boxplus n p q = boxplus n q p := by
      refine' Finset.sum_congr rfl fun k hk => _;
      unfold boxplus_coeff;
      rw [ ← Finset.sum_flip ];
      exact congr_arg₂ _ ( congr_arg _ ( Finset.sum_congr rfl fun i hi => by rw [ Nat.sub_sub_self ( Finset.mem_range_succ_iff.mp hi ) ] ; ring ) ) rfl

/-
Formula for boxplus coefficients of a shifted polynomial.
-/
lemma boxplus_coeff_comp_add_C_left (n : ℕ) (p q : ℝ[X]) (c : ℝ) (k : ℕ)
    (hk : k ≤ n) (hp : p.natDegree = n) (hq : q.natDegree = n) :
    boxplus_coeff n (p.comp (X + C c)) q k =
    ∑ j ∈ range (k + 1), boxplus_coeff n p q j * (Nat.choose (n - j) (n - k)) * c ^ (k - j) := by
  -- Let's expand the expression for the coefficient of $X^{n-k}$ in the boxplus of $p.comp (X + C c)$ and $q$.
  have h_expand : ∑ i ∈ Finset.range (k + 1), Polynomial.coeff (p.comp (Polynomial.X + Polynomial.C c)) (n - i) * Polynomial.coeff q (n - (k - i)) * (Nat.factorial (n - i) * Nat.factorial (n - (k - i)) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) =
                 ∑ j ∈ Finset.range (k + 1), (∑ i ∈ Finset.range (j + 1), Polynomial.coeff p (n - i) * Nat.choose (n - i) (j - i) * c ^ (j - i)) * Polynomial.coeff q (n - (k - j)) * (Nat.factorial (n - j) * Nat.factorial (n - (k - j)) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) := by
                   have h_expand : ∀ i ∈ Finset.range (k + 1), Polynomial.coeff (p.comp (Polynomial.X + Polynomial.C c)) (n - i) = ∑ j ∈ Finset.range (i + 1), Polynomial.coeff p (n - j) * Nat.choose (n - j) (i - j) * c ^ (i - j) := by
                     intro i hi
                     have h_expand : Polynomial.coeff (p.comp (Polynomial.X + Polynomial.C c)) (n - i) = ∑ j ∈ Finset.range (n + 1), Polynomial.coeff p j * Polynomial.coeff ((Polynomial.X + Polynomial.C c) ^ j) (n - i) := by
                       rw [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
                       aesop;
                     rw [ h_expand, ← Finset.sum_flip ];
                     rw [ ← Finset.sum_subset ( Finset.range_mono ( by linarith [ Finset.mem_range.mp hi ] : i + 1 ≤ n + 1 ) ) ];
                     · refine' Finset.sum_congr rfl fun x hx => _;
                       rw [ Polynomial.coeff_X_add_C_pow ];
                       rw [ show n - x - ( n - i ) = i - x from by rw [ tsub_right_comm, tsub_tsub_cancel_of_le ( by linarith [ Finset.mem_range.mp hx, Finset.mem_range.mp hi ] ) ] ] ; ring;
                       rw [ Nat.choose_symm_of_eq_add ] ; linarith [ Nat.sub_add_cancel ( show x ≤ n from by linarith [ Finset.mem_range.mp hx, Finset.mem_range.mp hi ] ), Nat.sub_add_cancel ( show i ≤ n from by linarith [ Finset.mem_range.mp hi ] ), Nat.sub_add_cancel ( show x ≤ i from by linarith [ Finset.mem_range.mp hx ] ) ];
                     · simp +zetaDelta at *;
                       exact fun x hx₁ hx₂ => Or.inr <| Polynomial.coeff_eq_zero_of_natDegree_lt <| by erw [ Polynomial.natDegree_pow, Polynomial.natDegree_X_add_C ] ; omega;
                   rw [ Finset.sum_congr rfl ] ; aesop;
  -- Let's simplify the expression using the properties of binomial coefficients and factorials.
  have h_simplify : ∑ j ∈ Finset.range (k + 1), (∑ i ∈ Finset.range (j + 1), Polynomial.coeff p (n - i) * Nat.choose (n - i) (j - i) * c ^ (j - i)) * Polynomial.coeff q (n - (k - j)) * (Nat.factorial (n - j) * Nat.factorial (n - (k - j)) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) =
                     ∑ i ∈ Finset.range (k + 1), Polynomial.coeff p (n - i) * (∑ j ∈ Finset.Ico i (k + 1), Nat.choose (n - i) (j - i) * Polynomial.coeff q (n - (k - j)) * (Nat.factorial (n - j) * Nat.factorial (n - (k - j)) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) * c ^ (j - i)) := by
                       simp +decide [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _, Finset.sum_mul ];
                       rw [ Finset.range_eq_Ico, Finset.sum_Ico_Ico_comm ];
  -- Let's simplify the expression using the properties of binomial coefficients and factorials further.
  have h_simplify_further : ∑ i ∈ Finset.range (k + 1), Polynomial.coeff p (n - i) * (∑ j ∈ Finset.Ico i (k + 1), Nat.choose (n - i) (j - i) * Polynomial.coeff q (n - (k - j)) * (Nat.factorial (n - j) * Nat.factorial (n - (k - j)) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) * c ^ (j - i)) =
                            ∑ i ∈ Finset.range (k + 1), Polynomial.coeff p (n - i) * (∑ j ∈ Finset.range (k - i + 1), Nat.choose (n - i) j * Polynomial.coeff q (n - (k - (i + j))) * (Nat.factorial (n - (i + j)) * Nat.factorial (n - (k - (i + j))) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) * c ^ j) := by
                              simp +decide [ Finset.sum_Ico_eq_sum_range ];
                              exact Finset.sum_congr rfl fun i hi => by rw [ Nat.sub_add_comm ( Finset.mem_range_succ_iff.mp hi ) ] ;
  convert h_expand.trans ( h_simplify.trans h_simplify_further ) using 1;
  · exact Finset.sum_congr rfl fun _ _ => by ring;
  · unfold boxplus_coeff;
    simp +decide [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _, Finset.sum_mul ];
    rw [ Finset.sum_sigma', Finset.sum_sigma' ];
    refine' Finset.sum_bij ( fun x hx => ⟨ x.snd, k - x.fst ⟩ ) _ _ _ _ <;> simp +decide;
    · grind;
    · grind;
    · exact fun b hb₁ hb₂ => ⟨ k - b.2, b.1, ⟨ by omega, by omega ⟩, by simp +decide [ Nat.sub_sub_self ( show b.2 ≤ k from by omega ) ] ⟩;
    · intro a ha₁ ha₂; rw [ Nat.choose_symm_of_eq_add ] ; ring;
      rotate_right;
      exact k - a.fst;
      · rw [ Nat.cast_choose, Nat.cast_choose ] <;> try omega;
        field_simp;
        rw [ show n - ( a.fst - a.snd ) = n - a.fst + a.snd by omega, show n - a.snd - ( k - a.fst ) = n - k + ( a.fst - a.snd ) by omega, show n - a.fst - ( k - a.fst ) = n - k by omega, show n - ( a.snd + ( k - a.fst ) ) = n - k + ( a.fst - a.snd ) by omega, show n - ( k - ( a.snd + ( k - a.fst ) ) ) = n - a.fst + a.snd by omega ] ; ring_nf ; aesop;
      · rw [ tsub_add_tsub_cancel ( by linarith ) ( by linarith ) ]

/-
`boxplus` is linear in the first argument.
-/
lemma boxplus_linear_left (n : ℕ) (p1 p2 q : ℝ[X]) :
    boxplus n (p1 + p2) q = boxplus n p1 q + boxplus n p2 q := by
      unfold boxplus;
      simp +decide only [boxplus_coeff, coeff_add];
      simp +decide [ mul_add, add_mul, Finset.sum_add_distrib ]

/-
`boxplus` commutes with shifting the first argument.
-/
lemma boxplus_comp_add_C_left (n : ℕ) (p q : ℝ[X]) (c : ℝ)
    (hp : p.natDegree = n) (hq : q.natDegree = n) :
    boxplus n (p.comp (X + C c)) q = (boxplus n p q).comp (X + C c) := by
  ext k
  -- We need to show coefficients match.
  -- LHS coeff k: boxplus_coeff n (p(x+c)) q (n-k)
  -- RHS coeff k: coeff of (boxplus n p q)(x+c) at k
  -- Let m = n - k. We need to show coeff m matches.
  -- Actually, let's just use polynomial extensionality.
  -- But `boxplus` is defined as a sum of `C (boxplus_coeff ...) * X^(n-k)`.
  -- So `boxplus n ...` is a polynomial of degree at most `n`.
  -- The coefficient of `X^m` in `boxplus n P Q` is `boxplus_coeff n P Q (n-m)`.
  -- So we need to show:
  -- `boxplus_coeff n (p(x+c)) q k = coeff ((boxplus n p q)(x+c)) (n-k)`
  -- Let's use `boxplus_coeff_comp_add_C_left` for the LHS.
  -- And expand RHS using binomial theorem for `(boxplus n p q)(x+c)`.
  -- `(boxplus n p q)(x+c) = sum_j (boxplus n p q)_j * (x+c)^j`
  -- coeff of `X^(n-k)` in RHS is:
  -- sum_j (boxplus n p q)_j * coeff ((x+c)^j) (n-k)
  -- coeff ((x+c)^j) (n-k) = choose j (n-k) * c^(j-(n-k))
  -- (boxplus n p q)_j is coeff of X^j in boxplus n p q.
  -- By definition, boxplus n p q = sum_r C (boxplus_coeff n p q r) * X^(n-r).
  -- So coeff of X^j is `boxplus_coeff n p q (n-j)`.
  -- Let `r = n-j`. Then `j = n-r`.
  -- Sum over `r`.
  -- This matches the form in `boxplus_coeff_comp_add_C_left`.
  -- By definition of coefficient of a polynomial, we can write
  have h_coeff_def : ∀ (k : ℕ), Polynomial.coeff (boxplus n (p.comp (Polynomial.X + Polynomial.C c)) q) k = ∑ j ∈ Finset.range (n + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n (p.comp (Polynomial.X + Polynomial.C c)) q j) * Polynomial.X ^ (n - j)) k := by
    unfold boxplus; aesop;
  -- By definition of coefficient of a polynomial, we can write the composition as a sum of terms.
  have h_comp_def : Polynomial.coeff ((boxplus n p q).comp (Polynomial.X + Polynomial.C c)) k = ∑ j ∈ Finset.range (n + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n p q j) * (Polynomial.X + Polynomial.C c) ^ (n - j)) k := by
    unfold boxplus; aesop;
  -- Apply the lemma boxplus_coeff_comp_add_C_left to each term in the sum.
  have h_sum_eq : ∑ j ∈ Finset.range (n + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n (p.comp (Polynomial.X + Polynomial.C c)) q j) * Polynomial.X ^ (n - j)) k = ∑ j ∈ Finset.range (n + 1), ∑ i ∈ Finset.range (j + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n p q i * Nat.choose (n - i) (n - j) * c ^ (j - i)) * Polynomial.X ^ (n - j)) k := by
    refine' Finset.sum_congr rfl fun j hj => _;
    rw [ boxplus_coeff_comp_add_C_left ];
    · simp +decide [ Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, Finset.sum_mul ];
    · linarith [ Finset.mem_range.mp hj ];
    · exact hp;
    · exact hq;
  -- By Fubini's theorem, we can interchange the order of summation.
  have h_fubini : ∑ j ∈ Finset.range (n + 1), ∑ i ∈ Finset.range (j + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n p q i * Nat.choose (n - i) (n - j) * c ^ (j - i)) * Polynomial.X ^ (n - j)) k = ∑ i ∈ Finset.range (n + 1), ∑ j ∈ Finset.Ico i (n + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n p q i * Nat.choose (n - i) (n - j) * c ^ (j - i)) * Polynomial.X ^ (n - j)) k := by
    rw [ Finset.range_eq_Ico, Finset.sum_Ico_Ico_comm ];
  -- Apply the lemma boxplus_coeff_comp_add_C_left to each term in the sum, noting that the coefficient of $X^k$ in $(X + C c)^{n - i}$ is $\binom{n - i}{k} c^{n - i - k}$.
  have h_coeff_eq : ∀ i ∈ Finset.range (n + 1), ∑ j ∈ Finset.Ico i (n + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n p q i * Nat.choose (n - i) (n - j) * c ^ (j - i)) * Polynomial.X ^ (n - j)) k = Polynomial.coeff (Polynomial.C (boxplus_coeff n p q i) * (Polynomial.X + Polynomial.C c) ^ (n - i)) k := by
    intros i hi
    have h_coeff_eq : ∑ j ∈ Finset.Ico i (n + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n p q i * Nat.choose (n - i) (n - j) * c ^ (j - i)) * Polynomial.X ^ (n - j)) k = ∑ j ∈ Finset.range (n - i + 1), Polynomial.coeff (Polynomial.C (boxplus_coeff n p q i * Nat.choose (n - i) j * c ^ j) * Polynomial.X ^ (n - i - j)) k := by
      rw [ Finset.sum_Ico_eq_sum_range ];
      simp +decide [ Nat.sub_sub, add_comm i ];
      rw [ Nat.sub_add_comm ( Finset.mem_range_succ_iff.mp hi ) ];
      refine' Finset.sum_congr rfl fun x hx => _;
      rw [ show n - ( x + i ) = n - i - x by rw [ Nat.sub_sub, add_comm ] ];
      rw [ Nat.choose_symm ( Nat.le_of_lt_succ ( Finset.mem_range.mp hx ) ) ];
    rw [ h_coeff_eq ];
    rw [ add_pow ] ; norm_num [ mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _ ] ; ring;
    rw [ add_comm, ← Finset.sum_flip ];
    exact Finset.sum_congr rfl fun x hx => by rw [ Nat.choose_symm ( Finset.mem_range_succ_iff.mp hx ), tsub_tsub_cancel_of_le ( Finset.mem_range_succ_iff.mp hx ) ] ;
  rw [ h_coeff_def, h_sum_eq, h_fubini, Finset.sum_congr rfl h_coeff_eq, h_comp_def ]

/-
`boxplus` commutes with scalar multiplication in the first argument.
-/
lemma boxplus_smul_left (n : ℕ) (a : ℝ) (p q : ℝ[X]) :
    boxplus n (C a * p) q = C a * boxplus n p q := by
      unfold boxplus;
      unfold boxplus_coeff;
      simp +decide [ mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _, Finset.sum_mul ]

/-
`boxplus` is linear over sums in the first argument.
-/
lemma boxplus_sum_left {ι : Type*} (n : ℕ) (s : Finset ι) (f : ι → ℝ[X]) (q : ℝ[X]) :
    boxplus n (∑ i ∈ s, f i) q = ∑ i ∈ s, boxplus n (f i) q := by
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty, map_zero]
    unfold boxplus boxplus_coeff
    simp
  | insert x s hx ih =>
    simp only [Finset.sum_insert hx]
    rw [boxplus_linear_left, ih]

/-
Coefficient formula for shifted polynomial.
-/
lemma coeff_comp_X_add_C (p : ℝ[X]) (c : ℝ) (k : ℕ) :
    (p.comp (X + C c)).coeff k = ∑ i ∈ Finset.range (p.natDegree + 1), p.coeff i * (Nat.choose i k) * c ^ (i - k) := by
      rw [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
      norm_num [ Polynomial.coeff_X_add_C_pow ];
      ac_rfl

/-
It suffices to prove the Finite Free Stam Inequality for centered polynomials.
-/
lemma finite_free_stam_inequality_centered_sufficient (n : ℕ) (hn : n ≥ 2) :
    (∀ (p q : ℝ[X]),
      is_centered n p → is_centered n q →
      p.Splits (RingHom.id ℝ) → p.roots.Nodup →
      q.Splits (RingHom.id ℝ) → q.roots.Nodup →
      (boxplus n p q).Splits (RingHom.id ℝ) → (boxplus n p q).roots.Nodup →
      invPhi (boxplus n p q) ≥ invPhi p + invPhi q) →
    (∀ (p q : ℝ[X]),
      p.Monic → p.natDegree = n → p.Splits (RingHom.id ℝ) → p.roots.Nodup →
      q.Monic → q.natDegree = n → q.Splits (RingHom.id ℝ) → q.roots.Nodup →
      (boxplus n p q).Splits (RingHom.id ℝ) → (boxplus n p q).roots.Nodup →
      invPhi (boxplus n p q) ≥ invPhi p + invPhi q) := by
        intro h p q hp hp' hp'' hp''' hq hq' hq'' hq''';
        -- By definition of `shifted_to_center`, we know that `shifted_to_center n p` and `shifted_to_center n q` are centered polynomials.
        have h_shifted_p : is_centered n (shifted_to_center n p) := by
          apply shifted_to_center_is_centered n p (by linarith) hp hp'
        have h_shifted_q : is_centered n (shifted_to_center n q) := by
          apply shifted_to_center_is_centered n q (by linarith) hq hq';
        -- By definition of `shifted_to_center`, we know that `boxplus n (shifted_to_center n p) (shifted_to_center n q)` is equal to `boxplus n p q` shifted by `shift_to_center_amount n p + shift_to_center_amount n q`.
        have h_boxplus_shifted : boxplus n (shifted_to_center n p) (shifted_to_center n q) = (boxplus n p q).comp (X + C (shift_to_center_amount n p + shift_to_center_amount n q)) := by
          have h_boxplus_shifted : ∀ (p q : ℝ[X]) (c d : ℝ), p.natDegree = n → q.natDegree = n → boxplus n (p.comp (X + C c)) (q.comp (X + C d)) = (boxplus n p q).comp (X + C (c + d)) := by
            intros p q c d hp hq;
            have h_boxplus_shifted : ∀ (p q : ℝ[X]) (c d : ℝ), p.natDegree = n → q.natDegree = n → boxplus n (p.comp (X + C c)) (q.comp (X + C d)) = (boxplus n p q).comp (X + C (c + d)) := by
              intros p q c d hp hq
              have h_boxplus_shifted : boxplus n (p.comp (X + C c)) (q.comp (X + C d)) = (boxplus n (p.comp (X + C c)) q).comp (X + C d) := by
                rw [ boxplus_comm ];
                rw [ boxplus_comp_add_C_left ];
                · rw [ boxplus_comm ];
                · exact hq;
                · rw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, hp, mul_one ]
              have h_boxplus_shifted : boxplus n (p.comp (X + C c)) q = (boxplus n p q).comp (X + C c) := by
                exact?;
              simp_all +decide [ Polynomial.comp_assoc ];
              exact congr_arg _ ( by ring );
            exact h_boxplus_shifted p q c d hp hq;
          convert h_boxplus_shifted p q ( shift_to_center_amount n p ) ( shift_to_center_amount n q ) hp' hq' using 1;
        intro h_splits h_nodup
        have h_invPhi_shifted : invPhi (boxplus n (shifted_to_center n p) (shifted_to_center n q)) = invPhi (boxplus n p q) := by
          rw [h_boxplus_shifted];
          exact?;
        have h_invPhi_shifted_p : invPhi (shifted_to_center n p) = invPhi p := by
          apply invPhi_shift_invariance
        have h_invPhi_shifted_q : invPhi (shifted_to_center n q) = invPhi q := by
          convert invPhi_shift_invariance q ( shift_to_center_amount n q ) using 1;
        have := h ( shifted_to_center n p ) ( shifted_to_center n q ) h_shifted_p h_shifted_q ( by
          convert splits_comp_at_add_C p ( shift_to_center_amount n p ) hp'' using 1 ) ( by
          convert nodup_roots_comp_at_add_C p ( shift_to_center_amount n p ) hp''' using 1 ) ( by
          convert splits_comp_at_add_C _ _ hq'' using 1 ) ( by
          convert nodup_roots_comp_at_add_C q ( shift_to_center_amount n q ) hq''' using 1 ) ( by
          rw [h_boxplus_shifted];
          exact? ) ( by
          rw [ h_boxplus_shifted ];
          exact? );
        linarith

/-
Sum restriction for binomial coefficients.
-/
lemma sum_choose_restriction (n k : ℕ) (hk : k ≤ n) (f : ℕ → ℝ) :
    ∑ j ∈ Finset.range (n + 1), f j * (Nat.choose (n - j) (n - k)) =
    ∑ j ∈ Finset.range (k + 1), f j * (Nat.choose (n - j) (n - k)) := by
      rw [ ← Finset.sum_range_add_sum_Ico _ ( by linarith : k + 1 ≤ n + 1 ) ];
      simp;
      exact Finset.sum_eq_zero fun x hx => by rw [ Nat.choose_eq_zero_of_lt ( by rw [ tsub_lt_tsub_iff_left_of_le ] <;> linarith [ Finset.mem_Ico.mp hx ] ) ] ; ring;

/-
Equality of coefficients for shifted boxplus.
-/
lemma boxplus_comp_add_C_left_coeff_eq (n : ℕ) (p q : ℝ[X]) (c : ℝ) (k : ℕ)
    (hk : k ≤ n) (hp : p.natDegree = n) (hq : q.natDegree = n) :
    boxplus_coeff n (p.comp (X + C c)) q k = ((boxplus n p q).comp (X + C c)).coeff (n - k) := by
      -- By definition of polynomial composition, we know that the coefficients of $(boxplus n p q).comp (X + C c)$ are the same as the coefficients of $boxplus n (p.comp (X + C c)) q$.
      have h_comp : (boxplus n p q).comp (Polynomial.X + Polynomial.C c) = boxplus n (p.comp (Polynomial.X + Polynomial.C c)) q := by
        exact?;
      unfold boxplus at *;
      simp_all +decide [ Polynomial.coeff_X_add_C_pow ];
      rw [ Finset.sum_ite ];
      rw [ show ( Finset.filter ( fun x => n - k = n - x ) ( Finset.range ( n + 1 ) ) ) = { k } from ?_ ] ; aesop;
      grind

/-
`boxplus` commutes with shifting both arguments.
-/
lemma boxplus_comp_add_C (n : ℕ) (p q : ℝ[X]) (c d : ℝ)
    (hp : p.natDegree = n) (hq : q.natDegree = n) :
    boxplus n (p.comp (X + C c)) (q.comp (X + C d)) = (boxplus n p q).comp (X + C (c + d)) := by
      convert congr_arg ( fun x => x.comp ( Polynomial.X + Polynomial.C d ) ) ( boxplus_comp_add_C_left n p q c hp hq ) using 1;
      · rw [ boxplus_comp_add_C_left ];
        · rw [ boxplus_comm ];
          rw [ boxplus_comp_add_C_left, boxplus_comp_add_C_left ];
          · rw [ boxplus_comm ] ; norm_num [ Polynomial.comp_assoc ] ; ring;
          · exact hp;
          · exact hq;
          · exact hq;
          · exact hp;
        · exact hp;
        · rw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, hq, mul_one ];
      · norm_num [ Polynomial.comp_assoc ];
        exact congr_arg _ ( by ring )

/-
Reindexing lemma for sums involving binomial coefficients.
-/
lemma sum_choose_reindex (n k : ℕ) (hk : k ≤ n) (f : ℕ → ℝ) (c : ℝ) :
    ∑ j ∈ Finset.range (k + 1), f j * (Nat.choose (n - j) (n - k)) * c ^ (k - j) =
    ∑ i ∈ Finset.range (n + 1), f (n - i) * (Nat.choose i (n - k)) * c ^ (i - (n - k)) := by
      -- By reindexing the sum with $i = n - j$, we can transform the LHS sum into the RHS sum.
      have h_reindex : Finset.sum (Finset.range (k + 1)) (fun j => f j * Nat.choose (n - j) (n - k) * c ^ (k - j)) = Finset.sum (Finset.image (fun j => n - j) (Finset.range (k + 1))) (fun i => f (n - i) * Nat.choose i (n - k) * c ^ (i - (n - k))) := by
        rw [ Finset.sum_image ];
        · refine' Finset.sum_congr rfl fun x hx => _;
          grind;
        · exact fun x hx y hy hxy => by rw [ tsub_right_inj ] at hxy <;> linarith [ Finset.mem_range.mp hx, Finset.mem_range.mp hy ] ;
      rw [ h_reindex, Finset.sum_subset ];
      · exact Finset.image_subset_iff.mpr fun x hx => Finset.mem_range.mpr ( Nat.lt_succ_of_le ( Nat.sub_le _ _ ) );
      · simp +zetaDelta at *;
        exact fun x hx₁ hx₂ => Or.inl <| Or.inr <| Nat.choose_eq_zero_of_lt <| by contrapose! hx₂; exact ⟨ n - x, by omega, by omega ⟩ ;

/-
invPhi of boxplus is invariant under centering shifts.
-/
lemma invPhi_boxplus_shifted_eq (n : ℕ) (p q : ℝ[X])
    (hp : p.natDegree = n) (hq : q.natDegree = n) :
    invPhi (boxplus n p q) = invPhi (boxplus n (shifted_to_center n p) (shifted_to_center n q)) := by
  let c := shift_to_center_amount n p
  let d := shift_to_center_amount n q
  have h_shift : boxplus n (shifted_to_center n p) (shifted_to_center n q) =
                 (boxplus n p q).comp (X + C (c + d)) := by
    unfold shifted_to_center
    rw [boxplus_comp_add_C n p q c d hp hq]
  rw [h_shift]
  rw [invPhi_shift_invariance (boxplus n p q) (c + d)]

/-
Shifting to center preserves splitting and distinct roots.
-/
lemma shifted_to_center_properties (n : ℕ) (p : ℝ[X])
    (hp_splits : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup) :
    (shifted_to_center n p).Splits (RingHom.id ℝ) ∧ (shifted_to_center n p).roots.Nodup := by
  unfold shifted_to_center
  constructor
  · exact splits_comp_at_add_C p (shift_to_center_amount n p) hp_splits
  · exact nodup_roots_comp_at_add_C p (shift_to_center_amount n p) hp_nodup

/-
It suffices to prove the Finite Free Stam Inequality for centered polynomials.
-/
lemma finite_free_stam_inequality_centered_sufficient_v2 (n : ℕ) (hn : n ≥ 2) :
    (∀ (p q : ℝ[X]),
      is_centered n p → is_centered n q →
      p.Splits (RingHom.id ℝ) → p.roots.Nodup →
      q.Splits (RingHom.id ℝ) → q.roots.Nodup →
      (boxplus n p q).Splits (RingHom.id ℝ) → (boxplus n p q).roots.Nodup →
      invPhi (boxplus n p q) ≥ invPhi p + invPhi q) →
    (∀ (p q : ℝ[X]),
      p.Monic → p.natDegree = n → p.Splits (RingHom.id ℝ) → p.roots.Nodup →
      q.Monic → q.natDegree = n → q.Splits (RingHom.id ℝ) → q.roots.Nodup →
      (boxplus n p q).Splits (RingHom.id ℝ) → (boxplus n p q).roots.Nodup →
      invPhi (boxplus n p q) ≥ invPhi p + invPhi q) := by
  intro h p q hp_monic hp_deg hp_splits hp_nodup hq_monic hq_deg hq_splits hq_nodup hpq_splits hpq_nodup
  let p_cent := shifted_to_center n p
  let q_cent := shifted_to_center n q
  let c := shift_to_center_amount n p
  let d := shift_to_center_amount n q
  
  -- Centered properties
  have hp_cent_centered : is_centered n p_cent := shifted_to_center_is_centered n p (by linarith) hp_monic hp_deg
  have hq_cent_centered : is_centered n q_cent := shifted_to_center_is_centered n q (by linarith) hq_monic hq_deg
  
  -- Splitting and Nodup properties
  have hp_cent_props := shifted_to_center_properties n p hp_splits hp_nodup
  have hq_cent_props := shifted_to_center_properties n q hq_splits hq_nodup
  
  -- Invariance of invPhi for p and q
  have hp_invPhi : invPhi p_cent = invPhi p := invPhi_shift_invariance p c
  have hq_invPhi : invPhi q_cent = invPhi q := invPhi_shift_invariance q d
  
  -- Boxplus shift relation
  have h_box_shift : boxplus n p_cent q_cent = (boxplus n p q).comp (X + C (c + d)) :=
    boxplus_comp_add_C n p q c d hp_deg hq_deg
    
  -- Splitting and Nodup for boxplus
  have hpq_cent_splits : (boxplus n p_cent q_cent).Splits (RingHom.id ℝ) := by
    rw [h_box_shift]
    exact splits_comp_at_add_C (boxplus n p q) (c + d) hpq_splits
    
  have hpq_cent_nodup : (boxplus n p_cent q_cent).roots.Nodup := by
    rw [h_box_shift]
    exact nodup_roots_comp_at_add_C (boxplus n p q) (c + d) hpq_nodup
    
  -- Invariance of invPhi for boxplus
  have hpq_invPhi : invPhi (boxplus n p_cent q_cent) = invPhi (boxplus n p q) := by
    rw [h_box_shift]
    exact invPhi_shift_invariance (boxplus n p q) (c + d)
    
  -- Apply hypothesis
  specialize h p_cent q_cent hp_cent_centered hq_cent_centered hp_cent_props.1 hp_cent_props.2 hq_cent_props.1 hq_cent_props.2 hpq_cent_splits hpq_cent_nodup
  
  -- Conclude
  rw [← hpq_invPhi, ← hp_invPhi, ← hq_invPhi]
  exact h

/-
Finite Free Stam Inequality for centered polynomials (n=2).
-/
lemma finite_free_stam_inequality_centered_n2 (p q : ℝ[X])
    (hp_cent : is_centered 2 p) (hq_cent : is_centered 2 q)
    (hp_splits : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hq_splits : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hpq_splits : (boxplus 2 p q).Splits (RingHom.id ℝ)) (hpq_nodup : (boxplus 2 p q).roots.Nodup) :
    invPhi (boxplus 2 p q) ≥ invPhi p + invPhi q := by
      have hp_roots : p.roots.card = 2 := by
        have := hp_cent.2.1; rw [ Polynomial.splits_iff_card_roots ] at hp_splits; aesop;
      have hq_roots : q.roots.card = 2 := by
        have := hq_cent.2.1; rw [ Polynomial.splits_iff_card_roots ] at hq_splits; aesop;
      obtain ⟨a₁, a₂, ha₁, ha₂, hp⟩ : ∃ a₁ a₂ : ℝ, a₁ ≠ a₂ ∧ p = Polynomial.C 1 * (Polynomial.X - Polynomial.C a₁) * (Polynomial.X - Polynomial.C a₂) := by
        obtain ⟨a₁, a₂, ha₁, ha₂⟩ : ∃ a₁ a₂ : ℝ, p.roots = {a₁, a₂} ∧ a₁ ≠ a₂ := by
          rw [ Multiset.card_eq_two ] at hp_roots ; aesop;
        use a₁, a₂, ha₂;
        convert Polynomial.eq_prod_roots_of_monic_of_splits_id hp_cent.1 hp_splits using 1 ; aesop
      obtain ⟨b₁, b₂, hb₁, hb₂, hq⟩ : ∃ b₁ b₂ : ℝ, b₁ ≠ b₂ ∧ q = Polynomial.C 1 * (Polynomial.X - Polynomial.C b₁) * (Polynomial.X - Polynomial.C b₂) := by
        obtain ⟨b₁, b₂, hb₁, hb₂⟩ : ∃ b₁ b₂ : ℝ, b₁ ≠ b₂ ∧ q.roots = {b₁, b₂} := by
          rw [ Multiset.card_eq_two ] at hq_roots; obtain ⟨ b₁, b₂, hb ⟩ := hq_roots; use b₁, b₂; aesop;
        use b₁, b₂, hb₁;
        convert Polynomial.eq_prod_roots_of_monic_of_splits_id hq_cent.1 hq_splits using 1 ; aesop;
      have := hp_cent.2.2; have := hq_cent.2.2; simp_all +decide [ Polynomial.coeff_one, Polynomial.coeff_X, mul_sub ] ;
      norm_num [ show a₁ = -a₂ by linarith, show b₁ = -b₂ by linarith ] at *;
      unfold invPhi; norm_num [ Polynomial.coeff_one, Polynomial.coeff_X, Polynomial.coeff_C, boxplus ] ;
      unfold Phi; norm_num [ Finset.sum_range_succ', Polynomial.coeff_one, Polynomial.coeff_X, Polynomial.coeff_C, boxplus_coeff ] ;
      rw [ show ( Polynomial.X + Polynomial.C a₂ ) * Polynomial.X - ( Polynomial.X + Polynomial.C a₂ ) * Polynomial.C a₂ = ( Polynomial.X - Polynomial.C a₂ ) * ( Polynomial.X + Polynomial.C a₂ ) by ring, show ( Polynomial.X + Polynomial.C b₂ ) * Polynomial.X - ( Polynomial.X + Polynomial.C b₂ ) * Polynomial.C b₂ = ( Polynomial.X - Polynomial.C b₂ ) * ( Polynomial.X + Polynomial.C b₂ ) by ring ] at * ; norm_num [ Polynomial.roots_mul, Polynomial.X_sub_C_ne_zero, Polynomial.X_add_C_ne_zero ] at *;
      rw [ show ( - ( Polynomial.C a₂ * Polynomial.C a₂ ) + - ( Polynomial.C b₂ * Polynomial.C b₂ ) + Polynomial.X ^ 2 : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt ( a₂ ^ 2 + b₂ ^ 2 ) ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt ( a₂ ^ 2 + b₂ ^ 2 ) ) ) by exact Polynomial.funext fun x => by norm_num; linarith [ Real.mul_self_sqrt ( add_nonneg ( sq_nonneg a₂ ) ( sq_nonneg b₂ ) ) ] ] at * ; rw [ Polynomial.roots_mul <| by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ] at * ; norm_num at *;
      simp_all +decide [ Finset.sum_pair, Finset.erase ];
      ring_nf; norm_num [ Real.sqrt_nonneg, add_nonneg, sq_nonneg ];
      split_ifs <;> nlinarith [ Real.sqrt_nonneg ( a₂ ^ 2 + b₂ ^ 2 ), Real.mul_self_sqrt ( add_nonneg ( sq_nonneg a₂ ) ( sq_nonneg b₂ ) ) ]

#check finite_free_stam_inequality_centered_sufficient

/-
Formula for invPhi of a centered cubic.
-/
def invPhi_cubic_centered_formula (a b : ℝ) : ℝ :=
  -(4 * a^3 + 27 * b^2) / (18 * a^2)

lemma invPhi_eq_invPhi_cubic_centered_formula (a b : ℝ)
    (p : ℝ[X]) (hp : p = X^3 + C a * X + C b)
    (h_splits : p.Splits (RingHom.id ℝ)) (h_nodup : p.roots.Nodup) :
    invPhi p = invPhi_cubic_centered_formula a b := by
      -- Let's denote the roots of $p$ by $r_1, r_2, r_3$.
      obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, p = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) ∧ r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r1 := by
        have h_roots : Multiset.card p.roots = 3 := by
          rw [ Polynomial.splits_iff_card_roots ] at h_splits;
          rw [ h_splits, hp, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
        obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, p.roots = {r1, r2, r3} := by
          exact Multiset.card_eq_three.mp h_roots;
        refine' ⟨ r1, r2, r3, _, _, _, _ ⟩ <;> simp_all +decide [ mul_assoc ];
        · rw [ ← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq ( show Polynomial.Monic ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) from ?_ ) ];
          · norm_num [ hr, mul_assoc ];
          · rw [ Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
            · aesop;
            · aesop;
          · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
        · tauto;
      -- By Vieta's formulas, we know that $r_1 + r_2 + r_3 = 0$, $r_1r_2 + r_2r_3 + r_3r_1 = a$, and $r_1r_2r_3 = -b$.
      have h_vieta : r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a ∧ r1 * r2 * r3 = -b := by
        subst hp; have h₁ := congr_arg ( Polynomial.eval 0 ) hr.1; have h₂ := congr_arg ( Polynomial.eval 1 ) hr.1; have h₃ := congr_arg ( Polynomial.eval ( -1 ) ) hr.1; norm_num at h₁ h₂ h₃; exact ⟨ by linarith, by linarith, by linarith ⟩ ;
      -- By definition of $Phi$, we know that
      have h_phi : Phi p = 2 * (1 / (r1 - r2)^2 + 1 / (r2 - r3)^2 + 1 / (r3 - r1)^2) := by
        unfold Phi;
        rw [ hr.1, Polynomial.roots_mul, Polynomial.roots_mul ] <;> norm_num [ Polynomial.X_sub_C_ne_zero ];
        simp +decide [ Finset.sum, * ] ; ring;
        rw [ Multiset.ndinsert_of_notMem ] <;> norm_num [ hr ] ; ring;
        · rw [ show ( -r1 + r2 ) = - ( r1 - r2 ) by ring, inv_neg ] ; ring;
          rw [ Multiset.erase_cons_tail ] ; norm_num ; ring;
          · rw [ Multiset.erase_cons_tail ] ; norm_num ; ring;
            · rw [ show -r1 + r3 = - ( r1 - r3 ) by ring, show -r2 + r3 = - ( r2 - r3 ) by ring, inv_neg, inv_neg ] ; ring;
              grind;
            · tauto;
          · tauto;
        · tauto;
      -- By definition of $invPhi$, we know that
      have h_inv_phi : invPhi p = (1 / (2 * (1 / (r1 - r2)^2 + 1 / (r2 - r3)^2 + 1 / (r3 - r1)^2))) := by
        rw [ ← h_phi, invPhi ];
        rw [ hr.1, Polynomial.roots_mul, Polynomial.roots_mul ] <;> norm_num [ hr.2 ];
        · tauto;
        · exact ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_sub_C_ne_zero _ ⟩;
        · exact ⟨ ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_sub_C_ne_zero _ ⟩, Polynomial.X_sub_C_ne_zero _ ⟩;
      unfold invPhi_cubic_centered_formula; simp_all +decide [ sub_eq_iff_eq_add ] ;
      rw [ inv_mul_eq_div, div_eq_div_iff ];
      · field_simp;
        rw [ div_add_div, div_add_div ] <;> try nlinarith [ mul_self_pos.2 ( sub_ne_zero.2 hr.2.1 ), mul_self_pos.2 ( sub_ne_zero.2 hr.2.2.1 ), mul_self_pos.2 ( sub_ne_zero.2 hr.2.2.2 ) ];
        rw [ mul_div, eq_div_iff ];
        · grind;
        · exact mul_ne_zero ( mul_ne_zero ( pow_ne_zero 2 ( sub_ne_zero_of_ne hr.2.1 ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne hr.2.2.1 ) ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne hr.2.2.2 ) );
      · exact ne_of_gt ( add_pos ( add_pos ( inv_pos.mpr ( sq_pos_of_ne_zero ( sub_ne_zero.mpr hr.2.1 ) ) ) ( inv_pos.mpr ( sq_pos_of_ne_zero ( sub_ne_zero.mpr hr.2.2.1 ) ) ) ) ( inv_pos.mpr ( sq_pos_of_ne_zero ( sub_ne_zero.mpr hr.2.2.2 ) ) ) );
      · simp_all +decide [ sub_eq_iff_eq_add ];
        cases lt_or_gt_of_ne hr.2.1 <;> cases lt_or_gt_of_ne hr.2.2.1 <;> cases lt_or_gt_of_ne hr.2.2.2 <;> nlinarith

#check finite_free_stam_inequality_centered_n2

/-
Phi formula using derivatives.
-/
lemma Phi_derivative_form (p : ℝ[X])
    (h_splits : p.Splits (RingHom.id ℝ))
    (h_nodup : p.roots.Nodup) :
    Phi p = ∑ r ∈ p.roots.toFinset, (p.derivative.derivative.eval r / (2 * p.derivative.eval r))^2 := by
  unfold Phi
  apply Finset.sum_congr rfl
  intro r hr
  congr 1
  -- We need to show sum_{j != r} 1/(r - r_j) = p''(r) / (2 p'(r))
  -- p(x) = (x-r) * q(x)
  -- p'(x) = q(x) + (x-r)q'(x)
  -- p'(r) = q(r)
  -- p''(x) = 2q'(x) + (x-r)q''(x)
  -- p''(r) = 2q'(r)
  -- So we need sum 1/(r - r_j) = q'(r)/q(r)
  -- q(x) = prod (x - r_j)
  -- q'(x)/q(x) = sum 1/(x - r_j)
  -- Evaluating at r gives the result.
  -- By definition of $p$, we know that $p(x) = \prod_{j=1}^n (x - r_j)$.
  have h_prod : p = Polynomial.C (p.leadingCoeff) * ∏ r_j ∈ p.roots.toFinset, (Polynomial.X - Polynomial.C r_j) := by
    convert Polynomial.eq_prod_roots_of_splits_id h_splits;
    rw [ ← Multiset.toFinset_eq ] ; aesop;
  rw [ h_prod ];
  norm_num [ Polynomial.eval_prod, Finset.prod_eq_prod_diff_singleton_mul ( show r ∈ p.roots.toFinset from hr ) ];
  -- By definition of polynomial multiplication and the properties of roots, we can simplify the expression.
  have h_simplify : Polynomial.eval r (Polynomial.derivative (∏ r_j ∈ p.roots.toFinset \ {r}, (Polynomial.X - Polynomial.C r_j))) = (∏ r_j ∈ p.roots.toFinset \ {r}, (r - r_j)) * (∑ r_j ∈ p.roots.toFinset \ {r}, (r - r_j)⁻¹) := by
    have h_simplify : ∀ {S : Finset ℝ}, (∀ r_j ∈ S, r ≠ r_j) → Polynomial.eval r (Polynomial.derivative (∏ r_j ∈ S, (Polynomial.X - Polynomial.C r_j))) = (∏ r_j ∈ S, (r - r_j)) * (∑ r_j ∈ S, (r - r_j)⁻¹) := by
      intro S hS; induction S using Finset.induction <;> norm_num at *;
      simp +decide [ *, Finset.prod_insert, Finset.sum_insert, Polynomial.derivative_prod ];
      simp +decide [ Polynomial.eval_prod, mul_add, add_comm, mul_assoc, mul_left_comm, sub_ne_zero.mpr hS.1 ];
    exact h_simplify fun x hx => by rintro rfl; exact Finset.notMem_sdiff_of_mem_right ( Finset.mem_singleton_self _ ) hx;
  rw [ h_simplify ];
  rw [ show ( Polynomial.C p.leadingCoeff * ( ( ∏ r_j ∈ p.roots.toFinset \ { r }, ( Polynomial.X - Polynomial.C r_j ) ) * ( Polynomial.X - Polynomial.C r ) ) |> Polynomial.roots |> Multiset.toFinset |> Finset.erase <| r ) = p.roots.toFinset \ { r } from ?_ ];
  · rw [ eq_div_iff ] <;> ring;
    norm_num [ Finset.prod_eq_zero_iff, sub_eq_zero ] at *;
    exact hr.1;
  · ext; simp [hr];
    constructor;
    · intro h;
      simp +decide [ Polynomial.eval_prod, Finset.prod_eq_zero_iff, sub_eq_zero ] at h ⊢;
      tauto;
    · simp +contextual [ Polynomial.eval_prod, Finset.prod_eq_zero_iff, sub_eq_zero ];
      exact fun _ _ _ => ⟨ fun x hx hx' => ne_of_apply_ne Polynomial.derivative <| by norm_num, ne_of_apply_ne Polynomial.derivative <| by norm_num ⟩

/-
Roots of shifted polynomial.
-/
lemma roots_comp_X_add_C (p : ℝ[X]) (c : ℝ) :
    (p.comp (X + C c)).roots = p.roots.map (fun r => r - c) := by
      ext x;
      by_cases h : p = 0 <;> simp_all +decide [ Polynomial.rootMultiplicity_eq_zero ];
      rw [ show Multiset.count x ( Multiset.map ( fun r => r - c ) p.roots ) = Polynomial.rootMultiplicity ( x + c ) p from ?_ ];
      · rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
        norm_num [ add_assoc, Polynomial.comp_assoc ];
      · rw [ Multiset.count_map ];
        rw [ show ( Multiset.filter ( fun a => x = a - c ) p.roots ) = Multiset.filter ( fun a => a = x + c ) p.roots by congr; ext; constructor <;> intro <;> linarith ] ; rw [ Multiset.filter_eq' ] ; aesop

/-
Algebraic identity for cubic roots sum.
-/
lemma cubic_sum_sq_roots_div_deriv (r1 r2 r3 a b : ℝ)
    (h_sum : r1 + r2 + r3 = 0)
    (h_a : a = r1 * r2 + r2 * r3 + r3 * r1)
    (h_b : b = - (r1 * r2 * r3))
    (h_deriv : ∀ x, 3 * x^2 + a = (x - r1) * (x - r2) * (x - r3) / (x - x) * 0 + 3 * x^2 + a) -- dummy
    (h_disc : 4 * a^3 + 27 * b^2 ≠ 0) :
    let p_deriv := fun x => 3 * x^2 + a
    (3 * r1 / p_deriv r1)^2 + (3 * r2 / p_deriv r2)^2 + (3 * r3 / p_deriv r3)^2 =
    18 * a^2 / -(4 * a^3 + 27 * b^2) := by
      simp +zetaDelta at *;
      rw [ div_pow, div_pow, div_pow ];
      rw [ div_add_div, div_add_div ];
      · grind;
      · grind;
      · grind;
      · grind;
      · grind