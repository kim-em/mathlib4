open scoped BigOperators Real Nat Classical Pointwise
open Polynomial BigOperators Finset Classical

def boxplus_coeff (n : ℕ) (p q : ℝ[X]) (k : ℕ) : ℝ :=
  ∑ i ∈ range (k + 1),
    let j := k - i
    (Nat.factorial (n - i) * Nat.factorial (n - j) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) *
    (p.coeff (n - i)) * (q.coeff (n - j))

def boxplus (n : ℕ) (p q : ℝ[X]) : ℝ[X] :=
  Finset.sum (range (n + 1)) (fun k => C (boxplus_coeff n p q k) * X ^ (n - k))

def Phi (p : ℝ[X]) : ℝ :=
  let roots := p.roots.toFinset
  ∑ r_i ∈ roots, (∑ r_j ∈ roots.erase r_i, 1 / (r_i - r_j))^2

def invPhi (p : ℝ[X]) : ℝ :=
  if p.roots.Nodup ∧ p.roots.card > 1 then
    1 / Phi p
  else 0

def is_centered (n : ℕ) (p : ℝ[X]) : Prop :=
  p.Monic ∧ p.natDegree = n ∧ p.coeff (n - 1) = 0

def shift_to_center_amount (n : ℕ) (p : ℝ[X]) : ℝ :=
  - p.coeff (n - 1) / n

def shifted_to_center (n : ℕ) (p : ℝ[X]) : ℝ[X] :=
  p.comp (X + C (shift_to_center_amount n p))

/-
`shifted_to_center` produces a centered polynomial.
-/
lemma shifted_to_center_is_centered (n : ℕ) (p : ℝ[X]) (hn : n ≠ 0)
    (hp_monic : p.Monic) (hp_deg : p.natDegree = n) :
    is_centered n (shifted_to_center n p) := by
      refine' ⟨ _, _, _ ⟩ <;> simp_all +decide [ is_centered ];
      · unfold shifted_to_center;
        rw [ Polynomial.Monic, Polynomial.leadingCoeff_comp, Polynomial.leadingCoeff_X_add_C ] <;> aesop;
      · erw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C ] ; aesop;
      · unfold shifted_to_center;
        norm_num [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
        rw [ Finset.sum_eq_add ( n - 1 ) n ] <;> norm_num [ Polynomial.coeff_X_add_C_pow, hp_deg ];
        · rcases n with ( _ | _ | n ) <;> simp_all +decide [ Nat.choose, shift_to_center_amount ];
          · have := hp_monic.coeff_natDegree; aesop;
          · field_simp;
            have := hp_monic.coeff_natDegree; aesop;
        · omega;
        · intro c hc₁ hc₂ hc₃; cases lt_or_gt_of_ne hc₂ <;> cases lt_or_gt_of_ne hc₃ <;> exact Or.inr <| Or.inr <| Nat.choose_eq_zero_of_lt <| by omega;
        · exact fun h => absurd h ( by omega )

/-
Phi is invariant under shifts.
-/
lemma Phi_comp_add_C (p : ℝ[X]) (c : ℝ) :
    Phi (p.comp (X + C c)) = Phi p := by
      unfold Phi;
      have h_roots : (p.comp (.X + .C c)).roots.toFinset = Finset.image (fun r => r - c) p.roots.toFinset := by
        ext; simp [Finset.mem_image];
        rw [ Polynomial.comp_eq_zero_iff ] ; aesop;
      rw [ h_roots, Finset.sum_image ];
      · refine' Finset.sum_congr rfl fun x hx => _;
        rw [ show ( Finset.image ( fun r => r - c ) p.roots.toFinset ).erase ( x - c ) = Finset.image ( fun r => r - c ) ( p.roots.toFinset.erase x ) from ?_, Finset.sum_image ] <;> aesop;
      · exact fun x hx y hy hxy => by simpa using hxy;

/-
invPhi is invariant under shifts.
-/
lemma invPhi_shift_invariance (p : ℝ[X]) (c : ℝ) :
    invPhi (p.comp (X + C c)) = invPhi p := by
      unfold invPhi;
      rw [ show ( p.comp ( X + C c ) |> Polynomial.roots ) = p.roots.map ( fun x => x - c ) from ?_ ];
      · rw [ ← Phi_comp_add_C ];
