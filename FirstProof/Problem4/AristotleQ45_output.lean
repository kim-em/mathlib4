      have roots_comp : Polynomial.roots (p.comp (Polynomial.X + C c)) = Multiset.map (fun r => r - c) (Polynomial.roots p) := by
        ext x; simp [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C];
        rw [ Multiset.count_map ];
        rw [ show Polynomial.rootMultiplicity x ( p.comp ( Polynomial.X + Polynomial.C c ) ) = Polynomial.rootMultiplicity ( x + c ) p from ?_ ];
