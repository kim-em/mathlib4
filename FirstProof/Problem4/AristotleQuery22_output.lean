      rw [ ← eq_sub_iff_add_eq' ] at h_sum ; subst_vars ; nlinarith [ sq_nonneg ( r1 - r2 - ( s1 - s2 ) ), sq_nonneg ( r1 - r2 + ( s1 - s2 ) ) ] ;

/-
Formula for Phi of a reduced cubic polynomial X³ + aX + b.
-/
lemma Phi_deg3_reduced_eq (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_nodup : (X^3 + C a * X + C b).roots.Nodup) :
  Phi (X^3 + C a * X + C b) = 18 * a^2 / (-4 * a^3 - 27 * b^2) := by
    have h_distinct : ∃ r1 r2 r3 : ℝ, r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r1 ∧ Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) := by
      obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) := by
        have h_card : Multiset.card (Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 3 := by
          rw [ Polynomial.splits_iff_card_roots ] at h_real;
          rw [ h_real, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ]
        obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = {r1, r2, r3} := by
          exact Multiset.card_eq_three.mp h_card;
        rw [ ← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq ( show Polynomial.Monic ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) from ?_ ) ];
        · exact ⟨ r1, r2, r3, by simpa [ hr, mul_assoc ] ⟩;
        · rw [ h_card, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
        · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
      use r1, r2, r3;
      rw [ hr ] at h_nodup; norm_num [ Polynomial.roots_mul, Polynomial.X_sub_C_ne_zero ] at h_nodup; aesop;
    obtain ⟨r1, r2, r3, hr⟩ := h_distinct
    have h_roots : Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = {r1, r2, r3} := by
      rw [ hr.2.2.2, Polynomial.roots_mul, Polynomial.roots_mul ];
      · norm_num;
      · exact mul_ne_zero ( mul_ne_zero ( Polynomial.C_ne_zero.mpr one_ne_zero ) ( Polynomial.X_sub_C_ne_zero _ ) ) ( Polynomial.X_sub_C_ne_zero _ );
      · exact mul_ne_zero ( mul_ne_zero ( mul_ne_zero ( Polynomial.C_ne_zero.mpr one_ne_zero ) ( Polynomial.X_sub_C_ne_zero r1 ) ) ( Polynomial.X_sub_C_ne_zero r2 ) ) ( Polynomial.X_sub_C_ne_zero r3 );
    have h_sum : r1 + r2 + r3 = 0 := by
      have h₁ := congr_arg ( Polynomial.eval 0 ) hr.2.2.2; have h₂ := congr_arg ( Polynomial.eval 1 ) hr.2.2.2; have h₃ := congr_arg ( Polynomial.eval ( -1 ) ) hr.2.2.2; norm_num at h₁ h₂ h₃; linarith;
    have h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a := by
      have := congr_arg ( Polynomial.eval 0 ) hr.2.2.2; norm_num at this; ( have := congr_arg ( Polynomial.eval 1 ) hr.2.2.2; norm_num at this; ( have := congr_arg ( Polynomial.eval ( -1 ) ) hr.2.2.2; norm_num at this; linarith; ) )
    have h_prod : r1 * r2 * r3 = -b := by
      replace hr := congr_arg ( Polynomial.eval 0 ) hr.2.2.2; norm_num at hr; linarith;
    have h_phi : Phi (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = (1 / (r1 - r2)^2 + 1 / (r1 - r3)^2 + 1 / (r2 - r1)^2 + 1 / (r2 - r3)^2 + 1 / (r3 - r1)^2 + 1 / (r3 - r2)^2) := by
      unfold Phi; simp_all +decide [ Finset.sum ] ;
      norm_num [ sq, sub_mul, mul_sub, add_mul, mul_add, hr ] ; ring;
      rw [ show -r1 + r2 = - ( r1 - r2 ) by ring, show -r1 + r3 = - ( r1 - r3 ) by ring, show -r2 + r3 = - ( r2 - r3 ) by ring, inv_neg, inv_neg, inv_neg ] ; ring;
      rw [ show - ( r1 * r2 * 2 ) + r1 ^ 2 + r2 ^ 2 = ( r1 - r2 ) ^ 2 by ring, show - ( r1 * r3 * 2 ) + r1 ^ 2 + r3 ^ 2 = ( r1 - r3 ) ^ 2 by ring, show - ( r2 * r3 * 2 ) + r2 ^ 2 + r3 ^ 2 = ( r2 - r3 ) ^ 2 by ring ] ; norm_num ; ring;
      grind;
    rw [ h_phi, div_add_div, div_add_div, div_add_div, div_add_div, div_add_div ] <;> try nlinarith [ mul_self_pos.2 ( sub_ne_zero.2 hr.1 ), mul_self_pos.2 ( sub_ne_zero.2 hr.2.1 ), mul_self_pos.2 ( sub_ne_zero.2 hr.2.2.1 ) ];
    · rw [ div_eq_div_iff ];
      · rw [ ← eq_sub_iff_add_eq' ] at h_sum ; subst_vars ; ring;
        grind +ring;
      · simp +decide [ sub_eq_iff_eq_add, hr ];
        tauto;
      · grind;
    · exact mul_ne_zero ( mul_ne_zero ( mul_ne_zero ( mul_ne_zero ( pow_ne_zero 2 ( sub_ne_zero_of_ne hr.1 ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) );
    · exact mul_ne_zero ( mul_ne_zero ( mul_ne_zero ( pow_ne_zero 2 ( sub_ne_zero_of_ne hr.1 ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) );
    · exact mul_ne_zero ( mul_ne_zero ( pow_ne_zero 2 ( sub_ne_zero_of_ne hr.1 ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) ) ) ( pow_ne_zero 2 ( sub_ne_zero_of_ne ( by tauto ) ) )

/-
The n=3 case of the Finite Free Stam Inequality for reduced cubics.
-/
theorem conjecture_n_3_reduced (a1 b1 a2 b2 : ℝ)
  (h_real1 : (X^3 + C a1 * X + C b1).Splits (RingHom.id ℝ))
  (h_nodup1 : (X^3 + C a1 * X + C b1).roots.Nodup)
  (h_real2 : (X^3 + C a2 * X + C b2).Splits (RingHom.id ℝ))
  (h_nodup2 : (X^3 + C a2 * X + C b2).roots.Nodup)
  (h_real3 : (X^3 + C (a1+a2) * X + C (b1+b2)).Splits (RingHom.id ℝ))
  (h_nodup3 : (X^3 + C (a1+a2) * X + C (b1+b2)).roots.Nodup) :
  invPhi (X^3 + C (a1+a2) * X + C (b1+b2)) ≥
  invPhi (X^3 + C a1 * X + C b1) + invPhi (X^3 + C a2 * X + C b2) := by
    -- Using the formula for the discriminant, we have:
    have h_discriminant : (-4 * a1^3 - 27 * b1^2) > 0 ∧ (-4 * a2^3 - 27 * b2^2) > 0 ∧ (-4 * (a1 + a2)^3 - 27 * (b1 + b2)^2) > 0 := by
      have h_discriminant_pos : ∀ (a b : ℝ), (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b).Splits (RingHom.id ℝ) → (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots.Nodup → -4 * a ^ 3 - 27 * b ^ 2 > 0 := by
        intros a b h_real h_nodup
        have h_discriminant_pos : ∃ r1 r2 r3 : ℝ, r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r1 ∧ r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a ∧ r1 * r2 * r3 = -b := by
          obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) := by
            have h_roots : Multiset.card (Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 3 := by
              rw [ Polynomial.splits_iff_card_roots ] at h_real;
              rw [ h_real, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
            obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = {r1, r2, r3} := by
              exact Multiset.card_eq_three.mp h_roots;
            rw [ ← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq ( show Polynomial.Monic ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) from ?_ ) ];
            · exact ⟨ r1, r2, r3, by simpa [ hr, mul_assoc ] ⟩;
            · rw [ h_roots, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
            · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha, Polynomial.coeff_eq_zero_of_natDegree_lt ];
          have h_roots : r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r1 := by
            rw [ hr ] at h_nodup; simp_all +decide [ Polynomial.roots_mul, Polynomial.X_sub_C_ne_zero ] ;
            tauto;
          exact ⟨ r1, r2, r3, h_roots.1, h_roots.2.1, h_roots.2.2, by have h₁ := congr_arg ( Polynomial.eval 0 ) hr; have h₂ := congr_arg ( Polynomial.eval 1 ) hr; have h₃ := congr_arg ( Polynomial.eval ( -1 ) ) hr; norm_num at h₁ h₂ h₃; linarith, by have h₁ := congr_arg ( Polynomial.eval 0 ) hr; have h₂ := congr_arg ( Polynomial.eval 1 ) hr; have h₃ := congr_arg ( Polynomial.eval ( -1 ) ) hr; norm_num at h₁ h₂ h₃; linarith, by have h₁ := congr_arg ( Polynomial.eval 0 ) hr; have h₂ := congr_arg ( Polynomial.eval 1 ) hr; have h₃ := congr_arg ( Polynomial.eval ( -1 ) ) hr; norm_num at h₁ h₂ h₃; linarith ⟩;
        obtain ⟨ r1, r2, r3, h1, h2, h3, h4, h5, h6 ⟩ := h_discriminant_pos; rw [ ← eq_sub_iff_add_eq' ] at h4; subst_vars; ring_nf;
        rw [ show b = r1 * r2 * ( r1 + r2 ) by linarith ] ; nlinarith [ mul_self_pos.mpr ( sub_ne_zero.mpr h1 ), mul_self_pos.mpr ( sub_ne_zero.mpr h2 ), mul_self_pos.mpr ( sub_ne_zero.mpr h3 ), mul_pos ( mul_self_pos.mpr ( sub_ne_zero.mpr h1 ) ) ( mul_self_pos.mpr ( sub_ne_zero.mpr h2 ) ), mul_pos ( mul_self_pos.mpr ( sub_ne_zero.mpr h1 ) ) ( mul_self_pos.mpr ( sub_ne_zero.mpr h3 ) ), mul_pos ( mul_self_pos.mpr ( sub_ne_zero.mpr h2 ) ) ( mul_self_pos.mpr ( sub_ne_zero.mpr h3 ) ) ] ;
      exact ⟨ h_discriminant_pos a1 b1 h_real1 h_nodup1, h_discriminant_pos a2 b2 h_real2 h_nodup2, h_discriminant_pos ( a1 + a2 ) ( b1 + b2 ) h_real3 h_nodup3 ⟩;
    -- Using the formula for the inverse Phi, we have:
    have h_invPhi_formula : ∀ a b : ℝ, (-4 * a^3 - 27 * b^2) > 0 → invPhi (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = (-4 * a^3 - 27 * b^2) / (18 * a^2) := by
      intros a b h_discriminant_pos
      have h_real : (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b).Splits (RingHom.id ℝ) := by
        rw [ Polynomial.splits_iff_card_roots ];
        -- Since the discriminant is positive, the polynomial has three distinct real roots.
        have h_distinct_roots : ∃ r1 r2 r3 : ℝ, r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r1 ∧ r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a ∧ r1 * r2 * r3 = -b := by
          obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a ∧ r1 * r2 * r3 = -b := by
            obtain ⟨r1, hr1⟩ : ∃ r1 : ℝ, r1^3 + a * r1 + b = 0 := by
              -- By the Intermediate Value Theorem, since the polynomial $X^3 + aX + b$ is continuous and changes sign, it must have at least one real root.
              have h_ivt : ∃ r ∈ Set.Icc (-|b| - |a| - 1) (|b| + |a| + 1), r^3 + a * r + b = 0 := by
                apply_rules [ intermediate_value_Icc ] <;> norm_num;
                · linarith [ abs_nonneg a, abs_nonneg b ];
                · fun_prop;
                · constructor <;> cases abs_cases b <;> cases abs_cases a <;> nlinarith [ sq_abs b, sq_abs a ];
              grind;
            use r1, (-r1 + Real.sqrt (r1^2 - 4 * (r1^2 + a))) / 2, (-r1 - Real.sqrt (r1^2 - 4 * (r1^2 + a))) / 2;
            ring_nf at *;
            rw [ Real.sq_sqrt ] <;> norm_num;
            · constructor <;> nlinarith [ sq_nonneg ( a + 3 * r1 ^ 2 ) ];
            · contrapose! h_discriminant_pos;
              rw [ show b = -r1 ^ 3 - r1 * a by linarith ] ; nlinarith [ sq_nonneg ( a + r1 ^ 2 * 3 ), sq_nonneg ( a - r1 ^ 2 * 3 ) ];
          use r1, r2, r3;
          refine' ⟨ _, _, _, hr ⟩ <;> rintro rfl <;> norm_num at *;
          · norm_num [ show r3 = -2 * r1 by linarith ] at *;
            norm_num [ show a = -3 * r1 ^ 2 by linarith, show b = 2 * r1 ^ 3 by linarith ] at * ; nlinarith [ sq_nonneg ( r1 ^ 2 ) ];
          · norm_num [ show r1 = -2 * r2 by linarith ] at *;
            bound;
          · norm_num [ show r2 = -2 * r3 by linarith ] at *;
            norm_num [ show a = -3 * r3 ^ 2 by linarith, show b = 2 * r3 ^ 3 by linarith ] at * ; nlinarith [ sq_nonneg ( r3 ^ 2 ) ];
        obtain ⟨ r1, r2, r3, h1, h2, h3, h4, h5, h6 ⟩ := h_distinct_roots; rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r1 ) * ( Polynomial.X - Polynomial.C r2 ) * ( Polynomial.X - Polynomial.C r3 ) by exact Polynomial.funext fun x => by norm_num; linear_combination h4 * x^2 - h5 * x + h6 ] ; erw [ Polynomial.natDegree_mul', Polynomial.natDegree_mul' ] <;> norm_num;
        rw [ Polynomial.roots_mul ( by exact mul_ne_zero ( mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_mul ( by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ) ] ; erw [ Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num
      have h_nodup : (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots.Nodup := by
        by_contra h_dup;
        rw [ Multiset.nodup_iff_count_le_one ] at h_dup;
        obtain ⟨x, hx⟩ : ∃ x : ℝ, Polynomial.eval x (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = 0 ∧ Polynomial.eval x (Polynomial.derivative (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 0 := by
          obtain ⟨x, hx⟩ : ∃ x : ℝ, Polynomial.rootMultiplicity x (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) ≥ 2 := by
            aesop;
          exact ⟨ x, by exact Polynomial.rootMultiplicity_pos ( by aesop ) |>.1 ( by linarith ), by exact Polynomial.isRoot_iterate_derivative_of_lt_rootMultiplicity hx ⟩;
        norm_num at hx;
        rw [ show b = -x ^ 3 - a * x by linarith ] at h_discriminant_pos ; rw [ show a = -3 * x ^ 2 by linarith ] at h_discriminant_pos ; nlinarith [ sq_nonneg ( x ^ 2 ) ];
      convert congr_arg ( fun x : ℝ => x⁻¹ ) ( Phi_deg3_reduced_eq a b h_real h_nodup ) using 1 ; ring;
      · unfold invPhi;
        have := roots_card_eq_natDegree ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) h_real ( by { exact Polynomial.Monic.def.mpr <| by { erw [ Polynomial.leadingCoeff ] ; erw [ Polynomial.natDegree_add_C ] ; erw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ] } } ) ; simp_all +decide [ add_comm, add_left_comm, add_assoc ] ;
        rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
      · rw [ inv_div ];
    by_cases ha1 : a1 = 0 <;> by_cases ha2 : a2 = 0 <;> simp_all +decide [ add_comm, add_left_comm, add_assoc ];
    · nlinarith;
    · nlinarith;
    · nlinarith;
    · rw [ show ( Polynomial.X ^ 3 + ( ( Polynomial.C : ℝ → ℝ[X] ) b1 + ( ( Polynomial.C : ℝ → ℝ[X] ) b2 + ( ( Polynomial.C : ℝ → ℝ[X] ) a1 + ( Polynomial.C : ℝ → ℝ[X] ) a2 ) * Polynomial.X ) ) ) = ( Polynomial.X ^ 3 + ( ( Polynomial.C : ℝ → ℝ[X] ) ( b1 + b2 ) + ( Polynomial.C : ℝ → ℝ[X] ) ( a1 + a2 ) * Polynomial.X ) ) by simpa using by ring ] ; rw [ h_invPhi_formula _ _ h_discriminant.2.2 ] ; rw [ div_add_div, div_le_div_iff₀ ] <;> try positivity;
      · -- Let's simplify the inequality.
        by_cases h_case : a1 * a2 > 0;
        · by_cases h_case : a1 < 0 ∧ a2 < 0;
          · nlinarith [ sq_nonneg ( a1 * b2 - a2 * b1 ), mul_le_mul_of_nonneg_left h_case.1.le ( sq_nonneg a2 ), mul_le_mul_of_nonneg_left h_case.2.le ( sq_nonneg a1 ), mul_le_mul_of_nonneg_left h_case.1.le ( sq_nonneg b2 ), mul_le_mul_of_nonneg_left h_case.2.le ( sq_nonneg b1 ), mul_le_mul_of_nonneg_left h_case.1.le ( sq_nonneg ( a1 + a2 ) ), mul_le_mul_of_nonneg_left h_case.2.le ( sq_nonneg ( a1 + a2 ) ) ];
          · exact False.elim <| h_case ⟨ by nlinarith [ sq_nonneg ( a1 - a2 ), mul_self_pos.2 ha1, mul_self_pos.2 ha2 ], by nlinarith [ sq_nonneg ( a1 - a2 ), mul_self_pos.2 ha1, mul_self_pos.2 ha2 ] ⟩;
        · by_cases h_case : a1 * a2 < 0;
          · nlinarith [ sq_nonneg ( a1 * b2 - a2 * b1 ), mul_pos ( neg_pos_of_neg h_case ) ( neg_pos_of_neg h_case ) ];
          · cases lt_or_gt_of_ne ( mul_ne_zero ha1 ha2 ) <;> linarith;
      · nlinarith [ mul_self_pos.2 ha1, mul_self_pos.2 ha2 ]

/-
For a centered quadratic polynomial X^2 + c with c < 0, invPhi is -2c.
-/
lemma invPhi_centered_quadratic (c : ℝ) (hc : c < 0) :
    invPhi (X^2 + C c) = -2 * c := by
      -- The roots of the polynomial $X^2 + c$ are $\sqrt{-c}$ and $-\sqrt{-c}$.
      have h_roots : (Polynomial.X ^ 2 + Polynomial.C c).roots.toFinset = {Real.sqrt (-c), -Real.sqrt (-c)} := by
        norm_num [ Finset.ext_iff ];
        exact fun x => ⟨ fun hx => eq_or_eq_neg_of_sq_eq_sq _ _ <| by linarith [ Real.mul_self_sqrt <| show 0 ≤ -c by linarith ], fun hx => by rcases hx with ( rfl | rfl ) <;> exact ⟨ by exact ne_of_apply_ne ( fun p => p.coeff 2 ) <| by norm_num [ Polynomial.coeff_eq_zero_of_natDegree_lt ], by linarith [ Real.mul_self_sqrt <| show 0 ≤ -c by linarith ] ⟩ ⟩;
      unfold invPhi;
      unfold Phi; norm_num [ Finset.sum_pair, h_roots ] ; ring;
      rw [ if_pos ];
      · rw [ Finset.sum_pair ] <;> norm_num [ hc.ne ] ; ring_nf;
        · rw [ Finset.sum_pair ] <;> norm_num [ hc.ne ] ; ring;
          · rw [ Finset.erase_eq_of_notMem ] <;> norm_num ; ring ; norm_num [ hc.le ];
            linarith [ Real.sqrt_pos.2 ( neg_pos.2 hc ) ];
          · linarith [ Real.sqrt_pos.2 ( neg_pos.2 hc ) ];
        · linarith [ Real.sqrt_pos.2 ( neg_pos.2 hc ) ];
      · rw [ show ( Polynomial.X ^ 2 + Polynomial.C c : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt ( -c ) ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt ( -c ) ) ) by exact Polynomial.funext fun x => by norm_num; linarith [ Real.mul_self_sqrt ( show 0 ≤ -c by linarith ) ] ] ; rw [ Polynomial.roots_mul <| by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ] ; erw [ Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num;
        linarith [ Real.sqrt_pos.2 ( neg_pos.2 hc ) ]

/-
Any monic polynomial of positive degree can be shifted to have zero trace (second highest coefficient).
-/
lemma exists_shift_centered (n : ℕ) (p : ℝ[X]) (hn : n > 0)
  (hp_monic : p.Monic) (hp_deg : p.natDegree = n) :
  ∃ c : ℝ, (p.comp (X + C c)).coeff (n - 1) = 0 := by
    -- Let $c = -\frac{p.coeff (n - 1)}{n}$.
    use -p.coeff (n - 1) / n;
    rw [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
    norm_num [ Polynomial.coeff_sum, Polynomial.coeff_X_add_C_pow ];
    rcases n with ( _ | _ | n ) <;> simp_all +decide [ Finset.sum_range_succ ];
    · have := hp_monic.coeff_natDegree; aesop;
    · norm_num [ Nat.choose_eq_zero_of_lt, Finset.sum_range, Nat.lt_succ_iff ];
      rw [ hp_deg.symm, hp_monic.coeff_natDegree ] ; norm_num [ Nat.cast_add_one_ne_zero ];
      rw [ div_mul_cancel₀ ] <;> linarith

/-
invPhi is invariant under translation.
-/
lemma invPhi_comp_add_C (p : ℝ[X]) (c : ℝ) :
  invPhi (p.comp (X + C c)) = invPhi p := by
    unfold invPhi;
    unfold Phi;
    rw [ show ( p.comp ( Polynomial.X + Polynomial.C c ) |> Polynomial.roots ) = ( p.roots.map fun x => x - c ) from ?_ ];
    · split_ifs <;> simp_all +decide [ sub_eq_iff_eq_add ];
      · rw [ Multiset.toFinset_map ];
        rw [ Finset.sum_image, Finset.sum_congr rfl ];
        · intro x hx; rw [ Finset.sum_image ] ; aesop;
          exact fun x hx y hy hxy => by simpa using hxy;
        · exact fun x hx y hy hxy => by simpa using hxy;
      · rw [ Multiset.nodup_iff_count_le_one ] at *;
        simp +zetaDelta at *;
        obtain ⟨ x, hx ⟩ := ‹∃ x, 1 < Polynomial.rootMultiplicity x p›; specialize ‹ ( ∀ a : ℝ, Multiset.count a ( Multiset.map ( fun x => x - c ) p.roots ) ≤ 1 ) ∧ 1 < p.roots.card›; have := ‹ ( ∀ a : ℝ, Multiset.count a ( Multiset.map ( fun x => x - c ) p.roots ) ≤ 1 ) ∧ 1 < p.roots.card›.1 ( x - c ) ; simp_all +decide [ Polynomial.rootMultiplicity_eq_zero ] ;
        rename_i h; specialize h; have := h.1 ( x - c ) ; simp_all +decide [ Multiset.count_map ] ;
        simp_all +decide [ eq_comm, Multiset.filter_eq ];
        grind;
      · simp_all +decide [ Multiset.nodup_map_iff_inj_on ];
    · ext x; simp +decide [ sub_eq_iff_eq_add ] ;
      -- By definition of polynomial composition, the roots of $p.comp (X + C c)$ are the roots of $p$ shifted by $-c$.
      have h_roots : Polynomial.rootMultiplicity x (p.comp (Polynomial.X + Polynomial.C c)) = Polynomial.rootMultiplicity (x + c) p := by
        rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
        norm_num [ add_assoc, Polynomial.comp_assoc ];
      rw [ Multiset.count_map ];
      rw [ show ( Multiset.filter ( fun a => x = a - c ) p.roots ) = Multiset.filter ( fun a => a = x + c ) p.roots by congr; ext; constructor <;> intro <;> linarith ] ; rw [ Multiset.filter_eq' ] ; aesop;

/-
The invPhi of the boxplus convolution is invariant under shifting the input polynomials.
-/
lemma invPhi_boxplus_shift_invariance (n : ℕ) (p q : ℝ[X]) (c d : ℝ)
  (hp : p.natDegree = n) (hq : q.natDegree = n) :
  invPhi (boxplus n (p.comp (X + C c)) (q.comp (X + C d))) = invPhi (boxplus n p q) := by
    rw [boxplus_comp_add_C n p q c d hp hq]
    rw [invPhi_comp_add_C]

/-
Explicit formula for boxplus of two reduced cubic polynomials.
-/
lemma boxplus_deg3_reduced_eq (p q : ℝ[X])
  (hp_monic : p.Monic) (hq_monic : q.Monic)
  (hp_deg : p.natDegree = 3) (hq_deg : q.natDegree = 3)
  (hp_red : p.coeff 2 = 0) (hq_red : q.coeff 2 = 0) :
  boxplus 3 p q = X^3 + C (p.coeff 1 + q.coeff 1) * X + C (p.coeff 0 + q.coeff 0) := by
    unfold boxplus;
    unfold boxplus_coeff;
    norm_num [ Finset.sum_range_succ', hp_deg, hq_deg, hp_red, hq_red ];
    simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
    ring

/-
Centered boxplus preserves centering.
-/
lemma boxplus_centered_is_centered (n : ℕ) (p q : ℝ[X])
  (hp : is_centered n p) (hq : is_centered n q) :
  is_centered n (boxplus n p q) := by
    obtain ⟨hp_monic, hp_deg, hp_zero⟩ := hp
    obtain ⟨hq_monic, hq_deg, hq_zero⟩ := hq
    simp [is_centered] at *;
    -- The leading coefficient of the boxplus convolution is 1, since it is a monic polynomial.
    have h_leading_coeff : (boxplus n p q).coeff n = 1 := by
      unfold boxplus; norm_num [ Polynomial.coeff_X_pow, Polynomial.coeff_C, hp_deg ] ;
      rw [ Finset.sum_eq_single 0 ] <;> norm_num [ boxplus_coeff ];
      · rw [ div_self <| by positivity, one_mul, ← hp_deg, hp_monic.coeff_natDegree, one_mul ];
        rw [ hp_deg, hq_deg.symm, hq_monic.coeff_natDegree ];
      · intros; omega;
    refine' ⟨ _, _, _ ⟩;
    · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
      exact h_leading_coeff;
      rw [ Polynomial.degree_eq_of_le_of_coeff_ne_zero ] <;> norm_num [ h_leading_coeff ];
      rw [ Polynomial.degree_le_iff_coeff_zero ];
      intro m hm; rw [ boxplus ] ; simp +decide [ Polynomial.coeff_sum, Polynomial.coeff_C_mul_X_pow ] ;
      exact Finset.sum_eq_zero fun x hx => if_neg ( by norm_cast at hm; omega );
    · refine' Polynomial.natDegree_eq_of_le_of_coeff_ne_zero _ _;
      · refine' Polynomial.natDegree_le_of_degree_le _;
        refine' le_trans ( Polynomial.degree_sum_le _ _ ) _;
        exact Finset.sup_le fun i hi => le_trans ( Polynomial.degree_C_mul_X_pow_le _ _ ) ( WithBot.coe_le_coe.mpr ( Nat.sub_le _ _ ) );
      · aesop;
    · rcases n with ( _ | _ | n ) <;> simp_all +decide [ boxplus_coeff ];
      · unfold boxplus; norm_num [ Polynomial.coeff_zero_eq_eval_zero ] ;
        unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', hp_deg, hq_deg, hp_zero, hq_zero ] ;
      · unfold boxplus at *; simp_all +decide [ Nat.choose_succ_succ, mul_assoc, mul_left_comm, Finset.sum_range_succ' ] ;
        rw [ Finset.sum_eq_zero ] <;> simp_all +decide [ Nat.ne_of_gt ];
        · unfold boxplus_coeff; simp_all +decide [ Nat.choose_succ_succ, mul_assoc, mul_left_comm, Finset.sum_range_succ' ] ;
        · intros; omega;

/-
Helper lemmas for the behavior of natDegree, roots, and Splits under composition with X + C c.
-/
lemma natDegree_comp_X_add_C (p : ℝ[X]) (c : ℝ) :
  (p.comp (X + C c)).natDegree = p.natDegree := by
    rw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, mul_one ]

lemma roots_comp_X_add_C (p : ℝ[X]) (c : ℝ) :
  (p.comp (X + C c)).roots = p.roots.map (fun x => x - c) := by
    ext x;
    rw [ Multiset.count_map ];
    -- The multiplicity of $x$ in the roots of $p.comp (X + C c)$ is equal to the multiplicity of $x + c$ in the roots of $p$.
    have h_mult : Polynomial.rootMultiplicity x (p.comp (Polynomial.X + Polynomial.C c)) = Polynomial.rootMultiplicity (x + c) p := by
      rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
      norm_num [ add_assoc, Polynomial.comp_assoc ];
    simp_all +decide [ eq_sub_iff_add_eq ];
    rw [ Multiset.filter_eq ] ; aesop

lemma splits_comp_X_add_C (p : ℝ[X]) (c : ℝ) :
  p.Splits (RingHom.id ℝ) ↔ (p.comp (X + C c)).Splits (RingHom.id ℝ) := by
    rw [ Polynomial.splits_iff_card_roots, Polynomial.splits_iff_card_roots ];
    rw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, mul_one ];
    -- By definition of polynomial composition, we have that the roots of $p.comp (X + C c)$ are the roots of $p$ shifted by $-c$.
    have h_roots : (p.comp (Polynomial.X + Polynomial.C c)).roots = Multiset.map (fun r => r - c) p.roots := by
      ext x;
      rw [ Multiset.count_map ];
      -- The multiplicity of $x$ in the roots of $p.comp (X + C c)$ is equal to the multiplicity of $x + c$ in the roots of $p$.
      have h_mult : Polynomial.rootMultiplicity x (p.comp (Polynomial.X + Polynomial.C c)) = Polynomial.rootMultiplicity (x + c) p := by
        rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
        norm_num [ add_assoc, Polynomial.comp_assoc ];
      simp_all +decide [ eq_sub_iff_add_eq ];
      rw [ Multiset.filter_eq ] ; aesop;
    aesop

/-
The Finite Free Stam Inequality holds for n=3.
-/
lemma finite_free_stam_inequality_n3 (p q : ℝ[X])
    (hp : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hp_monic : p.Monic) (hp_deg : p.natDegree = 3)
    (hq : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hq_monic : q.Monic) (hq_deg : q.natDegree = 3)
    (hpq : (boxplus 3 p q).Splits (RingHom.id ℝ))
    (hpq_nodup : (boxplus 3 p q).roots.Nodup) :
    invPhi (boxplus 3 p q) ≥ invPhi p + invPhi q := by
      -- By translation invariance, we can assume without loss of generality that $p$ and $q$ are centered.
      obtain ⟨c, hc⟩ : ∃ c : ℝ, (p.comp (X + C c)).coeff 2 = 0 := by
        have := exists_shift_centered 3 p ( by decide ) hp_monic hp_deg; aesop;
      obtain ⟨d, hd⟩ : ∃ d : ℝ, (q.comp (X + C d)).coeff 2 = 0 := by
        obtain ⟨d, hd⟩ : ∃ d : ℝ, (q.comp (X + C d)).coeff 2 = 0 := by
          have := exists_shift_centered 3 q (by norm_num) hq_monic hq_deg
          exact this;
        use d;
      -- By translation invariance, we can assume without loss of generality that $p$ and $q$ are centered, i.e., $p(x) = x^3 + ax + b$ and $q(x) = x^3 + cx + d$.
      obtain ⟨a, b, ha⟩ : ∃ a b : ℝ, p.comp (X + C c) = X^3 + C a * X + C b := by
        use (p.comp (X + C c)).coeff 1, (p.comp (X + C c)).coeff 0;
        ext x; rcases x with ( _ | _ | _ | _ | x ) <;> simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ] ;
        · rw [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ] ; norm_num [ Finset.sum_range_succ', hp_deg ];
          norm_num [ Polynomial.coeff_X, Polynomial.coeff_C, add_mul, pow_succ' ];
          rw [ ← hp_monic.coeff_natDegree, hp_deg ];
        · rw [ Polynomial.coeff_eq_zero_of_natDegree_lt ] ; erw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C ] ; linarith
      obtain ⟨c', d', hc'⟩ : ∃ c' d' : ℝ, q.comp (X + C d) = X^3 + C c' * X + C d' := by
        rw [ Polynomial.as_sum_range_C_mul_X_pow q ] at hd ⊢; norm_num [ Finset.sum_range_succ', Polynomial.natDegree_eq_of_degree_eq_some, hq_deg ] at hd ⊢;
        simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some, Polynomial.coeff_eq_zero_of_natDegree_lt ];
        norm_num [ Polynomial.coeff_X_add_C_pow ] at hd;
        exact ⟨ q.coeff 1 + 2 * d * q.coeff 2 + 3 * d ^ 2, q.coeff 0 + d * q.coeff 1 + d ^ 2 * q.coeff 2 + d ^ 3, Polynomial.funext fun x => by norm_num; rw [ show q.coeff 2 = -d * 3 by linarith ] ; ring ⟩;
      -- By translation invariance, we can assume without loss of generality that $p$ and $q$ are centered, i.e., $p(x) = x^3 + ax + b$ and $q(x) = x^3 + cx + d$. Thus, we can apply the lemma for reduced cubics.
      have h_reduced : invPhi (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))) ≥ invPhi (p.comp (X + C c)) + invPhi (q.comp (X + C d)) := by
        have h_reduced : Polynomial.Splits (RingHom.id ℝ) (p.comp (X + C c)) ∧ (p.comp (X + C c)).roots.Nodup ∧ Polynomial.Splits (RingHom.id ℝ) (q.comp (X + C d)) ∧ (q.comp (X + C d)).roots.Nodup ∧ Polynomial.Splits (RingHom.id ℝ) (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))) ∧ (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))).roots.Nodup := by
          have h_reduced : Polynomial.Splits (RingHom.id ℝ) (p.comp (X + C c)) ∧ (p.comp (X + C c)).roots.Nodup ∧ Polynomial.Splits (RingHom.id ℝ) (q.comp (X + C d)) ∧ (q.comp (X + C d)).roots.Nodup := by
            refine' ⟨ _, _, _, _ ⟩;
            · exact?;
            · rw [ roots_comp_X_add_C ];
              exact Multiset.Nodup.map ( fun x => by aesop ) hp_nodup;
            · exact?;
            · convert hq_nodup.map _ using 1;
              rotate_left;
              use fun x => x - d;
              · exact sub_left_injective;
              · exact?;
          have h_reduced : Polynomial.Splits (RingHom.id ℝ) (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))) ∧ (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))).roots.Nodup := by
            have h_shift : boxplus 3 (p.comp (X + C c)) (q.comp (X + C d)) = (boxplus 3 p q).comp (X + C (c + d)) := by
              convert boxplus_comp_add_C 3 p q c d _ _ using 1 <;> norm_num [ hp_deg, hq_deg ]
            rw [ h_shift ];
            refine' ⟨ _, _ ⟩;
            · exact?;
            · rw [ roots_comp_X_add_C ];
              exact Multiset.Nodup.map ( fun x => by aesop ) hpq_nodup;
          tauto;
        have h_reduced : boxplus 3 (p.comp (X + C c)) (q.comp (X + C d)) = X^3 + C (a + c') * X + C (b + d') := by
          convert boxplus_deg3_reduced_eq _ _ _ _ _ _ _ _ using 1 <;> norm_num [ ha, hc', hp_monic, hq_monic, hp_deg, hq_deg ];
          · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
          · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases hc' : c' = 0 <;> simp +decide [ hc' ];
          · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
          · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases hc' : c' = 0 <;> simp +decide [ hc' ];
        convert conjecture_n_3_reduced a b c' d' _ _ _ _ _ _ using 1 <;> aesop;
      convert h_reduced using 1;
      · convert invPhi_boxplus_shift_invariance 3 p q c d hp_deg hq_deg |> Eq.symm using 1;
      · rw [ invPhi_comp_add_C, invPhi_comp_add_C ]

/-
The Finite Free Stam Inequality holds for n=3.
-/
lemma finite_free_stam_inequality_n3_v2 (p q : ℝ[X])
    (hp : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hp_monic : p.Monic) (hp_deg : p.natDegree = 3)
    (hq : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hq_monic : q.Monic) (hq_deg : q.natDegree = 3)
    (hpq : (boxplus 3 p q).Splits (RingHom.id ℝ))
    (hpq_nodup : (boxplus 3 p q).roots.Nodup) :
    invPhi (boxplus 3 p q) ≥ invPhi p + invPhi q := by
      convert finite_free_stam_inequality_n3 p q hp hp_nodup hp_monic hp_deg hq hq_nodup hq_monic hq_deg hpq hpq_nodup using 1

/-
The Finite Free Stam Inequality holds for n=3.
-/
lemma finite_free_stam_inequality_n3_v3 (p q : ℝ[X])
    (hp : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hp_monic : p.Monic) (hp_deg : p.natDegree = 3)
    (hq : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hq_monic : q.Monic) (hq_deg : q.natDegree = 3)
    (hpq : (boxplus 3 p q).Splits (RingHom.id ℝ))
    (hpq_nodup : (boxplus 3 p q).roots.Nodup) :
    invPhi (boxplus 3 p q) ≥ invPhi p + invPhi q := by
      -- Apply the finite_free_stam_inequality_n3 lemma with the given hypotheses.
      apply finite_free_stam_inequality_n3 p q hp hp_nodup hp_monic hp_deg hq hq_nodup hq_monic hq_deg hpq hpq_nodup