  (t * (2 * x * (1 - 4 * x)) * (1 + 12 * Z) * (1 + 12 * y) +
   (1 - t) * (2 * y * (1 - 4 * y)) * (1 + 12 * Z) * (1 + 12 * x))

lemma poly_diff_symmetry (t x y : ℝ) :
    poly_diff t x y = poly_diff (1 - t) y x := by
  unfold poly_diff; ring;

