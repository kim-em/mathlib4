      · exact mul_ne_zero ( by contrapose! hx; linarith ) ( by contrapose! hy; linarith );
      · rwa [ mul_comm ];
      · contrapose! hy; linarith;
    · cases lt_or_gt_of_ne hZ_denom <;> nlinarith;
