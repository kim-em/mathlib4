  (boxplus n p q).coeff (n - 2) = p.coeff (n - 2) + q.coeff (n - 2) := by
  -- By definition of boxplus, the coefficient of $X^{n-2}$ in $p \boxplus q$ is given by the sum of the products of the coefficients of $X^{n-i}$ in $p$ and $X^{n-j}$ in $q$ where $i + j = 2$.
  have h_coeff : (boxplus n p q).coeff (n - 2) = ∑ i ∈ Finset.range (2 + 1), (Nat.factorial (n - i) * Nat.factorial (n - (2 - i))) / (Nat.factorial n * Nat.factorial (n - 2) : ℝ) * p.coeff (n - i) * q.coeff (n - (2 - i)) := by
    rcases n with ( _ | _ | n ) <;> simp_all +decide [ Finset.sum_range_succ ];
    · unfold is_centered at * ; aesop;
    · unfold boxplus; norm_num [ Finset.sum_range_succ' ] ; ring;
      unfold boxplus_coeff; norm_num [ Finset.sum_range_succ ] ; ring;
      cases hp ; cases hq ; aesop;
    · unfold boxplus;
      simp +decide [ Finset.sum_range_succ', Polynomial.coeff_C, Polynomial.coeff_X_pow ];
      rw [ Finset.sum_eq_zero ] <;> norm_num +decide [ Nat.factorial_ne_zero ];
      · unfold boxplus_coeff; norm_num [ Nat.factorial_succ, Finset.sum_range_succ' ] ; ring;
        field_simp;
        grind;
      · intros; omega;
  rcases n with ( _ | _ | n ) <;> simp_all +decide [ Finset.sum_range_succ' ];
  · cases hp ; cases hq ; aesop;
  · cases hp ; cases hq ; aesop;
  · simp_all +decide [ Nat.factorial_ne_zero, mul_comm, mul_assoc, mul_left_comm, div_eq_mul_inv ];
    simp_all +decide [ is_centered, Nat.factorial_succ ];
    have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; aesop;

lemma Phi_scaleRoots (p : ℝ[X]) (c : ℝ) (hc : c ≠ 0) :
  Phi (p.scaleRoots c) = c⁻¹ ^ 2 * Phi p := by
  unfold Phi;
  simp +zetaDelta at * ; simp_all +decide [ Polynomial.scaleRoots ];
  -- Let's simplify the expression using the fact that multiplication by a non-zero constant preserves the roots.
  have h_roots : (∑ i ∈ p.support, (Polynomial.monomial i : ℝ → ℝ[X]) (p.coeff i * c ^ (p.natDegree - i))).roots.toFinset = Finset.image (fun x => c * x) p.roots.toFinset := by
    -- By definition of polynomial multiplication and roots, we can show that the roots of the scaled polynomial are the scaled roots of the original polynomial.
    have h_roots_scaled : ∀ x, (∑ i ∈ p.support, (Polynomial.monomial i : ℝ → ℝ[X]) (p.coeff i * c ^ (p.natDegree - i))).eval x = c ^ p.natDegree * p.eval (x / c) := by
      simp +decide [ Polynomial.eval_finset_sum, Polynomial.eval_monomial ];
      intro x; rw [ Polynomial.eval_eq_sum, Polynomial.sum_def ] ; simp +decide [ mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _, hc ] ;
      field_simp;
      exact Finset.sum_congr rfl fun i hi => by rw [ div_pow, div_mul_eq_mul_div, div_mul_eq_mul_div, eq_div_iff ( pow_ne_zero _ hc ) ] ; rw [ show c ^ p.natDegree = c ^ ( p.natDegree - i ) * c ^ i by rw [ ← pow_add, Nat.sub_add_cancel ( Polynomial.le_natDegree_of_mem_supp _ hi ) ] ] ; ring;
    ext; simp [h_roots_scaled];
    constructor <;> intro h <;> simp_all +decide [ Polynomial.ext_iff ];
    · exact ⟨ _, ⟨ ⟨ Polynomial.natDegree p, by aesop ⟩, h.2 ⟩, mul_div_cancel₀ _ hc ⟩;
    · rcases h with ⟨ a, ⟨ ⟨ x, hx ⟩, hx' ⟩, rfl ⟩ ; simp_all +decide [ mul_div_cancel_left₀ ] ;
      use p.natDegree; simp_all +decide [ Polynomial.coeff_monomial ] ;
      aesop_cat;
  rw [ h_roots, Finset.sum_image ];
  · rw [ Finset.mul_sum _ _ _ ] ; refine' Finset.sum_congr rfl fun x hx => _ ; rw [ Finset.sum_image <| by aesop ] ; ring;
    simp +decide [ ← mul_sub, mul_pow, ← Finset.mul_sum _ _ _, ← Finset.sum_mul, hc ];
    ring;
  · exact fun x hx y hy hxy => mul_left_cancel₀ hc hxy

lemma boxplus_centered_coeff_add_3 (n : ℕ) (p q : ℝ[X])
  (hp : is_centered n p) (hq : is_centered n q)
  (hn : n ≥ 3) :
  (boxplus n p q).coeff (n - 3) = p.coeff (n - 3) + q.coeff (n - 3) := by
  -- The coefficient of $X^{n-3}$ in the boxplus is given by $boxplus_coeff n p q 3$.
  have h_coeff : (boxplus n p q).coeff (n - 3) = boxplus_coeff n p q 3 := by
    unfold boxplus;
    norm_num [ Polynomial.coeff_sum, Polynomial.coeff_C_mul_X_pow ];
    rw [ Finset.sum_eq_single 3 ] <;> norm_num;
    · intros; omega;
    · intros; linarith;
  rcases n with ( _ | _ | _ | n ) <;> simp_all +decide [ Finset.sum_range_succ', boxplus_coeff ];
  simp_all +decide [ Nat.factorial_ne_zero, mul_comm, mul_assoc, mul_left_comm, div_eq_mul_inv, is_centered ];
  have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; aesop;

lemma boxplus_centered_deg4_kappa4_additive (p q : ℝ[X])
  (hp : is_centered 4 p) (hq : is_centered 4 q) :
  let k4 := fun poly => poly.coeff 0 - 1/12 * (poly.coeff 2)^2
  k4 (boxplus 4 p q) = k4 p + k4 q := by
  unfold is_centered at *;
  unfold boxplus; norm_num [ Finset.sum_range_succ', hp, hq ] ; ring;
  unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', hp, hq ] ; ring;
  have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; simp_all +decide [ Polynomial.Monic.def ] ; ring;

lemma Phi_symmetric_quartic (A c : ℝ)
  (hA : A < 0) (hc : c > 0) (hD : A^2 - 4*c > 0) :
  Phi (X^4 + C A * X^2 + C c) = -A * (A^2 + 12*c) / (2*c * (A^2 - 4*c)) := by
  field_simp;
  -- Let $u, v$ be the roots of $y^2 + Ay + c = 0$.
  set u := (-A + Real.sqrt (A^2 - 4 * c)) / 2
  set v := (-A - Real.sqrt (A^2 - 4 * c)) / 2
  have hu_pos : 0 < u := by
    exact div_pos ( add_pos_of_pos_of_nonneg ( neg_pos_of_neg hA ) ( Real.sqrt_nonneg _ ) ) zero_lt_two
  have hv_pos : 0 < v := by
    exact div_pos ( sub_pos.mpr <| by rw [ Real.sqrt_lt' ] <;> nlinarith ) zero_lt_two
  have hu_ne_v : u ≠ v := by
    grind
  have h_roots : (Polynomial.X^4 + Polynomial.C A * Polynomial.X^2 + Polynomial.C c).roots.toFinset = {Real.sqrt u, -Real.sqrt u, Real.sqrt v, -Real.sqrt v} := by
    -- By definition of $u$ and $v$, we know that $y^2 + Ay + c = (y - u)(y - v)$.
    have h_factor : Polynomial.X^4 + Polynomial.C A * Polynomial.X^2 + Polynomial.C c = (Polynomial.X^2 - Polynomial.C u) * (Polynomial.X^2 - Polynomial.C v) := by
      simp +zetaDelta at *;
      exact Polynomial.funext fun x => by norm_num; cases le_or_gt x 0 <;> nlinarith [ Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - 4 * c by linarith ) ] ;
    rw [ h_factor, Polynomial.roots_mul ];
    · rw [ show ( Polynomial.X ^ 2 - Polynomial.C u : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt u ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt u ) ) by exact Polynomial.funext fun x => by norm_num; linarith [ Real.mul_self_sqrt hu_pos.le ], show ( Polynomial.X ^ 2 - Polynomial.C v : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt v ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt v ) ) by exact Polynomial.funext fun x => by norm_num; linarith [ Real.mul_self_sqrt hv_pos.le ] ];
      rw [ Polynomial.roots_mul ( by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_mul ( by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num;
      grind;
    · exact mul_ne_zero ( Polynomial.X_pow_sub_C_ne_zero ( by norm_num ) _ ) ( Polynomial.X_pow_sub_C_ne_zero ( by norm_num ) _ );
  -- Use the formula derived: $\Phi = (u+v) [ \frac{8}{(u-v)^2} + \frac{1}{2uv} ]$.
  have h_phi_formula : Phi (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c) = (u + v) * (8 / (u - v)^2 + 1 / (2 * u * v)) := by
    have h_phi_formula : Phi (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c) = ∑ r ∈ ({Real.sqrt u, -Real.sqrt u, Real.sqrt v, -Real.sqrt v} : Finset ℝ), ((Polynomial.derivative (Polynomial.derivative (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c))).eval r / (2 * (Polynomial.derivative (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c)).eval r))^2 := by
      convert Phi_derivative_form _ _ _ using 1;
      · rw [ h_roots ];
      · rw [ Polynomial.splits_iff_card_roots ];
        rw [ Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ Polynomial.natDegree_X_pow, Polynomial.natDegree_C, hA.ne, hc.ne' ];
        rw [ show ( Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt u ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt u ) ) * ( Polynomial.X - Polynomial.C ( Real.sqrt v ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt v ) ) from _ ];
        · rw [ Polynomial.roots_mul, Polynomial.roots_mul, Polynomial.roots_mul, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] <;> norm_num;
          · exact ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩;
          · exact ⟨ ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩, Polynomial.X_sub_C_ne_zero _ ⟩;
          · exact ⟨ ⟨ ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩, Polynomial.X_sub_C_ne_zero _ ⟩, Polynomial.X_add_C_ne_zero _ ⟩;
        · refine' Polynomial.funext fun x => _;
          norm_num +zetaDelta at *;
          ring_nf;
          rw [ show ( Real.sqrt 2 ) ⁻¹ ^ 4 = ( Real.sqrt 2 ) ⁻¹ ^ 2 * ( Real.sqrt 2 ) ⁻¹ ^ 2 by ring, inv_pow ] ; norm_num ; rw [ Real.sq_sqrt <| by nlinarith [ Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - c * 4 by linarith ) ], Real.sq_sqrt <| by nlinarith [ Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - c * 4 by linarith ) ] ] ; ring;
          rw [ Real.sq_sqrt ] <;> linarith;
      · refine' Multiset.nodup_iff_count_le_one.mpr _;
        intro x; by_cases hx : x ∈ Polynomial.roots ( Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c ) <;> simp_all +decide [ Polynomial.rootMultiplicity_eq_zero ] ;
        refine' Nat.le_of_not_lt fun h => _;
        -- If $x$ is a root of multiplicity greater than 1, then $x$ must also be a root of the derivative of the polynomial.
        have h_deriv_root : Polynomial.eval x (Polynomial.derivative (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c)) = 0 := by
          exact Polynomial.isRoot_iterate_derivative_of_lt_rootMultiplicity h;
        norm_num at h_deriv_root;
        grind;
    rw [ h_phi_formula, Finset.sum_insert, Finset.sum_insert, Finset.sum_insert, Finset.sum_singleton ] <;> norm_num;
    · field_simp;
      rw [ Real.sq_sqrt hu_pos.le, Real.sq_sqrt hv_pos.le ] ; ring;
      grind;
    · linarith [ Real.sqrt_pos.2 hv_pos ];
    · exact ⟨ by linarith [ Real.sqrt_pos.2 hu_pos, Real.sqrt_pos.2 hv_pos ], by rw [ Real.sqrt_inj hu_pos.le hv_pos.le ] ; contrapose! hu_ne_v; linarith ⟩;
    · exact ⟨ by linarith [ Real.sqrt_pos.2 hu_pos ], by rw [ Real.sqrt_inj hu_pos.le hv_pos.le ] ; aesop, by linarith [ Real.sqrt_pos.2 hu_pos, Real.sqrt_pos.2 hv_pos ] ⟩;
  convert congr_arg ( · * c * 2 ) h_phi_formula using 1 ; ring;
  field_simp [u, v]
  ring;
  rw [ show u = ( -A + Real.sqrt ( A^2 - 4 * c ) ) / 2 by rfl, show v = ( -A - Real.sqrt ( A^2 - 4 * c ) ) / 2 by rfl ] ; ring;
  rw [ inv_pow, Real.sq_sqrt ] <;> nlinarith [ mul_inv_cancel_left₀ ( by linarith : ( A ^ 2 - c * 4 ) ≠ 0 ) ( A * c ) ]

lemma quartic_denominator_superadditive (u1 u2 K1 K2 : ℝ)
  (hu1 : u1 > 0) (hu2 : u2 > 0)
  (hK1 : K1 > -u1^2/12) (hK2 : K2 > -u2^2/12) :
  let D := fun u K => u^3 + 6*u*K
  D (u1+u2) (K1+K2) ≥ D u1 K1 + D u2 K2 := by
  nlinarith [ sq_nonneg ( u1 - u2 ), mul_pos hu1 hu2 ]

lemma sum_sq_div_le_sum_sq_div (a b x y : ℝ) (hx : x > 0) (hy : y > 0) :
  (a + b)^2 / (x + y) ≤ a^2 / x + b^2 / y := by
  rw [ div_add_div, div_le_div_iff₀ ] <;> nlinarith [ sq_nonneg ( a * y - b * x ) ]

lemma invPhi_symmetric_quartic_expansion (A c : ℝ)
  (hA : A < 0) (hc : c > 0) (hD : A^2 - 4*c > 0) :
  let u := -A
  let K := c - u^2/12
  1 / Phi (X^4 + C A * X^2 + C c) = u/18 - 4*K^2 / (u^3 + 6*u*K) := by
  convert congr_arg _ (Phi_symmetric_quartic A c hA hc hD ) using 1 ; ring;
  field_simp;
  rw [ div_eq_div_iff ] <;> ring_nf <;> try nlinarith;
  nlinarith [ inv_mul_cancel_left₀ ( by nlinarith : ( -A ^ 2 - c * 12 ) ≠ 0 ) ( A * c ^ 2 ), inv_mul_cancel_left₀ ( by nlinarith : ( -A ^ 2 - c * 12 ) ≠ 0 ) ( A ^ 3 * c ), inv_mul_cancel_left₀ ( by nlinarith : ( -A ^ 2 - c * 12 ) ≠ 0 ) ( A ^ 5 ) ]

lemma n4_symmetric_inequality (u1 u2 K1 K2 : ℝ)
  (hu1 : u1 > 0) (hu2 : u2 > 0)
  (hK1_lower : K1 > -u1^2/12) (hK1_upper : K1 < u1^2/6)
  (hK2_lower : K2 > -u2^2/12) (hK2_upper : K2 < u2^2/6) :
  let F := fun u K => u/18 - 4*K^2 / (u^3 + 6*u*K)
  F (u1+u2) (K1+K2) ≥ F u1 K1 + F u2 K2 := by
  -- By `sum_sq_div_le_sum_sq_div`, $\frac{(K_1 + K_2)^2}{D(u_1, K_1) + D(u_2, K_2)} \le \frac{K_1^2}{D(u_1, K_1)} + \frac{K_2^2}{D(u_2, K_2)}$.
  have h_sum_sq_div : (K1 + K2)^2 / (u1^3 + 6 * u1 * K1 + u2^3 + 6 * u2 * K2) ≤ K1^2 / (u1^3 + 6 * u1 * K1) + K2^2 / (u2^3 + 6 * u2 * K2) := by
    convert sum_sq_div_le_sum_sq_div K1 K2 ( u1 ^ 3 + 6 * u1 * K1 ) ( u2 ^ 3 + 6 * u2 * K2 ) _ _ using 1 <;> ring_nf at * <;> nlinarith [ pow_pos hu1 3, pow_pos hu2 3 ] ;
  -- By `quartic_denominator_superadditive`, $D(u_1+u_2, K_1+K_2) \ge D(u_1, K_1) + D(u_2, K_2)$.
  have h_denom_superadd : u1^3 + 6 * u1 * K1 + u2^3 + 6 * u2 * K2 ≤ (u1 + u2)^3 + 6 * (u1 + u2) * (K1 + K2) := by
    nlinarith [ sq_nonneg ( u1 - u2 ), mul_pos hu1 hu2 ];
  -- Applying the inequality $\frac{(K_1 + K_2)^2}{D(u_1 + u_2, K_1 + K_2)} \le \frac{(K_1 + K_2)^2}{D(u_1, K_1) + D(u_2, K_2)} from `h_sum_sq_div`.
  have h_apply_sum_sq_div : (K1 + K2)^2 / ((u1 + u2)^3 + 6 * (u1 + u2) * (K1 + K2)) ≤ (K1 + K2)^2 / (u1^3 + 6 * u1 * K1 + u2^3 + 6 * u2 * K2) := by
    gcongr;
    nlinarith [ sq_pos_of_pos hu1, sq_pos_of_pos hu2 ];
  ring_nf at *; linarith;

lemma boxplus_symmetric_centered_is_symmetric_centered (p q : ℝ[X])
  (hp_centered : is_centered 4 p) (hq_centered : is_centered 4 q)
  (hp_sym : p.coeff 1 = 0) (hq_sym : q.coeff 1 = 0) :
  (boxplus 4 p q).coeff 1 = 0 := by
  convert boxplus_centered_coeff_add_3 4 p q hp_centered hq_centered using 1;
  grind

lemma symmetric_quartic_splits_nodup (A c : ℝ)
  (hA : A < 0) (hc : c > 0) (hD : A^2 - 4*c > 0) :
  (X^4 + C A * X^2 + C c).Splits (RingHom.id ℝ) ∧ (X^4 + C A * X^2 + C c).roots.Nodup := by
  -- Let $u, v$ be roots of $y^2 + Ay + c$.
  let u := (-A + Real.sqrt (A^2 - 4 * c)) / 2
  let v := (-A - Real.sqrt (A^2 - 4 * c)) / 2
  have huv : u > 0 ∧ v > 0 ∧ u ≠ v := by
    simp +zetaDelta at *;
    exact ⟨ by nlinarith [ Real.sqrt_nonneg ( A ^ 2 - 4 * c ), Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - 4 * c by linarith ) ], by nlinarith [ Real.sqrt_nonneg ( A ^ 2 - 4 * c ), Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - 4 * c by linarith ) ], by nlinarith [ Real.sqrt_nonneg ( A ^ 2 - 4 * c ), Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - 4 * c by linarith ) ] ⟩;
  -- The roots of the quartic are $\pm\sqrt{u}, \pm\sqrt{v}$.
  have h_roots : (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c) = Polynomial.C 1 * (Polynomial.X - Polynomial.C (Real.sqrt u)) * (Polynomial.X - Polynomial.C (-Real.sqrt u)) * (Polynomial.X - Polynomial.C (Real.sqrt v)) * (Polynomial.X - Polynomial.C (-Real.sqrt v)) := by
    refine' Polynomial.funext fun x => _ ; norm_num ; ring;
    grind;
  rw [ h_roots, Polynomial.splits_mul_iff, Polynomial.splits_mul_iff, Polynomial.splits_mul_iff ] <;> norm_num;
  any_goals exact ne_of_apply_ne Polynomial.derivative <| by norm_num [ Real.sqrt_nonneg ] ;
  · erw [ Polynomial.roots_mul, Polynomial.roots_mul, Polynomial.roots_mul ] <;> norm_num [ Polynomial.X_sub_C_ne_zero, Polynomial.X_add_C_ne_zero ];
    norm_num [ Polynomial.splits_iff_card_roots ];
    grind;
  · exact ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩;
  · exact ⟨ ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩, Polynomial.X_sub_C_ne_zero _ ⟩

lemma invPhi_val_symm (A c : ℝ)
  (hA : A < 0) (hc : c > 0) (hD : A^2 - 4*c > 0) :
  invPhi (X^4 + C A * X^2 + C c) = let u := -A; let K := c - u^2/12; u/18 - 4*K^2 / (u^3 + 6*u*K) := by
  convert invPhi_symmetric_quartic_expansion A c hA hc hD using 1;
  unfold invPhi;
  rw [ if_pos ];
  exact symmetric_quartic_splits_nodup A c hA hc hD |> fun h => ⟨ h.2, by exact ( by have := Polynomial.natDegree_eq_card_roots h.1; norm_num [ Polynomial.natDegree_add_eq_left_of_natDegree_lt, hA.ne, hc.ne', hD.ne' ] at *; linarith ) ⟩

def quartic_discriminant (A B C_coeff : ℝ) : ℝ :=
  256*C_coeff^3 - 128*A^2*C_coeff^2 + 144*A*B^2*C_coeff - 27*B^4 - 4*A^3*B^2 + 16*A^4*C_coeff

def quartic_has_distinct_real_roots (A B C_coeff : ℝ) : Prop :=
  (X^4 + C A * X^2 + C B * X + C C_coeff).Splits (RingHom.id ℝ) ∧
  (X^4 + C A * X^2 + C B * X + C C_coeff).roots.Nodup

def quartic_coeffs_from_cumulants (k2 k3 k4 : ℝ) : ℝ × ℝ × ℝ :=
  let A := 12 * k2
  let B := 24 * k3
  let C_coeff := 24 * k4 + 12 * k2^2
  (A, B, C_coeff)

def quartic_cumulant_domain (k2 k3 k4 : ℝ) : Prop :=
  let (A, B, C_coeff) := quartic_coeffs_from_cumulants k2 k3 k4
  k2 < 0 ∧ quartic_has_distinct_real_roots A B C_coeff

/-
Lemma stating that `Phi` is invariant under `p(-x)`, and consequently Phi for a quartic is even in the linear coefficient B.
-/
lemma roots_comp_neg_X_eq_roots_scaleRoots (p : ℝ[X]) :
  (p.comp (-X)).roots = (p.scaleRoots (-1)).roots := by
    ext x; exact (by
    -- By definition of polynomial composition and scaling, if $x$ is a root of $p(-x)$, then $-x$ is a root of $p(x)$.
    have h_root : Polynomial.eval x (p.comp (-Polynomial.X)) = 0 ↔ Polynomial.eval (-x) p = 0 := by
      norm_num +zetaDelta at *
    have h_root_scale : Polynomial.eval x (p.scaleRoots (-1)) = 0 ↔ Polynomial.eval (-x) p = 0 := by
      -- By definition of polynomial scaling, we have that Polynomial.eval x (p.scaleRoots (-1)) = (-1)^p.natDegree * Polynomial.eval (-x) p.
      have h_scale_def : Polynomial.eval x (p.scaleRoots (-1)) = (-1 : ℝ) ^ p.natDegree * Polynomial.eval (-x) p := by
        rw [ Polynomial.eval_eq_sum_range ] ; rw [ Polynomial.eval_eq_sum_range ] ; simp +decide [ Polynomial.natDegree_scaleRoots, Polynomial.coeff_scaleRoots ] ; ring;
        rw [ Finset.sum_mul _ _ _ ] ; refine' Finset.sum_congr rfl fun i hi => _ ; rw [ show ( -1 : ℝ ) ^ ( p.natDegree - i ) = ( -1 : ℝ ) ^ p.natDegree / ( -1 : ℝ ) ^ i by rw [ eq_div_iff ( pow_ne_zero _ <| by norm_num ), ← pow_add, Nat.sub_add_cancel <| by linarith [ Finset.mem_range.mp hi ] ] ] ; ring;
        norm_num [ mul_assoc ]
      rw [h_scale_def]
      simp [mul_eq_zero]
    have h_count : Multiset.count x (p.comp (-Polynomial.X)).roots = Multiset.count (-x) p.roots := by
      have h_count : Polynomial.rootMultiplicity x (p.comp (-Polynomial.X)) = Polynomial.rootMultiplicity (-x) p := by
        have h_root_scale : ∀ k : ℕ, (Polynomial.X - Polynomial.C x)^k ∣ p.comp (-Polynomial.X) ↔ (Polynomial.X - Polynomial.C (-x))^k ∣ p := by
          intros k
          constructor
          intro h_div
          have h_div_scale : (Polynomial.X - Polynomial.C (-x))^k ∣ p := by
            obtain ⟨ q, hq ⟩ := h_div; replace hq := congr_arg ( Polynomial.comp · ( -Polynomial.X ) ) hq; simp_all +decide [ Polynomial.comp_assoc ] ;
            exact dvd_mul_of_dvd_left ( by rw [ ← neg_add', neg_pow ] ; norm_num ) _;
          exact h_div_scale
          intro h_div
          have h_div_comp : (Polynomial.X - Polynomial.C x)^k ∣ p.comp (-Polynomial.X) := by
            obtain ⟨ q, hq ⟩ := h_div; simp_all +decide [ Polynomial.comp_assoc ] ;
            exact dvd_mul_of_dvd_left ( by rw [ show -Polynomial.X + Polynomial.C x = - ( Polynomial.X - Polynomial.C x ) by ring, neg_pow ] ; norm_num ) _
          exact h_div_comp;
        rw [ Polynomial.rootMultiplicity_eq_multiplicity, Polynomial.rootMultiplicity_eq_multiplicity ];
        split_ifs <;> simp_all +decide [ multiplicity ];
        · rw [ Polynomial.comp_eq_zero_iff ] at * ; aesop;
        · rw [ emultiplicity, emultiplicity ];
          simp_all +decide [ FiniteMultiplicity ];
      rw [ Polynomial.count_roots, Polynomial.count_roots ] ; aesop;
    have h_count_scale : Multiset.count x (p.scaleRoots (-1)).roots = Multiset.count (-x) p.roots := by
      by_cases h : p = 0 <;> simp_all +decide [ Polynomial.scaleRoots ];
      rw [ show ( ∑ i ∈ p.support, Polynomial.monomial i ( p.coeff i * ( -1 ) ^ ( p.natDegree - i ) ) ) = p.comp ( -Polynomial.X ) * Polynomial.C ( ( -1 ) ^ p.natDegree ) from ?_, Polynomial.rootMultiplicity_mul ] <;> norm_num [ h ];
      · by_cases h : Even p.natDegree <;> simp_all +decide [ Polynomial.rootMultiplicity_eq_zero ];
      · rw [ Polynomial.comp_eq_zero_iff ] ; aesop;
      · conv_rhs => rw [ Polynomial.comp, Polynomial.eval₂_eq_sum, Polynomial.sum_def ] ; simp +decide [ ← Polynomial.C_mul_X_pow_eq_monomial ] ; ring;
        rw [ Finset.sum_mul _ _ _ ] ; refine' Finset.sum_congr rfl fun i hi => _ ; rw [ ← Nat.sub_add_cancel ( Polynomial.le_natDegree_of_mem_supp _ hi ) ] ; ring;
        norm_num [ pow_mul', ← Polynomial.C_mul_X_pow_eq_monomial ] ; ring
    rw [h_count, h_count_scale]);

lemma Phi_comp_neg_X (p : ℝ[X]) : Phi (p.comp (-X)) = Phi p := by
  unfold Phi;
  rw [ show ( p.comp ( -Polynomial.X ) |> Polynomial.roots |> Multiset.toFinset ) = Finset.image ( fun x => -x ) ( p.roots.toFinset ) from ?_, Finset.sum_image ] <;> norm_num;
  · refine' Finset.sum_congr rfl fun x hx => _;
    rw [ show ( Multiset.map ( fun x => -x ) p.roots |> Multiset.toFinset |> Finset.erase ) ( -x ) = Finset.image ( fun x => -x ) ( p.roots.toFinset.erase x ) from ?_, Finset.sum_image ] <;> norm_num;
    · field_simp;
      rw [ ← Finset.sum_congr rfl fun y hy => by rw [ ← neg_div_neg_eq, neg_add_eq_sub ] ] ; norm_num [ neg_div, div_neg ] ;
    · ext; aesop;
  · ext; simp +decide [ Polynomial.comp_assoc ] ;
    rw [ Polynomial.comp_eq_zero_iff ] ; aesop

lemma Phi_quartic_even_in_B (A B C_coeff : ℝ) :
  Phi (X^4 + C A * X^2 + C B * X + C C_coeff) = Phi (X^4 + C A * X^2 + C (-B) * X + C C_coeff) := by
    -- Let's rewrite the goal using the definition of `Phi`.
    unfold Phi;
    rw [ ← Finset.sum_bij ( fun r hr => -r ) ];
    · norm_num +zetaDelta at *;
      exact fun a ha₁ ha₂ => ⟨ by exact ne_of_apply_ne ( fun p => p.coeff 4 ) ( by norm_num [ Polynomial.coeff_X, Polynomial.coeff_C ] ), ha₂ ⟩;
    · aesop;
    · simp +zetaDelta at *;
      exact fun b hb hb' => ⟨ -b, ⟨ by exact ne_of_apply_ne ( fun p => p.coeff 4 ) <| by norm_num [ Polynomial.coeff_X, Polynomial.coeff_C ], by linarith ⟩, by ring ⟩;
    · intro a ha
      have h_erase : (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C (-B) * Polynomial.X + Polynomial.C C_coeff).roots.toFinset.erase a = Finset.image (fun r => -r) ((Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C B * Polynomial.X + Polynomial.C C_coeff).roots.toFinset.erase (-a)) := by
        ext; simp [Finset.mem_image];
        constructor;
        · exact fun h => ⟨ -‹_›, ⟨ by aesop, by exact ne_of_apply_ne ( fun p => p.coeff 4 ) <| by norm_num [ Polynomial.coeff_X, Polynomial.coeff_C ], by linarith ⟩, by ring ⟩;
        · rintro ⟨ b, ⟨ hb₁, hb₂, hb₃ ⟩, rfl ⟩ ; exact ⟨ by contrapose! hb₁; linarith, by exact ne_of_apply_ne ( fun p => p.coeff 4 ) <| by norm_num [ Polynomial.coeff_X, Polynomial.coeff_C ], by linarith ⟩;
      rw [ h_erase, Finset.sum_image ];
      · rw [ ← Finset.sum_congr rfl fun x hx => by rw [ ← neg_div_neg_eq ] ] ; norm_num [ neg_div, div_neg ];
        exact congr_arg ( · ^ 2 ) ( Finset.sum_congr rfl fun x hx => by ring );
      · aesop_cat

/-
If two polynomials have the same roots (as multisets), they have the same `Phi` value.
-/
lemma Phi_eq_of_roots_eq {p q : ℝ[X]} (h : p.roots = q.roots) : Phi p = Phi q := by
  unfold Phi
  rw [h]

/-
The coefficient of the i-th term of p(-X) is (-1)^i times the coefficient of the i-th term of p.
-/
lemma coeff_comp_neg_X (p : ℝ[X]) (i : ℕ) :
  (p.comp (-X)).coeff i = (-1 : ℝ)^i * p.coeff i := by
  norm_num [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
  rw [ Finset.sum_eq_single i ] <;> norm_num;
  · ring_nf;
    by_cases hi : Even i <;> aesop;
  · ring_nf;
    intro b hb hbi; by_cases hi : Even b <;> aesop;
  · exact fun hi => Or.inl <| Polynomial.coeff_eq_zero_of_natDegree_lt hi

/-
`p.scaleRoots (-1)` is equal to `(-1)^n * p(-X)`.
-/
lemma scaleRoots_neg_one_eq (p : ℝ[X]) :
  p.scaleRoots (-1) = C ((-1 : ℝ) ^ p.natDegree) * p.comp (-X) := by
    ext i; rw [ Polynomial.coeff_scaleRoots ] ; by_cases hi : i ≤ p.natDegree <;> simp +decide [ *, Polynomial.coeff_eq_zero_of_natDegree_lt ] ; ring;
    · rw [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
      rw [ Finset.sum_mul, Polynomial.finset_sum_coeff ];
      rw [ Finset.sum_eq_single i ] <;> norm_num ; ring;
      · by_cases hi' : Even i <;> by_cases hi'' : Even p.natDegree <;> simp_all +decide [ Nat.even_sub hi ];
        · simp_all +decide [ Nat.even_sub hi, parity_simps ];
        · cases le_iff_exists_add'.mp hi ; simp_all +decide [ parity_simps ];
          by_cases hi''' : Even ‹_› <;> simp_all +decide [ parity_simps ];
          exact False.elim <| Nat.not_even_iff_odd.mpr hi' hi'';
        · cases hi'' ; cases hi' ; simp_all +decide [ Nat.even_sub hi ];
          norm_num [ ← mul_tsub ];
      · intro j hj₁ hj₂; ring_nf;
        by_cases hi' : Even j <;> by_cases hj' : Even p.natDegree <;> aesop;
      · exact fun h => False.elim <| h.not_lt <| Nat.lt_succ_of_le hi;
    · simp +zetaDelta at *;
      rw [ Polynomial.coeff_eq_zero_of_natDegree_lt hi, Polynomial.coeff_eq_zero_of_natDegree_lt ] ; aesop;
      by_cases h : Even p.natDegree <;> simp_all +decide [ Polynomial.natDegree_comp, Polynomial.natDegree_neg ]

/-
Phi is invariant under negating the variable of the polynomial.
-/
lemma Phi_comp_neg_X_eq (p : ℝ[X]) : Phi (p.comp (-X)) = Phi p := by
  by_cases hp : p = 0
  · subst hp; simp [Phi]
  · have h_roots : (p.comp (-X)).roots = (p.scaleRoots (-1)).roots := roots_comp_neg_X_eq_roots_scaleRoots p
    rw [Phi_eq_of_roots_eq h_roots]
    rw [Phi_scaleRoots p (-1)]
    · norm_num
    · norm_num

/-
The roots of `p.scaleRoots (-1)` are the same as the roots of `p.comp (-X)`.
-/
lemma roots_scaleRoots_neg_one (p : ℝ[X]) :
  (p.scaleRoots (-1)).roots = (p.comp (-X)).roots := by
  rw [scaleRoots_neg_one_eq]
  rw [Polynomial.roots_C_mul]
  norm_num

/-
Phi for a quartic polynomial is even in the linear coefficient B.
-/
lemma Phi_quartic_even_in_B_eq (A B C_coeff : ℝ) :
  Phi (X^4 + C A * X^2 + C B * X + C C_coeff) = Phi (X^4 + C A * X^2 + C (-B) * X + C C_coeff) := by
  let p := X^4 + C A * X^2 + C B * X + C C_coeff
  have h_neg : p.comp (-X) = X^4 + C A * X^2 + C (-B) * X + C C_coeff := by
    simp [p]
    ring
  rw [← h_neg, Phi_comp_neg_X_eq]

/-
A symmetric quintic with appropriate coefficients splits and has distinct roots.
-/
lemma symmetric_quintic_splits_nodup (A C_coeff : ℝ)
  (hA : A < 0) (hC : C_coeff > 0) (hD : A^2 - 4*C_coeff > 0) :
  let p := X^5 + C A * X^3 + C C_coeff * X
  p.Splits (RingHom.id ℝ) ∧ p.roots.Nodup := by
    -- By definition of $p$, we know that its roots are the roots of $X$ and the roots of $X^4 + A X^2 + C_coeff$.
    have h_roots : (Polynomial.X ^ 5 + Polynomial.C A * Polynomial.X ^ 3 + Polynomial.C C_coeff * Polynomial.X).roots = {0} + (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C C_coeff).roots := by
      rw [ show ( Polynomial.X ^ 5 + Polynomial.C A * Polynomial.X ^ 3 + Polynomial.C C_coeff * Polynomial.X : Polynomial ℝ ) = Polynomial.X * ( Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C C_coeff ) by ring, Polynomial.roots_mul ] <;> norm_num;
      exact ne_of_apply_ne ( Polynomial.eval 0 ) ( by norm_num; linarith );
    have h_quartic_splits_nodup : (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C C_coeff).Splits (RingHom.id ℝ) ∧ (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C C_coeff).roots.Nodup := by
      exact?;
    simp_all +decide [ Polynomial.splits_iff_card_roots ];
    rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ Polynomial.natDegree_add_eq_left_of_natDegree_lt, hA.ne, hC.ne' ]

/-
Formula for Phi of a symmetric quintic polynomial.
-/
lemma Phi_symmetric_quintic (A C_coeff : ℝ)
  (hA : A < 0) (hC : C_coeff > 0) (hD : A^2 - 4*C_coeff > 0) :
  Phi (X^5 + C A * X^3 + C C_coeff * X) = (20*A*C_coeff - 9*A^3) / (2*C_coeff*(A^2 - 4*C_coeff)) := by
  rw [ Phi_derivative_form ];
  · -- The roots of the polynomial are $0$, $\pm \sqrt{u}$, and $\pm \sqrt{v}$, where $u$ and $v$ are the roots of $y^2 + Ay + C_coeff = 0$.
    obtain ⟨u, v, hu, hv, huv⟩ : ∃ u v : ℝ, u > 0 ∧ v > 0 ∧ u + v = -A ∧ u * v = C_coeff := by
      exact ⟨ ( -A + Real.sqrt ( A^2 - 4 * C_coeff ) ) / 2, ( -A - Real.sqrt ( A^2 - 4 * C_coeff ) ) / 2, by nlinarith [ Real.sqrt_nonneg ( A^2 - 4 * C_coeff ), Real.mul_self_sqrt hD.le ], by nlinarith [ Real.sqrt_nonneg ( A^2 - 4 * C_coeff ), Real.mul_self_sqrt hD.le ], by ring, by linarith [ Real.mul_self_sqrt hD.le ] ⟩;
    -- The roots of the polynomial are $0$, $\pm \sqrt{u}$, and $\pm \sqrt{v}$.
    have h_roots : (Polynomial.X ^ 5 + Polynomial.C A * Polynomial.X ^ 3 + Polynomial.C C_coeff * Polynomial.X).roots.toFinset = {0, Real.sqrt u, -Real.sqrt u, Real.sqrt v, -Real.sqrt v} := by
      ext x; simp [huv];
      constructor <;> intro hx
      all_goals generalize_proofs at *;
      · -- If $x \neq 0$, then $x^4 + A x^2 + C_coeff = 0$, which implies $x^2 = u$ or $x^2 = v$.
        have h_quad : x^4 + A * x^2 + C_coeff = 0 → x^2 = u ∨ x^2 = v := by
          exact fun h => Classical.or_iff_not_imp_left.2 fun h' => mul_left_cancel₀ ( sub_ne_zero_of_ne h' ) <| by nlinarith;
        by_cases hx_zero : x = 0 <;> simp_all +decide [ pow_succ, mul_assoc ];
        rcases h_quad ( mul_left_cancel₀ hx_zero <| by linarith ) with h | h <;> [ exact Or.imp id ( Or.inl ) ( eq_or_eq_neg_of_sq_eq_sq _ _ <| by rw [ Real.sq_sqrt hu.le ] ; linarith ) ; exact Or.inr <| Or.inr <| eq_or_eq_neg_of_sq_eq_sq _ _ <| by rw [ Real.sq_sqrt hv.le ] ; linarith ] ;
      · refine' ⟨ ne_of_apply_ne ( fun p => p.coeff 5 ) _, _ ⟩ <;> norm_num [ Polynomial.coeff_X, Polynomial.coeff_C ];
        grind;
    rw [ h_roots, Finset.sum_insert, Finset.sum_insert, Finset.sum_insert, Finset.sum_insert ] <;> norm_num;
    · rw [ show ( Real.sqrt u ) ^ 4 = ( Real.sqrt u ^ 2 ) ^ 2 by ring, show ( Real.sqrt v ) ^ 4 = ( Real.sqrt v ^ 2 ) ^ 2 by ring, Real.sq_sqrt hu.le, Real.sq_sqrt hv.le ] ; ring;
      rw [ show Real.sqrt u ^ 4 = ( Real.sqrt u ^ 2 ) ^ 2 by ring, show Real.sqrt u ^ 6 = ( Real.sqrt u ^ 2 ) ^ 3 by ring, show Real.sqrt v ^ 4 = ( Real.sqrt v ^ 2 ) ^ 2 by ring, show Real.sqrt v ^ 6 = ( Real.sqrt v ^ 2 ) ^ 3 by ring, Real.sq_sqrt hu.le, Real.sq_sqrt hv.le ] ; ring;
      rw [ show A = -u - v by linarith ] ; rw [ show C_coeff = u * v by linarith ] ; ring;
      field_simp;
      grind;
    · linarith [ Real.sqrt_pos.2 hv ];
    · exact ⟨ by linarith [ Real.sqrt_pos.2 hu, Real.sqrt_pos.2 hv ], by rw [ Real.sqrt_inj hu.le hv.le ] ; nlinarith ⟩;
    · exact ⟨ by linarith [ Real.sqrt_pos.2 hu ], by rw [ Real.sqrt_inj hu.le hv.le ] ; nlinarith, by linarith [ Real.sqrt_pos.2 hu, Real.sqrt_pos.2 hv ] ⟩;
    · exact ⟨ by positivity, by positivity, by positivity, by positivity ⟩;
  · convert symmetric_quintic_splits_nodup A C_coeff hA hC hD |>.1 using 1;
  · convert symmetric_quintic_splits_nodup A C_coeff hA hC hD |>.2 using 1

/-
Algebraic identity for the sum of terms in the Phi formula for a symmetric quintic.
-/
lemma quintic_algebra_identity (A C_coeff u v : ℝ)
  (hu : u ≠ 0) (hv : v ≠ 0) (hC : C_coeff ≠ 0)
  (hsum : u + v = -A) (hprod : u * v = C_coeff) :
  (10*u + 3*A)^2 / u + (10*v + 3*A)^2 / v = (20*A*C_coeff - 9*A^3) / C_coeff := by
    grind

/-
Numerator of the Phi formula for a general centered quartic.
-/
def Phi_quartic_numerator (A C_coeff : ℝ) : ℝ :=
  -8 * A * (A^2 - 4 * C_coeff) * (A^2 + 12 * C_coeff)

/-
Discriminant of a cubic polynomial in terms of elementary symmetric polynomials.
-/
def cubic_discriminant_e (e1 e2 e3 : ℝ) : ℝ :=
  e1^2 * e2^2 - 4 * e2^3 - 4 * e1^3 * e3 - 27 * e3^2 + 18 * e1 * e2 * e3

/-
Definitions for partial discriminant, Phi sum, and elementary symmetric polynomials e2 and e3.
-/
def partial_discriminant (r_i A B : ℝ) : ℝ :=
  let e1 := -r_i
  let e2 := A + r_i^2
  let e3 := -B - A * r_i - r_i^3
  cubic_discriminant_e e1 e2 e3

def Phi_Disc_sum (A B : ℝ) (r : Fin 4 → ℝ) : ℝ :=
  ∑ i, (6 * (r i)^2 + A)^2 * partial_discriminant (r i) A B

def e2_sum (r : Fin 4 → ℝ) : ℝ :=
  ∑ i, ∑ j, if i < j then r i * r j else 0

def e3_sum (r : Fin 4 → ℝ) : ℝ :=
  ∑ i, ∑ j, ∑ k, if i < j ∧ j < k then r i * r j * r k else 0

/-
Algebraic identity for the symmetric case (B=0).
-/
lemma Phi_Disc_sum_eq_Num_symm (A C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_e3 : e3_sum r = 0) -- B=0
  (h_prod : ∏ i, r i = C_coeff) :
  Phi_Disc_sum A 0 r = Phi_quartic_numerator A C_coeff := by
  -- Expand definitions
  unfold Phi_Disc_sum Phi_quartic_numerator partial_discriminant cubic_discriminant_e
  -- We need to expand the sums over Fin 4.
  -- Since r is abstract, we can't evaluate the sums to numbers.
  -- But we can use the properties of symmetric polynomials.
  -- However, since we don't have a library for that, we might need to rely on `ring` doing the heavy lifting
  -- after we substitute the relations.
  -- But `ring` doesn't know about `e2_sum r = A`.
  -- We need to rewrite `A` and `C_coeff` in terms of `r` in the RHS.
  rw [← h_e2, ← h_prod]
  -- Now both sides are polynomials in `r`.
  -- We need to show they are equal given `sum r = 0` and `e3_sum r = 0`.
  -- This is still hard for `ring` because of the constraints.
  -- We can try to substitute `r 3 = -r 0 - r 1 - r 2` (using `h_sum`).
  -- And then use `h_e3` to substitute something else?
  -- Maybe just `nlinarith` or `grind`?
  simp_all +decide [ Fin.sum_univ_four, Fin.prod_univ_four, e2_sum, e3_sum ];
  grind +ring

/-
Simplified formula for partial discriminant in the symmetric case.
-/
lemma partial_discriminant_symm_val (r A : ℝ) :
  partial_discriminant r A 0 = -4 * (A + r^2) * (2 * r^2 + A)^2 := by
  unfold partial_discriminant cubic_discriminant_e
  ring

/-
Algebraic identity for the sum of terms in the symmetric case.
-/
def Phi_Disc_symm_term_y (A y : ℝ) : ℝ :=
  -4 * (6 * y + A)^2 * (A + y) * (2 * y + A)^2

lemma Phi_Disc_symm_sum_uv (A C_coeff u v : ℝ)
  (hsum : u + v = -A) (hprod : u * v = C_coeff) :
  2 * Phi_Disc_symm_term_y A u + 2 * Phi_Disc_symm_term_y A v = Phi_quartic_numerator A C_coeff := by
    unfold Phi_Disc_symm_term_y Phi_quartic_numerator; rw [ ← eq_sub_iff_add_eq' ] at hsum; subst_vars; ring;

/-
Reduction of the symmetric term modulo the quadratic equation.
-/
lemma Phi_Disc_symm_reduction (A C_coeff y : ℝ)
  (h_root : y^2 + A * y + C_coeff = 0) :
  Phi_Disc_symm_term_y A y =
  let c := -4 * (A^2 - 4*C_coeff) * (A^2 - 36*C_coeff)
  let d := -4 * (A^2 - 4*C_coeff) * (A^3 - 12*A*C_coeff)
  c * y + d := by
    unfold Phi_Disc_symm_term_y;
    grind

/-
Algebraic identity for the symmetric case (B=0) using linear reduction.
-/
lemma Phi_Disc_sum_eq_Num_symm_v3 (A C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_e3 : e3_sum r = 0) -- B=0
  (h_prod : ∏ i, r i = C_coeff)
  (h_roots : ∀ i, (r i)^4 + A * (r i)^2 + C_coeff = 0) :
  Phi_Disc_sum A 0 r = Phi_quartic_numerator A C_coeff := by
  -- 1. Convert terms to Phi_Disc_symm_term_y
  have h_term (i : Fin 4) : (6 * (r i)^2 + A)^2 * partial_discriminant (r i) A 0 =
    Phi_Disc_symm_term_y A ((r i)^2) := by
    rw [partial_discriminant_symm_val]
    unfold Phi_Disc_symm_term_y
    ring
  rw [Phi_Disc_sum]
  simp only [h_term]
  -- 2. Use reduction to linear form
  let c := -4 * (A^2 - 4*C_coeff) * (A^2 - 36*C_coeff)
  let d := -4 * (A^2 - 4*C_coeff) * (A^3 - 12*A*C_coeff)
  have h_red (i : Fin 4) : Phi_Disc_symm_term_y A ((r i)^2) = c * (r i)^2 + d := by
    apply Phi_Disc_symm_reduction
    -- Check if (r i)^2 is a root of y^2 + Ay + C = 0
    let y := (r i)^2
    have : y^2 + A * y + C_coeff = (r i)^4 + A * (r i)^2 + C_coeff := by ring
    rw [this]
    exact h_roots i
  simp only [h_red]
  -- 3. Sum linear terms
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, Finset.card_fin]
  -- 4. Calculate sum (r i)^2
  have h_sq_sum : ∑ i, (r i)^2 = -2 * A := by
    have h_id : (∑ i, r i)^2 = ∑ i, (r i)^2 + 2 * e2_sum r := by
      unfold e2_sum
      -- We need the identity (sum x)^2 = sum x^2 + 2 sum_{i<j} x_i x_j
      -- For Fin 4, we can just expand it or use a library lemma.
      -- Let's try to prove it by expansion for Fin 4.
      simp [Fin.sum_univ_four]
      ring
    rw [h_sum, h_e2] at h_id
    linarith
  rw [h_sq_sum]
  -- 5. Verify final equality
  unfold Phi_quartic_numerator
  dsimp [c, d]
  ring

/-
Coefficient of B^2 in the expansion of Phi * Disc.
-/
def Phi_Disc_sum_B2_coeff (A C_coeff : ℝ) : ℝ :=
  -27 * (52 * A^2 - 144 * C_coeff)

/-
Decomposition of Phi_Disc_sum into powers of B.
-/
lemma Phi_Disc_sum_decomposition (A B : ℝ) (r : Fin 4 → ℝ) :
  Phi_Disc_sum A B r =
  let D0 := fun r => (-r)^2 * (A + r^2)^2 - 4 * (A + r^2)^3
  let D1 := fun r => -4 * (-r)^3 + 18 * (-r) * (A + r^2)
  let D2 := -27
  let Q := fun r => A * r + r^3
  let Term := fun r => (6 * r^2 + A)^2
  ∑ i, Term (r i) * (D0 (r i) - D1 (r i) * Q (r i) + D2 * (Q (r i))^2) +
  B * ∑ i, Term (r i) * (-D1 (r i) + 2 * D2 * Q (r i)) +
  B^2 * ∑ i, Term (r i) * D2 := by
    unfold Phi_Disc_sum;
    unfold partial_discriminant; norm_num [ Fin.sum_univ_four ] ; ring;
    unfold cubic_discriminant_e; ring;

/-
Power sum p4 in terms of A and C.
-/
def Phi_Disc_sum_B2_coeff_correct (A C_coeff : ℝ) : ℝ :=
  1212 * A^2 - 6192 * C_coeff

lemma sum_r_pow_4 (A C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_prod : ∏ i, r i = C_coeff) :
  ∑ i, (r i)^4 = 2 * A^2 - 4 * C_coeff := by
  -- We proved this in scratchpad, let's formalize.
  -- p4 = e1 p3 - e2 p2 + e3 p1 - 4 e4
  -- p1 = 0.
  -- p2 = -2A.
  -- p3 = 3 e3.
  -- p4 = 0 - A(-2A) + e3(0) - 4C = 2A^2 - 4C.
  -- We need to prove p2 and p4 relations.
  have h_p1 : ∑ i, r i = 0 := h_sum
  have h_p2 : ∑ i, (r i)^2 = -2 * A := by
    have h : (∑ i, r i)^2 = ∑ i, (r i)^2 + 2 * e2_sum r := by
      simp [Fin.sum_univ_four, e2_sum]
      ring
    rw [h_sum, h_e2] at h
    linarith
  -- For p4, we need Newton sums.
  -- We can prove p4 directly by expanding (sum r)^4? No, too big.
  -- (sum r^2)^2 = sum r^4 + 2 sum r_i^2 r_j^2.
  -- sum r_i^2 r_j^2 = e2^2 - 2 e1 e3 + 2 e4.
  -- = A^2 - 0 + 2C.
  -- So (-2A)^2 = p4 + 2(A^2 - 2C).
  -- 4A^2 = p4 + 2A^2 - 4C.
  -- p4 = 2A^2 + 4C.
  -- Wait, my scratchpad said 2A^2 - 4C.
  -- Let's recheck sum r_i^2 r_j^2.
  -- e2^2 = (sum r_i r_j)^2 = sum r_i^2 r_j^2 + ...
  -- Actually, Newton sums are safer.
  -- p4 - e1 p3 + e2 p2 - e3 p1 + 4 e4 = 0.
  -- p4 - 0 + A(-2A) - 0 + 4C = 0.
  -- p4 - 2A^2 + 4C = 0.
  -- p4 = 2A^2 - 4C.
  -- So my scratchpad was correct.
  -- Let's verify sum r_i^2 r_j^2.
  -- e2 = A.
  -- e2^2 = A^2.
  -- e2^2 = sum r_i^2 r_j^2 + 2 sum r_i r_j r_k (r_l?) + 6 e4.
  -- This is getting complicated.
  -- Let's use the Newton sum relation directly if possible, or prove it.
  -- We can prove p4 = 2A^2 - 4C by expanding (sum r^2)^2 - 2 e2^2? No.
  -- Let's try to prove it using `ring` on the expanded form if we assume the relations.
  -- Or just assume the Newton sum identity holds.
  -- I will state it as a lemma.
  simp_all +decide [ Fin.sum_univ_four, Fin.prod_univ_four ];
  grind

/-
The sum of squares of the second derivative terms depends only on A and C.
-/
lemma sum_sq_6r2_plus_A (A C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_prod : ∏ i, r i = C_coeff) :
  ∑ i, (6 * (r i)^2 + A)^2 = 52 * A^2 - 144 * C_coeff := by
    unfold e2_sum at h_e2;
    norm_num [ Fin.sum_univ_four, Fin.prod_univ_four ] at *;
    grind

/-
Equivalence of coefficient and root forms of the partial discriminant.
-/
def partial_discriminant_roots (i : Fin 4) (r : Fin 4 → ℝ) : ℝ :=
  ∏ j ∈ Finset.univ.filter (· ≠ i), ∏ k ∈ Finset.univ.filter (fun x => x ≠ i ∧ j < x), (r j - r k)^2

def Phi_Disc_sum_roots (A : ℝ) (r : Fin 4 → ℝ) : ℝ :=
  ∑ i, (6 * (r i)^2 + A)^2 * partial_discriminant_roots i r

lemma partial_discriminant_eq_roots (i : Fin 4) (A B : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_e3 : e3_sum r = -B) :
  partial_discriminant (r i) A B = partial_discriminant_roots i r := by
  unfold partial_discriminant partial_discriminant_roots;
  fin_cases i <;> simp +decide [ Fin.sum_univ_four, Fin.prod_univ_four, Finset.prod_filter ] at *;
  · unfold e2_sum e3_sum at *;
    simp_all +decide [ Fin.sum_univ_four ];
    unfold cubic_discriminant_e; rw [ ← h_e3, ← h_e2 ] ; ring;
    grind +ring;
  · unfold e2_sum e3_sum at *;
    simp_all +decide [ Fin.sum_univ_four ];
    rw [ ← eq_sub_iff_add_eq' ] at h_sum ; subst_vars ; ring;
    rw [ show B = - ( r 0 * r 1 * r 2 + r 0 * r 1 * r 3 + r 0 * r 2 * r 3 + r 1 * r 2 * r 3 ) by linarith ] ; rw [ h_sum ] ; ring;
    unfold cubic_discriminant_e; ring;
  · unfold cubic_discriminant_e e2_sum e3_sum at *;
    simp_all +decide [ Fin.sum_univ_four ];
    grind +ring;
  · unfold e2_sum e3_sum at *;
    simp_all +decide [ Fin.sum_univ_four ];
    unfold cubic_discriminant_e;
    grind +ring

/-
Definition of power sums for a centered quartic polynomial.
-/
def power_sum (A B C_coeff : ℝ) (k : ℕ) : ℝ :=
  match k with
  | 0 => 4
  | 1 => 0
  | 2 => -2 * A
  | 3 => -3 * B
  | 4 => 2 * A^2 - 4 * C_coeff
  | 5 => 5 * A * B
  | 6 => -2 * A^3 + 6 * A * C_coeff + 3 * B^2
  | 7 => -7 * A^2 * B + 7 * B * C_coeff
  | 8 => 2 * A^4 - 8 * A^2 * C_coeff + 2 * C_coeff^2 + 8 * A * B^2
  | 9 => 9 * A^3 * B - 18 * A * B * C_coeff - 3 * B^3
  | 10 => -2 * A^5 + 10 * A^3 * C_coeff - 8 * A * C_coeff^2 - A^2 * B^2 - 10 * B^2 * C_coeff
  | _ => 0

/-
Value of the third part of the Phi_Disc_sum decomposition.
-/
def Phi_Disc_sum_part3_poly (A C_coeff : ℝ) : ℝ :=
  -27 * (52 * A^2 - 144 * C_coeff)

lemma Phi_Disc_sum_part3_val (A B C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_prod : ∏ i, r i = C_coeff) :
  let D2 := -27
  let Term := fun r => (6 * r^2 + A)^2
  B^2 * ∑ i, Term (r i) * D2 = B^2 * Phi_Disc_sum_part3_poly A C_coeff := by
    unfold Phi_Disc_sum_part3_poly;
    unfold e2_sum at * ; simp_all +decide [ Fin.sum_univ_four, Fin.prod_univ_four ] ; ring;
    grind

/-
Definition of power sums for a centered quartic polynomial.
-/
def power_sum_correct (A B C_coeff : ℝ) (k : ℕ) : ℝ :=
  match k with
  | 0 => 4
  | 1 => 0
  | 2 => -2 * A
  | 3 => -3 * B
  | 4 => 2 * A^2 - 4 * C_coeff
  | 5 => 5 * A * B
  | 6 => -2 * A^3 + 6 * A * C_coeff + 3 * B^2
  | 7 => -7 * A^2 * B + 7 * B * C_coeff
  | 8 => 2 * A^4 - 8 * A^2 * C_coeff - 8 * A * B^2 + 4 * C_coeff^2
  | 9 => 9 * A^3 * B - 18 * A * B * C_coeff - 3 * B^3
  | 10 => -2 * A^5 + 10 * A^3 * C_coeff + 15 * A^2 * B^2 - 10 * A * C_coeff^2 - 10 * B^2 * C_coeff
  | _ => 0

/-
Value of the third part of the decomposition (coefficient of B^2).
-/
lemma Phi_Disc_sum_part3_eq (A C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_prod : ∏ i, r i = C_coeff) :
  let D2 := -27
  let Term := fun r => (6 * r^2 + A)^2
  ∑ i, Term (r i) * D2 = Phi_Disc_sum_part3_poly A C_coeff := by
  dsimp
  rw [← Finset.sum_mul]
  rw [sum_sq_6r2_plus_A A C_coeff r h_sum h_e2 h_prod]
  unfold Phi_Disc_sum_part3_poly
  ring

/-
Decomposition of Phi_Disc_sum into sums of polynomials.
-/
open Polynomial

def D0_poly (A : ℝ) : ℝ[X] := (-X)^2 * (C A + X^2)^2 - 4 * (C A + X^2)^3
def D1_poly (A : ℝ) : ℝ[X] := -4 * (-X)^3 + 18 * (-X) * (C A + X^2)
def D2_poly : ℝ[X] := -27
def Q_poly (A : ℝ) : ℝ[X] := C A * X + X^3
def Term_poly (A : ℝ) : ℝ[X] := (6 * X^2 + C A)^2

def Poly_B0 (A : ℝ) : ℝ[X] := Term_poly A * (D0_poly A - D1_poly A * Q_poly A + D2_poly * (Q_poly A)^2)
def Poly_B1 (A : ℝ) : ℝ[X] := Term_poly A * (-D1_poly A + 2 * D2_poly * Q_poly A)
def Poly_B2 (A : ℝ) : ℝ[X] := Term_poly A * D2_poly

lemma Phi_Disc_sum_eq_sum_polys (A B : ℝ) (r : Fin 4 → ℝ) :
  Phi_Disc_sum A B r =
  (∑ i, (Poly_B0 A).eval (r i)) +
  B * (∑ i, (Poly_B1 A).eval (r i)) +
  B^2 * (∑ i, (Poly_B2 A).eval (r i)) := by
    convert Phi_Disc_sum_decomposition A B r using 1 ; ring!;
    unfold Poly_B0 Poly_B1 Poly_B2; norm_num [ Fin.sum_univ_four ] ; ring;
    unfold Term_poly D0_poly D1_poly Q_poly D2_poly; norm_num ; ring;

/-
Coefficient of B^2 in the expansion of Phi * Disc.
-/
def Phi_Disc_sum_B2_total_coeff (A C_coeff : ℝ) : ℝ :=
  -12324 * A^2 - 432 * C_coeff

/-
Power sums of roots for a general centered quartic match the explicit formulas.
-/
lemma sum_r_pow_eq_power_sum (A B C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_roots : ∀ i, (r i)^4 + A * (r i)^2 + B * (r i) + C_coeff = 0)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_e3 : e3_sum r = -B)
  (h_prod : ∏ i, r i = C_coeff) :
  ∀ k ∈ Finset.range 11, ∑ i, (r i)^k = power_sum_correct A B C_coeff k := by
    intro k hk;
    rcases k with ( _ | _ | _ | _ | _ | _ | _ | k ) <;> norm_num [ Fin.sum_univ_four ] at hk ⊢;
    all_goals norm_num [ Fin.sum_univ_four, e2_sum, e3_sum, power_sum_correct ] at *;
    grind;
    grind;
    · grind +ring;
    · grind;
    · grind +ring;
    · grind;
    · interval_cases _ : k + 1 + 1 + 1 + 1 + 1 + 1 + 1 <;> simp_all +decide;
      · grind +ring;
      · grind +ring;
      · grind +ring;
      · grind

/-
Power sums of roots for a general centered quartic match the explicit formulas.
