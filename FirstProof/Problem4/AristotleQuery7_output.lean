lemma sum_r_pow_eq_power_sum_v2 (A B C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_roots : ∀ i, (r i)^4 + A * (r i)^2 + B * (r i) + C_coeff = 0)
