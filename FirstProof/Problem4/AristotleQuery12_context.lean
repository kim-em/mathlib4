    · have := hp.2.2; have := hq.2.2; unfold boxplus; norm_num [ Polynomial.coeff_eq_zero_of_natDegree_lt, hp.1, hq.1, hp.2.1, hq.2.1 ] ;
      unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', ‹p.coeff 0 = 0›, ‹q.coeff 0 = 0› ] ;
    · unfold is_centered at *;
      unfold boxplus; simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt, Finset.sum_range_succ' ] ;
      unfold boxplus_coeff; simp_all +decide [ Finset.sum_range_succ', Nat.factorial_ne_zero ] ;
      exact Finset.sum_eq_zero fun x hx => if_neg ( by omega )

/-
For centered polynomials of degree n >= 2, the (n-2)-th coefficient is additive under boxplus.
-/
lemma boxplus_centered_coeff_add (n : ℕ) (p q : ℝ[X])
  (hp : is_centered n p) (hq : is_centered n q) :
  (boxplus n p q).coeff (n - 2) = p.coeff (n - 2) + q.coeff (n - 2) := by
  -- By definition of boxplus, the coefficient of $X^{n-2}$ in $p \boxplus q$ is given by the sum of the products of the coefficients of $X^{n-i}$ in $p$ and $X^{n-j}$ in $q$ where $i + j = 2$.
  have h_coeff : (boxplus n p q).coeff (n - 2) = ∑ i ∈ Finset.range (2 + 1), (Nat.factorial (n - i) * Nat.factorial (n - (2 - i))) / (Nat.factorial n * Nat.factorial (n - 2) : ℝ) * p.coeff (n - i) * q.coeff (n - (2 - i)) := by
    rcases n with ( _ | _ | n ) <;> simp_all +decide [ Finset.sum_range_succ ];
    · unfold is_centered at * ; aesop;
    · unfold boxplus; norm_num [ Finset.sum_range_succ' ] ; ring;
      unfold boxplus_coeff; norm_num [ Finset.sum_range_succ ] ; ring;
      cases hp ; cases hq ; aesop;
    · unfold boxplus;
      simp +decide [ Finset.sum_range_succ', Polynomial.coeff_C, Polynomial.coeff_X_pow ];
      rw [ Finset.sum_eq_zero ] <;> norm_num +decide [ Nat.factorial_ne_zero ];
      · unfold boxplus_coeff; norm_num [ Nat.factorial_succ, Finset.sum_range_succ' ] ; ring;
        field_simp;
        grind;
      · intros; omega;
  rcases n with ( _ | _ | n ) <;> simp_all +decide [ Finset.sum_range_succ' ];
  · cases hp ; cases hq ; aesop;
  · cases hp ; cases hq ; aesop;
  · simp_all +decide [ Nat.factorial_ne_zero, mul_comm, mul_assoc, mul_left_comm, div_eq_mul_inv ];
    simp_all +decide [ is_centered, Nat.factorial_succ ];
    have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; aesop;

/-
Phi scales with the inverse square of the scaling factor.
-/
lemma Phi_scaleRoots (p : ℝ[X]) (c : ℝ) (hc : c ≠ 0) :
  Phi (p.scaleRoots c) = c⁻¹ ^ 2 * Phi p := by
  unfold Phi;
  simp +zetaDelta at * ; simp_all +decide [ Polynomial.scaleRoots ];
  -- Let's simplify the expression using the fact that multiplication by a non-zero constant preserves the roots.
  have h_roots : (∑ i ∈ p.support, (Polynomial.monomial i : ℝ → ℝ[X]) (p.coeff i * c ^ (p.natDegree - i))).roots.toFinset = Finset.image (fun x => c * x) p.roots.toFinset := by
    -- By definition of polynomial multiplication and roots, we can show that the roots of the scaled polynomial are the scaled roots of the original polynomial.
    have h_roots_scaled : ∀ x, (∑ i ∈ p.support, (Polynomial.monomial i : ℝ → ℝ[X]) (p.coeff i * c ^ (p.natDegree - i))).eval x = c ^ p.natDegree * p.eval (x / c) := by
      simp +decide [ Polynomial.eval_finset_sum, Polynomial.eval_monomial ];
      intro x; rw [ Polynomial.eval_eq_sum, Polynomial.sum_def ] ; simp +decide [ mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _, hc ] ;
      field_simp;
      exact Finset.sum_congr rfl fun i hi => by rw [ div_pow, div_mul_eq_mul_div, div_mul_eq_mul_div, eq_div_iff ( pow_ne_zero _ hc ) ] ; rw [ show c ^ p.natDegree = c ^ ( p.natDegree - i ) * c ^ i by rw [ ← pow_add, Nat.sub_add_cancel ( Polynomial.le_natDegree_of_mem_supp _ hi ) ] ] ; ring;
    ext; simp [h_roots_scaled];
    constructor <;> intro h <;> simp_all +decide [ Polynomial.ext_iff ];
    · exact ⟨ _, ⟨ ⟨ Polynomial.natDegree p, by aesop ⟩, h.2 ⟩, mul_div_cancel₀ _ hc ⟩;
    · rcases h with ⟨ a, ⟨ ⟨ x, hx ⟩, hx' ⟩, rfl ⟩ ; simp_all +decide [ mul_div_cancel_left₀ ] ;
      use p.natDegree; simp_all +decide [ Polynomial.coeff_monomial ] ;
      aesop_cat;
  rw [ h_roots, Finset.sum_image ];
  · rw [ Finset.mul_sum _ _ _ ] ; refine' Finset.sum_congr rfl fun x hx => _ ; rw [ Finset.sum_image <| by aesop ] ; ring;
    simp +decide [ ← mul_sub, mul_pow, ← Finset.mul_sum _ _ _, ← Finset.sum_mul, hc ];
    ring;
  · exact fun x hx y hy hxy => mul_left_cancel₀ hc hxy

/-
For centered polynomials of degree n >= 3, the (n-3)-th coefficient is additive under boxplus.
-/
lemma boxplus_centered_coeff_add_3 (n : ℕ) (p q : ℝ[X])
  (hp : is_centered n p) (hq : is_centered n q)
  (hn : n ≥ 3) :
  (boxplus n p q).coeff (n - 3) = p.coeff (n - 3) + q.coeff (n - 3) := by
  -- The coefficient of $X^{n-3}$ in the boxplus is given by $boxplus_coeff n p q 3$.
  have h_coeff : (boxplus n p q).coeff (n - 3) = boxplus_coeff n p q 3 := by
    unfold boxplus;
    norm_num [ Polynomial.coeff_sum, Polynomial.coeff_C_mul_X_pow ];
    rw [ Finset.sum_eq_single 3 ] <;> norm_num;
    · intros; omega;
    · intros; linarith;
  rcases n with ( _ | _ | _ | n ) <;> simp_all +decide [ Finset.sum_range_succ', boxplus_coeff ];
  simp_all +decide [ Nat.factorial_ne_zero, mul_comm, mul_assoc, mul_left_comm, div_eq_mul_inv, is_centered ];
  have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; aesop;

/-
The 4th finite free cumulant is additive for centered quartics.
-/
lemma boxplus_centered_deg4_kappa4_additive (p q : ℝ[X])
  (hp : is_centered 4 p) (hq : is_centered 4 q) :
  let k4 := fun poly => poly.coeff 0 - 1/12 * (poly.coeff 2)^2
  k4 (boxplus 4 p q) = k4 p + k4 q := by
  unfold is_centered at *;
  unfold boxplus; norm_num [ Finset.sum_range_succ', hp, hq ] ; ring;
  unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', hp, hq ] ; ring;
  have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; simp_all +decide [ Polynomial.Monic.def ] ; ring;

/-
Formula for Phi of a symmetric quartic polynomial x^4 + Ax^2 + c.
-/
lemma Phi_symmetric_quartic (A c : ℝ)
  (hA : A < 0) (hc : c > 0) (hD : A^2 - 4*c > 0) :
  Phi (X^4 + C A * X^2 + C c) = -A * (A^2 + 12*c) / (2*c * (A^2 - 4*c)) := by
  field_simp;
  -- Let $u, v$ be the roots of $y^2 + Ay + c = 0$.
  set u := (-A + Real.sqrt (A^2 - 4 * c)) / 2
  set v := (-A - Real.sqrt (A^2 - 4 * c)) / 2
  have hu_pos : 0 < u := by
    exact div_pos ( add_pos_of_pos_of_nonneg ( neg_pos_of_neg hA ) ( Real.sqrt_nonneg _ ) ) zero_lt_two
  have hv_pos : 0 < v := by
    exact div_pos ( sub_pos.mpr <| by rw [ Real.sqrt_lt' ] <;> nlinarith ) zero_lt_two
  have hu_ne_v : u ≠ v := by
    grind
  have h_roots : (Polynomial.X^4 + Polynomial.C A * Polynomial.X^2 + Polynomial.C c).roots.toFinset = {Real.sqrt u, -Real.sqrt u, Real.sqrt v, -Real.sqrt v} := by
    -- By definition of $u$ and $v$, we know that $y^2 + Ay + c = (y - u)(y - v)$.
    have h_factor : Polynomial.X^4 + Polynomial.C A * Polynomial.X^2 + Polynomial.C c = (Polynomial.X^2 - Polynomial.C u) * (Polynomial.X^2 - Polynomial.C v) := by
      simp +zetaDelta at *;
      exact Polynomial.funext fun x => by norm_num; cases le_or_gt x 0 <;> nlinarith [ Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - 4 * c by linarith ) ] ;
    rw [ h_factor, Polynomial.roots_mul ];
    · rw [ show ( Polynomial.X ^ 2 - Polynomial.C u : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt u ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt u ) ) by exact Polynomial.funext fun x => by norm_num; linarith [ Real.mul_self_sqrt hu_pos.le ], show ( Polynomial.X ^ 2 - Polynomial.C v : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt v ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt v ) ) by exact Polynomial.funext fun x => by norm_num; linarith [ Real.mul_self_sqrt hv_pos.le ] ];
      rw [ Polynomial.roots_mul ( by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_mul ( by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num;
      grind;
    · exact mul_ne_zero ( Polynomial.X_pow_sub_C_ne_zero ( by norm_num ) _ ) ( Polynomial.X_pow_sub_C_ne_zero ( by norm_num ) _ );
  -- Use the formula derived: $\Phi = (u+v) [ \frac{8}{(u-v)^2} + \frac{1}{2uv} ]$.
  have h_phi_formula : Phi (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c) = (u + v) * (8 / (u - v)^2 + 1 / (2 * u * v)) := by
    have h_phi_formula : Phi (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c) = ∑ r ∈ ({Real.sqrt u, -Real.sqrt u, Real.sqrt v, -Real.sqrt v} : Finset ℝ), ((Polynomial.derivative (Polynomial.derivative (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c))).eval r / (2 * (Polynomial.derivative (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c)).eval r))^2 := by
      convert Phi_derivative_form _ _ _ using 1;
      · rw [ h_roots ];
      · rw [ Polynomial.splits_iff_card_roots ];
        rw [ Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> norm_num [ Polynomial.natDegree_X_pow, Polynomial.natDegree_C, hA.ne, hc.ne' ];
        rw [ show ( Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt u ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt u ) ) * ( Polynomial.X - Polynomial.C ( Real.sqrt v ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt v ) ) from _ ];
        · rw [ Polynomial.roots_mul, Polynomial.roots_mul, Polynomial.roots_mul, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] <;> norm_num;
          · exact ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩;
          · exact ⟨ ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩, Polynomial.X_sub_C_ne_zero _ ⟩;
          · exact ⟨ ⟨ ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩, Polynomial.X_sub_C_ne_zero _ ⟩, Polynomial.X_add_C_ne_zero _ ⟩;
        · refine' Polynomial.funext fun x => _;
          norm_num +zetaDelta at *;
          ring_nf;
          rw [ show ( Real.sqrt 2 ) ⁻¹ ^ 4 = ( Real.sqrt 2 ) ⁻¹ ^ 2 * ( Real.sqrt 2 ) ⁻¹ ^ 2 by ring, inv_pow ] ; norm_num ; rw [ Real.sq_sqrt <| by nlinarith [ Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - c * 4 by linarith ) ], Real.sq_sqrt <| by nlinarith [ Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - c * 4 by linarith ) ] ] ; ring;
          rw [ Real.sq_sqrt ] <;> linarith;
      · refine' Multiset.nodup_iff_count_le_one.mpr _;
        intro x; by_cases hx : x ∈ Polynomial.roots ( Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c ) <;> simp_all +decide [ Polynomial.rootMultiplicity_eq_zero ] ;
        refine' Nat.le_of_not_lt fun h => _;
        -- If $x$ is a root of multiplicity greater than 1, then $x$ must also be a root of the derivative of the polynomial.
        have h_deriv_root : Polynomial.eval x (Polynomial.derivative (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c)) = 0 := by
          exact Polynomial.isRoot_iterate_derivative_of_lt_rootMultiplicity h;
        norm_num at h_deriv_root;
        grind;
    rw [ h_phi_formula, Finset.sum_insert, Finset.sum_insert, Finset.sum_insert, Finset.sum_singleton ] <;> norm_num;
    · field_simp;
      rw [ Real.sq_sqrt hu_pos.le, Real.sq_sqrt hv_pos.le ] ; ring;
      grind;
    · linarith [ Real.sqrt_pos.2 hv_pos ];
    · exact ⟨ by linarith [ Real.sqrt_pos.2 hu_pos, Real.sqrt_pos.2 hv_pos ], by rw [ Real.sqrt_inj hu_pos.le hv_pos.le ] ; contrapose! hu_ne_v; linarith ⟩;
    · exact ⟨ by linarith [ Real.sqrt_pos.2 hu_pos ], by rw [ Real.sqrt_inj hu_pos.le hv_pos.le ] ; aesop, by linarith [ Real.sqrt_pos.2 hu_pos, Real.sqrt_pos.2 hv_pos ] ⟩;
  convert congr_arg ( · * c * 2 ) h_phi_formula using 1 ; ring;
  field_simp [u, v]
  ring;
  rw [ show u = ( -A + Real.sqrt ( A^2 - 4 * c ) ) / 2 by rfl, show v = ( -A - Real.sqrt ( A^2 - 4 * c ) ) / 2 by rfl ] ; ring;
  rw [ inv_pow, Real.sq_sqrt ] <;> nlinarith [ mul_inv_cancel_left₀ ( by linarith : ( A ^ 2 - c * 4 ) ≠ 0 ) ( A * c ) ]

/-
The denominator function D(u, K) = u^3 + 6uK is superadditive in the relevant domain.
-/
lemma quartic_denominator_superadditive (u1 u2 K1 K2 : ℝ)
  (hu1 : u1 > 0) (hu2 : u2 > 0)
  (hK1 : K1 > -u1^2/12) (hK2 : K2 > -u2^2/12) :
  let D := fun u K => u^3 + 6*u*K
  D (u1+u2) (K1+K2) ≥ D u1 K1 + D u2 K2 := by
  nlinarith [ sq_nonneg ( u1 - u2 ), mul_pos hu1 hu2 ]

/-
Standard inequality (a+b)^2/(x+y) <= a^2/x + b^2/y for positive x, y.
-/
lemma sum_sq_div_le_sum_sq_div (a b x y : ℝ) (hx : x > 0) (hy : y > 0) :
  (a + b)^2 / (x + y) ≤ a^2 / x + b^2 / y := by
  rw [ div_add_div, div_le_div_iff₀ ] <;> nlinarith [ sq_nonneg ( a * y - b * x ) ]

/-
Expansion of 1/Phi for symmetric quartic in terms of u and K.
-/
lemma invPhi_symmetric_quartic_expansion (A c : ℝ)
  (hA : A < 0) (hc : c > 0) (hD : A^2 - 4*c > 0) :
  let u := -A
  let K := c - u^2/12
  1 / Phi (X^4 + C A * X^2 + C c) = u/18 - 4*K^2 / (u^3 + 6*u*K) := by
  convert congr_arg _ (Phi_symmetric_quartic A c hA hc hD ) using 1 ; ring;
  field_simp;
  rw [ div_eq_div_iff ] <;> ring_nf <;> try nlinarith;
  nlinarith [ inv_mul_cancel_left₀ ( by nlinarith : ( -A ^ 2 - c * 12 ) ≠ 0 ) ( A * c ^ 2 ), inv_mul_cancel_left₀ ( by nlinarith : ( -A ^ 2 - c * 12 ) ≠ 0 ) ( A ^ 3 * c ), inv_mul_cancel_left₀ ( by nlinarith : ( -A ^ 2 - c * 12 ) ≠ 0 ) ( A ^ 5 ) ]

/-
The function F(u, K) representing 1/Phi for symmetric quartics is superadditive.
-/
lemma n4_symmetric_inequality (u1 u2 K1 K2 : ℝ)
  (hu1 : u1 > 0) (hu2 : u2 > 0)
  (hK1_lower : K1 > -u1^2/12) (hK1_upper : K1 < u1^2/6)
  (hK2_lower : K2 > -u2^2/12) (hK2_upper : K2 < u2^2/6) :
  let F := fun u K => u/18 - 4*K^2 / (u^3 + 6*u*K)
  F (u1+u2) (K1+K2) ≥ F u1 K1 + F u2 K2 := by
  -- By `sum_sq_div_le_sum_sq_div`, $\frac{(K_1 + K_2)^2}{D(u_1, K_1) + D(u_2, K_2)} \le \frac{K_1^2}{D(u_1, K_1)} + \frac{K_2^2}{D(u_2, K_2)}$.
  have h_sum_sq_div : (K1 + K2)^2 / (u1^3 + 6 * u1 * K1 + u2^3 + 6 * u2 * K2) ≤ K1^2 / (u1^3 + 6 * u1 * K1) + K2^2 / (u2^3 + 6 * u2 * K2) := by
    convert sum_sq_div_le_sum_sq_div K1 K2 ( u1 ^ 3 + 6 * u1 * K1 ) ( u2 ^ 3 + 6 * u2 * K2 ) _ _ using 1 <;> ring_nf at * <;> nlinarith [ pow_pos hu1 3, pow_pos hu2 3 ] ;
  -- By `quartic_denominator_superadditive`, $D(u_1+u_2, K_1+K_2) \ge D(u_1, K_1) + D(u_2, K_2)$.
  have h_denom_superadd : u1^3 + 6 * u1 * K1 + u2^3 + 6 * u2 * K2 ≤ (u1 + u2)^3 + 6 * (u1 + u2) * (K1 + K2) := by
    nlinarith [ sq_nonneg ( u1 - u2 ), mul_pos hu1 hu2 ];
  -- Applying the inequality $\frac{(K_1 + K_2)^2}{D(u_1 + u_2, K_1 + K_2)} \le \frac{(K_1 + K_2)^2}{D(u_1, K_1) + D(u_2, K_2)}$ from `h_sum_sq_div`.
  have h_apply_sum_sq_div : (K1 + K2)^2 / ((u1 + u2)^3 + 6 * (u1 + u2) * (K1 + K2)) ≤ (K1 + K2)^2 / (u1^3 + 6 * u1 * K1 + u2^3 + 6 * u2 * K2) := by
    gcongr;
    nlinarith [ sq_pos_of_pos hu1, sq_pos_of_pos hu2 ];
  ring_nf at *; linarith;

/-
If p and q are symmetric centered quartics (coeff 3 = 0, coeff 1 = 0), then their boxplus is also symmetric (coeff 1 = 0).
-/
lemma boxplus_symmetric_centered_is_symmetric_centered (p q : ℝ[X])
  (hp_centered : is_centered 4 p) (hq_centered : is_centered 4 q)
  (hp_sym : p.coeff 1 = 0) (hq_sym : q.coeff 1 = 0) :
  (boxplus 4 p q).coeff 1 = 0 := by
  convert boxplus_centered_coeff_add_3 4 p q hp_centered hq_centered using 1;
  grind

/-
A symmetric quartic x^4 + Ax^2 + c with A < 0, c > 0, A^2 > 4c splits and has distinct roots.
-/
lemma symmetric_quartic_splits_nodup (A c : ℝ)
  (hA : A < 0) (hc : c > 0) (hD : A^2 - 4*c > 0) :
  (X^4 + C A * X^2 + C c).Splits (RingHom.id ℝ) ∧ (X^4 + C A * X^2 + C c).roots.Nodup := by
  -- Let $u, v$ be roots of $y^2 + Ay + c$.
  let u := (-A + Real.sqrt (A^2 - 4 * c)) / 2
  let v := (-A - Real.sqrt (A^2 - 4 * c)) / 2
  have huv : u > 0 ∧ v > 0 ∧ u ≠ v := by
    simp +zetaDelta at *;
    exact ⟨ by nlinarith [ Real.sqrt_nonneg ( A ^ 2 - 4 * c ), Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - 4 * c by linarith ) ], by nlinarith [ Real.sqrt_nonneg ( A ^ 2 - 4 * c ), Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - 4 * c by linarith ) ], by nlinarith [ Real.sqrt_nonneg ( A ^ 2 - 4 * c ), Real.mul_self_sqrt ( show 0 ≤ A ^ 2 - 4 * c by linarith ) ] ⟩;
  -- The roots of the quartic are $\pm\sqrt{u}, \pm\sqrt{v}$.
  have h_roots : (Polynomial.X ^ 4 + Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C c) = Polynomial.C 1 * (Polynomial.X - Polynomial.C (Real.sqrt u)) * (Polynomial.X - Polynomial.C (-Real.sqrt u)) * (Polynomial.X - Polynomial.C (Real.sqrt v)) * (Polynomial.X - Polynomial.C (-Real.sqrt v)) := by
    refine' Polynomial.funext fun x => _ ; norm_num ; ring;
    grind;
  rw [ h_roots, Polynomial.splits_mul_iff, Polynomial.splits_mul_iff, Polynomial.splits_mul_iff ] <;> norm_num;
  any_goals exact ne_of_apply_ne Polynomial.derivative <| by norm_num [ Real.sqrt_nonneg ] ;
  · erw [ Polynomial.roots_mul, Polynomial.roots_mul, Polynomial.roots_mul ] <;> norm_num [ Polynomial.X_sub_C_ne_zero, Polynomial.X_add_C_ne_zero ];
    norm_num [ Polynomial.splits_iff_card_roots ];
    grind;
  · exact ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩;
  · exact ⟨ ⟨ Polynomial.X_sub_C_ne_zero _, Polynomial.X_add_C_ne_zero _ ⟩, Polynomial.X_sub_C_ne_zero _ ⟩

/-
Value of invPhi for symmetric quartic in terms of u and K.
-/
lemma invPhi_val_symm (A c : ℝ)
  (hA : A < 0) (hc : c > 0) (hD : A^2 - 4*c > 0) :
  invPhi (X^4 + C A * X^2 + C c) = let u := -A; let K := c - u^2/12; u/18 - 4*K^2 / (u^3 + 6*u*K) := by
  convert invPhi_symmetric_quartic_expansion A c hA hc hD using 1;
  unfold invPhi;
  rw [ if_pos ];
  exact symmetric_quartic_splits_nodup A c hA hc hD |> fun h => ⟨ h.2, by exact ( by have := Polynomial.natDegree_eq_card_roots h.1; norm_num [ Polynomial.natDegree_add_eq_left_of_natDegree_lt, hA.ne, hc.ne', hD.ne' ] at *; linarith ) ⟩

/-
The class of hyperbolic symmetric quartics is closed under boxplus convolution.
-/
def is_hyperbolic_symmetric_quartic (p : ℝ[X]) : Prop :=
  is_centered 4 p ∧ p.coeff 1 = 0 ∧ p.coeff 2 < 0 ∧ p.coeff 0 > 0 ∧ p.coeff 2 ^ 2 - 4 * p.coeff 0 > 0

lemma boxplus_hyperbolic_is_hyperbolic (p q : ℝ[X])
  (hp : is_hyperbolic_symmetric_quartic p) (hq : is_hyperbolic_symmetric_quartic q) :
  is_hyperbolic_symmetric_quartic (boxplus 4 p q) := by
  rcases hp with ⟨ hp₁, hp₂, hp₃ ⟩;
  rcases hq with ⟨ hq₁, hq₂, hq₃ ⟩;
  -- By the properties of the boxplus operation, we know that the coefficients of the resulting polynomial are given by the sum of the coefficients of the individual polynomials.
  have h_coeff : (boxplus 4 p q).coeff 2 = p.coeff 2 + q.coeff 2 ∧ (boxplus 4 p q).coeff 0 = p.coeff 0 + q.coeff 0 + (1/6) * p.coeff 2 * q.coeff 2 := by
    unfold is_centered at *;
    unfold boxplus; norm_num [ Finset.sum_range_succ', hp₁, hp₂, hp₃, hq₁, hq₂, hq₃ ] ; ring;
    unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', hp₁, hp₂, hp₃, hq₁, hq₂, hq₃ ] ; ring;
    have := hp₁.1.coeff_natDegree; have := hq₁.1.coeff_natDegree; aesop;
  constructor;
  · exact?;
  · have h_coeff1 : (boxplus 4 p q).coeff 1 = 0 := by
      apply boxplus_symmetric_centered_is_symmetric_centered p q hp₁ hq₁ hp₂ hq₂;
    exact ⟨ h_coeff1, by linarith, by nlinarith, by nlinarith ⟩

/-
A hyperbolic symmetric quartic has the form X^4 + A X^2 + C.
-/
lemma hyperbolic_eq_standard_form (p : ℝ[X]) (hp : is_hyperbolic_symmetric_quartic p) :
  p = X^4 + C (p.coeff 2) * X^2 + C (p.coeff 0) := by
  obtain ⟨ hp₁, hp₂, hp₃, hp₄, hp₅ ⟩ := hp;
  rcases hp₁ with ⟨ hp₁, hp₂, hp₃ ⟩;
  rw [ p.as_sum_range_C_mul_X_pow ] ; norm_num [ Finset.sum_range_succ', hp₂, hp₃, ‹p.coeff 1 = 0› ];
  rw [ ← hp₂, hp₁.coeff_natDegree, Polynomial.C_1 ]

/-
The finite free Stam inequality holds for hyperbolic symmetric quartics.
-/
theorem invPhi_superadditive_hyperbolic_symmetric_quartic (p q : ℝ[X])
  (hp : is_hyperbolic_symmetric_quartic p) (hq : is_hyperbolic_symmetric_quartic q) :
  invPhi (boxplus 4 p q) ≥ invPhi p + invPhi q := by
  -- By `hyperbolic_eq_standard_form`, we can write p as X^4 + C (p.coeff 2) * X^2 + C (p.coeff 0).
  -- Similarly for q and p \boxplus q.
  have h_p : p = X^4 + C (p.coeff 2) * X^2 + C (p.coeff 0) := by
    exact?
  have h_q : q = X^4 + C (q.coeff 2) * X^2 + C (q.coeff 0) := by
    exact?
  have h_box : boxplus 4 p q = X^4 + C ((boxplus 4 p q).coeff 2) * X^2 + C ((boxplus 4 p q).coeff 0) := by
    convert hyperbolic_eq_standard_form ( boxplus 4 p q ) _ using 1;
    exact?;
  -- By `invPhi_val_symm`, we have `invPhi p = F u_p K_p`, `invPhi q = F u_q K_q`, and `invPhi (p \boxplus q) = F u_r K_r`.
  have h_invPhi_p : invPhi p = let u := -p.coeff 2; let K := p.coeff 0 - u^2 / 12; u / 18 - 4 * K^2 / (u^3 + 6 * u * K) := by
    convert invPhi_val_symm ( p.coeff 2 ) ( p.coeff 0 ) _ _ _ using 1;
    · exact h_p ▸ rfl;
    · exact hp.2.2.1;
    · exact hp.2.2.2.1;
    · exact hp.2.2.2.2
  have h_invPhi_q : invPhi q = let u := -q.coeff 2; let K := q.coeff 0 - u^2 / 12; u / 18 - 4 * K^2 / (u^3 + 6 * u * K) := by
    convert invPhi_val_symm ( q.coeff 2 ) ( q.coeff 0 ) _ _ _ using 1;
    · exact h_q ▸ rfl;
    · exact hq.2.2.1;
    · exact hq.2.2.2.1;
    · linarith [ hq.2.2.2.2 ]
  have h_invPhi_box : invPhi (boxplus 4 p q) = let u := -(boxplus 4 p q).coeff 2; let K := (boxplus 4 p q).coeff 0 - u^2 / 12; u / 18 - 4 * K^2 / (u^3 + 6 * u * K) := by
    convert invPhi_val_symm _ _ _ _ _ using 1;
    · congr! 1;
    · exact boxplus_hyperbolic_is_hyperbolic p q hp hq |>.2.2.1;
    · -- By `boxplus_hyperbolic_is_hyperbolic`, we know that `boxplus 4 p q` is hyperbolic.
      have h_box_hyperbolic : is_hyperbolic_symmetric_quartic (boxplus 4 p q) := by
        exact?;
      exact h_box_hyperbolic.2.2.2.1;
    · convert hp.2.2.2.2 |> fun h => hq.2.2.2.2 |> fun h' => boxplus_hyperbolic_is_hyperbolic p q hp hq |> fun h'' => h''.2.2.2.2 using 1;
  -- By `boxplus_centered_coeff_add` (with $n=4$), we have $r.coeff 2 = p.coeff 2 + q.coeff 2$.
  have h_coeff2 : (boxplus 4 p q).coeff 2 = p.coeff 2 + q.coeff 2 := by
    convert boxplus_centered_coeff_add 4 p q _ _ using 1 <;> norm_num [ hp.1, hq.1 ];
  -- By `boxplus_centered_deg4_kappa4_additive`, we have $K_r = K_p + K_q$.
  have h_coeff0 : (boxplus 4 p q).coeff 0 - ((boxplus 4 p q).coeff 2)^2 / 12 = (p.coeff 0 - (p.coeff 2)^2 / 12) + (q.coeff 0 - (q.coeff 2)^2 / 12) := by
    field_simp;
    convert congr_arg ( fun x : ℝ => x * 12 ) ( boxplus_centered_deg4_kappa4_additive p q hp.1 hq.1 ) using 1 <;> ring!;
  -- By definition of `is_hyperbolic_symmetric_quartic`, we know that $p.coeff 2 < 0$, $p.coeff 0 > 0$, and $p.coeff 2^2 - 4 * p.coeff 0 > 0$.
  obtain ⟨hp_coeff2, hp_coeff0, hp_disc⟩ := hp.right.right
  obtain ⟨hq_coeff2, hq_coeff0, hq_disc⟩ := hq.right.right;
  rw [ h_invPhi_p, h_invPhi_q, h_invPhi_box ];
  convert n4_symmetric_inequality ( -p.coeff 2 ) ( -q.coeff 2 ) ( p.coeff 0 - ( -p.coeff 2 ) ^ 2 / 12 ) ( q.coeff 0 - ( -q.coeff 2 ) ^ 2 / 12 ) ( by linarith ) ( by linarith ) ( by nlinarith ) ( by nlinarith ) ( by nlinarith ) ( by nlinarith ) using 1 ; norm_num [ h_coeff2, h_coeff0 ] ; ring;
  grind

/-
Explicit formulas for boxplus coefficients for n=3.
-/
lemma boxplus_n3_coeffs (p q : ℝ[X])
  (hp : p.natDegree = 3) (hq : q.natDegree = 3)
  (hp_monic : p.Monic) (hq_monic : q.Monic) :
  (boxplus 3 p q).coeff 2 = p.coeff 2 + q.coeff 2 ∧
  (boxplus 3 p q).coeff 1 = p.coeff 1 + q.coeff 1 + (2/3) * p.coeff 2 * q.coeff 2 ∧
  (boxplus 3 p q).coeff 0 = p.coeff 0 + q.coeff 0 + (1/3) * (p.coeff 1 * q.coeff 2 + p.coeff 2 * q.coeff 1) := by
  unfold boxplus;
  norm_num [ Finset.sum_range_succ, boxplus_coeff ] ; ring;
  simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
  ring

/-
Coefficients of a degree 3 polynomial shifted by c.
-/
lemma coeff_comp_add_C_deg3 (p : ℝ[X]) (c : ℝ) (hp : p.natDegree = 3) :
  (p.comp (X + C c)).coeff 3 = p.coeff 3 ∧
  (p.comp (X + C c)).coeff 2 = p.coeff 2 + 3 * c * p.coeff 3 ∧
  (p.comp (X + C c)).coeff 1 = p.coeff 1 + 2 * c * p.coeff 2 + 3 * c^2 * p.coeff 3 ∧
  (p.comp (X + C c)).coeff 0 = p.coeff 0 + c * p.coeff 1 + c^2 * p.coeff 2 + c^3 * p.coeff 3 := by
  norm_num [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
  norm_num [ Finset.sum_range_succ', hp, Polynomial.coeff_X_add_C_pow ] ; ring ; aesop

/-
Translation covariance of boxplus for degree 3.
-/
lemma boxplus_comp_add_C_n3 (p q : ℝ[X]) (c d : ℝ)
  (hp : p.natDegree = 3) (hq : q.natDegree = 3)
  (hp_monic : p.Monic) (hq_monic : q.Monic) :
  boxplus 3 (p.comp (X + C c)) (q.comp (X + C d)) = (boxplus 3 p q).comp (X + C (c + d)) := by
  apply Polynomial.ext_iff.mpr;
  intro n;
  -- By definition of boxplus, we know that the coefficients of the boxplus of two polynomials are given by the sum of the products of the coefficients of the individual polynomials.
  simp [boxplus];
  simp +decide [ Finset.sum_range_succ', Polynomial.coeff_X_add_one_pow, boxplus_coeff ];
  rcases n with ( _ | _ | _ | _ | n ) <;> simp +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt, hp, hq ];
  · norm_num [ Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_one, Polynomial.coeff_X, add_mul, mul_assoc, pow_succ' ] ; ring;
    norm_num [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
    norm_num [ Polynomial.eval_eq_sum_range, hp, hq, Finset.sum_range_succ', Polynomial.coeff_X_add_C_pow ] ; ring;
  · norm_num [ Polynomial.comp, Polynomial.eval₂_eq_sum_range, hp, hq, Finset.sum_range_succ' ];
    norm_num [ Polynomial.coeff_X, Polynomial.coeff_C, add_mul, mul_assoc, pow_succ' ] ; ring;
  · norm_num [ Polynomial.comp, Polynomial.eval₂_eq_sum_range, hp, hq, Nat.factorial ];
    norm_num [ Finset.sum_range_succ', Polynomial.coeff_X_add_one_pow ];
    norm_num [ Polynomial.coeff_one, Polynomial.coeff_X, add_mul, mul_assoc, pow_succ' ] ; ring;
  · erw [ Polynomial.comp, Polynomial.comp, Polynomial.eval₂_eq_sum_range, Polynomial.eval₂_eq_sum_range ] ; norm_num [ Finset.sum_range_succ', hp, hq, hp_monic, hq_monic ];
    norm_num [ Polynomial.coeff_X, Polynomial.coeff_C, add_mul, mul_assoc, pow_succ' ];
  · norm_num [ Polynomial.coeff_X_add_one_pow, Polynomial.coeff_X, Polynomial.coeff_C, add_mul, mul_assoc, pow_succ' ]

/-
Coefficient 2 of boxplus translation covariance for n=3.
-/
lemma boxplus_comp_add_C_n3_coeff2 (p q : ℝ[X]) (c d : ℝ)
  (hp : p.natDegree = 3) (hq : q.natDegree = 3)
  (hp_monic : p.Monic) (hq_monic : q.Monic) :
  (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))).coeff 2 = ((boxplus 3 p q).comp (X + C (c + d))).coeff 2 := by
  convert congr_arg ( fun x => Polynomial.coeff x 2 ) ( boxplus_comp_add_C_n3 p q c d hp hq hp_monic hq_monic ) using 1

/-
Coefficient 1 of boxplus translation covariance for n=3.
-/
lemma boxplus_comp_add_C_n3_coeff1 (p q : ℝ[X]) (c d : ℝ)
  (hp : p.natDegree = 3) (hq : q.natDegree = 3)
  (hp_monic : p.Monic) (hq_monic : q.Monic) :
  (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))).coeff 1 = ((boxplus 3 p q).comp (X + C (c + d))).coeff 1 := by
  convert congr_arg ( fun x => Polynomial.coeff x 1 ) ( boxplus_comp_add_C_n3 ( p ) ( q ) c d hp hq hp_monic hq_monic ) using 1

/-
Coefficient 0 of boxplus translation covariance for n=3.
-/
lemma boxplus_comp_add_C_n3_coeff0 (p q : ℝ[X]) (c d : ℝ)
  (hp : p.natDegree = 3) (hq : q.natDegree = 3)
  (hp_monic : p.Monic) (hq_monic : q.Monic) :
  (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))).coeff 0 = ((boxplus 3 p q).comp (X + C (c + d))).coeff 0 := by
  convert congr_arg ( fun x => Polynomial.coeff x 0 ) ( boxplus_comp_add_C_n3 ( p ) ( q ) c d hp hq hp_monic hq_monic ) using 1

/-
invPhi of boxplus is invariant under shifting the input polynomials (for n=3).
-/
lemma invPhi_boxplus_shift_invariance_n3 (p q : ℝ[X]) (c d : ℝ)
  (hp : p.natDegree = 3) (hq : q.natDegree = 3)
  (hp_monic : p.Monic) (hq_monic : q.Monic) :
  invPhi (boxplus 3 p q) = invPhi (boxplus 3 (p.comp (X + C c)) (q.comp (X + C d))) := by
  -- By definition of $Phi$, we know that it is invariant under translation.
  have hPhitrans (p : ℝ[X]) (c : ℝ) : Phi (p.comp (Polynomial.X + Polynomial.C c)) = Phi p := by
    convert Phi_comp_add_C p c using 1;
  -- By definition of $invPhi$, we know that it is invariant under translation.
  have hInvPhitrans (p : ℝ[X]) (c : ℝ) : invPhi (p.comp (Polynomial.X + Polynomial.C c)) = invPhi p := by
    -- Since the roots of $p.comp (X + C c)$ are the roots of $p$ shifted by $-c$, the nodup and cardinality conditions are preserved.
    have h_roots_shift : (p.comp (Polynomial.X + Polynomial.C c)).roots = Multiset.map (fun r => r - c) p.roots := by
      ext x; simp [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C];
      -- The multiplicity of x in p.comp (X + C c) is the same as the multiplicity of x + c in p.
      have h_mult : Polynomial.rootMultiplicity x (p.comp (Polynomial.X + Polynomial.C c)) = Polynomial.rootMultiplicity (x + c) p := by
        rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
        norm_num [ add_assoc, Polynomial.comp_assoc ];
      rw [ Multiset.count_map ];
      rw [ show ( Multiset.filter ( fun a => x = a - c ) p.roots ) = Multiset.filter ( fun a => a = x + c ) p.roots by congr; ext; constructor <;> intro <;> linarith ] ; rw [ Multiset.filter_eq' ] ; aesop;
    simp [invPhi, h_roots_shift];
    simp_all +decide [ Multiset.nodup_map_iff_of_injective, sub_eq_iff_eq_add, Function.Injective ];
  convert hInvPhitrans _ ( c + d ) |> Eq.symm using 2;
  convert boxplus_comp_add_C_n3 p q c d hp hq hp_monic hq_monic using 1

/-
invPhi is invariant under translation.
-/
lemma invPhi_comp_add_C (p : ℝ[X]) (c : ℝ) :
  invPhi (p.comp (X + C c)) = invPhi p := by
  -- By definition of invPhi, we know that if p and q are polynomials such that p.comp (X + C c) = q and q.comp (X + C c) = p, then invPhi p = invPhi q.
  unfold invPhi
  simp [Phi_comp_add_C];
  -- By definition of polynomial composition, we know that the roots of $p.comp (X + C c)$ are the roots of $p$ shifted by $-c$.
  have h_roots : (p.comp (Polynomial.X + Polynomial.C c)).roots = Multiset.map (fun r => r - c) p.roots := by
    ext x;
    have h_roots_eq : Polynomial.rootMultiplicity x (p.comp (Polynomial.X + Polynomial.C c)) = Polynomial.rootMultiplicity (x + c) p := by
      rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
      norm_num [ Polynomial.comp_assoc, add_assoc ];
    rw [ Multiset.count_map ];
    rw [ show ( Multiset.filter ( fun a => x = a - c ) p.roots ) = Multiset.filter ( fun a => a = x + c ) p.roots by congr; ext; constructor <;> intro <;> linarith ] ; rw [ Multiset.filter_eq' ] ; aesop;
  by_cases h : Multiset.Nodup p.roots <;> simp_all +decide [ Multiset.nodup_map_iff_inj_on ];
  exact fun h1 h2 => False.elim <| h <| Multiset.Nodup.of_map _ h1

/-
A monic degree 3 polynomial with zero quadratic coefficient is in standard reduced form.
-/
lemma monic_deg3_coeff2_zero_eq_standard_form (p : ℝ[X])
  (hp_monic : p.Monic) (hp_deg : p.natDegree = 3) (hp_red : p.coeff 2 = 0) :
  p = X^3 + C (p.coeff 1) * X + C (p.coeff 0) := by
  ext x; rw [ Polynomial.as_sum_range_C_mul_X_pow p ] ; simp +decide [ Finset.sum_range_succ', * ] ;

/-
=== THE MAIN THEOREM ===

The Finite Free Stam Inequality for general n:
  For monic real-rooted degree-n polynomials p, q with distinct roots,
  1/Phi_n(p ⊞_n q) >= 1/Phi_n(p) + 1/Phi_n(q).
-/
theorem finite_free_stam_inequality (n : ℕ) (hn : n ≥ 2)
    (p q : ℝ[X])
    (hp : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hp_monic : p.Monic) (hp_deg : p.natDegree = n)
    (hq : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hq_monic : q.Monic) (hq_deg : q.natDegree = n)
    (hpq : (boxplus n p q).Splits (RingHom.id ℝ))
    (hpq_nodup : (boxplus n p q).roots.Nodup) :
    invPhi (boxplus n p q) ≥ invPhi p + invPhi q := by
  sorry
  rw [ ← hp_deg, hp_monic.coeff_natDegree ]