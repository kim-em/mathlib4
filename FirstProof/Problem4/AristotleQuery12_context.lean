      exact lt_of_le_of_lt ( Polynomial.natDegree_mul_le .. ) ( by by_cases ha : a1 + a2 = 0 <;> simp +decide [ ha ] );
    exact ⟨ cubic_distinct_real_roots_implies_a_neg a1 b1 h_card.1, cubic_distinct_real_roots_implies_a_neg a2 b2 h_card.2.1, cubic_distinct_real_roots_implies_a_neg ( a1 + a2 ) ( b1 + b2 ) h_card.2.2 ⟩;
  rw [ hPhi_def _ _ h_real1 h_nodup1, hPhi_def _ _ h_real2 h_nodup2, hPhi_def _ _ h_real3 h_nodup3 ] ; linarith [ h_ineq a1 a2 b1 b2 h_ineq_applied.1 h_ineq_applied.2.1 h_ineq_applied.2.2 ] ;

/-
Alternative formula for Phi using derivatives evaluated at roots.
-/
lemma Phi_derivative_form (p : ℝ[X])
  (h_splits : p.Splits (RingHom.id ℝ))
  (h_nodup : p.roots.Nodup) :
  Phi p = ∑ r ∈ p.roots.toFinset, (p.derivative.derivative.eval r / (2 * p.derivative.eval r))^2 := by
  -- By definition of $Phi$, we know that for each root $r_i$ of $p$, $\frac{p''(r_i)}{2p'(r_i)} = \sum_{j \ne i} \frac{1}{r_i - r_j}$.
  have h_root_deriv : ∀ r ∈ p.roots.toFinset, (Polynomial.eval r (Polynomial.derivative (Polynomial.derivative p))) / (2 * Polynomial.eval r (Polynomial.derivative p)) = ∑ j ∈ p.roots.toFinset.erase r, (1 / (r - j)) := by
    -- Let $r$ be a root of $p$. Then $p(x) = (x - r)q(x)$ for some polynomial $q(x)$.
    intro r hr
    obtain ⟨q, hq⟩ : ∃ q : Polynomial ℝ, p = (Polynomial.X - Polynomial.C r) * q ∧ ¬(Polynomial.eval r q = 0) := by
      -- Since $r$ is a root of $p$, we can write $p(x) = (x - r)q(x)$ for some polynomial $q(x)$.
      obtain ⟨q, hq⟩ : ∃ q : Polynomial ℝ, p = (Polynomial.X - Polynomial.C r) * q := by
        exact Polynomial.dvd_iff_isRoot.mpr ( by aesop ) |> fun ⟨ q, hq ⟩ => ⟨ q, hq ⟩ ;
      simp_all +decide [ Polynomial.natDegree_mul' ];
      intro h; simp_all +decide [ Polynomial.roots_mul, Polynomial.X_sub_C_ne_zero ] ;
    -- By definition of $q$, we know that its roots are exactly the roots of $p$ excluding $r$.
    have h_q_roots : q.roots.toFinset = p.roots.toFinset.erase r := by
      ext; simp [hq];
      by_cases h : ‹ℝ› = r <;> simp_all +decide [ sub_eq_iff_eq_add ];
    -- By definition of $q$, we know that $q(x) = c \prod_{j \neq r} (x - r_j)$ for some constant $c$.
    obtain ⟨c, hc⟩ : ∃ c : ℝ, q = Polynomial.C c * ∏ j ∈ p.roots.toFinset.erase r, (Polynomial.X - Polynomial.C j) := by
      refine' ⟨ q.leadingCoeff, _ ⟩;
      convert Polynomial.eq_prod_roots_of_splits_id _ using 1;
      · rw [ ← h_q_roots, ← Multiset.toFinset_eq ];
        exact?;
        rw [ Multiset.nodup_iff_ne_cons_cons ] at *;
        intro a t h; specialize h_nodup a ( t + { r } ) ; simp_all +decide [ Multiset.cons_eq_cons ] ;
        rw [ Polynomial.roots_mul ] at h_nodup <;> simp_all +decide [ Polynomial.X_sub_C_ne_zero ];
        exact h_nodup ( by ext x; by_cases hx : x = r <;> simp +decide [ hx, Multiset.cons_eq_cons ] );
      · rw [ Polynomial.splits_iff_card_roots ] at *;
        replace h_splits := congr_arg ( fun x => x - 1 ) h_splits ; simp_all +decide [ Polynomial.natDegree_mul' ];
        rw [ Polynomial.roots_mul ] at h_splits <;> aesop;
    -- By definition of $q$, we know that $q'(x) = c \sum_{j \neq r} \prod_{k \neq j, r} (x - r_k)$.
    have h_q_deriv : Polynomial.derivative q = Polynomial.C c * ∑ j ∈ p.roots.toFinset.erase r, (∏ k ∈ p.roots.toFinset.erase r \ {j}, (Polynomial.X - Polynomial.C k)) := by
      rw [ hc, Polynomial.derivative_mul, Polynomial.derivative_C ];
      erw [ Polynomial.derivative_prod ];
      simp +decide [ Finset.sdiff_singleton_eq_erase, Finset.prod_erase ];
      exact Or.inl rfl;
    -- By definition of $q$, we know that $q'(r) = c \sum_{j \neq r} \prod_{k \neq j, r} (r - r_k)$.
    have h_q_deriv_eval : Polynomial.eval r (Polynomial.derivative q) = c * ∑ j ∈ p.roots.toFinset.erase r, (∏ k ∈ p.roots.toFinset.erase r \ {j}, (r - k)) := by
      simp +decide [ h_q_deriv, Polynomial.eval_finset_sum, Polynomial.eval_prod ];
    -- By definition of $q$, we know that $q'(r) = c \sum_{j \neq r} \prod_{k \neq j, r} (r - r_k) = c \prod_{k \neq r} (r - r_k) \sum_{j \neq r} \frac{1}{r - r_j}$.
    have h_q_deriv_eval_simplified : Polynomial.eval r (Polynomial.derivative q) = c * (∏ k ∈ p.roots.toFinset.erase r, (r - k)) * (∑ j ∈ p.roots.toFinset.erase r, (1 / (r - j))) := by
