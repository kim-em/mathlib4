      · grind;
    · exact pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) );
    · exact mul_ne_zero ( pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) ) ) ( pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) ) );
    · exact pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) );
    · exact pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) )

/-
Roots of p(x+c) are roots of p shifted by -c.
-/
lemma roots_comp_X_add_C (p : ℝ[X]) (c : ℝ) :
  (p.comp (X + C c)).roots = p.roots.map (fun r => r - c) := by
    ext x;
    have h_roots_eq : Polynomial.rootMultiplicity x (p.comp (Polynomial.X + Polynomial.C c)) = Polynomial.rootMultiplicity (x + c) p := by
      rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
      norm_num [ Polynomial.comp_assoc, add_assoc ];
    rw [ Multiset.count_map ];
    rw [ show ( Multiset.filter ( fun a => x = a - c ) p.roots ) = Multiset.filter ( fun a => a = x + c ) p.roots by congr; ext; constructor <;> intro <;> linarith ] ; rw [ Multiset.filter_eq' ] ; aesop

/-
Nodup is preserved under translation.
-/
lemma nodup_comp_X_add_C (p : ℝ[X]) (c : ℝ) :
  (p.comp (X + C c)).roots.Nodup ↔ p.roots.Nodup := by
    rw [ show ( p.comp ( Polynomial.X + Polynomial.C c ) |> Polynomial.roots ) = Multiset.map ( fun r => r - c ) ( p.roots ) from ?_, Multiset.nodup_map_iff_of_injective ] ; aesop_cat;
    rw [ roots_comp_X_add_C ]

/-
A monic cubic with zero quadratic coefficient is X^3 + aX + b.
-/
lemma cubic_reduced_form (p : ℝ[X])
  (hp_monic : p.Monic)
  (hp_deg : p.natDegree = 3)
  (hp_red : p.coeff 2 = 0) :
  p = X^3 + C (p.coeff 1) * X + C (p.coeff 0) := by
    conv_lhs => rw [ p.as_sum_range_C_mul_X_pow ] ; norm_num [ Finset.sum_range_succ', hp_deg, hp_red ] ;
    rw [ ← hp_deg, hp_monic.coeff_natDegree, Polynomial.C_1, one_mul ]

/-
Cauchy-Schwarz type inequality for n=3 case.
-/
lemma n3_inequality (b1 b2 u1 u2 : ℝ) (hu1 : u1 > 0) (hu2 : u2 > 0) :
  (b1 + b2)^2 / (u1 + u2)^2 ≤ b1^2 / u1^2 + b2^2 / u2^2 := by
  rw [ div_add_div, div_le_div_iff₀ ] <;> try positivity;
  have h_am_gm : (b1 * u2)^2 + (b2 * u1)^2 ≥ 2 * b1 * b2 * u1 * u2 := by
    linarith [ sq_nonneg ( b1 * u2 - b2 * u1 ) ];
  nlinarith [ sq_nonneg ( u1 - u2 ), mul_pos hu1 hu2, mul_le_mul_of_nonneg_left h_am_gm ( sq_nonneg u1 ), mul_le_mul_of_nonneg_left h_am_gm ( sq_nonneg u2 ) ]

/-
Conjecture for n=3 reduced cubics.
-/
theorem conjecture_n_3_reduced (a1 b1 a2 b2 : ℝ)
  (h_real1 : (X^3 + C a1 * X + C b1).Splits (RingHom.id ℝ))
  (h_nodup1 : (X^3 + C a1 * X + C b1).roots.Nodup)
  (h_real2 : (X^3 + C a2 * X + C b2).Splits (RingHom.id ℝ))
  (h_nodup2 : (X^3 + C a2 * X + C b2).roots.Nodup)
  (h_real3 : (X^3 + C (a1+a2) * X + C (b1+b2)).Splits (RingHom.id ℝ))
  (h_nodup3 : (X^3 + C (a1+a2) * X + C (b1+b2)).roots.Nodup) :
  invPhi (X^3 + C (a1+a2) * X + C (b1+b2)) ≥
  invPhi (X^3 + C a1 * X + C b1) + invPhi (X^3 + C a2 * X + C b2) := by
    -- By definition of invPhi, we know that
    have h_invPhi_def : ∀ a b : ℝ, (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b).Splits (RingHom.id ℝ) → (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots.Nodup → invPhi (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = (-4 * a^3 - 27 * b^2) / (18 * a^2) := by
      intros a b h_real h_nodup
      have h_invPhi_def : invPhi (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = 1 / (18 * a^2 / (-4 * a^3 - 27 * b^2)) := by
        rw [ invPhi ];
        split_ifs <;> simp_all +decide [ Polynomial.splits_iff_card_roots ];
        · convert congr_arg ( fun x : ℝ => x⁻¹ ) ( Phi_deg3_reduced_eq a b ?_ ?_ ) using 1;
          · rw [ inv_div ] ; ring;
          · rw [ Polynomial.splits_iff_card_roots ] ; aesop;
          · tauto;
        · by_cases ha : a = 0 <;> simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ];
      rw [ h_invPhi_def, one_div_div ];
    by_cases ha1 : a1 = 0 <;> by_cases ha2 : a2 = 0 <;> simp_all +decide [ add_mul, mul_add, mul_left_comm, add_assoc ];
    · have := h_invPhi_def 0 b1; have := h_invPhi_def 0 b2; have := h_invPhi_def 0 ( b1 + b2 ) ; aesop;
    · have h_card_roots : Multiset.card (Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C b1)) = 3 := by
        rw [ Polynomial.splits_iff_card_roots ] at h_real1 ; aesop;
      obtain ⟨x₁, x₂, x₃, hx⟩ : ∃ x₁ x₂ x₃ : ℝ, x₁ ≠ x₂ ∧ x₁ ≠ x₃ ∧ x₂ ≠ x₃ ∧ x₁^3 + b1 = 0 ∧ x₂^3 + b1 = 0 ∧ x₃^3 + b1 = 0 := by
        obtain ⟨ x₁, x₂, x₃, h ⟩ := Multiset.card_eq_three.mp h_card_roots;
        use x₁, x₂, x₃;
        have := h ▸ h_nodup1; simp_all +decide [ Multiset.nodup_cons ] ;
        exact ⟨ by replace h := h.symm ▸ Multiset.mem_cons_self _ _; aesop, by replace h := h.symm ▸ Multiset.mem_cons_of_mem ( Multiset.mem_cons_self _ _ ) ; aesop, by replace h := h.symm ▸ Multiset.mem_cons_of_mem ( Multiset.mem_cons_of_mem ( Multiset.mem_cons_self _ _ ) ) ; aesop ⟩;
      exact False.elim <| hx.1 <| by nlinarith [ sq_nonneg ( x₁ + x₂ ), mul_self_pos.2 ( sub_ne_zero.2 hx.1 ), mul_self_pos.2 ( sub_ne_zero.2 hx.2.1 ), mul_self_pos.2 ( sub_ne_zero.2 hx.2.2.1 ) ] ;
    · by_cases hb2 : b2 = 0 <;> simp_all +decide [ Polynomial.splits_iff_card_roots ];
      · norm_num [ Multiset.nsmul_singleton ] at h_nodup2;
      · -- Since $X^3 + C b2$ is a cubic polynomial with a non-zero constant term, it can have at most one real root.
        have h_real_roots : (Polynomial.X ^ 3 + Polynomial.C b2).roots.toFinset.card ≤ 1 := by
          have h_real_roots : ∀ x : ℝ, x^3 + b2 = 0 → ∀ y : ℝ, y^3 + b2 = 0 → x = y := by
            exact fun x hx y hy => by by_contra hxy; exact hxy <| by nlinarith [ sq_nonneg ( x + y ), mul_self_pos.2 ( sub_ne_zero_of_ne hxy ) ] ;
          exact Finset.card_le_one.mpr fun x hx y hy => h_real_roots x ( by simpa using Polynomial.isRoot_of_mem_roots ( Multiset.mem_toFinset.mp hx ) ) y ( by simpa using Polynomial.isRoot_of_mem_roots ( Multiset.mem_toFinset.mp hy ) );
        exact absurd h_real_roots ( by rw [ Multiset.toFinset_card_of_nodup h_nodup2 ] ; linarith );
    · rw [ show ( Polynomial.X ^ 3 + ( Polynomial.C a1 * Polynomial.X + ( Polynomial.C a2 * Polynomial.X + ( Polynomial.C b1 + Polynomial.C b2 ) ) ) ) = ( Polynomial.X ^ 3 + ( Polynomial.C ( a1 + a2 ) * Polynomial.X + ( Polynomial.C ( b1 + b2 ) ) ) ) by simpa using by ring, h_invPhi_def ];
      · -- By the properties of the roots of cubic polynomials, we know that $a_1 < 0$ and $a_2 < 0$.
        have ha1_neg : a1 < 0 := by
          have h_card_roots : Multiset.card (Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a1 * Polynomial.X + Polynomial.C b1)) = 3 := by
            simp_all +decide [ add_assoc, Polynomial.splits_iff_card_roots ];
            rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha1 : a1 = 0 <;> by_cases hb1 : b1 = 0 <;> simp +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt, * ];
          obtain ⟨x1, x2, x3, hx⟩ : ∃ x1 x2 x3 : ℝ, x1 ≠ x2 ∧ x2 ≠ x3 ∧ x3 ≠ x1 ∧ x1^3 + a1 * x1 + b1 = 0 ∧ x2^3 + a1 * x2 + b1 = 0 ∧ x3^3 + a1 * x3 + b1 = 0 := by
            obtain ⟨x1, x2, x3, hx⟩ : ∃ x1 x2 x3 : ℝ, Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a1 * Polynomial.X + Polynomial.C b1) = {x1, x2, x3} := by
              exact Multiset.card_eq_three.mp h_card_roots;
            use x1, x2, x3;
            simp_all +decide [ add_assoc ];
            exact ⟨ Ne.symm <| by tauto, by replace hx := hx.symm ▸ Multiset.mem_cons_self _ _; norm_num at hx; linarith, by replace hx := hx.symm ▸ Multiset.mem_cons_of_mem ( Multiset.mem_cons_self _ _ ) ; norm_num at hx; linarith, by replace hx := hx.symm ▸ Multiset.mem_cons_of_mem ( Multiset.mem_cons_of_mem ( Multiset.mem_cons_self _ _ ) ) ; norm_num at hx; linarith ⟩;
          -- By Vieta's formulas, we know that $x_1 + x_2 + x_3 = 0$ and $x_1 x_2 + x_2 x_3 + x_3 x_1 = a_1$.
          have h_vieta : x1 + x2 + x3 = 0 ∧ x1 * x2 + x2 * x3 + x3 * x1 = a1 := by
            grind;
          cases lt_or_gt_of_ne hx.1 <;> cases lt_or_gt_of_ne hx.2.1 <;> cases lt_or_gt_of_ne hx.2.2.1 <;> nlinarith [ sq_nonneg x1, sq_nonneg x2, sq_nonneg x3 ]
        have ha2_neg : a2 < 0 := by
          have h_card2 : (Polynomial.X ^ 3 + Polynomial.C a2 * Polynomial.X + Polynomial.C b2).roots.toFinset.card = 3 := by
            have h_card2 : Multiset.card (Polynomial.roots (Polynomial.X ^ 3 + Polynomial.C a2 * Polynomial.X + Polynomial.C b2)) = 3 := by
              simp_all +decide [ add_assoc, Polynomial.splits_iff_card_roots ];
              rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha2 : a2 = 0 <;> simp +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt, * ];
            rwa [ Multiset.toFinset_card_of_nodup ];
            simpa only [ add_assoc ] using h_nodup2;
          have h_increasing : StrictMono (fun x : ℝ => x^3 + a2 * x + b2) → False := by
            intro h_mono; have := Finset.one_lt_card.mp ( by linarith ) ; obtain ⟨ x, hx, y, hy, hxy ⟩ := this; exact hxy ( h_mono.injective <| by aesop ) ;
          contrapose! h_increasing;
          exact ⟨ fun x y hxy => by norm_num; nlinarith [ sq_nonneg ( x^2 - y^2 ), pow_pos ( sub_pos.mpr hxy ) 3, mul_le_mul_of_nonneg_left hxy.le h_increasing ], trivial ⟩;
        rw [ div_add_div, div_le_div_iff₀ ] <;> try positivity;
        · nlinarith [ sq_nonneg ( a1 * b2 - a2 * b1 ), mul_pos ( neg_pos.mpr ha1_neg ) ( neg_pos.mpr ha2_neg ), sq_nonneg ( a1 * a2 ), sq_nonneg ( a1 * b1 ), sq_nonneg ( a1 * b2 ), sq_nonneg ( a2 * b1 ), sq_nonneg ( a2 * b2 ), sq_nonneg ( b1 * b2 ) ];
        · nlinarith [ mul_self_pos.2 ha1, mul_self_pos.2 ha2 ];
      · convert h_real3 using 1 ; simpa using by ring;
      · convert h_nodup3 using 2 ; simpa using by ring;

/-
Finite Free Stam Inequality for n=3.
-/
theorem finite_free_stam_inequality_n3 (p q : ℝ[X])
    (hp : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hp_monic : p.Monic) (hp_deg : p.natDegree = 3)
    (hq : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hq_monic : q.Monic) (hq_deg : q.natDegree = 3)
    (hpq : (boxplus 3 p q).Splits (RingHom.id ℝ))
    (hpq_nodup : (boxplus 3 p q).roots.Nodup) :
    invPhi (boxplus 3 p q) ≥ invPhi p + invPhi q := by
      -- Let's denote the shifted polynomials as $p_1$, $q_1$, and $p_1 \boxplus q_1$.
      obtain ⟨c1, hc1⟩ : ∃ c1 : ℝ, (p.comp (X + C c1)).coeff 2 = 0 := by
        apply exists_shift_centered 3 p (by norm_num) hp_monic hp_deg
      obtain ⟨c2, hc2⟩ : ∃ c2 : ℝ, (q.comp (X + C c2)).coeff 2 = 0 := by
        convert exists_shift_centered 3 q ( by decide ) hq_monic hq_deg using 1
      set p1 : ℝ[X] := p.comp (X + C c1)
      set q1 : ℝ[X] := q.comp (X + C c2)
      set pq1 : ℝ[X] := boxplus 3 p1 q1;
      -- By the properties of the boxplus operation and the invariance of invPhi under translation, we have:
      have h_invPhi_eq : invPhi p = invPhi p1 ∧ invPhi q = invPhi q1 ∧ invPhi (boxplus 3 p q) = invPhi pq1 := by
        have h_invPhi_eq : invPhi p = invPhi p1 ∧ invPhi q = invPhi q1 := by
          constructor <;> rw [ invPhi_comp_add_C ];
        have := invPhi_boxplus_shift_invariance_eq 3 p q c1 c2; aesop;
      -- By the properties of the boxplus operation and the invariance of invPhi under translation, we have that $pq1 = X^3 + (a1 + a2)X + (b1 + b2)$.
      obtain ⟨a1, b1, ha1⟩ : ∃ a1 b1 : ℝ, p1 = Polynomial.X^3 + Polynomial.C a1 * Polynomial.X + Polynomial.C b1 := by
        have h_deg_p1 : p1.natDegree = 3 := by
          rw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, hp_deg, mul_one ]
        have h_monic_p1 : p1.Monic := by
          exact hp_monic.comp_X_add_C _
        have h_coeff_p1 : p1.coeff 2 = 0 := by
          exact hc1
        have h_form_p1 : p1 = X^3 + C (p1.coeff 1) * X + C (p1.coeff 0) := by
          exact?
        use p1.coeff 1, p1.coeff 0
      obtain ⟨a2, b2, ha2⟩ : ∃ a2 b2 : ℝ, q1 = Polynomial.X^3 + Polynomial.C a2 * Polynomial.X + Polynomial.C b2 := by
        use q1.coeff 1, q1.coeff 0;
        convert cubic_reduced_form q1 _ _ _ using 1;
        · exact hq_monic.comp_X_add_C _;
        · rw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, hq_deg, mul_one ];
        · exact hc2
      have hpq1 : pq1 = Polynomial.X^3 + Polynomial.C (a1 + a2) * Polynomial.X + Polynomial.C (b1 + b2) := by
        convert boxplus_deg3_reduced_eq p1 q1 _ _ _ _ _ _ using 1 <;> simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ];
        · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha1 : a1 = 0 <;> simp +decide [ ha1 ];
        · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha2 : a2 = 0 <;> simp +decide [ ha2 ];
        · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha1 : a1 = 0 <;> simp +decide [ ha1 ];
        · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha2 : a2 = 0 <;> simp +decide [ ha2 ];
      have h_real1 : Polynomial.Splits (RingHom.id ℝ) (Polynomial.X^3 + Polynomial.C a1 * Polynomial.X + Polynomial.C b1) := by
        rw [ ← ha1 ];
        exact?
      have h_real2 : Polynomial.Splits (RingHom.id ℝ) (Polynomial.X^3 + Polynomial.C a2 * Polynomial.X + Polynomial.C b2) := by
        rw [ ← ha2 ];
        exact?
      have h_real3 : Polynomial.Splits (RingHom.id ℝ) (Polynomial.X^3 + Polynomial.C (a1 + a2) * Polynomial.X + Polynomial.C (b1 + b2)) := by
        have h_real3 : Polynomial.Splits (RingHom.id ℝ) (boxplus 3 (p.comp (X + C c1)) (q.comp (X + C c2))) := by
          convert hpq.comp_X_add_C ( c1 + c2 ) using 1;
          convert boxplus_comp_add_C 3 p q c1 c2 _ _ using 1 <;> norm_num [ hp_deg, hq_deg ];
        aesop
      have h_nodup1 : (Polynomial.X^3 + Polynomial.C a1 * Polynomial.X + Polynomial.C b1).roots.Nodup := by
        have h_nodup1 : (p.comp (X + C c1)).roots.Nodup := by
          exact?;
        grind
      have h_nodup2 : (Polynomial.X^3 + Polynomial.C a2 * Polynomial.X + Polynomial.C b2).roots.Nodup := by
        convert nodup_comp_X_add_C q c2 |>.2 hq_nodup using 1;
        rw [ ← ha2 ]
      have h_nodup3 : (Polynomial.X^3 + Polynomial.C (a1 + a2) * Polynomial.X + Polynomial.C (b1 + b2)).roots.Nodup := by
        rw [ ← hpq1 ] at *;
        rw [ show pq1 = ( boxplus 3 p q |> Polynomial.comp <| Polynomial.X + Polynomial.C ( c1 + c2 ) ) by
              convert boxplus_comp_add_C 3 p q c1 c2 hp_deg hq_deg using 1 ];
        convert nodup_comp_X_add_C _ _ using 1;
        rotate_left;
        exact boxplus 3 p q;
        exact c1 + c2;
        simp [hpq_nodup];
      have := conjecture_n_3_reduced a1 b1 a2 b2 h_real1 h_nodup1 h_real2 h_nodup2 h_real3 h_nodup3; aesop;