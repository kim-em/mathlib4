    (h_poly : poly_diff t x y ≥ 0) :
    let Z := t^2 * x + (1 - t)^2 * y + t * (1 - t) / 6
    f_aux Z ≥ t * f_aux x + (1 - t) * f_aux y := by
      unfold f_aux;
      field_simp;
      rw [ le_div_iff₀ ] <;> unfold poly_diff at h_poly <;> nlinarith [ mul_pos ht ( mul_pos hx hy ) ]

/-
Structure of Case 4: if x+y > 1/6 and Z < 1/12, then one variable is > 1/12 and the other < 1/12, and t is restricted.
-/
lemma case4_structure (t x y : ℝ)
    (ht : 0 < t) (ht1 : t < 1)
    (hx : 0 < x) (hy : 0 < y)
    (hsum : x + y > 1/6)
    (hZ : t^2 * x + (1 - t)^2 * y + t * (1 - t) / 6 < 1/12) :
    (x > 1/12 ∧ y < 1/12 ∧ t < 1/2) ∨ (y > 1/12 ∧ x < 1/12 ∧ t > 1/2) := by
      by_cases hx12 : x > 1 / 12;
      · exact Or.inl ⟨ hx12, by nlinarith [ mul_pos ht ( sub_pos_of_lt ht1 ) ], by nlinarith [ mul_pos ht ( sub_pos_of_lt ht1 ) ] ⟩;
      · by_cases hy12 : y > 1 / 12;
        · exact Or.inr ⟨ hy12, lt_of_le_of_ne ( le_of_not_gt hx12 ) ( by rintro rfl; nlinarith ), by nlinarith [ sq_nonneg ( t - 1 / 2 ) ] ⟩;
        · nlinarith [ sq_nonneg ( t - 1 / 2 ) ]