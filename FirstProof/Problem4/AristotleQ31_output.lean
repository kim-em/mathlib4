/-
Definition of the auxiliary function f_aux used in the parametrization of the inverse Phi functional for symmetric quartics.
-/
def f_aux (k : ℝ) : ℝ := (2 * k * (1 - 4 * k)) / (12 * k + 1)

/-
Definition of h_aux, a transformed version of f_aux.
-/
def h_aux (x : ℝ) : ℝ := (2 * x * (1/4 - x)) / (1 - 3 * x)

/-
Equivalence between f_aux and the transformed function h_aux.
-/
lemma f_aux_eq_h_aux (k : ℝ) (hk : k < 1/3) :
