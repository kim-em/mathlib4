  stam_poly_H x y 0 x' y' 0 ≤ 0 := by
    revert h1 h2 h3;
    unfold stam_domain stam_poly_H;
    intro hx hy hxy;
    unfold stam_Num stam_Denom;
    -- Apply the symmetric_ratio_inequality with a = x, b = y, a' = x', and b' = y'.
    have h_symm : (y + y')^2 / ((x + x') * ((x + x')^2 + (y + y'))) ≤ y^2 / (x * (x^2 + y)) + y'^2 / (x' * (x'^2 + y')) := by
      convert symmetric_ratio_inequality x y x' y' hx.1 ( abs_lt.mpr ⟨ by nlinarith, by nlinarith ⟩ ) hy.1 ( abs_lt.mpr ⟨ by nlinarith, by nlinarith ⟩ ) using 1;
    rw [ div_le_iff₀ ] at h_symm;
    · rw [ div_add_div, div_mul_eq_mul_div, le_div_iff₀ ] at h_symm <;> try nlinarith;
      · nlinarith [ show 0 < ( x + x' ) * ( ( x + x' ) ^ 2 - ( y + y' ) ) * ( x ^ 2 - y ) * ( x' ^ 2 - y' ) by exact mul_pos ( mul_pos ( mul_pos hxy.1 ( by nlinarith ) ) ( by nlinarith ) ) ( by nlinarith ) ];
      · exact mul_pos ( mul_pos hx.1 hx.2.1 ) ( mul_pos hy.1 hy.2.1 );
    · nlinarith

/-
Decomposition of stam_H into S1, S2, S3.
-/
def stam_S1 (x y w : ℝ) : ℝ := -w^2 / (6*(x^2+y))
def stam_S2 (x y : ℝ) : ℝ := -4*x*(x^2+2*y) / (3*(x^2+y))
def stam_S3 (x y w : ℝ) : ℝ := 16*(x^2+y)*(x^2-y) / (3*(4*x^3 - 4*x*y - w^2))

theorem stam_H_decomposition (x y w : ℝ)
  (h : stam_domain x y w) :
  stam_H x y w = stam_S1 x y w + stam_S2 x y + stam_S3 x y w := by
    unfold stam_H stam_S1 stam_S2 stam_S3;
    unfold Q_quartic D_cumulant;
    by_cases h1 : x ^ 2 + y = 0 <;> by_cases h2 : 4 * x ^ 3 - 4 * x * y - w ^ 2 = 0 <;> simp_all +decide [ mul_assoc, mul_comm, mul_left_comm ];
    · exact absurd h2 ( by nlinarith [ h.1, h.2.1, h.2.2 ] );
    · rw [ div_add_div, div_add_div, div_eq_div_iff ] <;> first | positivity | ring;
      cases lt_or_gt_of_ne h1 <;> cases lt_or_gt_of_ne h2 <;> nlinarith [ h.1, h.2.1, h.2.2 ]

/-
Defining stam_g and stating its convexity (second derivative non-negative).
-/
def stam_g (x y u : ℝ) : ℝ :=
  (32*y^2*(x^2-y) + 4*x*(x^2+5*y)*u + u^2) / (6*(x^2+y)*(4*x^3 - 4*x*y - u))

lemma stam_g_convex_check (x y u : ℝ)
  (hx : x > 0) (hy : x^2 + y > 0) (hu : 4*x^3 - 4*x*y - u > 0) (h_bound : x^2 - y > 0) :
  deriv^[2] (fun t => stam_g x y t) u ≥ 0 := by
  unfold stam_g;
  -- By simplifying, we can see that the second derivative is non-negative.
  have h_simp : deriv (deriv (fun t => (32 * y^2 * (x^2 - y) + 4 * x * (x^2 + 5 * y) * t + t^2) / (6 * (x^2 + y) * (4 * x^3 - 4 * x * y - t)))) u = deriv (fun t => (6 * (x^2 + y) * (4 * x^3 - 4 * x * y - t) * (4 * x * (x^2 + 5 * y) + 2 * t) + (32 * y^2 * (x^2 - y) + 4 * x * (x^2 + 5 * y) * t + t^2) * (6 * (x^2 + y))) / (6 * (x^2 + y) * (4 * x^3 - 4 * x * y - t))^2) u := by
    field_simp;
    refine' Filter.EventuallyEq.deriv_eq _;
    filter_upwards [ Iio_mem_nhds ( show u < 4 * x ^ 3 - 4 * x * y by linarith ) ] with t ht;
    simp +zetaDelta at *;
    norm_num [ mul_comm ];
    convert HasDerivAt.deriv ( HasDerivAt.div ( HasDerivAt.add ( HasDerivAt.add ( hasDerivAt_const _ _ ) ( HasDerivAt.mul ( hasDerivAt_id t ) ( hasDerivAt_const _ _ ) ) ) ( hasDerivAt_pow 2 t ) ) ( HasDerivAt.mul ( HasDerivAt.sub ( hasDerivAt_const _ _ ) ( hasDerivAt_id t ) ) ( hasDerivAt_const _ _ ) ) _ ) using 1 <;> norm_num;
    · rw [ ← mul_div_mul_right _ _ ( by positivity : ( x ^ 2 + y ) * 6 ≠ 0 ) ] ; ring;
    · exact ⟨ by nlinarith, by linarith ⟩;
  norm_num [ h_simp ];
  norm_num [ mul_comm, sub_mul ];
  norm_num [ show x ^ 3 * 4 * ( ( x ^ 2 + y ) * 6 ) - y * ( x * 4 ) * ( ( x ^ 2 + y ) * 6 ) - u * ( ( x ^ 2 + y ) * 6 ) ≠ 0 by nlinarith ];
  field_simp;
  rw [ le_div_iff₀ ];
  · nlinarith [ sq_nonneg ( x * 4 * ( x ^ 2 - y ) - u - ( x * 4 * ( x ^ 2 + y * 5 ) + 2 * u ) ), mul_pos hx hy, mul_pos hx ( sub_pos.mpr h_bound ), mul_pos hx ( sub_pos.mpr hu ), mul_pos hy ( sub_pos.mpr h_bound ), mul_pos hy ( sub_pos.mpr hu ), mul_pos ( sub_pos.mpr h_bound ) ( sub_pos.mpr hu ) ];
  · exact pow_pos ( by nlinarith ) _

/-
Proving stam_H(x,y,w) = stam_g(x,y,w^2).
-/
lemma stam_H_eq_g_sq (x y w : ℝ) :
  stam_H x y w = stam_g x y (w^2) := by
    unfold stam_H stam_g;
    unfold Q_quartic D_cumulant; ring;

/-
Decomposition of stam_H into q and remainder.
-/
def stam_q (x y : ℝ) : ℝ := y^2 / (x * (x^2 + y))

def stam_H_rem (x y w : ℝ) : ℝ :=
  -w^2 / (6*(x^2+y)) + 16*(x^4-y^2) / (3*(4*x^3 - 4*x*y - w^2)) - 4*(x^2+y)/(3*x)

lemma stam_H_decomposition_rem (x y w : ℝ)
  (h : stam_domain x y w) :
  stam_H x y w = 4/3 * stam_q x y + stam_H_rem x y w := by
    unfold stam_H stam_q stam_H_rem; ring;
    unfold Q_quartic D_cumulant; ring;
    rcases h with ⟨ hx, hy, hw ⟩;
    field_simp;
    grind

/-
Proving stam_domain implies feasible, and non-negativity of Num/Denom.
-/
lemma stam_domain_implies_feasible (x y w : ℝ) (h : stam_domain x y w) :
  quartic_cumulant_feasible (-x) (w/3) y := by
    exact ⟨ neg_neg_of_pos h.1, by nlinarith [ h.1, h.2.1, h.2.2 ], by nlinarith [ h.1, h.2.1, h.2.2 ] ⟩

lemma stam_Denom_pos (x y w : ℝ) (h : stam_domain x y w) :
  stam_Denom x y w > 0 := by
    exact mul_pos ( by linarith [ h.1, h.2.1 ] ) ( by linarith [ h.1, h.2.1, h.2.2 ] )

lemma stam_Num_nonneg (x y w : ℝ) (h : stam_domain x y w) :
  stam_Num x y w ≥ 0 := by
    -- Let's expand the polynomial stam_poly_H for the case when w=0 and x ≠ x'.
    by_contra h_neg;
    -- By definition of $stam_Num$, we know that $stam_Num x y w \geq 0$.
    have h_nonneg : ∀ x y w : ℝ, 0 < x → 0 < x ^ 2 + y → 0 < 4 * x ^ 3 - 4 * x * y - w ^ 2 → stam_Num x y w ≥ 0 := by
      intros x y w hx hy hw
      have h_nonneg : 32 * y^2 * (x^2 - y) + 4 * x * (x^2 + 5 * y) * w^2 + w^4 ≥ 0 := by
        by_cases h_case2 : x^2 + 5 * y ≤ 0;
        · have h_nonneg : 32 * y^2 * (x^2 - y) + w^4 ≥ 2 * Real.sqrt (32 * y^2 * (x^2 - y) * w^4) := by
            nlinarith only [ sq_nonneg ( 32 * y ^ 2 * ( x ^ 2 - y ) - w ^ 4 ), show 0 ≤ 32 * y ^ 2 * ( x ^ 2 - y ) by exact mul_nonneg ( mul_nonneg ( by norm_num ) ( sq_nonneg _ ) ) ( by nlinarith ), show 0 ≤ w ^ 4 by positivity, Real.mul_self_sqrt ( show 0 ≤ 32 * y ^ 2 * ( x ^ 2 - y ) * w ^ 4 by exact mul_nonneg ( mul_nonneg ( mul_nonneg ( by norm_num ) ( sq_nonneg _ ) ) ( by nlinarith ) ) ( by positivity ) ) ];
          have h_nonneg : 2 * Real.sqrt (32 * y^2 * (x^2 - y) * w^4) ≥ -4 * x * (x^2 + 5 * y) * w^2 := by
            have h_nonneg : 4 * (32 * y^2 * (x^2 - y) * w^4) ≥ (4 * x * (x^2 + 5 * y) * w^2)^2 := by
              have h_nonneg : 4 * (32 * y^2 * (x^2 - y)) ≥ (4 * x * (x^2 + 5 * y))^2 := by
                nlinarith [ sq_nonneg ( x^2 + 5*y + 4*y ), sq_nonneg ( x^2 + 5*y - 4*y ), sq_nonneg ( x^2 + 5*y + 2*y ), sq_nonneg ( x^2 + 5*y - 2*y ), sq_nonneg ( x^2 + 5*y + y ), sq_nonneg ( x^2 + 5*y - y ), sq_nonneg ( x^2 + 5*y + 3*y ), sq_nonneg ( x^2 + 5*y - 3*y ), sq_nonneg ( x^2 + 5*y + 6*y ), sq_nonneg ( x^2 + 5*y - 6*y ) ];
              nlinarith only [ h_nonneg, show 0 ≤ w ^ 4 by positivity ];
            nlinarith only [ h_nonneg, Real.sqrt_nonneg ( 32 * y ^ 2 * ( x ^ 2 - y ) * w ^ 4 ), Real.mul_self_sqrt ( show 0 ≤ 32 * y ^ 2 * ( x ^ 2 - y ) * w ^ 4 by exact mul_nonneg ( mul_nonneg ( mul_nonneg ( by norm_num ) ( sq_nonneg _ ) ) ( by nlinarith ) ) ( by positivity ) ) ];
          linarith;
        · exact add_nonneg ( add_nonneg ( mul_nonneg ( mul_nonneg ( by norm_num ) ( sq_nonneg _ ) ) ( by nlinarith ) ) ( mul_nonneg ( mul_nonneg ( by positivity ) ( by nlinarith ) ) ( sq_nonneg _ ) ) ) ( by positivity );
      exact le_of_sub_nonneg ( by unfold stam_Num; nlinarith );
    exact h_neg <| h_nonneg x y w h.1 h.2.1 h.2.2

/-
Decomposition of stam_H into q and diff.
-/
def stam_Term (x y w : ℝ) : ℝ :=
  -1/(6*(x^2+y)) + 4*(x^2+y)/(3*x*(4*x^3-4*x*y-w^2))

def stam_diff (x y w : ℝ) : ℝ := w^2 * stam_Term x y w

lemma stam_H_eq_q_plus_diff (x y w : ℝ)
  (h : stam_domain x y w) :
  stam_H x y w = 4/3 * stam_q x y + stam_diff x y w := by
    unfold stam_H stam_diff; ring;
    unfold Q_quartic D_cumulant stam_Term stam_q; ring;
    rcases h with ⟨ hx, hy, hw ⟩;
    field_simp;
    grind

/-
Defining poly_q and proving it is non-positive.
-/
def poly_q (x y x' y' : ℝ) : ℝ :=
  let Nq1 := y^2
  let Dq1 := x * (x^2 + y)
  let Nq2 := y'^2
  let Dq2 := x' * (x'^2 + y')
  let Nqs := (y+y')^2
  let Dqs := (x+x') * ((x+x')^2 + (y+y'))
  Nqs * Dq1 * Dq2 - Nq1 * Dqs * Dq2 - Nq2 * Dqs * Dq1

lemma poly_q_nonpos (x y x' y' : ℝ)
  (h1 : stam_domain x y 0)
  (h2 : stam_domain x' y' 0)
  (h3 : stam_domain (x+x') (y+y') 0) :
  poly_q x y x' y' ≤ 0 := by
    unfold poly_q;
    have := @symmetric_ratio_inequality x y x' y' ?_ ?_ ?_ ?_;
    · simp +zetaDelta at *;
      rw [ div_add_div, div_le_div_iff₀ ] at this <;> try nlinarith [ h1.1, h1.2.1, h2.1, h2.2.1, h3.1, h3.2.1 ];
      exact mul_pos ( mul_pos h1.1 ( by nlinarith [ h1.2.1 ] ) ) ( mul_pos h2.1 ( by nlinarith [ h2.2.1 ] ) );
    · exact h1.1;
    · cases abs_cases y <;> nlinarith [ h1.1, h1.2.1, h1.2.2 ];
    · exact h2.1;
    · rw [ abs_lt ] ; constructor <;> nlinarith [ h1.1, h1.2.1, h1.2.2, h2.1, h2.2.1, h2.2.2, h3.1, h3.2.1, h3.2.2 ]

/-
Defining values for remainder and q terms.
-/
noncomputable def stam_rem_val (x y w : ℝ) : ℝ :=
  stam_H_rem x y w

noncomputable def stam_q_val (x y : ℝ) : ℝ :=
  4/3 * stam_q x y