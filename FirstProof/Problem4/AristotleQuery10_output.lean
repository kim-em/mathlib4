lemma Phi_eq_of_roots_eq {p q : ℝ[X]} (h : p.roots = q.roots) : Phi p = Phi q := by
  unfold Phi
  rw [h]

lemma coeff_comp_neg_X (p : ℝ[X]) (i : ℕ) :
  (p.comp (-X)).coeff i = (-1 : ℝ)^i * p.coeff i := by
  norm_num [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
  rw [ Finset.sum_eq_single i ] <;> norm_num;
  · ring_nf;
    by_cases hi : Even i <;> aesop;
  · ring_nf;
    intro b hb hbi; by_cases hi : Even b <;> aesop;
  · exact fun hi => Or.inl <| Polynomial.coeff_eq_zero_of_natDegree_lt hi

lemma scaleRoots_neg_one_eq (p : ℝ[X]) :
  p.scaleRoots (-1) = C ((-1 : ℝ) ^ p.natDegree) * p.comp (-X) := by
    ext i; rw [ Polynomial.coeff_scaleRoots ] ; by_cases hi : i ≤ p.natDegree <;> simp +decide [ *, Polynomial.coeff_eq_zero_of_natDegree_lt ] ; ring;
    · rw [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
      rw [ Finset.sum_mul, Polynomial.finset_sum_coeff ];
      rw [ Finset.sum_eq_single i ] <;> norm_num ; ring;
      · by_cases hi' : Even i <;> by_cases hi'' : Even p.natDegree <;> simp_all +decide [ Nat.even_sub hi ];
        · simp_all +decide [ Nat.even_sub hi, parity_simps ];
        · cases le_iff_exists_add'.mp hi ; simp_all +decide [ parity_simps ];
          by_cases hi''' : Even ‹_› <;> simp_all +decide [ parity_simps ];
          exact False.elim <| Nat.not_even_iff_odd.mpr hi' hi'';
        · cases hi'' ; cases hi' ; simp_all +decide [ Nat.even_sub hi ];
          norm_num [ ← mul_tsub ];
      · intro j hj₁ hj₂; ring_nf;
        by_cases hi' : Even j <;> by_cases hj' : Even p.natDegree <;> aesop;
      · exact fun h => False.elim <| h.not_lt <| Nat.lt_succ_of_le hi;
    · simp +zetaDelta at *;
      rw [ Polynomial.coeff_eq_zero_of_natDegree_lt hi, Polynomial.coeff_eq_zero_of_natDegree_lt ] ; aesop;
      by_cases h : Even p.natDegree <;> simp_all +decide [ Polynomial.natDegree_comp, Polynomial.natDegree_neg ]

