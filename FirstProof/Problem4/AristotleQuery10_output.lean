open Polynomial BigOperators Finset Classical

def power_sum_correct (A B C_coeff : ℝ) (k : ℕ) : ℝ :=
  match k with
  | 0 => 4
  | 1 => 0
  | 2 => -2 * A
  | 3 => -3 * B
  | 4 => 2 * A^2 - 4 * C_coeff
  | 5 => 5 * A * B
  | 6 => -2 * A^3 + 6 * A * C_coeff + 3 * B^2
  | 7 => -7 * A^2 * B + 7 * B * C_coeff
  | 8 => 2 * A^4 - 8 * A^2 * C_coeff - 8 * A * B^2 + 4 * C_coeff^2
  | 9 => 9 * A^3 * B - 18 * A * B * C_coeff - 3 * B^3
  | 10 => -2 * A^5 + 10 * A^3 * C_coeff + 15 * A^2 * B^2 - 10 * A * C_coeff^2 - 10 * B^2 * C_coeff
  | _ => 0

def D0_poly (A : ℝ) : ℝ[X] := (-X)^2 * (C A + X^2)^2 - 4 * (C A + X^2)^3
def D1_poly (A : ℝ) : ℝ[X] := -4 * (-X)^3 + 18 * (-X) * (C A + X^2)
def D2_poly : ℝ[X] := -27
def Q_poly (A : ℝ) : ℝ[X] := C A * X + X^3
def Term_poly (A : ℝ) : ℝ[X] := (6 * X^2 + C A)^2

def Poly_B0 (A : ℝ) : ℝ[X] := Term_poly A * (D0_poly A - D1_poly A * Q_poly A + D2_poly * (Q_poly A)^2)
def Poly_B1 (A : ℝ) : ℝ[X] := Term_poly A * (-D1_poly A + 2 * D2_poly * Q_poly A)
def Poly_B2 (A : ℝ) : ℝ[X] := Term_poly A * D2_poly

/-
Loading user context (part 8)
-/
open Polynomial BigOperators Finset Classical

def partial_discriminant_roots (i : Fin 4) (r : Fin 4 → ℝ) : ℝ :=
  ∏ j ∈ Finset.univ.filter (· ≠ i), ∏ k ∈ Finset.univ.filter (fun x => x ≠ i ∧ j < x), (r j - r k)^2

def Phi_Disc_sum_roots (A : ℝ) (r : Fin 4 → ℝ) : ℝ :=
  ∑ i, (6 * (r i)^2 + A)^2 * partial_discriminant_roots i r

lemma partial_discriminant_eq_roots (i : Fin 4) (A B : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_e3 : e3_sum r = -B) :
  partial_discriminant (r i) A B = partial_discriminant_roots i r := by
  unfold partial_discriminant partial_discriminant_roots;
  fin_cases i <;> simp +decide [ Fin.sum_univ_four, Fin.prod_univ_four, Finset.prod_filter ] at *;
  · unfold e2_sum e3_sum at *;
    simp_all +decide [ Fin.sum_univ_four ];
    unfold cubic_discriminant_e; rw [ ← h_e3, ← h_e2 ] ; ring;
    grind +ring;
  · unfold e2_sum e3_sum at *;
    simp_all +decide [ Fin.sum_univ_four ];
    rw [ ← eq_sub_iff_add_eq' ] at h_sum ; subst_vars ; ring;
    rw [ show B = - ( r 0 * r 1 * r 2 + r 0 * r 1 * r 3 + r 0 * r 2 * r 3 + r 1 * r 2 * r 3 ) by linarith ] ; rw [ h_sum ] ; ring;
    unfold cubic_discriminant_e; ring;
  · unfold cubic_discriminant_e e2_sum e3_sum at *;
    simp_all +decide [ Fin.sum_univ_four ];
    grind +ring;
  · unfold e2_sum e3_sum at *;
    simp_all +decide [ Fin.sum_univ_four ];
    unfold cubic_discriminant_e;
    grind +ring

lemma Phi_Disc_sum_eq_sum_polys (A B : ℝ) (r : Fin 4 → ℝ) :
  Phi_Disc_sum A B r =
  (∑ i, (Poly_B0 A).eval (r i)) +
  B * (∑ i, (Poly_B1 A).eval (r i)) +
  B^2 * (∑ i, (Poly_B2 A).eval (r i)) := by
    convert Phi_Disc_sum_decomposition A B r using 1 ; ring!;
    unfold Poly_B0 Poly_B1 Poly_B2; norm_num [ Fin.sum_univ_four ] ; ring;
    unfold Term_poly D0_poly D1_poly Q_poly D2_poly; norm_num ; ring;

lemma sum_r_pow_eq_power_sum (A B C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_roots : ∀ i, (r i)^4 + A * (r i)^2 + B * (r i) + C_coeff = 0)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_e3 : e3_sum r = -B)
  (h_prod : ∏ i, r i = C_coeff) :
  ∀ k ∈ Finset.range 11, ∑ i, (r i)^k = power_sum_correct A B C_coeff k := by
    intro k hk;
    rcases k with ( _ | _ | _ | _ | _ | _ | _ | k ) <;> norm_num [ Fin.sum_univ_four ] at hk ⊢;
    all_goals norm_num [ Fin.sum_univ_four, e2_sum, e3_sum, power_sum_correct ] at *;
    grind;
    grind;
    · grind +ring;
    · grind;
    · grind +ring;
    · grind;
    · interval_cases _ : k + 1 + 1 + 1 + 1 + 1 + 1 + 1 <;> simp_all +decide;
      · grind +ring;
      · grind +ring;
      · grind +ring;
      · grind

/-
The Phi * Disc product for a general centered quartic is given by -4 * (A^2 + 12C) * (2A^3 - 8AC + 9B^2).
-/
theorem Phi_Disc_sum_eq_general (A B C_coeff : ℝ) (r : Fin 4 → ℝ)
    (h_roots : ∀ i, (r i)^4 + A * (r i)^2 + B * (r i) + C_coeff = 0)
    (h_sum : ∑ i, r i = 0)
    (h_e2 : e2_sum r = A)
    (h_e3 : e3_sum r = -B)
    (h_prod : ∏ i, r i = C_coeff) :
    Phi_Disc_sum A B r = -4 * (A^2 + 12*C_coeff) * (2*A^3 - 8*A*C_coeff + 9*B^2) := by
  rw [Phi_Disc_sum_eq_sum_polys]
  have h_pow : ∀ k < 11, ∑ i, (r i)^k = power_sum_correct A B C_coeff k := by
    intro k hk
    apply sum_r_pow_eq_power_sum A B C_coeff r h_roots h_sum h_e2 h_e3 h_prod
    simp [Finset.mem_range, hk]
  have h_B2 : ∑ i, (Poly_B2 A).eval (r i) = -1404*A^2 + 3888*C_coeff := by
    unfold Poly_B2;
    -- Substitute the known values of the sums of powers of roots into the expression.
    have h_subst : ∑ i, (6 * r i ^ 2 + A) ^ 2 = 52 * A ^ 2 - 144 * C_coeff := by
      convert sum_sq_6r2_plus_A A C_coeff r h_sum h_e2 h_prod using 1;
    unfold Term_poly D2_poly; norm_num [ Fin.sum_univ_four ] at *; linarith!;
  have h_B1 : ∑ i, (Poly_B1 A).eval (r i) = 2616*A^2*B - 10080*B*C_coeff := by
    unfold Poly_B1;
    unfold Term_poly D1_poly D2_poly Q_poly;
    simp +decide [ Fin.sum_univ_four ] at *;
    unfold power_sum_correct at *;
    grind +ring
  have h_B0 : ∑ i, (Poly_B0 A).eval (r i) = -8*A^5 - 64*A^3*C_coeff - 1248*A^2*B^2 + 384*A*C_coeff^2 + 5760*B^2*C_coeff := by
    unfold Poly_B0;
    unfold Term_poly D0_poly D1_poly D2_poly Q_poly;
    ring_nf;
    norm_num [ Finset.sum_add_distrib, Finset.mul_sum _ _ _, Finset.sum_mul _ _ _, Polynomial.eval_finset_sum ];
    norm_num [ ← Finset.sum_mul _ _ _, ← Finset.mul_sum, ← Finset.sum_add_distrib, h_pow ];
    unfold power_sum_correct; norm_num; ring;
  rw [h_B0, h_B1, h_B2]
  ring

/-
The product of the partial discriminant and the square of the derivative at a root equals the quartic discriminant.
-/
lemma partial_discriminant_identity (A B C_coeff r : ℝ)
  (h_root : r^4 + A * r^2 + B * r + C_coeff = 0) :
  partial_discriminant r A B * (4 * r^3 + 2 * A * r + B)^2 = quartic_discriminant A B C_coeff := by
  -- Substitute C_coeff = -r^4 - A r^2 - B r
  have hC : C_coeff = -r^4 - A * r^2 - B * r := by linarith
  rw [hC]
  unfold partial_discriminant cubic_discriminant_e quartic_discriminant
  ring

/-
The value of Phi for a general centered quartic is given by the formula involving A, B, C and the discriminant.
-/
theorem Phi_quartic_general (A B C_coeff : ℝ)
    (h : quartic_has_distinct_real_roots A B C_coeff)
    (h_disc : quartic_discriminant A B C_coeff ≠ 0) :
    Phi (X^4 + C A * X^2 + C B * X + C C_coeff) =
    -4 * (A^2 + 12*C_coeff) * (2*A^3 - 8*A*C_coeff + 9*B^2) /
    quartic_discriminant A B C_coeff := by
  let p := X^4 + C A * X^2 + C B * X + C C_coeff
  have h_splits : p.Splits (RingHom.id ℝ) := h.1
  have h_nodup : p.roots.Nodup := h.2
  have h_natDegree : p.natDegree = 4 := by
    rw [ Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : A = 0 <;> by_cases hb : B = 0 <;> norm_num [ Polynomial.natDegree_add_eq_left_of_natDegree_lt, ha, hb ]
  have h_card : p.roots.card = 4 := by
    rw [ Polynomial.splits_iff_card_roots ] at h_splits ; aesop
  -- Extract roots as a function r : Fin 4 → ℝ
  let r_list := p.roots.sort (· ≤ ·)
  have h_len : r_list.length = 4 := by
    aesop
  let r := fun (i : Fin 4) => r_list.get ⟨i, by rw [h_len]; exact i.isLt⟩
  have h_roots_eq : p.roots = (r_list : Multiset ℝ) := by
    aesop
  have h_r_roots : ∀ i, (r i)^4 + A * (r i)^2 + B * (r i) + C_coeff = 0 := by
    intro i
    have h_root : r i ∈ p.roots := by
      exact h_roots_eq.symm ▸ Multiset.mem_coe.mpr ( List.getElem_mem _ )
    generalize_proofs at *;
    exact Polynomial.isRoot_of_mem_roots h_root |> fun h => by aesop;
  have h_sum : ∑ i, r i = 0 := by
    have h_vieta_sum : p = Polynomial.C 1 * (∏ i : Fin 4, (Polynomial.X - Polynomial.C (r i))) := by
      refine' Polynomial.eq_of_degree_sub_lt_of_eval_finset_eq _ _ _;
      exact Finset.image r Finset.univ;
      · refine' lt_of_lt_of_le ( Polynomial.degree_sub_lt _ _ _ ) _ <;> norm_num [ Polynomial.degree_prod, Polynomial.degree_X_pow_sub_C, h_natDegree ];
        · rw [ Polynomial.degree_eq_natDegree ] <;> aesop ( simp_config := { singlePass := true } );
        · exact ne_of_apply_ne Polynomial.natDegree ( by aesop );
        · rw [ Polynomial.leadingCoeff_prod ] ; norm_num [ Polynomial.leadingCoeff_X_sub_C ];
          rw [ Polynomial.leadingCoeff, h_natDegree ] ; aesop;
        · rw [ Finset.card_image_of_injective _ fun i j hij => _ ] <;> norm_num [ Fin.ext_iff ] at *;
          · exact Polynomial.degree_le_of_natDegree_le h_natDegree.le;
          · intro i j hij; have := List.nodup_iff_injective_get.mp ( show List.Nodup r_list from by simpa [ h_roots_eq ] using h_nodup ) ; have := @this ⟨ i, by aesop ⟩ ⟨ j, by aesop ⟩ ; aesop;
      · simp +zetaDelta at *;
        intro i; rw [ Finset.prod_eq_prod_diff_singleton_mul ( Finset.mem_univ i ) ] ; simp +decide [ h_r_roots i ] ;
    replace h_vieta_sum := congr_arg ( fun q => Polynomial.coeff q 3 ) h_vieta_sum ; norm_num [ Polynomial.coeff_X, Polynomial.coeff_C, Fin.prod_univ_four, sub_mul ] at h_vieta_sum;
    norm_num +zetaDelta at *;
    norm_num [ Fin.sum_univ_four, Polynomial.coeff_X, Polynomial.coeff_C, mul_sub ] at * ; linarith!
  have h_e2 : e2_sum r = A := by
    -- By Vieta's formulas, the sum of the products of the roots taken two at a time is equal to $A$.
    have h_vieta_e2 : ∑ i, ∑ j, (if i < j then r i * r j else 0) = A := by
      have h_poly : p = Polynomial.C 1 * (∏ i, (Polynomial.X - Polynomial.C (r i))) := by
        convert Polynomial.eq_prod_roots_of_splits_id h_splits using 1;
        rw [ h_roots_eq ];
        norm_num [ Fin.prod_univ_succ ];
        rcases r_list with ( _ | ⟨ x, _ | ⟨ y, _ | ⟨ z, _ | ⟨ w, _ | r_list ⟩ ⟩ ⟩ ⟩ ) <;> norm_num at *;
        all_goals norm_num at h_len;
        · rw [ Polynomial.leadingCoeff, h_natDegree ] ; norm_num [ r ];
          simp +zetaDelta at *;
        · linarith
      replace h_poly := congr_arg ( fun q => Polynomial.coeff q 2 ) h_poly ; norm_num [ Fin.sum_univ_four, Polynomial.coeff_X, Polynomial.coeff_C, Fin.prod_univ_four ] at h_poly ⊢;
      norm_num [ Fin.ext_iff, Polynomial.coeff_X, mul_sub ] at h_poly ⊢;
      simp +zetaDelta at *;
      linarith!;
    exact h_vieta_e2
  have h_e3 : e3_sum r = -B := by
    -- By Vieta's formulas, the sum of the products of the roots taken three at a time is equal to -B.
    have h_vieta_e3 : ∑ i ∈ Finset.univ, ∑ j ∈ Finset.univ, ∑ k ∈ Finset.univ, (if i < j ∧ j < k then r i * r j * r k else 0) = -B := by
      have h_poly : p = Polynomial.C 1 * (Polynomial.X - Polynomial.C (r 0)) * (Polynomial.X - Polynomial.C (r 1)) * (Polynomial.X - Polynomial.C (r 2)) * (Polynomial.X - Polynomial.C (r 3)) := by
        have h_poly : p = Polynomial.C 1 * Multiset.prod (Multiset.map (fun r => Polynomial.X - Polynomial.C r) p.roots) := by
          convert Polynomial.eq_prod_roots_of_splits_id h_splits;
          rw [ Polynomial.leadingCoeff, h_natDegree ] ; aesop
        generalize_proofs at *;
        rw [ h_poly, h_roots_eq ];
        rcases r_list with ( _ | ⟨ x, _ | ⟨ y, _ | ⟨ z, _ | ⟨ w, _ | r_list ⟩ ⟩ ⟩ ⟩ ) <;> norm_num at *;
        · ring!;
        · linarith
      norm_num [ Fin.sum_univ_succ ] at *;
      simp +zetaDelta at *;
      exact Eq.symm ( by { have eq₁ := congr_arg ( Polynomial.eval 0 ) h_poly; have eq₂ := congr_arg ( Polynomial.eval 1 ) h_poly; have eq₃ := congr_arg ( Polynomial.eval 2 ) h_poly; have eq₄ := congr_arg ( Polynomial.eval 3 ) h_poly; norm_num at eq₁ eq₂ eq₃ eq₄; linarith } );
    exact h_vieta_e3
  have h_prod : ∏ i, r i = C_coeff := by
    have h_prod : ∏ i, r i = Polynomial.coeff p 0 := by
      have h_prod : ∏ i : Fin 4, r i = Multiset.prod p.roots := by
        rw [ h_roots_eq, ← List.prod_ofFn ];
        congr;
        refine' List.ext_get _ _ <;> simp +decide [ h_len ];
        intro n hn hn'; interval_cases n <;> rfl;
      rw [ h_prod, ← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq ( show Polynomial.Monic p from ?_ ) ] <;> norm_num [ h_natDegree, h_card ];
      · norm_num [ Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_multiset_prod ];
        norm_num [ h_card ];
      · rw [ Polynomial.Monic, Polynomial.leadingCoeff, h_natDegree ] ; norm_num [ p ];
    aesop
  -- Apply Phi_Disc_sum_eq_general
  have h_identity := Phi_Disc_sum_eq_general A B C_coeff r h_r_roots h_sum h_e2 h_e3 h_prod
  -- Relate Phi * disc to Phi_Disc_sum
  have h_rel : Phi p * quartic_discriminant A B C_coeff = Phi_Disc_sum A B r := by
    rw [ show Phi p = ∑ i, ( p.derivative.derivative.eval ( r i ) / ( 2 * p.derivative.eval ( r i ) ) ) ^ 2 from ?_, h_identity ];
    · have h_identity : ∀ i, (p.derivative.derivative.eval (r i) / (2 * p.derivative.eval (r i)))^2 * quartic_discriminant A B C_coeff = (6 * r i^2 + A)^2 * partial_discriminant (r i) A B := by
        intro i
        have h_partial_discriminant : partial_discriminant (r i) A B * (4 * (r i)^3 + 2 * A * (r i) + B)^2 = quartic_discriminant A B C_coeff := by
          exact?;
        simp +zetaDelta at *;
        rw [ div_pow, div_mul_eq_mul_div, div_eq_iff ];
        · rw [ ← h_partial_discriminant ] ; ring;
        · grind;
      rw [ Finset.sum_mul _ _ _, Finset.sum_congr rfl fun i _ => h_identity i ] ; aesop;
    · convert Phi_derivative_form p h_splits h_nodup using 1;
      rw [ show p.roots.toFinset = Finset.image r Finset.univ from ?_, Finset.sum_image ];
      · intro i hi j hj hij; have := List.nodup_iff_injective_get.mp ( show List.Nodup r_list from ?_ ) hij; aesop;
        convert h_nodup using 1;
        rw [ ← Multiset.coe_nodup, h_roots_eq ];
      · ext x; simp [h_roots_eq];
        constructor;
        · intro hx;
          obtain ⟨ i, hi ⟩ := List.mem_iff_get.mp hx;
          exact ⟨ ⟨ i, by linarith [ Fin.is_lt i ] ⟩, hi ⟩;
        · rintro ⟨ i, rfl ⟩ ; exact List.get_mem _ _
  rw [eq_div_iff h_disc]
  rw [h_rel]
  rw [h_identity]

/-
A set of cumulants (k2, k3, k4) is feasible if k2 < 0, k2^2 + k4 > 0, and 4k2^3 - 4k2k4 + 9k3^2 < 0.
-/
def quartic_cumulant_feasible (k2 k3 k4 : ℝ) : Prop :=
  k2 < 0 ∧
  k2^2 + k4 > 0 ∧
  4*k2^3 - 4*k2*k4 + 9*k3^2 < 0

/-
Definitions of numerator and denominator for the cumulant formula.
-/
def N_cumulant (k2 k3 k4 : ℝ) : ℝ :=
  16*k2^6 + 72*k2^3*k3^2 - 48*k2^2*k4^2 + 216*k2*k3^2*k4 - 81*k3^4 + 32*k4^3

def D_cumulant (k2 k3 k4 : ℝ) : ℝ :=
  6*(k2^2+k4)*(4*k2^3 - 4*k2*k4 + 9*k3^2)

lemma D_cumulant_neg (k2 k3 k4 : ℝ) (h : quartic_cumulant_feasible k2 k3 k4) :
  D_cumulant k2 k3 k4 < 0 := by
  unfold D_cumulant quartic_cumulant_feasible at *
  nlinarith

theorem invPhi_cumulant_formula_check (k2 k3 k4 : ℝ) :
  let f := fun a b c => - (N_cumulant a b c) / (D_cumulant a b c)
  f k2 k3 k4 = -(16*k2^6 + 72*k2^3*k3^2 - 48*k2^2*k4^2 + 216*k2*k3^2*k4 - 81*k3^4 + 32*k4^3) /
               (6*(k2^2+k4)*(4*k2^3 - 4*k2*k4 + 9*k3^2)) := by
  rfl

/-
Bijection between quartic coefficients and cumulants.
-/
def quartic_cumulants_from_coeffs (A B C_coeff : ℝ) : ℝ × ℝ × ℝ :=
  let k2 := A / 12
  let k3 := B / 24
  let k4 := (C_coeff - A^2 / 12) / 24
  (k2, k3, k4)

lemma quartic_cumulants_coeffs_inverse (A B C_coeff : ℝ) :
  let (k2, k3, k4) := quartic_cumulants_from_coeffs A B C_coeff
  quartic_coeffs_from_cumulants k2 k3 k4 = (A, B, C_coeff) := by
    unfold quartic_coeffs_from_cumulants quartic_cumulants_from_coeffs; ring;

lemma quartic_coeffs_cumulants_inverse (k2 k3 k4 : ℝ) :
  let (A, B, C_coeff) := quartic_coeffs_from_cumulants k2 k3 k4
  quartic_cumulants_from_coeffs A B C_coeff = (k2, k3, k4) := by
    unfold quartic_coeffs_from_cumulants quartic_cumulants_from_coeffs; ring;

/-
Cumulants of centered quartics are additive under boxplus.
-/
def quartic_cumulants_poly (p : ℝ[X]) : ℝ × ℝ × ℝ :=
  quartic_cumulants_from_coeffs (p.coeff 2) (p.coeff 1) (p.coeff 0)

lemma quartic_cumulants_additivity (p q : ℝ[X])
  (hp : is_centered 4 p) (hq : is_centered 4 q) :
  quartic_cumulants_poly (boxplus 4 p q) =
  quartic_cumulants_poly p + quartic_cumulants_poly q := by
    unfold quartic_cumulants_poly;
    unfold boxplus;
    unfold quartic_cumulants_from_coeffs; norm_num [ Finset.sum_range_succ', boxplus_coeff ] ; ring;
    rcases hp with ⟨ hp₁, hp₂, hp₃ ⟩ ; rcases hq with ⟨ hq₁, hq₂, hq₃ ⟩ ; simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
    exact ⟨ by ring, by ring ⟩

/-
invPhi matches the cumulant formula.
-/
theorem invPhi_eq_cumulant_formula (A B C_coeff : ℝ)
    (h : quartic_has_distinct_real_roots A B C_coeff)
    (h_disc : quartic_discriminant A B C_coeff ≠ 0) :
    let (k2, k3, k4) := quartic_cumulants_from_coeffs A B C_coeff
    let f := fun a b c => - (N_cumulant a b c) / (D_cumulant a b c)
    invPhi (X^4 + C A * X^2 + C B * X + C C_coeff) = f k2 k3 k4 := by
      rw [ invPhi, if_pos ];
      · rw [ Phi_quartic_general A B C_coeff h h_disc ];
        unfold quartic_cumulants_from_coeffs N_cumulant D_cumulant quartic_discriminant; ring;
        grind;
      · have := Polynomial.natDegree_eq_card_roots h.1;
        rw [ Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] at this <;> by_cases ha : A = 0 <;> by_cases hb : B = 0 <;> norm_num [ Polynomial.natDegree_add_eq_left_of_natDegree_lt, ha, hb ] at this ⊢;
        · exact ⟨ by simpa [ ha, hb ] using h.2, by linarith ⟩;
        · exact ⟨ by simpa [ ha ] using h.2, by linarith ⟩;
        · exact ⟨ by simpa [ hb ] using h.2, by linarith ⟩;
        · exact ⟨ h.2, by linarith ⟩

/-
N_cumulant is the scaled discriminant.
-/
lemma N_eq_disc (k2 k3 k4 : ℝ) :
  let A := 12 * k2
  let B := 24 * k3
  let C_coeff := 24 * k4 + 12 * k2^2
  N_cumulant k2 k3 k4 = quartic_discriminant A B C_coeff / 110592 := by
  unfold N_cumulant quartic_discriminant
  ring