def Phi_quartic_numerator (A C_coeff : ℝ) : ℝ :=
  -8 * A * (A^2 - 4 * C_coeff) * (A^2 + 12 * C_coeff)

def cubic_discriminant_e (e1 e2 e3 : ℝ) : ℝ :=
  e1^2 * e2^2 - 4 * e2^3 - 4 * e1^3 * e3 - 27 * e3^2 + 18 * e1 * e2 * e3

def partial_discriminant (r_i A B : ℝ) : ℝ :=
  let e1 := -r_i
  let e2 := A + r_i^2
  let e3 := -B - A * r_i - r_i^3
  cubic_discriminant_e e1 e2 e3

def Phi_Disc_sum (A B : ℝ) (r : Fin 4 → ℝ) : ℝ :=
  ∑ i, (6 * (r i)^2 + A)^2 * partial_discriminant (r i) A B

def e2_sum (r : Fin 4 → ℝ) : ℝ :=
  ∑ i, ∑ j, if i < j then r i * r j else 0

def e3_sum (r : Fin 4 → ℝ) : ℝ :=
  ∑ i, ∑ j, ∑ k, if i < j ∧ j < k then r i * r j * r k else 0

lemma Phi_Disc_sum_eq_Num_symm (A C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_e3 : e3_sum r = 0) -- B=0
  (h_prod : ∏ i, r i = C_coeff) :
  Phi_Disc_sum A 0 r = Phi_quartic_numerator A C_coeff := by
  -- Expand definitions
  unfold Phi_Disc_sum Phi_quartic_numerator partial_discriminant cubic_discriminant_e
  -- We need to expand the sums over Fin 4.
  -- Since r is abstract, we can't evaluate the sums to numbers.
  -- But we can use the properties of symmetric polynomials.
  -- However, since we don't have a library for that, we might need to rely on `ring` doing the heavy lifting
  -- after we substitute the relations.
  -- But `ring` doesn't know about `e2_sum r = A`.
  -- We need to rewrite `A` and `C_coeff` in terms of `r` in the RHS.
  rw [← h_e2, ← h_prod]
  -- Now both sides are polynomials in `r`.
  -- We need to show they are equal given `sum r = 0` and `e3_sum r = 0`.
  -- This is still hard for `ring` because of the constraints.
  -- We can try to substitute `r 3 = -r 0 - r 1 - r 2` (using `h_sum`).
  -- And then use `h_e3` to substitute something else?
  -- Maybe just `nlinarith` or `grind`?
  simp_all +decide [ Fin.sum_univ_four, Fin.prod_univ_four, e2_sum, e3_sum ];
  grind +ring

lemma partial_discriminant_symm_val (r A : ℝ) :
  partial_discriminant r A 0 = -4 * (A + r^2) * (2 * r^2 + A)^2 := by
  unfold partial_discriminant cubic_discriminant_e
  ring

def Phi_Disc_symm_term_y (A y : ℝ) : ℝ :=
  -4 * (6 * y + A)^2 * (A + y) * (2 * y + A)^2

lemma Phi_Disc_symm_sum_uv (A C_coeff u v : ℝ)
  (hsum : u + v = -A) (hprod : u * v = C_coeff) :
  2 * Phi_Disc_symm_term_y A u + 2 * Phi_Disc_symm_term_y A v = Phi_quartic_numerator A C_coeff := by
    unfold Phi_Disc_symm_term_y Phi_quartic_numerator; rw [ ← eq_sub_iff_add_eq' ] at hsum; subst_vars; ring;

lemma Phi_Disc_symm_reduction (A C_coeff y : ℝ)
  (h_root : y^2 + A * y + C_coeff = 0) :
  Phi_Disc_symm_term_y A y =
  let c := -4 * (A^2 - 4*C_coeff) * (A^2 - 36*C_coeff)
  let d := -4 * (A^2 - 4*C_coeff) * (A^3 - 12*A*C_coeff)
  c * y + d := by
    unfold Phi_Disc_symm_term_y;
    grind

lemma Phi_Disc_sum_eq_Num_symm_v3 (A C_coeff : ℝ) (r : Fin 4 → ℝ)
  (h_sum : ∑ i, r i = 0)
  (h_e2 : e2_sum r = A)
  (h_e3 : e3_sum r = 0) -- B=0
  (h_prod : ∏ i, r i = C_coeff)
  (h_roots : ∀ i, (r i)^4 + A * (r i)^2 + C_coeff = 0) :
  Phi_Disc_sum A 0 r = Phi_quartic_numerator A C_coeff := by
  -- 1. Convert terms to Phi_Disc_symm_term_y
  have h_term (i : Fin 4) : (6 * (r i)^2 + A)^2 * partial_discriminant (r i) A 0 =
    Phi_Disc_symm_term_y A ((r i)^2) := by
    rw [partial_discriminant_symm_val]
    unfold Phi_Disc_symm_term_y
    ring
  rw [Phi_Disc_sum]
  simp only [h_term]
  -- 2. Use reduction to linear form
  let c := -4 * (A^2 - 4*C_coeff) * (A^2 - 36*C_coeff)
  let d := -4 * (A^2 - 4*C_coeff) * (A^3 - 12*A*C_coeff)
  have h_red (i : Fin 4) : Phi_Disc_symm_term_y A ((r i)^2) = c * (r i)^2 + d := by
    apply Phi_Disc_symm_reduction
    -- Check if (r i)^2 is a root of y^2 + A y + C = 0
    let y := (r i)^2
    have : y^2 + A * y + C_coeff = (r i)^4 + A * (r i)^2 + C_coeff := by ring
    rw [this]
    exact h_roots i
  simp only [h_red]
  -- 3. Sum linear terms
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, Finset.card_fin]
  -- 4. Calculate sum (r i)^2
  have h_sq_sum : ∑ i, (r i)^2 = -2 * A := by
    have h_id : (∑ i, r i)^2 = ∑ i, (r i)^2 + 2 * e2_sum r := by
      unfold e2_sum
      -- We need the identity (sum x)^2 = sum x^2 + 2 sum_{i<j} x_i x_j
      -- For Fin 4, we can just expand it or use a library lemma.
      -- Let's try to prove it by expansion for Fin 4.
      simp [Fin.sum_univ_four]
      ring
    rw [h_sum, h_e2] at h_id
    linarith
  rw [h_sq_sum]
  -- 5. Verify final equality
  unfold Phi_quartic_numerator
  dsimp [c, d]
  ring

