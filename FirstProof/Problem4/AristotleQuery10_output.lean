lemma Phi_comp_neg_X (p : ℝ[X]) : Phi (p.comp (-X)) = Phi p := by
  unfold Phi;
  rw [ show ( p.comp ( -Polynomial.X ) |> Polynomial.roots |> Multiset.toFinset ) = Finset.image ( fun x => -x ) ( p.roots.toFinset ) from ?_, Finset.sum_image ] <;> norm_num;
