    rw [ show ( Multiset.map ( fun x => -x ) p.roots |> Multiset.toFinset |> Finset.erase ) ( -x ) = Finset.image ( fun x => -x ) ( p.roots.toFinset.erase x ) from ?_, Finset.sum_image ] <;> norm_num;
    · field_simp;
      rw [ ← Finset.sum_congr rfl fun y hy => by rw [ ← neg_div_neg_eq, neg_add_eq_sub ] ] ; norm_num [ neg_div, div_neg ] ;
    · ext; aesop;
  · ext; simp +decide [ Polynomial.comp_assoc ] ;
    rw [ Polynomial.comp_eq_zero_iff ] ; aesop

lemma Phi_quartic_even_in_B (A B C_coeff : ℝ) :
  Phi (X^4 + C A * X^2 + C B * X + C C_coeff) = Phi (X^4 + C A * X^2 + C (-B) * X + C C_coeff) := by
