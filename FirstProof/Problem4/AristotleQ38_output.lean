      obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a ∧ r1 * r2 * r3 = -b := by
        obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, Polynomial.roots (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = {r1, r2, r3} := by
          rw [ Polynomial.splits_iff_card_roots ] at h_splits;
          exact Multiset.card_eq_three.mp ( h_splits.trans ( by erw [ Polynomial.natDegree_add_C ] ; by_cases ha : a = 0 <;> simp +decide [ ha, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] ) );
        have h_vieta : Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) := by
