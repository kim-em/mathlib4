      have h_distinct : (r1 - r2) * (r1 - r3) * (r2 - r3) ≠ 0 := by
        contrapose! h_nodup;
        rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r1 ) * ( Polynomial.X - Polynomial.C r2 ) * ( Polynomial.X - Polynomial.C r3 ) by exact Polynomial.funext fun x => by norm_num; cases le_total x 0 <;> nlinarith [ sq_nonneg x ] ];
        rw [ Polynomial.roots_mul, Polynomial.roots_mul ];
        · norm_num [ sub_eq_iff_eq_add ] at h_nodup ; aesop;
        · exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero r1 ) ( Polynomial.X_sub_C_ne_zero r2 );
        · exact mul_ne_zero ( mul_ne_zero ( Polynomial.X_sub_C_ne_zero r1 ) ( Polynomial.X_sub_C_ne_zero r2 ) ) ( Polynomial.X_sub_C_ne_zero r3 );
      -- Substitute the values from Vieta's formulas into the discriminant formula.
      have h_discriminant : 4 * a ^ 3 + 27 * b ^ 2 = - (r1 - r2) ^ 2 * (r1 - r3) ^ 2 * (r2 - r3) ^ 2 := by
        grind;
      simp_all +decide [ mul_assoc ];
      exact mul_pos ( sq_pos_of_ne_zero h_distinct.1 ) ( mul_pos ( sq_pos_of_ne_zero h_distinct.2.1 ) ( sq_pos_of_ne_zero h_distinct.2.2 ) )

/-
The number of roots of a split monic polynomial is equal to its degree.
-/
lemma roots_card_eq_natDegree (p : ℝ[X])
    (h_splits : p.Splits (RingHom.id ℝ)) (h_monic : p.Monic) :
    p.roots.card = p.natDegree := by
  rw [Polynomial.splits_iff_card_roots] at h_splits
  exact h_splits

/-
Formula for invPhi of a centered cubic polynomial x^3 + ax + b.
-/
lemma invPhi_eq_invPhi_cubic_centered_formula (a b : ℝ)
    (h_discr : 4 * a^3 + 27 * b^2 < 0) :
    let p := X^3 + C a * X + C b
    p.roots.Nodup → p.Splits (RingHom.id ℝ) →
    invPhi p = invPhi_cubic_centered_formula a b := by
      unfold invPhi invPhi_cubic_centered_formula;
      -- By Vieta's formulas, we know that $r_1 + r_2 + r_3 = 0$, $r_1r_2 + r_2r_3 + r_3r_1 = a$, and $r_1r_2r_3 = -b$.
      intro p h_nodup h_splits
      have h_vieta : ∃ r₁ r₂ r₃ : ℝ, r₁ + r₂ + r₃ = 0 ∧ r₁ * r₂ + r₂ * r₃ + r₃ * r₁ = a ∧ r₁ * r₂ * r₃ = -b ∧ r₁ ≠ r₂ ∧ r₂ ≠ r₃ ∧ r₃ ≠ r₁ := by
        -- Since the polynomial splits and has no duplicate roots, it must have three distinct real roots.
        obtain ⟨r₁, r₂, r₃, hr⟩ : ∃ r₁ r₂ r₃ : ℝ, r₁ ≠ r₂ ∧ r₂ ≠ r₃ ∧ r₃ ≠ r₁ ∧ r₁ ^ 3 + a * r₁ + b = 0 ∧ r₂ ^ 3 + a * r₂ + b = 0 ∧ r₃ ^ 3 + a * r₃ + b = 0 := by
          have h_card : Multiset.card p.roots = 3 := by
            convert roots_card_eq_natDegree p h_splits _;
            · rw [ Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
            · erw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
              · aesop;
              · simp +zetaDelta at *;
          obtain ⟨ r₁, r₂, r₃, h ⟩ := Multiset.card_eq_three.mp h_card;
          simp_all +decide [ Multiset.nodup_cons ];
          exact ⟨ r₁, r₂, by tauto, r₃, by tauto, by tauto, by replace h := h.symm ▸ Multiset.mem_cons_self _ _; aesop, by replace h := h.symm ▸ Multiset.mem_cons_of_mem ( Multiset.mem_cons_self _ _ ) ; aesop, by replace h := h.symm ▸ Multiset.mem_cons_of_mem ( Multiset.mem_cons_of_mem ( Multiset.mem_cons_self _ _ ) ) ; aesop ⟩;
        use r₁, r₂, r₃;
        grind;
      obtain ⟨ r₁, r₂, r₃, h₁, h₂, h₃, h₄, h₅, h₆ ⟩ := h_vieta; simp_all +decide [ Phi ] ;
      -- By Vieta's formulas, we know that $p(x) = (x - r₁)(x - r₂)(x - r₃)$.
      have h_vieta_poly : p = Polynomial.C 1 * (Polynomial.X - Polynomial.C r₁) * (Polynomial.X - Polynomial.C r₂) * (Polynomial.X - Polynomial.C r₃) := by
        simp +zetaDelta at *;
        exact Polynomial.funext fun x => by norm_num; linear_combination h₁ * x^2 - h₂ * x + h₃;
      rw [ h_vieta_poly, Polynomial.roots_mul, Polynomial.roots_mul ] <;> norm_num [ Polynomial.X_sub_C_ne_zero ];
      rw [ Finset.sum_insert, Finset.sum_insert ] <;> norm_num [ h₄, h₅, h₆ ];
      · rw [ Finset.sum_insert, Finset.sum_insert ] <;> norm_num [ h₄, h₅, h₆ ];
        · rw [ Finset.sum_insert, Finset.sum_insert ] <;> norm_num [ h₄, h₅, h₆ ];
          · rw [ inv_eq_iff_eq_inv ] ; ring;
            grind;
          · tauto;
        · tauto;
      · tauto;
      · tauto

/-
Phi(X^2 + c) = -1/(2c) for c < 0.
-/
lemma Phi_quadratic_centered (c : ℝ) (hc : c < 0) :
    let p := X^2 + C c
    Phi p = -1 / (2 * c) := by
      field_simp;
      rw [ show ( Polynomial.X ^ 2 + Polynomial.C c : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( -Real.sqrt ( -c ) ) ) * ( Polynomial.X - Polynomial.C ( Real.sqrt ( -c ) ) ) by exact Polynomial.funext fun x => by norm_num; nlinarith [ Real.mul_self_sqrt ( show 0 ≤ -c by linarith ) ] ];
      unfold Phi;
      erw [ Polynomial.roots_mul <| mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ), Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num;
      rw [ Finset.sum_pair ] <;> norm_num [ hc.ne ];
      · rw [ Finset.sum_eq_single ( Real.sqrt ( -c ) ), Finset.sum_pair ] <;> norm_num;
        · ring_nf; norm_num [ hc.le ];
        · linarith [ Real.sqrt_pos.2 ( neg_pos.2 hc ) ];
        · aesop;
        · exact fun h => by linarith [ Real.sqrt_pos.2 ( neg_pos.2 hc ) ] ;
      · linarith [ Real.sqrt_pos.2 ( neg_pos.2 hc ) ]

/-
Finite Free Stam Inequality for n=2 centered polynomials.
-/
theorem finite_free_stam_inequality_centered_n2 (p q : ℝ[X])
    (hp : is_centered 2 p) (hq : is_centered 2 q)
    (hp_real : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hq_real : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hpq_real : (boxplus 2 p q).Splits (RingHom.id ℝ)) (hpq_nodup : (boxplus 2 p q).roots.Nodup) :
    invPhi (boxplus 2 p q) ≥ invPhi p + invPhi q := by
      obtain ⟨c₁, hc₁⟩ : ∃ c₁ : ℝ, p = Polynomial.X ^ 2 + Polynomial.C c₁ := by
        obtain ⟨ hp₁, hp₂, hp₃ ⟩ := hp;
        rw [ p.as_sum_range_C_mul_X_pow ] ; simp_all +decide [ Finset.sum_range_succ', Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ] ;
      obtain ⟨c₂, hc₂⟩ : ∃ c₂ : ℝ, q = Polynomial.X ^ 2 + Polynomial.C c₂ := by
        rcases hq with ⟨ hq₁, hq₂, hq₃ ⟩;
        rw [ Polynomial.as_sum_range_C_mul_X_pow q ] ; norm_num [ Finset.sum_range_succ', hq₂, hq₃ ] ;
        have := hq₁.coeff_natDegree; aesop;
      obtain ⟨c₃, hc₃⟩ : ∃ c₃ : ℝ, boxplus 2 p q = Polynomial.X ^ 2 + Polynomial.C c₃ := by
        unfold boxplus;
        unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', hc₁, hc₂ ] ;
        exact ⟨ c₁ + c₂, by simpa using by ring ⟩;
      have hc₁_neg : c₁ < 0 := by
        contrapose! hp_nodup; simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] ;
        rw [ Multiset.nodup_iff_count_le_one ] ; intro H ; replace H := H 0 ; simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] ;
        rw [ Polynomial.splits_iff_card_roots ] at hp_real ; simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ];
        obtain ⟨ x, hx ⟩ := Multiset.card_pos_iff_exists_mem.mp ( by linarith ) ; simp_all +decide [ Polynomial.rootMultiplicity_eq_zero ] ;
        norm_num [ show c₁ = 0 by nlinarith ] at *;
        norm_num [ Polynomial.rootMultiplicity_eq_natTrailingDegree ] at H
      have hc₂_neg : c₂ < 0 := by
        by_contra hc₂_nonneg;
        -- If $c₂$ is non-negative, then $q = X^2 + c₂$ has a double root at $X = 0$, which contradicts the assumption that $q$ has distinct roots.
        have h_double_root : q.roots = {0, 0} := by
          obtain ⟨r, hr⟩ : ∃ r : ℝ, q.eval r = 0 := by
            rw [ Polynomial.splits_iff_card_roots ] at hq_real;
            exact Exists.elim ( Multiset.card_pos_iff_exists_mem.mp ( by linarith [ hq.2 ] ) ) fun x hx => ⟨ x, by aesop ⟩;
          norm_num [ hc₂ ] at hr ⊢;
          norm_num [ show c₂ = 0 by nlinarith ] at *;
          rfl;
        aesop
      have hc₃_neg : c₃ < 0 := by
        contrapose! hpq_nodup; simp_all +decide [ Polynomial.splits_iff_card_roots ] ;
        norm_num [ show c₃ = 0 by exact le_antisymm ( le_of_not_gt fun h => by obtain ⟨ x, hx ⟩ := Multiset.card_pos_iff_exists_mem.mp ( by linarith ) ; norm_num at hx ; nlinarith ) hpq_nodup ] at *;
        norm_num [ two_smul ]
      have hc₃_eq : c₃ = c₁ + c₂ := by
        unfold boxplus at hc₃; simp_all +decide [ Finset.sum_range_succ ] ;
        unfold boxplus_coeff at hc₃; norm_num [ Finset.sum_range_succ' ] at hc₃; have := congr_arg ( Polynomial.eval 0 ) hc₃; norm_num at this; have := congr_arg ( Polynomial.eval 1 ) hc₃; norm_num at this; have := congr_arg ( Polynomial.eval ( -1 ) ) hc₃; norm_num at this; linarith;
      have h_invPhi_p : invPhi p = -2 * c₁ := by
        have h_invPhi_p : invPhi p = 1 / Phi p := by
          unfold invPhi;
          have := roots_card_eq_natDegree p hp_real hp.1; aesop;
        rw [ h_invPhi_p, show Phi p = -1 / ( 2 * c₁ ) from ?_ ];
        · group;
        · rw [ hc₁ ] ; exact?;
      have h_invPhi_q : invPhi q = -2 * c₂ := by
        rw [ invPhi ];
        rw [ show Phi q = -1 / ( 2 * c₂ ) from ?_ ];
        · rw [ if_pos ⟨ hq_nodup, by
            have := roots_card_eq_natDegree q hq_real hq.1; aesop; ⟩ ] ; group;
        · rw [ hc₂ ] ; exact Phi_quadratic_centered c₂ hc₂_neg;
      have h_invPhi_pq : invPhi (boxplus 2 p q) = -2 * c₃ := by
        rw [ hc₃, invPhi ];
        rw [ show ( Polynomial.X ^ 2 + Polynomial.C c₃ |> Polynomial.roots ) = { Real.sqrt ( -c₃ ), -Real.sqrt ( -c₃ ) } from ?_ ];
        · rw [ show Phi ( Polynomial.X ^ 2 + Polynomial.C c₃ ) = -1 / ( 2 * c₃ ) from ?_ ];
          · rw [ if_pos ] <;> norm_num [ hc₃_neg.ne ] ; ring;
            linarith [ Real.sqrt_pos.mpr ( neg_pos.mpr hc₃_neg ) ];
          · convert Phi_quadratic_centered c₃ hc₃_neg using 1;
        · rw [ show ( Polynomial.X ^ 2 + Polynomial.C c₃ : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( Real.sqrt ( -c₃ ) ) ) * ( Polynomial.X - Polynomial.C ( -Real.sqrt ( -c₃ ) ) ) by exact Polynomial.funext fun x => by norm_num; linarith [ Real.mul_self_sqrt ( show 0 ≤ -c₃ by linarith ) ] ];
          rw [ Polynomial.roots_mul <| mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ), Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; tauto;
      linarith

/-
For centered polynomials, (p ⊞ q)_{n-2} = p_{n-2} + q_{n-2}.
-/
lemma boxplus_centered_coeff_n_sub_2 (n : ℕ) (p q : ℝ[X])
    (hp : is_centered n p) (hq : is_centered n q) (hn : n ≥ 2) :
    (boxplus n p q).coeff (n - 2) = p.coeff (n - 2) + q.coeff (n - 2) := by
      rcases n with _ | _ | n <;> simp_all +decide [ Nat.succ_eq_add_one ];
      unfold is_centered at *;
      unfold boxplus; simp +decide [ Finset.sum_range_succ', hp.2.2, hq.2.2 ] ;
      rw [ Finset.sum_eq_zero ] <;> norm_num [ boxplus_coeff ] at *;
      · simp +arith +decide [ Finset.sum_range_succ', hp.2.1, hq.2.1 ];
        simp_all +decide [ Nat.factorial_ne_zero, mul_comm, mul_assoc, mul_left_comm ];
        have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; aesop;
      · intros; omega;

/-
For centered cubic polynomials, the constant term of p ⊞ q is the sum of the constant terms of p and q.
-/
lemma boxplus_centered_cubic_coeff_0 (p q : ℝ[X])
    (hp : is_centered 3 p) (hq : is_centered 3 q) :
    (boxplus 3 p q).coeff 0 = p.coeff 0 + q.coeff 0 := by
      unfold is_centered at *;
      unfold boxplus; norm_num [ Finset.sum_range_succ', hp, hq, Polynomial.coeff_zero_eq_eval_zero ] ; ring; (
      unfold boxplus_coeff; norm_num [ Polynomial.eval_eq_sum_range, Finset.sum_range_succ', hp, hq ] ; ring;
      have := hp.1.coeff_natDegree; have := hq.1.coeff_natDegree; aesop;)

/-
Algebraic inequality needed for the n=3 case of the Stam inequality.
-/
lemma algebraic_stam_inequality_n3 (a b c d : ℝ)
    (ha : a < 0) (hc : c < 0) :
    ((b + d) / (a + c)) ^ 2 ≤ (b / a) ^ 2 + (d / c) ^ 2 := by
      field_simp;
      rw [ div_add_div, div_le_div_iff₀ ] <;> try nlinarith [ mul_pos ( neg_pos.mpr ha ) ( neg_pos.mpr hc ) ];
      nlinarith [ sq_nonneg ( b * c ^ 2 - a ^ 2 * d ), sq_nonneg ( b * a * c + a ^ 2 * d ), sq_nonneg ( b * a * c - a ^ 2 * d ), mul_pos ( neg_pos.mpr ha ) ( neg_pos.mpr hc ) ]

/-
Finite Free Stam Inequality for n=3 centered polynomials.
-/
theorem finite_free_stam_inequality_centered_n3 (p q : ℝ[X])
    (hp : is_centered 3 p) (hq : is_centered 3 q)
    (hp_real : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hq_real : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hpq_real : (boxplus 3 p q).Splits (RingHom.id ℝ)) (hpq_nodup : (boxplus 3 p q).roots.Nodup) :
    invPhi (boxplus 3 p q) ≥ invPhi p + invPhi q := by
      -- By definition of centered polynomials, we know that $p = X^3 + aX + b$ and $q = X^3 + cX + d$ for some $a, b, c, d \in \mathbb{R}$.
      obtain ⟨a, b, ha⟩ : ∃ a b : ℝ, p = Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b := by
        rcases hp with ⟨ hp_monic, hp_deg, hp_coeff ⟩;
        rw [ p.as_sum_range_C_mul_X_pow ];
        norm_num [ Finset.sum_range_succ', hp_deg, hp_coeff ];
        have := hp_monic.coeff_natDegree; aesop;
      obtain ⟨c, d, hb⟩ : ∃ c d : ℝ, q = Polynomial.X^3 + Polynomial.C c * Polynomial.X + Polynomial.C d := by
        rcases hq with ⟨ hq_monic, hq_deg, hq_coeff ⟩;
        rw [ Polynomial.as_sum_range_C_mul_X_pow q ];
        norm_num [ Finset.sum_range_succ', hq_deg, hq_coeff ];
        have := hq_monic.coeff_natDegree; aesop;
      -- By definition of $p$ and $q$, we know that their discriminants are negative.
      have h_discriminant_neg : 4 * a^3 + 27 * b^2 < 0 ∧ 4 * c^3 + 27 * d^2 < 0 := by
        exact ⟨ cubic_discriminant_neg_of_nodup_splits a b ( by aesop ) ( by aesop ), cubic_discriminant_neg_of_nodup_splits c d ( by aesop ) ( by aesop ) ⟩;
      -- By definition of $p$ and $q$, we know that their boxplus is also a centered cubic polynomial.
      have h_boxplus_centered : ∃ e f : ℝ, boxplus 3 p q = Polynomial.X^3 + Polynomial.C e * Polynomial.X + Polynomial.C f ∧ e = a + c ∧ f = b + d := by
        unfold boxplus;
        unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', ha, hb ] ; ring;
        norm_num [ Polynomial.coeff_X ];
      -- By definition of $p$ and $q$, we know that their invPhi values are given by the formulas.
      have h_invPhi_p : invPhi p = -3 / 2 * (b / a)^2 - 2 / 9 * a := by
        convert invPhi_eq_invPhi_cubic_centered_formula a b _ using 1;
        · aesop;
        · linarith
      have h_invPhi_q : invPhi q = -3 / 2 * (d / c)^2 - 2 / 9 * c := by
        convert invPhi_eq_invPhi_cubic_centered_formula c d _ _ _ using 1 <;> aesop
      have h_invPhi_boxplus : invPhi (boxplus 3 p q) = -3 / 2 * ((b + d) / (a + c))^2 - 2 / 9 * (a + c) := by
        convert invPhi_eq_invPhi_cubic_centered_formula ( a + c ) ( b + d ) _ _ _ using 1;
        · grind;
        · have := cubic_discriminant_neg_of_nodup_splits ( a + c ) ( b + d ) ; aesop;
        · aesop;
        · grind;
      have h_algebraic_inequality : ((b + d) / (a + c))^2 ≤ (b / a)^2 + (d / c)^2 := by
        convert algebraic_stam_inequality_n3 a b c d _ _ using 1 <;> nlinarith [ sq_nonneg a, sq_nonneg c ];
      linarith

/-
Centered boxplus preserves centering.
-/
lemma boxplus_centered_is_centered (n : ℕ) (p q : ℝ[X])
  (hp : is_centered n p) (hq : is_centered n q) :
  is_centered n (boxplus n p q) := by
  refine' ⟨ _, _, _ ⟩;
  · have h_leading_coeff : Polynomial.coeff (boxplus n p q) n = 1 := by
      unfold boxplus;
      simp +zetaDelta at *;
      rw [ Finset.sum_eq_single 0 ] <;> norm_num;
      · unfold boxplus_coeff;
        simp +decide [ ← hp.2.1, ← hq.2.1, hp.1.coeff_natDegree, hq.1.coeff_natDegree, Nat.factorial_ne_zero ];
        rw [ hp.2.1, hq.2.1.symm, hq.1.coeff_natDegree ];
      · intros; omega;
    rwa [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
    refine' Polynomial.degree_eq_of_le_of_coeff_ne_zero _ _;
    · refine' le_trans ( Polynomial.degree_sum_le _ _ ) _;
      exact Finset.sup_le fun i hi => le_trans ( Polynomial.degree_C_mul_X_pow_le _ _ ) ( WithBot.coe_le_coe.mpr ( Nat.sub_le _ _ ) );
    · aesop;
  · have h_deg : (boxplus n p q).natDegree ≤ n := by
      exact le_trans ( Polynomial.natDegree_sum_le _ _ ) ( Finset.sup_le fun i hi => Polynomial.natDegree_C_mul_X_pow_le _ _ |> le_trans <| by aesop );
    refine' le_antisymm h_deg ( Polynomial.le_natDegree_of_ne_zero _ );
    unfold boxplus;
    simp +zetaDelta at *;
    rw [ Finset.sum_eq_single 0 ] <;> norm_num;
    · unfold boxplus_coeff; norm_num [ hp.1.leadingCoeff, hq.1.leadingCoeff ];
      exact ⟨ ⟨ Nat.factorial_ne_zero _, by rw [ ← hp.2.1, hp.1.coeff_natDegree ] ; aesop ⟩, by rw [ ← hq.2.1, hq.1.coeff_natDegree ] ; aesop ⟩;
    · intros; omega;
  · rcases n with ( _ | _ | n ) <;> simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ];
    · unfold is_centered at * ; aesop;
    · have := hp.2.2; have := hq.2.2; unfold boxplus; norm_num [ Polynomial.coeff_eq_zero_of_natDegree_lt, hp.1, hq.1, hp.2.1, hq.2.1 ] ;
      unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', ‹p.coeff 0 = 0›, ‹q.coeff 0 = 0› ] ;
    · unfold is_centered at *;
      unfold boxplus; simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt, Finset.sum_range_succ' ] ;
      unfold boxplus_coeff; simp_all +decide [ Finset.sum_range_succ', Nat.factorial_ne_zero ] ;
      exact Finset.sum_eq_zero fun x hx => if_neg ( by omega )

