/-
Definition of the amount to shift a polynomial to center it, and the centered polynomial itself.
-/
def shift_to_center_amount (n : ℕ) (p : ℝ[X]) : ℝ :=
  - p.coeff (n - 1) / n

def shifted_to_center (n : ℕ) (p : ℝ[X]) : ℝ[X] :=
  p.comp (X + C (shift_to_center_amount n p))

/-
Shifting a monic polynomial p by -p_{n-1}/n makes it centered.
-/
lemma shifted_to_center_is_centered (n : ℕ) (p : ℝ[X])
    (hn : n ≠ 0) (hp_monic : p.Monic) (hp_deg : p.natDegree = n) :
    is_centered n (shifted_to_center n p) := by
      refine' ⟨ _, _, _ ⟩;
      · convert hp_monic.comp_X_add_C _ using 1;
      · unfold shifted_to_center;
        rw [ Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, hp_deg ] ; aesop;
      · -- By definition of shifted_to_center, we have:
        have h_shift : shifted_to_center n p = p.comp (X + C (-p.coeff (n - 1) / n)) := by
          rfl;
        simp_all +decide [ Polynomial.comp, Polynomial.eval₂_eq_sum_range ];
        rcases n <;> simp_all +decide [ Polynomial.coeff_X_add_C_pow, Finset.sum_range_succ ];
        simp_all +decide [ Finset.sum_range, Nat.choose_eq_zero_of_lt ];
        rw [ div_mul_cancel₀ ] <;> first | positivity | rw [ ← hp_deg, hp_monic.coeff_natDegree ] ; ring;

/-
Shifting to center preserves real-rootedness and simple roots.
-/
lemma shifted_to_center_properties (n : ℕ) (p : ℝ[X])
    (hp_splits : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup) :
    (shifted_to_center n p).Splits (RingHom.id ℝ) ∧ (shifted_to_center n p).roots.Nodup := by
      -- Since shifting a polynomial by a constant doesn't change its roots, the shifted polynomial is also real-rooted and has simple roots.
      have h_shift_real_roots : Polynomial.Splits (RingHom.id ℝ) (shifted_to_center n p) := by
        unfold shifted_to_center;
        exact?;
      have h_shift_simple_roots : (shifted_to_center n p).roots = Multiset.map (fun r => r - shift_to_center_amount n p) p.roots := by
        ext; simp [shifted_to_center];
        have h_root_shift : ∀ a : ℝ, Polynomial.rootMultiplicity a (p.comp (Polynomial.X + Polynomial.C (shift_to_center_amount n p))) = Polynomial.rootMultiplicity (a + shift_to_center_amount n p) p := by
          intro a; rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ] ; simp +decide [ Polynomial.trailingDegree ] ;
          norm_num [ add_comm, add_left_comm, add_assoc, Polynomial.comp_assoc ];
        rw [ Multiset.count_map ];
        simp_all +decide [ eq_sub_iff_add_eq ];
        rw [ Multiset.filter_eq ] ; aesop;
      exact ⟨ h_shift_real_roots, h_shift_simple_roots ▸ Multiset.Nodup.map ( fun x => by aesop ) hp_nodup ⟩

/-
It suffices to prove the Finite Free Stam Inequality for centered polynomials.
-/
lemma finite_free_stam_inequality_centered_sufficient (n : ℕ)
    (hn : n ≥ 2) :
    (∀ (p q : ℝ[X]),
      is_centered n p → is_centered n q →
      p.Splits (RingHom.id ℝ) → p.roots.Nodup →
      q.Splits (RingHom.id ℝ) → q.roots.Nodup →
      (boxplus n p q).Splits (RingHom.id ℝ) → (boxplus n p q).roots.Nodup →
      invPhi (boxplus n p q) ≥ invPhi p + invPhi q) →
    (∀ (p q : ℝ[X]),
      p.Monic → p.natDegree = n → p.Splits (RingHom.id ℝ) → p.roots.Nodup →
      q.Monic → q.natDegree = n → q.Splits (RingHom.id ℝ) → q.roots.Nodup →
      (boxplus n p q).Splits (RingHom.id ℝ) → (boxplus n p q).roots.Nodup →
      invPhi (boxplus n p q) ≥ invPhi p + invPhi q) := by
        intro h p q hp hp_deg hp_splits hp_nodup hq hq_deg hq_splits hq_nodup hpq_splits hpq_nodup
        set c_p := -p.coeff (n - 1) / n
        set c_q := -q.coeff (n - 1) / n
        set p_shifted := p.comp (X + C c_p)
        set q_shifted := q.comp (X + C c_q);
        have hp_shifted_centered : is_centered n p_shifted := by
          convert shifted_to_center_is_centered n p ( by linarith ) hp hp_deg using 1
        have hq_shifted_centered : is_centered n q_shifted := by
          apply shifted_to_center_is_centered n q (by linarith) hq hq_deg
        have hp_shifted_splits : (p_shifted).Splits (RingHom.id ℝ) := by
          exact?
        have hp_shifted_nodup : (p_shifted).roots.Nodup := by
          convert shifted_to_center_properties n p hp_splits hp_nodup |>.2 using 1
        have hq_shifted_splits : (q_shifted).Splits (RingHom.id ℝ) := by
          convert shifted_to_center_properties n q hq_splits hq_nodup |> And.left using 1
        have hq_shifted_nodup : (q_shifted).roots.Nodup := by
          convert shifted_to_center_properties n q hq_splits hq_nodup |> And.right using 1
        have hpq_shifted_splits : (boxplus n p_shifted q_shifted).Splits (RingHom.id ℝ) := by
          convert hpq_splits.comp_X_add_C ( c_p + c_q ) using 1;
          convert boxplus_comp_add_C n p q c_p c_q hp_deg hq_deg using 1
        have hpq_shifted_nodup : (boxplus n p_shifted q_shifted).roots.Nodup := by
          have hpq_shifted_eq : boxplus n p_shifted q_shifted = (boxplus n p q).comp (X + C (c_p + c_q)) := by
            convert boxplus_comp_add_C n p q c_p c_q hp_deg hq_deg using 1;
          rw [hpq_shifted_eq];
          have h_roots_shift : (boxplus n p q).roots.map (fun r => r - (c_p + c_q)) = ((boxplus n p q).comp (X + C (c_p + c_q))).roots := by
            ext r;
            rw [ Multiset.count_map ];
            rw [ show ( Multiset.filter ( fun a => r = a - ( c_p + c_q ) ) ( boxplus n p q |> Polynomial.roots ) ) = Multiset.filter ( fun a => a = r + ( c_p + c_q ) ) ( boxplus n p q |> Polynomial.roots ) by congr; ext; constructor <;> intro <;> linarith ] ; rw [ Multiset.filter_eq' ] ; norm_num;
            rw [ Polynomial.rootMultiplicity_eq_natTrailingDegree, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
            norm_num [ add_assoc, Polynomial.comp_assoc ];
          rw [ ← h_roots_shift ] ; exact Multiset.Nodup.map ( fun x y hxy => by simpa using hxy ) hpq_nodup;
        have hp_shifted_invPhi : invPhi p_shifted = invPhi p := by
          exact?
        have hq_shifted_invPhi : invPhi q_shifted = invPhi q := by
          exact?
        have hpq_shifted_invPhi : invPhi (boxplus n p_shifted q_shifted) = invPhi (boxplus n p q) := by
          have hpq_shifted_invPhi : boxplus n p_shifted q_shifted = (boxplus n p q).comp (X + C (c_p + c_q)) := by
            convert boxplus_comp_add_C n p q c_p c_q hp_deg hq_deg using 1;
          rw [hpq_shifted_invPhi];
          exact?;
        linarith [ h p_shifted q_shifted hp_shifted_centered hq_shifted_centered hp_shifted_splits hp_shifted_nodup hq_shifted_splits hq_shifted_nodup hpq_shifted_splits hpq_shifted_nodup ]

/-
Formula for Phi of a centered cubic polynomial x^3 + ax + b.
-/
def Phi_cubic_centered_formula (a b : ℝ) : ℝ :=
  -18 * a^2 / (27 * b^2 + 4 * a^3)

/-
Formula for invPhi of a centered cubic polynomial x^3 + ax + b.
-/
def invPhi_cubic_centered_formula (a b : ℝ) : ℝ :=
  -3/2 * (b/a)^2 - 2/9 * a

