/-
Finite Free Stam Inequality for n=2 centered polynomials.
-/
theorem finite_free_stam_inequality_centered_n2_v2 (p q : ℝ[X])
    (hp : is_centered 2 p) (hq : is_centered 2 q)
    (hp_real : p.Splits (RingHom.id ℝ)) (hp_nodup : p.roots.Nodup)
    (hq_real : q.Splits (RingHom.id ℝ)) (hq_nodup : q.roots.Nodup)
    (hpq_real : (boxplus 2 p q).Splits (RingHom.id ℝ)) (hpq_nodup : (boxplus 2 p q).roots.Nodup) :
    invPhi (boxplus 2 p q) ≥ invPhi p + invPhi q := by
      convert finite_free_stam_inequality_centered_n2 p q hp hq hp_real hp_nodup hq_real hq_nodup hpq_real hpq_nodup using 1

/-
Finite Free Stam Inequality for n=2.
-/
theorem finite_free_stam_inequality_n2 (p q : ℝ[X])
    (hp_monic : p.Monic) (hp_deg : p.natDegree = 2)
    (hq_monic : q.Monic) (hq_deg : q.natDegree = 2)
    (hp_roots : p.roots.Nodup) (hq_roots : q.roots.Nodup)
    (hp_splits : p.Splits (RingHom.id ℝ)) (hq_splits : q.Splits (RingHom.id ℝ))
    (hpq_splits : (boxplus 2 p q).Splits (RingHom.id ℝ)) (hpq_roots : (boxplus 2 p q).roots.Nodup) :
    invPhi (boxplus 2 p q) ≥ invPhi p + invPhi q := by
  apply finite_free_stam_inequality_centered_sufficient 2 (by norm_num)
  · intro p_cent q_cent hp_cent hq_cent hp_c_splits hp_c_roots hq_c_splits hq_c_roots hpq_c_splits hpq_c_roots
    exact finite_free_stam_inequality_centered_n2 p_cent q_cent hp_cent hq_cent hp_c_splits hp_c_roots hq_c_splits hq_c_roots hpq_c_splits hpq_c_roots
  · exact hp_monic
  · exact hp_deg
  · exact hp_splits
  · exact hp_roots
  · exact hq_monic
  · exact hq_deg
  · exact hq_splits
  · exact hq_roots
  · exact hpq_splits
  · exact hpq_roots

/-
Checking availability of helper lemmas.
-/
#check finite_free_stam_inequality_centered_sufficient
#check finite_free_stam_inequality_centered_n2
#check finite_free_stam_inequality_centered_n3

/-
The finite free Stam inequality holds for degrees n=2 and n=3.
-/
theorem finite_free_stam_inequality_upto_3 (n : ℕ) (p q : ℝ[X])
    (hn_ge_2 : n ≥ 2) (hn_le_3 : n ≤ 3)
    (hp_monic : p.Monic) (hp_deg : p.natDegree = n)
    (hq_monic : q.Monic) (hq_deg : q.natDegree = n)
    (hp_roots : p.roots.Nodup) (hq_roots : q.roots.Nodup)
    (hp_splits : p.Splits (RingHom.id ℝ)) (hq_splits : q.Splits (RingHom.id ℝ))
    (hpq_splits : (boxplus n p q).Splits (RingHom.id ℝ)) (hpq_roots : (boxplus n p q).roots.Nodup) :
    invPhi (boxplus n p q) ≥ invPhi p + invPhi q := by
      interval_cases n <;> norm_num at *;
      · exact?;
      · -- Apply the finite free Stam inequality for n=3.
        have := finite_free_stam_inequality_centered_sufficient 3 (by norm_num);
        apply this;
        exact?;
        all_goals assumption;