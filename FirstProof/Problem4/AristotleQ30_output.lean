/-
Definitions of boxplus convolution, Phi functional, and inverse Phi functional.
-/
open scoped BigOperators Real Nat Classical Pointwise
open Polynomial BigOperators Finset Classical

def boxplus_coeff (n : ℕ) (p q : ℝ[X]) (k : ℕ) : ℝ :=
  ∑ i ∈ range (k + 1),
    let j := k - i
    (Nat.factorial (n - i) * Nat.factorial (n - j) : ℝ) / (Nat.factorial n * Nat.factorial (n - k) : ℝ) *
    (p.coeff (n - i)) * (q.coeff (n - j))

def boxplus (n : ℕ) (p q : ℝ[X]) : ℝ[X] :=
  Finset.sum (range (n + 1)) (fun k => C (boxplus_coeff n p q k) * X ^ (n - k))

def Phi (p : ℝ[X]) : ℝ :=
  let roots := p.roots.toFinset
  ∑ r_i ∈ roots, (∑ r_j ∈ roots.erase r_i, 1 / (r_i - r_j))^2

def invPhi (p : ℝ[X]) : ℝ :=
  if p.roots.Nodup ∧ p.roots.card > 1 then
    1 / Phi p
  else 0

def is_centered (n : ℕ) (p : ℝ[X]) : Prop :=
  p.Monic ∧ p.natDegree = n ∧ p.coeff (n - 1) = 0

/-
If μ is a root of the derivative of a centered quartic, the evaluation of the quartic at μ simplifies to -3μ^4 - Aμ^2 + C_val.
-/
def quartic_deriv (A B : ℝ) : ℝ[X] := 4 * X^3 + C (2 * A) * X + C B

def Phi_quartic_spectral (A B C_val : ℝ) : ℝ :=
  -1/4 * ∑ μ ∈ (quartic_deriv A B).roots.toFinset, (12 * μ^2 + 2 * A) / (-3 * μ^4 - A * μ^2 + C_val)

lemma quartic_eval_simplification (A B C_val μ : ℝ)
    (hμ : (quartic_deriv A B).eval μ = 0) :
    (X^4 + C A * X^2 + C B * X + C C_val).eval μ = -3 * μ^4 - A * μ^2 + C_val := by
      unfold quartic_deriv at hμ; norm_num at *; cases le_or_gt μ 0 <;> nlinarith;

/-
The derivative of a centered monic quartic polynomial is given by 4x^3 + 2Ax + B.
-/
lemma quartic_derivative_eq (p : ℝ[X]) (A B C_val : ℝ)
    (hp_monic : p.Monic) (hp_deg : p.natDegree = 4) (hp_centered : p.coeff 3 = 0)
    (hA : A = p.coeff 2) (hB : B = p.coeff 1) (hC : C_val = p.coeff 0) :
    p.derivative = quartic_deriv A B := by
      rw [ Polynomial.as_sum_range_C_mul_X_pow p ] ; norm_num [ Finset.sum_range_succ', hp_deg, hp_centered, hA, hB, hC ] ; ring;
      erw [ ← hp_deg, hp_monic.coeff_natDegree ] ; ring;
      exact Polynomial.funext fun x => by unfold quartic_deriv; norm_num; ring;