Formula for 1/Phi of a reduced cubic polynomial.
-/
lemma Phi_deg3_reduced_formula (a b : ℝ) (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ)) (h_simple : (X^3 + C a * X + C b).roots.Nodup) :
  invPhi (X^3 + C a * X + C b) = (-4 * a^3 - 27 * b^2) / (18 * a^2) := by
    -- Let's denote the roots of the polynomial by $r_1, r_2, r_3$.
    obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a ∧ r1 * r2 * r3 = -b := by
      rw [ Polynomial.splits_iff_card_roots ] at h_real;
      -- Since the polynomial splits, it has three roots. Let's denote them � as� r1, r2, r3.
      obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, Polynomial.roots (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = {r1, r2, r3} := by
        rw [ Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] at h_real <;> by_cases ha : a = 0 <;> simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ];
        · exact Multiset.card_eq_three.mp h_real;
        · exact Multiset.card_eq_three.mp h_real;
      -- By Vieta's formulas, we know that $r_1 + r_2 + r_3 = 0$.
      have h_sum : r1 + r2 + r3 = 0 := by
        have h_vieta_sum : Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) := by
          rw [ ← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq ( show Polynomial.Monic ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) from ?_ ) ];
          · simpa [ hr ] using by ring;
          · exact h_real;
          · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
        have h₁ := congr_arg ( Polynomial.eval 0 ) h_vieta_sum; have h₂ := congr_arg ( Polynomial.eval 1 ) h_vieta_sum; have h := congr_arg ( Polynomial.eval ( -1 ) ) h_vieta_sum; norm_num at h₁ h₂ h; linarith;
      -- By Vieta's formulas, we know that $r_1r_2 + r_2r_3 + r_3r_1 = a$.
      have h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a := by
        have h_vieta_prod_sum : Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b = Polynomial.C 1 * (Polynomial.X - Polynomial.C r1) * (Polynomial.X - Polynomial.C r2) * (Polynomial.X - Polynomial.C r3) := by
          rw [ ← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq ( show Polynomial.Monic ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) from ?_ ) ];
          · norm_num [ hr, mul_assoc ];
          · exact h_real;
          · rw [ Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha, Polynomial.coeff_eq_zero_of_natDegree_lt ];
        have h₁ := congr_arg ( Polynomial.eval 0 ) h_vieta_prod_sum; have h₂ := congr_arg ( Polynomial.eval 1 ) h_vieta_prod_sum; have h := congr_arg ( Polynomial.eval ( -1 ) ) h_vieta_prod_sum; norm_num at h₁ h₂ h; linarith;
      exact ⟨ r1, r2, r3, h_sum, h_prod_sum, by replace hr := congr_arg Multiset.toFinset hr; rw [ Finset.ext_iff ] at hr; specialize hr r1; norm_num at hr; cases le_or_gt 0 r1 <;> nlinarith [ sq_nonneg r1 ] ⟩;
    -- By definition of $invPhi$, we need to show that $\Phi(p) = \frac{18a^2}{-4a^3 - 27b^2}$.
    have h_invPhi_def : invPhi (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = 1 / ((1 / (r1 - r2)^2 + 1 / (r1 - r3)^2) + (1 / (r2 - r1)^2 + 1 / (r2 - r3)^2) + (1 / (r3 - r1)^2 + 1 / (r3 - r2)^2)) := by
      have h_invPhi_def : invPhi (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = 1 / ((∑ r_i ∈ ({r1, r2, r3} : Finset ℝ), (∑ r_j ∈ ({r1, r2, r3} : Finset ℝ).erase r_i, 1 / (r_i - r_j))^2)) := by
        have h_roots : (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots = {r1, r2, r3} := by
          rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r1 ) * ( Polynomial.X - Polynomial.C r2 ) * ( Polynomial.X - Polynomial.C r3 ) by exact Polynomial.funext fun x => by norm_num; linear_combination hr.1 * x^2 - hr.2.1 * x + hr.2.2 ] ; erw [ Polynomial.roots_mul <| by exact mul_ne_zero ( mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) <| Polynomial.X_sub_C_ne_zero _ ) <| Polynomial.X_sub_C_ne_zero _, Polynomial.roots_mul <| by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) <| Polynomial.X_sub_C_ne_zero _ ] ; aesop;
        rw [ invPhi ];
        unfold Phi; aesop;
      by_cases h1 : r1 = r2 <;> by_cases h2 : r1 = r3 <;> by_cases h3 : r2 = r3 <;> simp_all +decide [ Finset.sum ];
      · contrapose! h_simple;
        rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r2 ) ^ 2 * ( Polynomial.X - Polynomial.C ( -2 * r2 ) ) by exact Polynomial.funext fun x => by norm_num; rw [ show a = -3 * r2 ^ 2 by cases lt_or_gt_of_ne h3 <;> nlinarith, show b = 2 * r2 ^ 3 by cases lt_or_gt_of_ne h3 <;> nlinarith ] ; ring ] ; erw [ Polynomial.roots_mul <| by exact mul_ne_zero ( pow_ne_zero 2 <| Polynomial.X_sub_C_ne_zero _ ) <| Polynomial.X_sub_C_ne_zero _ ] ; erw [ Polynomial.roots_pow, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num;
        norm_num [ two_smul ];
      · simp_all +decide [ show r2 = -2 * r3 by linarith ];
        norm_num [ show a = -3 * r3 ^ 2 by linarith, show b = 2 * r3 ^ 3 by linarith ] at *;
        contrapose! h_simple;
        rw [ show ( Polynomial.X ^ 3 + - ( Polynomial.C 3 * Polynomial.C r3 ^ 2 * Polynomial.X ) + Polynomial.C 2 * Polynomial.C r3 ^ 3 : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r3 ) ^ 2 * ( Polynomial.X - Polynomial.C ( -2 * r3 ) ) by exact Polynomial.funext fun x => by norm_num; ring ];
        rw [ Polynomial.roots_mul ( by exact mul_ne_zero ( pow_ne_zero 2 ( Polynomial.X_sub_C_ne_zero _ ) ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_pow, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num [ h_simple ];
        norm_num [ two_smul, h_simple ];
      · norm_num [ show r1 = -2 * r3 by linarith ] at *;
        contrapose! h_simple;
        rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r3 ) ^ 2 * ( Polynomial.X - Polynomial.C ( -2 * r3 ) ) by exact Polynomial.funext fun x => by norm_num; rw [ ← hr.2.1, ← hr.2.2 ] ; ring ];
        rw [ Polynomial.roots_mul ( by exact mul_ne_zero ( pow_ne_zero 2 ( Polynomial.X_sub_C_ne_zero _ ) ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_pow, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num;
        norm_num [ two_smul ];
      · simp +decide [ sq, sub_eq_iff_eq_add, * ] ; ring;
        rw [ show -r1 + r2 = - ( r1 - r2 ) by ring, show -r1 + r3 = - ( r1 - r3 ) by ring, show -r2 + r3 = - ( r2 - r3 ) by ring, inv_neg, inv_neg, inv_neg ] ; ring;
        grind;
    by_cases hr1 : r1 = r2 <;> by_cases hr2 : r1 = r3 <;> by_cases hr3 : r2 = r3 <;> simp_all +decide [ sub_eq_iff_eq_add ];
    · norm_num [ show r3 = 0 by linarith ] at * ; aesop;
    · rw [ show a = r2 * r2 + r2 * r3 + r3 * r2 by linarith, show b = -r2 * r2 * r3 by linarith ] ; ring;
      rw [ show r3 = -2 * r2 by linarith ] ; ring;
      contrapose! h_simple; simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] ;
      rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r2 ) ^ 2 * ( Polynomial.X - Polynomial.C ( -2 * r2 ) ) by exact Polynomial.funext fun x => by norm_num; rw [ show a = -3 * r2 ^ 2 by cases lt_or_gt_of_ne h_simple <;> nlinarith, show b = 2 * r2 ^ 3 by cases lt_or_gt_of_ne h_simple <;> nlinarith ] ; ring ] ; erw [ Polynomial.roots_mul <| by exact mul_ne_zero ( pow_ne_zero 2 <| Polynomial.X_sub_C_ne_zero _ ) <| Polynomial.X_sub_C_ne_zero _ ] ; erw [ Polynomial.roots_pow ] ; erw [ Polynomial.roots_X_sub_C ] ; norm_num;
      erw [ show ( Polynomial.X + Polynomial.C 2 * Polynomial.C r2 : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( -2 * r2 ) ) by simp, Polynomial.roots_X_sub_C ] ; norm_num [ two_smul ];
    · rw [ show b = -r3 * r2 * r3 by linarith ] ; rw [ show a = r3 * r2 + r2 * r3 + r3 * r3 by linarith ] ; ring;
      rw [ show r2 = -2 * r3 by linarith ] ; ring;
      contrapose! h_simple; simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] ;
      rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r3 ) ^ 2 * ( Polynomial.X - Polynomial.C ( -2 * r3 ) ) by exact Polynomial.funext fun x => by norm_num; rw [ show a = -3 * r3 ^ 2 by cases lt_or_gt_of_ne h_simple <;> nlinarith ] ; rw [ show b = 2 * r3 ^ 3 by cases lt_or_gt_of_ne h_simple <;> nlinarith ] ; ring ] ; erw [ Polynomial.roots_mul <| by exact mul_ne_zero ( pow_ne_zero 2 <| Polynomial.X_sub_C_ne_zero _ ) <| Polynomial.X_sub_C_ne_zero _ ] ; erw [ Polynomial.roots_pow ] ; erw [ Polynomial.roots_X_sub_C ] ; norm_num;
      erw [ show ( Polynomial.X + Polynomial.C 2 * Polynomial.C r3 : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( -2 * r3 ) ) by simp, Polynomial.roots_X_sub_C ] ; norm_num [ two_smul ];
    · rw [ Multiset.nodup_iff_count_le_one ] at h_simple;
      contrapose! h_simple;
      use r3;
      rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r3 ) ^ 2 * ( Polynomial.X - Polynomial.C ( -2 * r3 ) ) by exact Polynomial.funext fun x => by norm_num; rw [ show a = -3 * r3 ^ 2 by cases lt_or_gt_of_ne hr2 <;> nlinarith, show b = 2 * r3 ^ 3 by cases lt_or_gt_of_ne hr2 <;> nlinarith ] ; ring ];
      rw [ Polynomial.roots_mul ( by exact mul_ne_zero ( pow_ne_zero 2 ( Polynomial.X_sub_C_ne_zero _ ) ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_pow, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num;
      exact lt_add_of_lt_of_nonneg ( by norm_num ) ( Nat.zero_le _ );
    · rw [ inv_eq_iff_eq_inv ] ; norm_num ; ring;
      field_simp;
      rw [ div_add_div, div_add_div ] <;> try nlinarith [ mul_self_pos.2 ( sub_ne_zero.2 hr1 ), mul_self_pos.2 ( sub_ne_zero.2 hr2 ), mul_self_pos.2 ( sub_ne_zero.2 hr3 ) ];
      rw [ mul_div, div_eq_div_iff ];
      · grind +ring;
      · grind;
      · grind

/-
Algebraic identity for the sum of squared derivative quotients for a reduced cubic.
-/
lemma sum_sq_roots_frac (a b : ℝ) (roots : Finset ℝ)
  (h_roots : ∀ r ∈ roots, r^3 + a * r + b = 0)
  (h_card : roots.card = 3)
  (h_nodup : roots.toList.Nodup) -- Finset is always nodup, but this implies distinct roots in the multiset sense if we constructed it from roots
  (h_a_neg : a < 0)
  (h_disc : -4 * a^3 - 27 * b^2 > 0) :
  ∑ r ∈ roots, (3 * r / (3 * r^2 + a))^2 = 18 * a^2 / (-4 * a^3 - 27 * b^2) := by
    -- By Vieta's formulas, we know that for� the� roots $r_1 �,� r_2, r_�3�$ of the polynomial $x^3 + ax + b$, we� have�:
    -- $r_1� +� r_2 + r_3 = 0$, $�r�_1r_2 + r_1r_3 + r_2r_3 = a$, and $r_1r_2r_3 = -b$.
    have h_vieta : ∃ r1 r2 r3 : ℝ, r1 + r2 + r3 = 0 ∧ r1 * r2 + r1 * r3 + r2 * r3 = a ∧ r1 * r2 * r3 = -b ∧ roots = {r1, r2, r3} := by
      rw [ Finset.card_eq_three ] at h_card;
      obtain ⟨ x, y, z, hxy, hxz, hyz, rfl ⟩ := h_card;
      use x, y, z;
      have h_vieta_sum : x + y + z = 0 := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne hxy ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne hxz ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne hyz ) <| by linear_combination ( h_roots x ( by norm_num ) ) * ( y - z ) - ( h_roots y ( by norm_num ) ) * ( x - z ) + ( h_roots z ( by norm_num ) ) * ( x - y ) ;
      have h_vieta_prod_sum : x * y + x * z + y * z = a := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne hxy ) ( by ring_nf; nlinarith [ h_roots x ( by norm_num ), h_roots y ( by norm_num ), h_roots z ( by norm_num ) ] )
      have h_vieta_prod : x * y * z = -b := by
        nlinarith [ sq_nonneg x, sq_nonneg y, sq_nonneg z, h_roots x ( by norm_num ), h_roots y ( by norm_num ), h_roots z ( by norm_num ) ]
      exact ⟨h_vieta_sum, h_vieta_prod_sum, h_vieta_prod, rfl⟩;
    obtain ⟨ r1, r2, r3, h1, h2, h3, rfl ⟩ := h_vieta; rw [ Finset.sum_insert, Finset.sum_insert ] <;> norm_num ; ring ; simp_all +decide [ Finset.sum ] ;
    · field_simp;
      rw [ div_add_div, div_add_div ];
      · grind +ring;
      · grind;
      · grind;
      · grind;
      · grind;
    · grind;
    · grind

/-
Proving the relation between derivatives and reciprocal sums for a cubic polynomial.
-/
lemma cubic_deriv_quot_eq_sum_inv_diff (r1 r2 r3 : ℝ) (h_distinct : r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3) :
  let p := C 1 * (X - C r1) * (X - C r2) * (X - C r3)
  (p.derivative.derivative.eval r1) / (2 * p.derivative.eval r1) = 1 / (r1 - r2) + 1 / (r1 - r3) := by
    norm_num [ Polynomial.derivative_mul, Polynomial.derivative_sub, Polynomial.derivative_X, Polynomial.derivative_C ];
    grind

/-
Proving the conjecture for n=1.
-/
theorem conjecture_n_1 (p q : ℝ[X])
  (hp_monic : p.Monic) (hq_monic : q.Monic)
  (hp_deg : p.natDegree = 1) (hq_deg : q.natDegree = 1)
  (hp_real : p.Splits (RingHom.id ℝ)) (hq_real : q.Splits (RingHom.id ℝ)) :
  invPhi (boxplus 1 p q) ≥ invPhi p + invPhi q := by
    unfold invPhi;
    rw [ Polynomial.eq_X_add_C_of_natDegree_le_one ( le_of_eq hp_deg ), Polynomial.eq_X_add_C_of_natDegree_le_one ( le_of_eq hq_deg ) ] ; norm_num;
    unfold boxplus;
    norm_num [ Finset.sum_range_succ, boxplus_coeff ];
    simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
    erw [ show ( Polynomial.X + ( Polynomial.C ( q.coeff 0 ) + Polynomial.C ( p.coeff 0 ) ) ) = ( Polynomial.X - Polynomial.C ( - ( q.coeff 0 + p.coeff 0 ) ) ) by simpa using by ring, Polynomial.roots_X_sub_C ] at * ; aesop

/-
Proving the algebraic identity for n=3 using brute force with r3 elimination.
-/
lemma sum_sq_deriv_quot_cubic (r1 r2 r3 a b : ℝ)
  (h_sum : r1 + r2 + r3 = 0)
  (h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a)
  (h_prod : r1 * r2 * r3 = -b)
  (h_distinct : r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3)
  (h_denom : 3 * r1^2 + a ≠ 0 ∧ 3 * r2^2 + a ≠ 0 ∧ 3 * r3^2 + a ≠ 0) :
  (3 * r1 / (3 * r1^2 + a))^2 + (3 * r2 / (3 * r2^2 + a))^2 + (3 * r3 / (3 * r3^2 + a))^2 =
  18 * a^2 / (-4 * a^3 - 27 * b^2) := by
    rw [ div_pow, div_pow, div_pow, div_add_div, div_add_div ] <;> try { aesop };
    rw [ div_eq_div_iff ] <;> norm_num [ ← h_prod_sum, ← h_prod ];
    · rw [ ← eq_sub_iff_add_eq' ] at h_sum ; subst_vars ; ring;
      rw [ show b = r1 * r2 * ( r1 + r2 ) by linarith ] ; ring;
    · aesop;
    · grind

/-
Simplification of the derivative quotient for a cubic root.
-/
lemma deriv_quot_simpl_cubic (r a b : ℝ) (h_root : r^3 + a * r + b = 0) (h_r_ne_zero : r ≠ 0) (h_denom : 3 * r^2 + a ≠ 0) :
  3 * r / (3 * r^2 + a) = 3 * r^2 / (-2 * a * r - 3 * b) := by
    grind

/-
Proving that 1/(r1-r2) + 1/(r1-r3) = 3r1/(3r1^2+a) for roots of x^3+ax+b.
-/
lemma sum_inv_diff_eq_deriv_quot_reduced (a b r1 r2 r3 : ℝ)
  (h_sum : r1 + r2 + r3 = 0)
  (h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a)
  (h_prod : r1 * r2 * r3 = -b)
  (h_distinct : r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3)
  (h_denom : 3 * r1^2 + a ≠ 0) :
  1 / (r1 - r2) + 1 / (r1 - r3) = 3 * r1 / (3 * r1^2 + a) := by
    grind

/-
Proving that the sum of derivative quotients is zero for a reduced cubic.
-/
lemma sum_deriv_quot_eq_zero (r1 r2 r3 a b : ℝ)
  (h_sum : r1 + r2 + r3 = 0)
  (h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a)
  (h_prod : r1 * r2 * r3 = -b)
  (h_denom : 3 * r1^2 + a ≠ 0 ∧ 3 * r2^2 + a ≠ 0 ∧ 3 * r3^2 + a ≠ 0) :
  3 * r1 / (3 * r1^2 + a) + 3 * r2 / (3 * r2^2 + a) + 3 * r3 / (3 * r3^2 + a) = 0 := by
    grind

/-
Proving the product of derivative values at roots for a reduced cubic.
-/
lemma prod_deriv_values_cubic (r1 r2 r3 a b : ℝ)
  (h_sum : r1 + r2 + r3 = 0)
  (h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a)
  (h_prod : r1 * r2 * r3 = -b) :
  (3 * r1^2 + a) * (3 * r2^2 + a) * (3 * r3^2 + a) = 4 * a^3 + 27 * b^2 := by
    grind +ring

/-
Proving the algebraic identity for n=3 using substitution and simplification (v2).
-/
lemma sum_sq_deriv_quot_cubic_v2 (r1 r2 r3 a b : ℝ)
  (h_sum : r1 + r2 + r3 = 0)
  (h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a)
  (h_prod : r1 * r2 * r3 = -b)
  (h_distinct : r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3)
  (h_denom : 3 * r1^2 + a ≠ 0 ∧ 3 * r2^2 + a ≠ 0 ∧ 3 * r3^2 + a ≠ 0) :
  (3 * r1 / (3 * r1^2 + a))^2 + (3 * r2 / (3 * r2^2 + a))^2 + (3 * r3 / (3 * r3^2 + a))^2 =
  18 * a^2 / (-4 * a^3 - 27 * b^2) := by
    convert sum_sq_deriv_quot_cubic r1 r2 r3 a b h_sum h_prod_sum h_prod h_distinct h_denom using 1

/-
Proving that a reduced cubic with 3 distinct real roots must have a < 0 using Rolle's theorem.
-/
lemma cubic_distinct_real_roots_implies_a_neg (a b : ℝ)
  (h_roots : (X^3 + C a * X + C b).roots.toFinset.card = 3) :
  a < 0 := by
    by_contra h_contra; push_neg at h_contra; (
    -- If $a \geq 0$, then the polynomial $x^3 + ax + b �$� is strictly � increasing�, hence it cannot have three distinct real roots.
    have h_increasing : StrictMono (fun x : ℝ => x^3 + a * x + b) := by
      exact fun x y hxy => by norm_num; nlinarith [ sq_nonneg ( x^2 - y^2 ), pow_pos ( sub_pos.mpr hxy ) 3, mul_le_mul_of_nonneg_left hxy.le h_contra ] ;
    exact absurd h_roots ( by exact ne_of_lt ( lt_of_le_of_lt ( Finset.card_le_one.mpr ( by intros x hx y hy; exact h_increasing.injective <| by aesop ) ) ( by norm_num ) ) ));

/-
Proving that the derivative of a reduced cubic with distinct roots is non-zero at its roots.
-/
lemma reduced_cubic_deriv_ne_zero_at_root (a b : ℝ)
  (h_nodup : (X^3 + C a * X + C b).roots.Nodup)
  (r : ℝ) (hr : r ∈ (X^3 + C a * X + C b).roots) :
  3 * r^2 + a ≠ 0 := by
    contrapose! h_nodup;
    rw [ Multiset.nodup_iff_count_le_one ];
    simp +zetaDelta at *;
    use r;
    rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r ) ^ 2 * ( Polynomial.X - Polynomial.C ( -2 * r ) ) by exact Polynomial.funext fun x => by norm_num; cases le_or_gt x r <;> nlinarith ];
    rw [ Polynomial.rootMultiplicity_mul ];
    · rw [ Polynomial.rootMultiplicity_X_sub_C_pow ] ; norm_num;
      exact lt_add_of_lt_of_nonneg ( by norm_num ) ( Nat.zero_le _ );
    · exact mul_ne_zero ( pow_ne_zero 2 ( Polynomial.X_sub_C_ne_zero _ ) ) ( Polynomial.X_sub_C_ne_zero _ )

/-
Helper lemma: x^3 + ax + b is strictly monotone if a >= 0.
-/
lemma cubic_eval_strict_mono_of_a_nonneg (a b : ℝ) (ha : a ≥ 0) :
  StrictMono (fun x => (X^3 + C a * X + C b).eval x) := by
    exact fun x y hxy => by norm_num; nlinarith [ sq_nonneg ( x + y ), sq_pos_of_pos ( sub_pos.mpr hxy ) ] ;

/-
Proving the formula for Phi in the reduced cubic case.
-/
lemma Phi_deg3_reduced_eq (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_nodup : (X^3 + C a * X + C b).roots.Nodup) :
  Phi (X^3 + C a * X + C b) = 18 * a^2 / (-4 * a^3 - 27 * b^2) := by
    -- By definition of polynomial roots, we know that the roots of $X^3 + aX + b$ are exactly the elements of the finite set `roots`.
    obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 + r2 + r3 = 0 ∧ r1 * r2 + r2 * r3 + r3 * r1 = a ∧ r1 * r2 * r3 = -b ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3 := by
      -- By Vieta's formulas, we know that the roots of the polynomial $ �X�^3 + aX + b$ are $r_1, r_2, r_3$ such that $r_1 + r_2 + r_3 = 0$, $r_1r_2 + r_2r_3 + r_3r_1 = a$, and $r_1r_2r_3 = -b$. Since the polynomial has three distinct real roots, we can choose any three distinct roots.
      obtain ⟨r1, r2, r3, hr⟩ : ∃ r1 r2 r3 : ℝ, r1 ∈ (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots ∧ r2 ∈ (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots ∧ r3 ∈ (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3 := by
        have h_card : Multiset.card (Polynomial.roots (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 3 := by
          rw [ Polynomial.splits_iff_card_roots ] at h_real;
          rw [ h_real, Polynomial.natDegree_add_C, Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ];
        rcases x : Polynomial.roots _ with ⟨ _ | ⟨ r1, _ | ⟨ r2, _ | ⟨ r3, _ | k ⟩ ⟩ ⟩ ⟩ <;> simp_all +decide;
      use r1, r2, r3;
      norm_num at hr;
      grind;
    -- By definition of polynomial roots, we know that the roots of $X^3 + aX + b$ are exactly the elements of the finite set `roots`, and since the polynomial splits, these roots are distinct.
    have h_roots : (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots = {r1, r2, r3} := by
      rw [ show ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C r1 ) * ( Polynomial.X - Polynomial.C r2 ) * ( Polynomial.X - Polynomial.C r3 ) by exact Polynomial.funext fun x => by norm_num; linear_combination hr.1 * x^2 - hr.2.1 * x + hr.2.2.1 ];
      rw [ Polynomial.roots_mul ( by exact mul_ne_zero ( mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_mul ( by exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ), Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; tauto;
    unfold Phi;
    simp_all +decide [ Finset.sum ];
    rw [ show a = r1 * r2 + r2 * r3 + r3 * r1 by linarith, show b = -r1 * r2 * r3 by linarith ];
    rw [ inv_add_inv, inv_add_inv, inv_add_inv ] <;> try cases lt_or_gt_of_ne hr.2.2.2.1 <;> cases lt_or_gt_of_ne hr.2.2.2.2.1 <;> cases lt_or_gt_of_ne hr.2.2.2.2.2 <;> nlinarith;
    rw [ div_pow, div_pow, div_pow, div_add_div, div_add_div ];
    · rw [ div_eq_div_iff ];
      · grind +ring;
      · simp +decide [ sub_eq_iff_eq_add, hr ];
        tauto;
      · grind;
    · exact pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) );
    · exact mul_ne_zero ( pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) ) ) ( pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) ) );
    · exact pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) );
    · exact pow_ne_zero 2 ( mul_ne_zero ( sub_ne_zero_of_ne <| by tauto ) ( sub_ne_zero_of_ne <| by tauto ) )

/-
Proving the formula for invPhi in the reduced cubic case.
-/
lemma invPhi_deg3_reduced_eq (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_nodup : (X^3 + C a * X + C b).roots.Nodup) :
  invPhi (X^3 + C a * X + C b) = (-4 * a^3 - 27 * b^2) / (18 * a^2) := by
    exact?

/-
Calculating coefficients for n=3 reduced case.
-/
lemma boxplus_deg3_reduced_coeffs (p q : ℝ[X])
  (hp_monic : p.Monic) (hq_monic : q.Monic)
  (hp_deg : p.natDegree = 3) (hq_deg : q.natDegree = 3)
  (hp_red : p.coeff 2 = 0) (hq_red : q.coeff 2 = 0) :
  (boxplus 3 p q).coeff 3 = 1 ∧
  (boxplus 3 p q).coeff 2 = 0 ∧
  (boxplus 3 p q).coeff 1 = p.coeff 1 + q.coeff 1 ∧
  (boxplus 3 p q).coeff 0 = p.coeff 0 + q.coeff 0 := by
    unfold boxplus;
    norm_num [ Finset.sum_range_succ, Polynomial.coeff_C, Polynomial.coeff_X_pow, boxplus_coeff ];
    simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree ];
    constructor <;> ring

/-
Proving that a reduced cubic with 3 distinct real roots must have a < 0 (v2).
-/
lemma cubic_distinct_real_roots_implies_a_neg_v2 (a b : ℝ)
  (h_roots : (X^3 + C a * X + C b).roots.toFinset.card = 3) :
  a < 0 := by
    exact?

/-
A reduced cubic with positive discriminant splits and has distinct roots.
-/
lemma cubic_splits_of_discrim_pos (a b : ℝ) (h_disc : -4 * a^3 - 27 * b^2 > 0) :
  (X^3 + C a * X + C b).Splits (RingHom.id ℝ) ∧ (X^3 + C a * X + C b).roots.Nodup := by
    have h_splits : Polynomial.Splits (RingHom.id ℝ) (Polynomial.X ^ 3 + (Polynomial.C a) * Polynomial.X + (Polynomial.C b)) := by
      by_contra h_contra;
      -- By the Intermediate Value Theorem, since $f(-∞) < 0$ and $f(∞) >  �0�$, there exists � some� $r ∈ ℝ$ such that $f(r) = 0$.
      obtain ⟨r, hr⟩ : ∃ r : ℝ, r^3 + a * r + b = 0 := by
        -- By the Intermediate Value � The�orem, since $f(-∞) < 0$ and $f(∞) > 0$, there exists some $r ∈ ℝ$ such that $f(r) = 0$.
        have h_ivt : ∃ r ∈ Set.Icc (-10 - |a| - |b|) (10 + |a| + |b|), r^3 + a * r + b = 0 := by
          apply_rules [ intermediate_value_Icc ] <;> norm_num;
          · linarith [ abs_nonneg a, abs_nonneg b ];
          · fun_prop (disch := norm_num);
          · constructor <;> cases abs_cases a <;> cases abs_cases b <;> nlinarith [ sq_abs a, sq_abs b ];
        aesop;
      -- Since $r$ is a root of $X^3 + aX + b$, we can factor it as $(X - r)(X^2 + rX + (r^2 + a))$.
      have h_factor : Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b = (Polynomial.X - Polynomial.C r) * (Polynomial.X^2 + Polynomial.C r * Polynomial.X + Polynomial.C (r^2 + a)) := by
        exact Polynomial.funext fun x => by norm_num; cases le_or_gt x r <;> nlinarith;
      -- Since the discriminant of $X^2 + rX + (r^2 + a)$ is positive, it splits into linear factors over the reals.
      have h_quad_splits : Polynomial.Splits (RingHom.id ℝ) (Polynomial.X^2 + Polynomial.C r * Polynomial.X + Polynomial.C (r^2 + a)) := by
        have h_discriminant_pos : r^2 - 4 * (r^2 + a) > 0 := by
          rw [ show b = -r ^ 3 - a * r by linarith ] at h_disc ; nlinarith [ sq_nonneg ( a + 3 * r ^ 2 ) ];
        rw [ Polynomial.splits_iff_card_roots ];
        rw [ show ( Polynomial.X ^ 2 + Polynomial.C r * Polynomial.X + Polynomial.C ( r ^ 2 + a ) ) = ( Polynomial.X - Polynomial.C ( ( -r + Real.sqrt ( r ^ 2 - 4 * ( r ^ 2 + a ) ) ) / 2 ) ) * ( Polynomial.X - Polynomial.C ( ( -r - Real.sqrt ( r ^ 2 - 4 * ( r ^ 2 + a ) ) ) / 2 ) ) by exact Polynomial.funext fun x => by norm_num; linarith [ Real.mul_self_sqrt h_discriminant_pos.le ] ] ; rw [ Polynomial.roots_mul <| mul_ne_zero ( Polynomial.X_sub_C_ne_zero _ ) ( Polynomial.X_sub_C_ne_zero _ ) ] ; erw [ Polynomial.roots_X_sub_C, Polynomial.roots_X_sub_C ] ; norm_num;
        rw [ Polynomial.natDegree_mul' ] <;> norm_num [ Polynomial.natDegree_sub_eq_left_of_natDegree_lt ];
      simp_all +decide [ Polynomial.splits_mul_iff ];
      exact h_contra <| Polynomial.splits_mul _ ( Polynomial.splits_X_sub_C _ ) h_quad_splits
    have h_distinct : (Polynomial.X ^ 3 + (Polynomial.C a) * Polynomial.X + (Polynomial.C b)).roots.Nodup := by
      rw [ Multiset.nodup_iff_count_le_one ];
      intro x; by_contra h; have := Polynomial.card_roots' ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) ; simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] ;
      -- If $x$ is a root of multiplicity greater than 1, then $x$ must also be a root of the derivative.
      have h_deriv_root : Polynomial.eval x (Polynomial.derivative (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 0 := by
        exact Polynomial.isRoot_iterate_derivative_of_lt_rootMultiplicity h;
      norm_num at h_deriv_root;
      -- Substitute $a = -3x^2$ into the discriminant condition.
      have h_sub : -4 * (-3 * x^2)^3 - 27 * b^2 > 0 := by
        rw [ show a = -3 * x ^ 2 by linarith ] at h_disc ; linarith;
      have h_sub : b = 2 * x^3 := by
        have h_sub : Polynomial.eval x (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = 0 := by
          exact Polynomial.rootMultiplicity_pos ( by aesop ) |>.1 ( by linarith );
        norm_num at h_sub; cases le_or_gt 0 x <;> nlinarith;
      subst h_sub; nlinarith;
    exact ⟨h_splits, h_distinct⟩
    skip

/-
Proving the formula for invPhi in the reduced cubic case (v2).
-/
lemma invPhi_deg3_reduced_eq_v2 (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_nodup : (X^3 + C a * X + C b).roots.Nodup) :
  invPhi (X^3 + C a * X + C b) = (-4 * a^3 - 27 * b^2) / (18 * a^2) := by
    convert invPhi_deg3_reduced_eq a b h_real h_nodup using 1

/-
Proving the formula for invPhi in the reduced cubic case for any real rooted polynomial with a < 0.
-/
lemma invPhi_deg3_reduced_eq_general (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_a_neg : a < 0) :
  invPhi (X^3 + C a * X + C b) = (-4 * a^3 - 27 * b^2) / (18 * a^2) := by
    by_contra h_contra;
    convert invPhi_deg3_reduced_eq_v2 a b h_real _ using 1;
    · grind;
    · rw [ Multiset.nodup_iff_count_le_one ];
      intro x; by_cases hx : x ∈ Polynomial.roots ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) <;> simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] ;
      refine' Nat.le_of_not_lt fun h => _;
      -- If $x$ is a root of multiplicity greater than 1, then $x$ must also be a root of the derivative.
      have h_deriv_root : Polynomial.eval x (Polynomial.derivative (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 0 := by
        exact Polynomial.isRoot_iterate_derivative_of_lt_rootMultiplicity h;
      norm_num at h_deriv_root;
      norm_num [ show a = -3 * x ^ 2 by linarith ] at *;
      norm_num [ show b = 2 * x ^ 3 by linarith ] at *;
      unfold invPhi at h_contra ; norm_num at h_contra;
      split_ifs at h_contra;
      · rw [ show ( Polynomial.X ^ 3 + - ( ( Polynomial.C : ℝ → Polynomial ℝ ) 3 * ( Polynomial.C : ℝ → Polynomial ℝ ) x ^ 2 * Polynomial.X ) + ( Polynomial.C : ℝ → Polynomial ℝ ) 2 * ( Polynomial.C : ℝ → Polynomial ℝ ) x ^ 3 ) = ( Polynomial.X - Polynomial.C x ) ^ 2 * ( Polynomial.X - Polynomial.C ( -2 * x ) ) by exact Polynomial.funext fun _ => by norm_num; ring ] at * ; simp_all +decide [ Polynomial.rootMultiplicity_eq_zero, Polynomial.rootMultiplicity_eq_natTrailingDegree ];
        rw [ Polynomial.roots_mul ] at * <;> simp_all +decide [ Polynomial.X_sub_C_ne_zero, Polynomial.X_add_C_ne_zero ];
        erw [ show ( Polynomial.X + Polynomial.C 2 * Polynomial.C x : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C ( -2 * x ) ) by simp, Polynomial.roots_X_sub_C ] at * ; simp_all +decide [ two_smul ];
      · exact h_contra ( by ring )

/-
Proving that if a reduced cubic has multiple roots, its discriminant is zero.
-/
lemma reduced_cubic_discriminant_zero_of_multiple_roots (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_multiple : ¬(X^3 + C a * X + C b).roots.Nodup)
  (h_a_neg : a < 0) :
  -4 * a^3 - 27 * b^2 = 0 := by
    rw [ Multiset.nodup_iff_count_le_one ] at h_multiple;
    -- If the polynomial has a multiple root, then its derivative must also have that root.
    obtain ⟨r, hr⟩ : ∃ r : ℝ, Polynomial.eval r (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) = 0 ∧ Polynomial.eval r (Polynomial.derivative (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 0 := by
      obtain ⟨r, hr⟩ : ∃ r : ℝ, Polynomial.rootMultiplicity r (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b) ≥ 2 := by
        aesop;
      exact ⟨ r, by exact Polynomial.rootMultiplicity_pos ( by aesop ) |>.1 ( by linarith ), by exact Polynomial.isRoot_iterate_derivative_of_lt_rootMultiplicity hr ⟩;
    norm_num at hr;
    grind +ring

/-
Proving that the discriminant of a reduced cubic with distinct real roots is positive.
-/
noncomputable def discrim_reduced_cubic (a b : ℝ) : ℝ := -4 * a^3 - 27 * b^2

lemma discrim_reduced_cubic_pos_of_distinct_roots (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_nodup : (X^3 + C a * X + C b).roots.Nodup) :
  discrim_reduced_cubic a b > 0 := by
    by_contra h_contra;
    -- Since the polynomial has three distinct real roots, the discriminant must be positive.
    have h_discrim_pos : -4 * a^3 - 27 * b^2 > 0 := by
      have h_card : (Polynomial.X^3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots.toFinset.card = 3 := by
        rw [ Polynomial.splits_iff_card_roots ] at h_real;
        rw [ Multiset.toFinset_card_of_nodup h_nodup ] ; erw [ h_real ] ; erw [ Polynomial.natDegree_add_C ] ; erw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] <;> by_cases ha : a = 0 <;> simp +decide [ ha ] ;
      obtain ⟨ r1, r2, r3, h ⟩ := Finset.card_eq_three.mp h_card;
      simp_all +decide [ Finset.ext_iff ];
      have h_vieta_sum : r1 + r2 + r3 = 0 := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne h.1 ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne h.2.1 ) <| mul_left_cancel₀ ( sub_ne_zero_of_ne h.2.2.1 ) <| by cases lt_or_gt_of_ne h.1 <;> cases lt_or_gt_of_ne h.2.1 <;> cases lt_or_gt_of_ne h.2.2.1 <;> nlinarith [ h.2.2.2 r1 |>.2 <| Or.inl rfl, h.2.2.2 r2 |>.2 <| Or.inr <| Or.inl rfl, h.2.2.2 r3 |>.2 <| Or.inr <| Or.inr rfl ] ;
      have h_vieta_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a := by
        exact mul_left_cancel₀ ( sub_ne_zero_of_ne h.1 ) ( by ring_nf; nlinarith [ h.2.2.2 r1 |>.2 ( Or.inl rfl ), h.2.2.2 r2 |>.2 ( Or.inr ( Or.inl rfl ) ), h.2.2.2 r3 |>.2 ( Or.inr ( Or.inr rfl ) ) ] )
      have h_vieta_prod : r1 * r2 * r3 = -b := by
        have := h.2.2.2 r1; norm_num at this; cases le_or_gt 0 r1 <;> nlinarith [ sq_nonneg r1 ] ;
      rw [ ← eq_sub_iff_add_eq' ] at h_vieta_sum ; subst_vars ; ring_nf at *;
      rw [ show b = r1 * r2 ^ 2 + r1 ^ 2 * r2 by linarith ] ; nlinarith [ mul_self_pos.mpr ( sub_ne_zero.mpr h.1 ), mul_self_pos.mpr ( sub_ne_zero.mpr h.2.1 ), mul_self_pos.mpr ( sub_ne_zero.mpr h.2.2.1 ), mul_pos ( mul_self_pos.mpr ( sub_ne_zero.mpr h.1 ) ) ( mul_self_pos.mpr ( sub_ne_zero.mpr h.2.1 ) ), mul_pos ( mul_self_pos.mpr ( sub_ne_zero.mpr h.1 ) ) ( mul_self_pos.mpr ( sub_ne_zero.mpr h.2.2.1 ) ), mul_pos ( mul_self_pos.mpr ( sub_ne_zero.mpr h.2.1 ) ) ( mul_self_pos.mpr ( sub_ne_zero.mpr h.2.2.1 ) ) ];
    exact h_contra <| by unfold discrim_reduced_cubic; linarith;

/-
Proving that if a reduced cubic splits and a >= 0, then it must be X^3.
-/
lemma reduced_cubic_eq_X_pow_3_of_a_nonneg (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_a_nonneg : a ≥ 0) :
  X^3 + C a * X + C b = X^3 := by
    by_cases ha : a = 0 <;> simp_all +decide [ Polynomial.splits_iff_card_roots ];
    · -- Since $X^3 + � b�$ has three real roots, it must be the zero polynomial.
      have h_zero_poly : (Polynomial.X ^ 3 + Polynomial.C b).roots.toFinset.card ≤ 1 := by
        refine' Finset.card_le_one.mpr _;
        norm_num +zetaDelta at *;
        exact fun x hx₁ hx₂ y hy₁ hy₂ => by by_contra hxy; exact hxy <| by nlinarith [ sq_nonneg ( x + y ), mul_self_pos.2 ( sub_ne_zero_of_ne hxy ) ] ;
      contrapose! h_zero_poly;
      rw [ Multiset.toFinset_card_of_nodup ] <;> norm_num [ h_real ];
      rw [ Multiset.nodup_iff_count_le_one ];
      intro x; by_cases hx : x ^ 3 + b = 0 <;> simp_all +decide [ pow_succ ] ;
      rw [ show ( Polynomial.X * Polynomial.X * Polynomial.X + Polynomial.C b : Polynomial ℝ ) = ( Polynomial.X - Polynomial.C x ) * ( Polynomial.X ^ 2 + Polynomial.C x * Polynomial.X + Polynomial.C x ^ 2 ) by exact Polynomial.funext fun n => by norm_num; linarith ] ; erw [ Polynomial.rootMultiplicity_mul ];
      · rw [ Polynomial.rootMultiplicity_X_sub_C ] ; norm_num;
        grind;
      · exact mul_ne_zero ( Polynomial.X_sub_C_ne_zero x ) ( by exact ne_of_apply_ne ( fun p => p.coeff 2 ) <| by norm_num [ Polynomial.coeff_eq_zero_of_natDegree_lt ] );
    · have h_distinct_roots : (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b).roots.toFinset.card ≤ 1 := by
        have h_strict_mono : StrictMono (fun x : ℝ => x^3 + a * x + b) := by
          exact strictMono_of_deriv_pos fun x => by norm_num [ mul_comm a ] ; positivity;
        exact Finset.card_le_one.mpr fun x hx y hy => h_strict_mono.injective <| by aesop;
      rw [ Multiset.toFinset_card_of_nodup ] at h_distinct_roots;
      · rw [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] at h_real <;> aesop;
      · rw [ Multiset.nodup_iff_count_le_one ];
        intro x; by_cases hx : x ∈ Polynomial.roots ( Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b ) <;> simp_all +decide [ Polynomial.natDegree_add_eq_left_of_natDegree_lt ] ;
        refine' Nat.le_of_not_lt fun h => _;
        have h_deriv : Polynomial.eval x (Polynomial.derivative (Polynomial.X ^ 3 + Polynomial.C a * Polynomial.X + Polynomial.C b)) = 0 := by
          exact Polynomial.isRoot_iterate_derivative_of_lt_rootMultiplicity h;
        norm_num at h_deriv; cases lt_or_gt_of_ne ha <;> nlinarith [ sq_nonneg ( x^2 ) ] ;

/-
Proving that invPhi matches the formula for all real rooted reduced cubics.
-/
noncomputable def invPhi_formula (a b : ℝ) : ℝ :=
  if a = 0 then 0 else (-4 * a^3 - 27 * b^2) / (18 * a^2)

lemma invPhi_eq_formula (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ)) :
  invPhi (X^3 + C a * X + C b) = invPhi_formula a b := by
    by_cases h_a_nonneg : a ≥ 0;
    · by_cases ha : a = 0;
      · by_cases hb : b = 0 <;> simp_all +decide [ invPhi ];
        · unfold invPhi_formula; norm_num [ Finset.sum_range_succ', Phi ] ;
        · have := reduced_cubic_eq_X_pow_3_of_a_nonneg 0 b; aesop;
      · exact absurd ( reduced_cubic_eq_X_pow_3_of_a_nonneg a b h_real h_a_nonneg ) ( by exact ne_of_apply_ne ( fun p => p.coeff 1 ) ( by norm_num [ ha ] ) );
    · convert invPhi_deg3_reduced_eq_general a b h_real ( not_le.mp h_a_nonneg ) using 1;
      unfold invPhi_formula; aesop

/-
Proving superadditivity of x^(3/2).
-/
lemma rpow_three_halves_superadditive (x y : ℝ) (hx : 0 ≤ x) (hy : 0 ≤ y) :
  x ^ (3/2 : ℝ) + y ^ (3/2 : ℝ) ≤ (x + y) ^ (3/2 : ℝ) := by
    rw [ show ( 3 / 2 : ℝ ) = 1 + 1 / 2 by norm_num, Real.rpow_add', Real.rpow_add' ] <;> norm_num <;> try positivity;
    rw [ show ( 3 / 2 : ℝ ) = 1 + 1 / 2 by norm_num, Real.rpow_add' ] <;> norm_num <;> try linarith;
    rw [ ← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow ] ; nlinarith [ Real.sqrt_nonneg x, Real.sqrt_nonneg y, Real.sqrt_le_sqrt ( by linarith : x ≤ x + y ), Real.sqrt_le_sqrt ( by linarith : y ≤ x + y ) ] ;

/-
Proving that invPhi is non-negative.
-/
lemma invPhi_nonneg (p : ℝ[X]) : invPhi p ≥ 0 := by
  unfold invPhi;
  unfold Phi;
  split_ifs <;> first | positivity | unreachable!;

/-
Proving that invPhi is positive for distinct real roots.
-/
lemma invPhi_pos_of_distinct_roots (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (h_nodup : (X^3 + C a * X + C b).roots.Nodup) :
  invPhi (X^3 + C a * X + C b) > 0 := by
    have h_pos : 0 < (-4 * a^3 - 27 * b^2) / (18 * a^2) := by
      have h_pos : -4 * a^3 - 27 * b^2 > 0 := by
        apply discrim_reduced_cubic_pos_of_distinct_roots a b h_real h_nodup;
      exact div_pos h_pos ( mul_pos ( by norm_num ) ( sq_pos_of_ne_zero ( show a ≠ 0 by rintro rfl; nlinarith ) ) );
    rw [ invPhi_deg3_reduced_eq_v2 ] <;> aesop

/-
Proving that if the invPhi formula is positive, the cubic splits.
-/
lemma boxplus_splits_of_invPhi_formula_pos (a b : ℝ)
  (h_pos : invPhi_formula a b > 0) :
  (X^3 + C a * X + C b).Splits (RingHom.id ℝ) := by
    by_cases ha : a = 0 <;> simp_all +decide [ invPhi_formula ];
    -- Since the discriminant is negative, the polynomial has three real roots.
    have h_discriminant_neg : -4 * a^3 - 27 * b^2 > 0 := by
      rw [ lt_div_iff₀ ] at h_pos <;> first | positivity | linarith;
    have := cubic_splits_of_discrim_pos a b h_discriminant_neg;
    exact this.1

/-
Proving that boxplus of reduced cubics is a reduced cubic with summed coefficients.
-/
lemma boxplus_deg3_reduced_eq (p q : ℝ[X])
  (hp_monic : p.Monic) (hq_monic : q.Monic)
  (hp_deg : p.natDegree = 3) (hq_deg : q.natDegree = 3)
  (hp_red : p.coeff 2 = 0) (hq_red : q.coeff 2 = 0) :
  boxplus 3 p q = X^3 + C (p.coeff 1 + q.coeff 1) * X + C (p.coeff 0 + q.coeff 0) := by
    unfold boxplus;
    simp_all +decide [ Finset.sum_range_succ, boxplus_coeff ];
    simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
    ring

/-
Lemma: if a=0 for a split reduced cubic, then b=0.
-/
lemma reduced_cubic_coeff_zero_implies_const_zero (a b : ℝ)
  (h_real : (X^3 + C a * X + C b).Splits (RingHom.id ℝ))
  (ha : a = 0) :
  b = 0 := by
    -- Apply the lemma that states if a split reduced cubic has a=0, then b=0.
    apply reduced_cubic_eq_X_pow_3_of_a_nonneg a b h_real (by linarith) |> fun h => by
      simpa [ ha ] using congr_arg ( Polynomial.eval 0 ) h

/-
Definitions of phi and freeAddConv.
-/
def phi (n : ℕ) (roots : Fin n → ℝ) : ℝ :=
  ∑ i, (∑ j ∈ univ.erase i, 1 / (roots i - roots j)) ^ 2

def freeAddConv (n : ℕ) (p q : ℝ[X]) : ℝ[X] :=
  ∑ k ∈ range (n + 1), C
    (∑ i ∈ range (k + 1),
      (((n - i).factorial : ℝ) * ((n - (k - i)).factorial : ℝ)) /
      (((n.factorial : ℝ) * ((n - k).factorial : ℝ))) *
      p.coeff (n - i) * q.coeff (n - (k - i))) * X ^ (n - k)

/-
Phi is equal to twice the sum of squared inverse differences of roots.
-/
lemma phi_eq_sum_sq_diff (n : ℕ) (roots : Fin n → ℝ) (h_distinct : Function.Injective roots) :
    phi n roots = 2 * ∑ i, ∑ j ∈ univ.filter (fun j => i < j), 1 / (roots i - roots j) ^ 2 := by
  unfold phi;
  -- By expanding the square and rearranging terms, we can show that both sides are equal.
  have h_expand : ∑ i : Fin n, (∑ j ∈ Finset.univ.erase i, (roots i - roots j)⁻¹) ^ 2 = ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i, (roots i - roots j)⁻¹ * (roots i - roots k)⁻¹ := by
    simp +decide only [sq, ← Finset.mul_sum _ _ _, ← sum_mul];
  -- Split the sum into diagonal and off-diagonal terms.
  have h_split : ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i, (roots i - roots j)⁻¹ * (roots i - roots k)⁻¹ = ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, (roots i - roots j)⁻¹ * (roots i - roots j)⁻¹ + ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots i - roots j)⁻¹ * (roots i - roots k)⁻¹ := by
    simp +decide only [← sum_add_distrib];
    exact Finset.sum_congr rfl fun i hi => Finset.sum_congr rfl fun j hj => by rw [ Finset.sum_eq_add_sum_diff_singleton hj ] ;
  -- The off-diagonal terms sum to zero due to the cyclic identity.
  have h_off_diag : ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots i - roots j)⁻¹ * (roots i - roots k)⁻¹ = 0 := by
    -- For each distinct triple $(i, j, k)$, the term $\frac{1}{(roots i - roots j)(roots i - roots k)}$ appears twice with opposite signs.
    have h_triple : ∀ i j k : Fin n, i ≠ j → i ≠ k → j ≠ k → (roots i - roots j)⁻¹ * (roots i - roots k)⁻¹ + (roots j - roots i)⁻¹ * (roots j - roots k)⁻¹ + (roots k - roots i)⁻¹ * (roots k - roots j)⁻¹ = 0 := by
      field_simp;
      intro i j k hij hik hjk; rw [ div_add_div, div_add_div ] <;> try nlinarith [ mul_self_pos.2 ( sub_ne_zero.2 <| h_distinct.ne hij ), mul_self_pos.2 ( sub_ne_zero.2 <| h_distinct.ne hik ), mul_self_pos.2 ( sub_ne_zero.2 <| h_distinct.ne hjk ) ] ;
      · ring;
      · exact mul_ne_zero ( mul_ne_zero ( sub_ne_zero_of_ne <| h_distinct.ne hij ) ( sub_ne_zero_of_ne <| h_distinct.ne hik ) ) ( mul_ne_zero ( sub_ne_zero_of_ne <| h_distinct.ne <| by tauto ) ( sub_ne_zero_of_ne <| h_distinct.ne <| by tauto ) );
    -- By grouping the terms in the sum into triples, we can show that each group sums to zero.
    have h_group : ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots i - roots j)⁻¹ * (roots i - roots k)⁻¹ = ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots j - roots i)⁻¹ * (roots j - roots k)⁻¹ := by
      rw [ Finset.sum_sigma', Finset.sum_sigma' ];
      rw [ Finset.sum_sigma', Finset.sum_sigma' ];
      apply Finset.sum_bij (fun x _ => ⟨⟨x.fst.snd, x.fst.fst⟩, x.snd⟩);
      · simp +contextual [ Finset.mem_erase, Finset.mem_sdiff, Finset.mem_singleton ];
        exact fun a ha₁ ha₂ ha₃ => Ne.symm ha₁;
      · grind;
      · simp +decide [ Finset.mem_erase, Finset.mem_sdiff ];
        exact fun b hb₁ hb₂ hb₃ => ⟨ b.1.2, b.1.1, b.2, ⟨ by tauto, by tauto, by tauto ⟩, rfl ⟩;
      · simp +contextual [ mul_comm ];
    have h_group : ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots i - roots j)⁻¹ * (roots i - roots k)⁻¹ + ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots j - roots i)⁻¹ * (roots j - roots k)⁻¹ + ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots k - roots i)⁻¹ * (roots k - roots j)⁻¹ = 0 := by
      simp +decide only [← sum_add_distrib];
      refine' Finset.sum_eq_zero fun i hi => Finset.sum_eq_zero fun j hj => Finset.sum_eq_zero fun k hk => _;
      grind;
    have h_group : ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots k - roots i)⁻¹ * (roots k - roots j)⁻¹ = ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, ∑ k ∈ Finset.univ.erase i \ {j}, (roots i - roots j)⁻¹ * (roots i - roots k)⁻¹ := by
      rw [ Finset.sum_sigma', Finset.sum_sigma' ];
      rw [ Finset.sum_sigma', Finset.sum_sigma' ];
      apply Finset.sum_bij (fun x _ => ⟨⟨x.snd, x.fst.fst⟩, x.fst.snd⟩);
      · simp +contextual [ Finset.mem_erase, Finset.mem_sdiff, Finset.mem_singleton ];
        exact fun a ha₁ ha₂ ha₃ => ⟨ Ne.symm ha₂, Ne.symm ha₃ ⟩;
      · grind;
      · simp +decide [ Finset.mem_sigma, Finset.mem_erase ];
        exact fun b hb₁ hb₂ hb₃ => ⟨ b.fst.snd, b.snd, b.fst.fst, by tauto ⟩;
      · grind;
    linarith;
  -- The diagonal terms sum to twice the sum of squared inverse differences.
  have h_diag : ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, (roots i - roots j)⁻¹ * (roots i - roots j)⁻¹ = 2 * ∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j), (roots i - roots j)⁻¹ * (roots i - roots j)⁻¹ := by
    have h_diag : ∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, (roots i - roots j)⁻¹ * (roots i - roots j)⁻¹ = ∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i < j), (roots i - roots j)⁻¹ * (roots i - roots j)⁻¹ + ∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j => i > j), (roots i - roots j)⁻¹ * (roots i - roots j)⁻¹ := by
      rw [ ← Finset.sum_add_distrib, Finset.sum_congr rfl ];
      intro i hi; rw [ ← Finset.sum_union ] ; congr; ext j; simp +decide [ lt_asymm ] ;
      · rw [ eq_comm ];
      · exact Finset.disjoint_filter.mpr fun _ _ _ _ => lt_asymm ‹_› ‹_›;
    rw [ h_diag, two_mul ];
    simp +zetaDelta at *;
    rw [ Finset.sum_sigma', Finset.sum_sigma' ];
    apply Finset.sum_bij (fun x _ => ⟨x.snd, x.fst⟩);
    · simp +contextual;
    · grind;
    · simp +zetaDelta at *;
      exact fun b hb => ⟨ b.snd, b.fst, hb, rfl ⟩;
    · field_simp;
      exact fun x hx => by ring;
  convert h_expand.trans ( h_split.trans ( congr_arg₂ _ h_diag h_off_diag ) ) using 1 <;> ring;
  exact congrArg₂ _ ( Finset.sum_congr rfl fun i hi => Finset.sum_congr rfl fun j hj => by rw [ inv_pow ] ; ring ) rfl

/-
The function (b, x) -> (b/x)^2 is subadditive in the sense that f(b1+b2, x1+x2) <= f(b1, x1) + f(b2, x2) for x > 0.
-/
lemma sq_ratio_subadditive (b1 b2 x1 x2 : ℝ) (hx1 : 0 < x1) (hx2 : 0 < x2) :
    (b1 + b2) ^ 2 / (x1 + x2) ^ 2 ≤ b1 ^ 2 / x1 ^ 2 + b2 ^ 2 / x2 ^ 2 := by
  have h_convex : ∀ (x1 x2 : ℝ) (b1 b2 : ℝ), 0 < x1 → 0 < x2 → (b1 + b2)^2 / (x1 + x2)^2 ≤ (b1^2 / x1^2) + (b2^2 / x2^2) := by
    intro x1 x2 b1 b2 hx1 hx2
    have h_convex : (b1 + b2)^2 / (x1 + x2)^2 ≤ (x1 * (b1 / x1)^2 + x2 * (b2 / x2)^2) / (x1 + x2) := by
      field_simp;
      nlinarith [ sq_nonneg ( b1 * x2 - b2 * x1 ) ];
    refine le_trans h_convex ?_;
    rw [ div_le_iff₀ ] <;> ring_nf <;> try positivity;
    nlinarith [ show 0 ≤ x1 * b2 ^ 2 * x2⁻¹ ^ 2 by positivity, show 0 ≤ b1 ^ 2 * x1⁻¹ ^ 2 * x2 by positivity ];
  grind

/-
Phi can be expressed using the ratio of the second derivative to the first derivative (evaluated at roots), or equivalently using symmetric sums of differences.
-/
lemma phi_eq_sum_sq_deriv_quot (n : ℕ) (roots : Fin n → ℝ) (h_distinct : Function.Injective roots) :
    phi n roots = ∑ i, (2 * (∏ j ∈ univ.erase i, (roots i - roots j)))⁻¹ ^ 2 * (∑ k ∈ univ.erase i, ∏ j ∈ (univ.erase i).erase k, (roots i - roots j)) ^ 2 * 4 := by
  -- By definition of $\Phi$, we know that
  have h_phi_def : ∀ i, (∑ j ∈ Finset.univ.erase i, 1 / (roots i - roots j)) = (∑ k ∈ Finset.univ.erase i, ∏ j ∈ Finset.erase Finset.univ i \ {k}, (roots i - roots j)) / (∏ j ∈ Finset.univ.erase i, (roots i - roots j)) := by
    intro i; rw [ Finset.sum_div _ _ _ ] ; refine' Finset.sum_congr rfl fun j hj => _ ; rw [ div_eq_div_iff ] <;> simp_all +decide [ Finset.prod_eq_zero_iff, sub_eq_zero, h_distinct.eq_iff ] ;
    · rw [ Finset.prod_eq_prod_diff_singleton_mul <| Finset.mem_erase_of_ne_of_mem hj <| Finset.mem_univ _ ];
    · tauto;
  convert congr_arg ( fun x : Fin n → ℝ => ∑ i, x i ^ 2 ) ( funext fun i => h_phi_def i ) using 1 ; norm_num [ Finset.sdiff_singleton_eq_erase ] ; ring;
  exact Finset.sum_congr rfl fun _ _ => by ring;

/-
The formula for 1/Phi of a reduced cubic is superadditive in the coefficients.
-/
lemma invPhi_deg3_superadditive (a1 b1 a2 b2 : ℝ)
  (ha1 : a1 < 0) (ha2 : a2 < 0) :
  let f := fun a b => (-4 * a^3 - 27 * b^2) / (18 * a^2)
  f (a1 + a2) (b1 + b2) ≥ f a1 b1 + f a2 b2 := by
    norm_num +zetaDelta at *;
    rw [ div_add_div, div_le_div_iff₀ ] <;> try nlinarith [ mul_pos ( neg_pos.mpr ha1 ) ( neg_pos.mpr ha2 ) ];
    -- Apply the subadditivity of the square ratio function.
    have h_subadd : (b1 + b2)^2 / (a1 + a2)^2 ≤ b1^2 / a1^2 + b2^2 / a2^2 := by
      convert sq_ratio_subadditive b1 b2 ( -a1 ) ( -a2 ) ( neg_pos.mpr ha1 ) ( neg_pos.mpr ha2 ) using 1 ; ring;
      norm_num +zetaDelta at *;
    rw [ div_add_div, div_le_div_iff₀ ] at h_subadd <;> nlinarith [ mul_pos ( neg_pos.mpr ha1 ) ( neg_pos.mpr ha2 ) ]

/-
Phi is translation invariant.
-/
lemma phi_translation_invariant (n : ℕ) (roots : Fin n → ℝ) (c : ℝ) :
    phi n (fun i => roots i + c) = phi n roots := by
  unfold phi;
  simp +zetaDelta at *

/-
The (n-1)-th coefficient of the boxplus convolution is the sum of the (n-1)-th coefficients of the operands, for n > 0.
-/
lemma boxplus_coeff_n_minus_1 (n : ℕ) (hn : 0 < n) (p q : ℝ[X]) (hp : p.natDegree = n) (hq : q.natDegree = n) (hp_monic : p.Monic) (hq_monic : q.Monic) :
    (boxplus n p q).coeff (n - 1) = p.coeff (n - 1) + q.coeff (n - 1) := by
  rcases n with ( _ | _ | n ) <;> simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ];
  · convert boxplus_deg1_coeffs p q hp_monic hq_monic hp hq |>.2 using 1;
  · unfold boxplus;
    rw [ Polynomial.finset_sum_coeff, Finset.sum_eq_add ( 0 : ℕ ) 1 ] <;> norm_num;
    · unfold boxplus_coeff; norm_num [ Finset.sum_range_succ', hp, hq ] ; ring;
      simp +decide [ Nat.add_comm 1, Nat.add_comm 2, mul_assoc, mul_comm, mul_left_comm, Nat.factorial_ne_zero ];
      have := hp_monic.coeff_natDegree; have := hq_monic.coeff_natDegree; aesop;
    · intros; omega;

/-
For centered polynomials (coeff of x^(n-1) is 0), the coefficient of x^(n-2) in the boxplus convolution is additive.
-/
lemma boxplus_coeff_n_minus_2_of_centered (n : ℕ) (hn : 2 ≤ n) (p q : ℝ[X])
    (hp : p.natDegree = n) (hq : q.natDegree = n)
    (hp_monic : p.Monic) (hq_monic : q.Monic)
    (hp_centered : p.coeff (n - 1) = 0) (hq_centered : q.coeff (n - 1) = 0) :
    (boxplus n p q).coeff (n - 2) = p.coeff (n - 2) + q.coeff (n - 2) := by
  rcases n with ( _ | _ | n ) <;> simp_all +decide [ Finset.sum_range_succ', Finset.sum_range_zero ];
  unfold boxplus; simp +decide [ Finset.sum_range_succ' ] ;
  rw [ Finset.sum_eq_zero ] <;> norm_num [ boxplus_coeff ];
  · norm_num [ Finset.sum_range_succ', Nat.factorial_ne_zero, hp_centered, hq_centered ];
    simp_all +decide [ Nat.factorial_ne_zero, mul_comm, mul_assoc, mul_left_comm, Nat.succ_eq_add_one, add_assoc ];
    simp_all +decide [ Polynomial.Monic.def, Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some ];
  · intros; omega;

/-
Phi scales by 1/c^2 when roots are scaled by c.
-/
lemma phi_scaling (n : ℕ) (roots : Fin n → ℝ) (c : ℝ) (hc : c ≠ 0) :
    phi n (fun i => c * roots i) = (1 / c ^ 2) * phi n roots := by
  unfold phi;
  simp +decide [ ← mul_sub, mul_pow, Finset.mul_sum _ _ _, div_eq_mul_inv, sq, mul_assoc, mul_comm, mul_left_comm, Finset.sum_mul ]

/-
Definition of hat_poly.
-/
def hat_poly (n : ℕ) (p : ℝ[X]) : ℝ[X] :=
  ∑ i ∈ range (n + 1), C (p.coeff (n - i) * (n - i).factorial) * X ^ i

/-
Definition of truncated_exp.
-/
def truncated_exp (n : ℕ) (c : ℝ) : ℝ[X] :=
  ∑ i ∈ range (n + 1), C (c ^ i / i.factorial) * X ^ i

/-
The hat transform of a translated polynomial is congruent to the hat transform of the original polynomial multiplied by a truncated exponential, modulo X^(n+1).
-/
lemma hat_poly_translate (n : ℕ) (p : ℝ[X]) (c : ℝ) (hp : p.natDegree ≤ n) :
    (hat_poly n (p.comp (X + C c))) % (X ^ (n + 1)) = ((hat_poly n p) * (truncated_exp n c)) % (X ^ (n + 1)) := by
  by_contra h_contra;
  -- We'll use the fact that if the polynomial $P(x)$ is evaluated at $x + c$, then its coefficients are given by the binomial theorem.
  have h_binom : ∀ i ∈ Finset.range (n + 1), Polynomial.coeff ((p.comp (Polynomial.X + Polynomial.C c))) (n - i) = ∑ j ∈ Finset.range (i + 1), Polynomial.coeff p (n - j) * (Nat.choose (n - j) (n - i)) * c ^ (i - j) := by
    intros i hi
    have h_binom_step : Polynomial.coeff ((p.comp (Polynomial.X + Polynomial.C c))) (n - i) = ∑ j ∈ Finset.range (n + 1), Polynomial.coeff p j * (Nat.choose j (n - i)) * c ^ (j - (n - i)) * (if j ≥ n - i then 1 else 0) := by
      rw [ Polynomial.comp, Polynomial.eval₂_eq_sum_range' ];
      any_goals exact Nat.lt_succ_of_le hp;
      norm_num [ Polynomial.coeff_sum, Polynomial.coeff_C, Polynomial.coeff_X_add_C_pow ];
      refine' Finset.sum_congr rfl fun x hx => _ ; split_ifs <;> ring;
      rw [ Nat.choose_eq_zero_of_lt ( by omega ), Nat.cast_zero, MulZeroClass.mul_zero ];
    have h_change_var : Finset.filter (fun j => j ≥ n - i) (Finset.range (n + 1)) = Finset.image (fun j => n - j) (Finset.range (i + 1)) := by
      ext j
      simp [Finset.mem_filter, Finset.mem_image];
      exact ⟨ fun h => ⟨ n - j, by omega, by omega ⟩, fun ⟨ a, ha, ha' ⟩ => ⟨ by omega, by omega ⟩ ⟩;
    simp_all +decide [ Finset.sum_ite ];
    rw [ Finset.sum_image ] <;> norm_num;
    · grind;
    · exact fun x hx y hy hxy => by rw [ tsub_right_inj ] at hxy <;> linarith [ Set.mem_Iio.mp hx, Set.mem_Iio.mp hy ] ;
  -- By definition of hat_poly and truncated_exp, we can expand both sides of the equation.
  have h_expand : ∀ i ∈ Finset.range (n + 1), Polynomial.coeff (hat_poly n (p.comp (X + C c))) i = ∑ j ∈ Finset.range (i + 1), Polynomial.coeff (hat_poly n p) j * (c ^ (i - j) / (i - j).factorial) := by
    intro i hi; rw [ show hat_poly n ( p.comp ( X + C c ) ) = ∑ j ∈ Finset.range ( n + 1 ), C ( Polynomial.coeff ( p.comp ( X + C c ) ) ( n - j ) * ( n - j ).factorial ) * X ^ j from ?_ ] ; simp +decide [ *, Polynomial.coeff_sum, Polynomial.coeff_C_mul ] ;
    · rw [ show hat_poly n p = ∑ j ∈ Finset.range ( n + 1 ), C ( p.coeff ( n - j ) * ( n - j ).factorial ) * X ^ j from ?_ ] ; simp +decide [ Polynomial.coeff_sum, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, Nat.factorial_ne_zero, mul_assoc, mul_div_assoc, Finset.sum_mul _ _ _ ];
      · rw [ h_binom i hi, Finset.sum_congr rfl fun j hj => if_pos <| by linarith [ Finset.mem_range.mp hj, Finset.mem_range.mp hi ] ] ; simp +decide [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _, Nat.cast_choose ];
        rw [ if_pos ( Finset.mem_range.mp hi ) ] ; refine' Finset.sum_congr rfl fun x hx => _ ; rw [ Nat.cast_choose ] ; ring;
        · simp +decide [ Nat.sub_sub, add_comm, mul_assoc, mul_comm, mul_left_comm, Nat.factorial_ne_zero ];
          rw [ show n - ( x + ( n - i ) ) = i - x from by rw [ Nat.sub_eq_of_eq_add ] ; linarith [ Nat.sub_add_cancel ( show x ≤ i from Finset.mem_range_succ_iff.mp hx ), Nat.sub_add_cancel ( show i ≤ n from Finset.mem_range_succ_iff.mp hi ), Nat.sub_add_cancel ( show x ≤ n from by linarith [ Finset.mem_range_succ_iff.mp hx, Finset.mem_range_succ_iff.mp hi ] ) ] ] ; ring ; aesop;
        · exact Nat.sub_le_sub_left ( by linarith [ Finset.mem_range.mp hx ] ) _;
      · exact?;
    · exact?;
  -- By definition of hat_poly and truncated_exp, we can expand both sides of the equation modulo X^(n+1).
  have h_expand_mod : ∀ i ∈ Finset.range (n + 1), Polynomial.coeff (hat_poly n (p.comp (X + C c))) i = Polynomial.coeff (hat_poly n p * truncated_exp n c) i := by
    intro i hi; rw [ h_expand i hi ] ; simp +decide [ Polynomial.coeff_mul, Finset.sum_mul _ _ _ ] ;
    rw [ Finset.Nat.sum_antidiagonal_eq_sum_range_succ fun j k => Polynomial.coeff ( hat_poly n p ) j * Polynomial.coeff ( truncated_exp n c ) k ];
    simp +decide [ truncated_exp ];
    exact Finset.sum_congr rfl fun x hx => by rw [ if_pos ( by linarith [ Finset.mem_range.mp hi, Finset.mem_range.mp hx, Nat.sub_le i x ] ) ] ;
  refine' h_contra _;
  rw [ Polynomial.mod_def, Polynomial.mod_def ];
  rw [ Polynomial.modByMonic_eq_of_dvd_sub ];
  · erw [ Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C ] ; norm_num;
  · rw [ Polynomial.leadingCoeff_X_pow ] ; norm_num;
    rw [ Polynomial.X_pow_dvd_iff ];
    exact fun i hi => by rw [ Polynomial.coeff_sub, h_expand_mod i ( Finset.mem_range.mpr hi ), sub_self ] ;

/-
The k-th coefficient of the hat transform of the boxplus convolution satisfies the identity.
-/
lemma hat_poly_boxplus_coeff (n : ℕ) (p q : ℝ[X]) (k : ℕ) (hk : k ≤ n) :
    (hat_poly n (boxplus n p q)).coeff k = (1 / (n.factorial : ℝ)) * ((hat_poly n p) * (hat_poly n q)).coeff k := by
  unfold hat_poly boxplus;
  norm_num [ Polynomial.coeff_mul ];
  simp +decide [ Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk, boxplus_coeff ];
  simp +decide [ Finset.sum_ite, Finset.filter_eq', Finset.filter_ne', Polynomial.coeff_C ];
  rw [ if_pos ( by linarith ) ];
  rw [ show ( Finset.filter ( fun x => n - k = n - x ) ( Finset.range ( n + 1 ) ) ) = { k } from ?_ ] ; norm_num [ Finset.sum_singleton, mul_assoc, mul_comm, mul_left_comm, div_eq_mul_inv ];
  · rw [ Finset.sum_filter ];
    field_simp;
    rw [ Finset.mul_sum _ _ _, Finset.sum_filter ];
    exact Finset.sum_congr rfl fun x hx => by rw [ if_pos ( by omega ), if_pos ( by linarith [ Finset.mem_range.mp hx ] ) ] ; rw [ mul_div_cancel₀ _ ( by positivity ) ] ;
  · grind

/-
The sum of squared derivative quotients for a reduced cubic equals 18a^2 / Discriminant.
-/
lemma sum_sq_deriv_quot_cubic_proven (r1 r2 r3 a b : ℝ)
  (h_sum : r1 + r2 + r3 = 0)
  (h_prod_sum : r1 * r2 + r2 * r3 + r3 * r1 = a)
  (h_prod : r1 * r2 * r3 = -b)
  (h_distinct : r1 ≠ r2 ∧ r1 ≠ r3 ∧ r2 ≠ r3)
  (h_denom : 3 * r1^2 + a ≠ 0 ∧ 3 * r2^2 + a ≠ 0 ∧ 3 * r3^2 + a ≠ 0) :
  (3 * r1 / (3 * r1^2 + a))^2 + (3 * r2 / (3 * r2^2 + a))^2 + (3 * r3 / (3 * r3^2 + a))^2 =
  18 * a^2 / (-4 * a^3 - 27 * b^2) := by
    convert sum_sq_deriv_quot_cubic_v2 r1 r2 r3 a b h_sum h_prod_sum h_prod h_distinct h_denom using 1

/-
Polynomials with matching coefficients up to degree n are congruent modulo X^(n+1).
-/
lemma polynomial_congruent_of_coeff_eq (n : ℕ) (p q : ℝ[X])
    (h : ∀ k ≤ n, p.coeff k = q.coeff k) :
    p % (X ^ (n + 1)) = q % (X ^ (n + 1)) := by
  -- By definition of polynomial division, we know that $p - q$ is divisible by $X^{n+1}$.
  have h_div : (p - q) % X ^ (n + 1) = 0 := by
    simp +zetaDelta at *;
    rw [ Polynomial.X_pow_dvd_iff ];
    exact fun k hk => by rw [ Polynomial.coeff_sub, h k ( Nat.le_of_lt_succ hk ), sub_self ] ;
  norm_num [ Polynomial.mod_def ] at *;
  rw [ Polynomial.sub_modByMonic ] at h_div;
  exact eq_of_sub_eq_zero h_div

/-
The hat transform of the boxplus convolution is congruent to the scaled product of hat transforms modulo X^(n+1).
-/
lemma hat_poly_boxplus (n : ℕ) (p q : ℝ[X]) (hp : p.natDegree = n) (hq : q.natDegree = n) (hp_monic : p.Monic) (hq_monic : q.Monic) :
    (hat_poly n (boxplus n p q)) % (X ^ (n + 1)) = ((1 / (n.factorial : ℝ)) • ((hat_poly n p) * (hat_poly n q))) % (X ^ (n + 1)) := by
  apply polynomial_congruent_of_coeff_eq
  intro k hk
  rw [hat_poly_boxplus_coeff n p q k hk]
  simp only [Polynomial.coeff_smul]
  rfl

/-
Checking types.
-/
#check Polynomial.taylor
#check Polynomial.coeff

/-
Definition of normalized_hat_poly.
-/
noncomputable def normalized_hat_poly (n : ℕ) (p : ℝ[X]) : ℝ[X] :=
  (hat_poly n p) * C (1 / (hat_poly n p).coeff 0)

/-
Definition of poly_log.
-/
noncomputable def poly_log (n : ℕ) (p : ℝ[X]) : ℝ[X] :=
  let q := p - 1
  ∑ i ∈ range (n + 1), C ((-1 : ℝ) ^ i / (i + 1 : ℝ)) * q ^ (i + 1)

/-
poly_log respects congruence modulo X^(n+1).
-/
lemma poly_log_congruent (n : ℕ) (p q : ℝ[X])
    (hp : p.coeff 0 = 1) (hq : q.coeff 0 = 1)
    (h : p % (X ^ (n + 1)) = q % (X ^ (n + 1))) :
    (poly_log n p) % (X ^ (n + 1)) = (poly_log n q) % (X ^ (n + 1)) := by
  by_contra h_neq
  obtain ⟨r, hr⟩ : ∃ r, p = q + X ^ (n + 1) * r := by
    rw [ EuclideanDomain.mod_eq_sub_mul_div, EuclideanDomain.mod_eq_sub_mul_div ] at h;
    exact ⟨ p / X ^ ( n + 1 ) - q / X ^ ( n + 1 ), by linear_combination' h ⟩
  have h_pos : 0 < n := by
    rcases n with ( _ | n ) <;> simp_all +decide [ Polynomial.coeff_zero_eq_eval_zero ];
    unfold poly_log at h_neq; simp_all +decide [ Polynomial.mod_def ] ;
    simp_all +decide [ Polynomial.modByMonic_X ]
  have h_r_zero : r = 0 := by
    exact Classical.not_not.1 fun hr' => h_neq <| by
      unfold poly_log at *; simp_all +decide [ Polynomial.mod_def ] ;
      refine' h_neq _;
      rw [ Polynomial.modByMonic_eq_of_dvd_sub ];
      · exact Polynomial.monic_X_pow _;
      · rw [ ← Finset.sum_sub_distrib ];
        refine' Finset.dvd_sum fun i hi => _;
        rw [ ← mul_sub ];
        refine' dvd_mul_of_dvd_right _ _;
        rw [ ← geom_sum₂_mul ];
        exact dvd_mul_of_dvd_right ( by exact ⟨ r, by ring ⟩ ) _;
  aesop
  skip

/-
The truncated inverse acts as a multiplicative inverse modulo X^(n+1).
-/
noncomputable def poly_inv (n : ℕ) (p : ℝ[X]) : ℝ[X] :=
  let q := 1 - p
  ∑ i ∈ range (n + 1), q ^ i

lemma poly_inv_mul_mod (n : ℕ) (p : ℝ[X]) (hp : p.coeff 0 = 1) :
    (p * poly_inv n p) % (X ^ (n + 1)) = 1 := by
  -- Since $p(0) = 1$, we have $q(0) = 0$, so $X \mid q$.
  have hq_div : X ∣ (1 - p) := by
    simpa [ hp ] using Polynomial.X_dvd_iff.mpr ( by aesop );
  -- Then $p * \sum_{i=0}^n q^i = (1-q) \sum_{i=0}^n q^i = 1 - q^{n+1}$.
  have h_poly_inv : p * (∑ i ∈ Finset.range (n + 1), (1 - p) ^ i) = 1 - (1 - p) ^ (n + 1) := by
    rw [ ← geom_sum_mul_neg ] ; ring;
  -- Since $X \mid q$, we have $X^{n+1} \mid q^{n+1}$.
  have hq_pow_div : X ^ (n + 1) ∣ (1 - p) ^ (n + 1) := by
    exact pow_dvd_pow_of_dvd hq_div _;
  -- Therefore, $p * \sum_{i=0}^n q^i \equiv 1 \pmod{X^{n+1}}$.
  have h_poly_inv_mod : p * (∑ i ∈ Finset.range (n + 1), (1 - p) ^ i) % X ^ (n + 1) = 1 % X ^ (n + 1) := by
    rw [ h_poly_inv, Polynomial.mod_def, Polynomial.mod_def ];
    rw [ Polynomial.sub_modByMonic ];
    obtain ⟨ q, hq ⟩ := hq_pow_div; aesop;
  convert h_poly_inv_mod using 1;
  rw [ eq_comm, Polynomial.mod_eq_self_iff ];
  · norm_num;
    exact_mod_cast Nat.succ_pos n;
  · exact pow_ne_zero _ <| Polynomial.X_ne_zero

/-
The derivative of the truncated logarithm is the logarithmic derivative modulo X^n.
-/
lemma poly_log_derivative (n : ℕ) (p : ℝ[X]) (hp : p.coeff 0 = 1) :
    (Polynomial.derivative (poly_log n p)) % (X ^ n) = ((Polynomial.derivative p) * (poly_inv n p)) % (X ^ n) := by
  -- Let $q = \text{poly\_inv } n p$. Then $p * q \equiv 1 \pmod{X^{n+1}}$.
  set q : ℝ[X] := poly_inv n p
  have hq : p * q % (X ^ (n + 1)) = 1 := by
    convert poly_inv_mul_mod n p hp using 1;
  -- By definition of $p$ and $q$, we know that $p = 1 - r$ and $q = \sum_{i=0}^{n} r^i$ for some polynomial $r$ with $r(0) = 0$.
  set r : ℝ[X] := 1 - p
  have hr : r.coeff 0 = 0 := by
    aesop
  have hq_def : q = Finset.sum (Finset.range (n + 1)) (fun i => r ^ i) := by
    aesop;
  -- By definition of $p$ and $q$, we know that $p' = -r'$ and $q' = \sum_{i=1}^{n} i r^{i-1} r'$.
  have hp'_def : derivative p = -derivative r := by
    rw [ Polynomial.derivative_sub ] ; norm_num;
  have hq'_def : derivative q = Finset.sum (Finset.range (n + 1)) (fun i => Polynomial.C (i : ℝ) * r ^ (i - 1) * derivative r) := by
    norm_num [ hq_def, Polynomial.derivative_sum, Polynomial.derivative_pow ]
  generalize_proofs at *; (
  -- By definition of $p$ and $q$, we know that $\log p = \sum_{i=1}^{n+1} -r^i/i$.
  have hlog_def : poly_log n p = -Finset.sum (Finset.range (n + 1)) (fun i => Polynomial.C (1 / (i + 1 : ℝ)) * r ^ (i + 1)) := by
    unfold poly_log
    generalize_proofs at *; (
    rw [ ← Finset.sum_neg_distrib ] ; ext ; ring;
    simp +zetaDelta at *;
    rw [ ← Finset.sum_neg_distrib ] ; rw [ ← Finset.sum_sub_distrib ] ; congr ; ext ; ring;
    norm_num [ mul_assoc, ← mul_pow ] ; ring)
  generalize_proofs at *; (
  -- By definition of $p$ and $q$, we know that $(\log p)' = \sum_{i=1}^{n+1} -r^{i-1} r'$.
  have hlog'_def : derivative (poly_log n p) = -Finset.sum (Finset.range (n + 1)) (fun i => Polynomial.C (1 : ℝ) * r ^ i * derivative r) := by
    norm_num [ hlog_def, Polynomial.derivative_sum, Polynomial.derivative_pow ];
    exact Finset.sum_congr rfl fun i hi => Polynomial.funext fun x => by simp +decide [ ← mul_assoc, ne_of_gt ( Nat.cast_add_one_pos i ) ] ;
  generalize_proofs at *; (
  simp_all +decide [ mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _ ];
  simp +decide [ Finset.sum_mul _ _ _ ])))

/-
Polynomials with congruent derivatives and equal constant terms are congruent modulo X^(n+1).
-/
lemma polynomial_congruent_of_derivative_congruent (n : ℕ) (p q : ℝ[X])
    (h_deriv : (Polynomial.derivative p) % (X ^ n) = (Polynomial.derivative q) % (X ^ n))
    (h_const : p.coeff 0 = q.coeff 0) :
    p % (X ^ (n + 1)) = q % (X ^ (n + 1)) := by
  -- Since $p - q$ is in $X^{n+1}$, we have $p \equiv q \pmod{X^{n+1}}$.
  have h_cong : (p - q) % X ^ (n + 1) = 0 := by
    -- Since the derivative of $p - q$ is divisible * $X^n$, $p - q$ must be divisible by $X^{n+1}$.
    have h_div : X ^ (n + 1) ∣ p - q := by
      -- Since the derivative of $p - q$ is divisible by $X^n$, we can write $p - q = X^{n+1} \cdot r$ for some polynomial $r$.
      have h_div : ∃ r : Polynomial ℝ, p - q = X ^ (n + 1) * r := by
        have h_deriv_div : X ^ n ∣ Polynomial.derivative (p - q) := by
          simp_all +decide [ EuclideanDomain.mod_eq_sub_mul_div ];
          exact ⟨ Polynomial.derivative p / X ^ n - Polynomial.derivative q / X ^ n, by linear_combination' h_deriv ⟩
        -- Since the derivative of $p - q$ is divisible by $X^n$, we can write $p - q$ as $X^{n+1}$ times some polynomial $r$.
        have h_div : ∀ k : ℕ, Polynomial.coeff (p - q) k = 0 ∨ k ≥ n + 1 := by
          intro k; contrapose! h_deriv_div; simp_all +decide [ Polynomial.coeff_derivative ] ;
          intro h; obtain ⟨ r, hr ⟩ := h; replace hr := congr_arg ( fun z => Polynomial.coeff z ( k - 1 ) ) hr; rcases k with ( _ | k ) <;> simp_all +decide [ Polynomial.coeff_derivative ] ;
          rw [ Polynomial.coeff_mul ] at hr ; simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ];
          rw [ Finset.sum_eq_zero ] at hr <;> simp_all +decide [ sub_eq_iff_eq_add ];
          · norm_cast at hr;
          · intros; linarith;
        exact exists_eq_mul_right_of_dvd ( Polynomial.X_pow_dvd_iff.mpr fun k hk => Or.resolve_right ( h_div k ) ( by linarith ) );
      exact h_div;
    aesop;
  rw [ Polynomial.mod_def, Polynomial.mod_def ] at *;
  rw [ Polynomial.sub_modByMonic ] at h_cong;
  exact eq_of_sub_eq_zero h_cong

/-
The truncated inverse is unique modulo X^(n+1).
-/
lemma poly_inv_unique (n : ℕ) (p q : ℝ[X]) (hp : p.coeff 0 = 1)
    (h : (p * q) % (X ^ (n + 1)) = 1) :
    q % (X ^ (n + 1)) = (poly_inv n p) % (X ^ (n + 1)) := by
  -- We know $p * poly\_inv(p) \equiv 1 \pmod{X^{n+1}}$.
  have h_poly_inv : (p * poly_inv n p) % (X ^ (n + 1)) = 1 := by
    convert poly_inv_mul_mod n p hp using 1;
  -- Given $p * q \equiv 1 \pmod{X^{n+1}}$.
  have h_cong : (p * q) % (X ^ (n + 1)) = (p * poly_inv n p) % (X ^ (n + 1)) := by
    rw [h, h_poly_inv];
  -- By definition of polynomial congruence modulo $X^{n+1}$, we know that $(p * q - p * poly_inv n p)$ is divisible by $X^{n+1}$.
  have h_div : (X ^ (n + 1)) ∣ (p * q - p * poly_inv n p) := by
    rw [ ← EuclideanDomain.div_add_mod ( p * q ) ( X ^ ( n + 1 ) ), ← EuclideanDomain.div_add_mod ( p * poly_inv n p ) ( X ^ ( n + 1 ) ), h_cong ] ; norm_num;
    exact dvd_sub ( dvd_mul_right _ _ ) ( dvd_mul_right _ _ );
  -- Since $p$ is monic, $p$ is coprime with $X^{n+1}$, so $X^{n+1}$ must divide $(q - poly_inv n p)$.
  have h_div_q : (X ^ (n + 1)) ∣ (q - poly_inv n p) := by
    refine' ( IsCoprime.dvd_of_dvd_mul_left _ <| by simpa only [ mul_sub ] using h_div );
    refine' IsCoprime.pow_left _;
    exact ⟨ -p.divX, 1, by ext i; rcases i with ( _ | i ) <;> simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ] ⟩;
  obtain ⟨ r, hr ⟩ := h_div_q; simp +decide [ sub_eq_iff_eq_add'.mp hr ] ;
  norm_num [ Polynomial.mod_def ];
  rw [ Polynomial.add_modByMonic ] ; aesop

/-
The truncated inverse of a product is the product of truncated inverses modulo X^(n+1).
-/
lemma poly_inv_mul (n : ℕ) (p q : ℝ[X]) (hp : p.coeff 0 = 1) (hq : q.coeff 0 = 1) :
    (poly_inv n (p * q)) % (X ^ (n + 1)) = ((poly_inv n p) * (poly_inv n q)) % (X ^ (n + 1)) := by
      have h_unique : (p * q) * (poly_inv n p * poly_inv n q) % (X ^ (n + 1)) = 1 := by
        have h_inv_prod : (p * poly_inv n p) % (X ^ (n + 1)) = 1 ∧ (q * poly_inv n q) % (X ^ (n + 1)) = 1 := by
          exact ⟨ poly_inv_mul_mod n p hp, poly_inv_mul_mod n q hq ⟩;
        convert congr_arg₂ ( fun x y : ℝ[X] => x * y % X ^ ( n + 1 ) ) h_inv_prod.1 h_inv_prod.2 using 1 ; ring;
        · norm_num [ mul_assoc, mul_comm, mul_left_comm, Polynomial.mod_def ];
          rw [ mul_comm, Polynomial.modByMonic_eq_of_dvd_sub ];
          · exact Polynomial.monic_X.mul ( Polynomial.monic_X_pow _ );
          · rw [ Polynomial.modByMonic_eq_sub_mul_div ];
            · rw [ Polynomial.modByMonic_eq_sub_mul_div ];
              · exact ⟨ ( p * poly_inv n p /ₘ ( X * X ^ n ) ) * ( q * poly_inv n q ) + ( q * poly_inv n q /ₘ ( X * X ^ n ) ) * ( p * poly_inv n p ) - X * X ^ n * ( p * poly_inv n p /ₘ ( X * X ^ n ) ) * ( q * poly_inv n q /ₘ ( X * X ^ n ) ), by ring ⟩;
              · exact Polynomial.monic_X.mul ( Polynomial.monic_X_pow _ );
            · exact Polynomial.monic_X.mul ( Polynomial.monic_X_pow _ );
        · norm_num [ EuclideanDomain.mod_eq_sub_mul_div ];
          rw [ Polynomial.div_eq_zero_iff ( pow_ne_zero _ Polynomial.X_ne_zero ) |>.2 ] <;> norm_num;
          exact_mod_cast Nat.succ_pos n;
      have h_poly_inv_unique : ∀ r : ℝ[X], ((p * q) * r) % (X ^ (n + 1)) = 1 → r % (X ^ (n + 1)) = poly_inv n (p * q) % (X ^ (n + 1)) := by
        intros r hr
        apply poly_inv_unique n (p * q) r (by
        simp +decide [ hp, hq ]) hr
        skip;
      exact Eq.symm ( h_poly_inv_unique _ h_unique )

/-
Congruence modulo X^(n+1) implies congruence modulo X^n.
-/
lemma mod_pow_succ_implies_mod_pow (n : ℕ) (p q : ℝ[X])
    (h : p % (X ^ (n + 1)) = q % (X ^ (n + 1))) :
    p % (X ^ n) = q % (X ^ n) := by
  -- By definition of polynomial congruence modulo $X^{n+1}$, we have $p - q = X^{n+1} * r$ for some polynomial $r$.
  obtain ⟨r, hr⟩ : ∃ r : ℝ[X], p - q = X ^ (n + 1) * r := by
    exact ⟨ p / X ^ ( n + 1 ) - q / X ^ ( n + 1 ), by rw [ EuclideanDomain.mod_eq_sub_mul_div, EuclideanDomain.mod_eq_sub_mul_div ] at h; linear_combination h ⟩;
  rw [ sub_eq_iff_eq_add'.mp hr ];
  norm_num [ pow_succ, mul_assoc, Polynomial.mod_def ];
  rw [ Polynomial.add_modByMonic ] ; norm_num

/-
The derivative of the truncated logarithm of a product is additive modulo X^n.
-/
lemma poly_log_derivative_mul_mod (n : ℕ) (p q : ℝ[X])
    (hp : p.coeff 0 = 1) (hq : q.coeff 0 = 1) :
    (Polynomial.derivative (poly_log n (p * q))) % (X ^ n) = ((Polynomial.derivative (poly_log n p)) + (Polynomial.derivative (poly_log n q))) % (X ^ n) := by
      -- By definition of $poly\_log$, we know that its derivative is the logarithmic derivative modulo $X^n$.
      have h_deriv : ∀ p : ℝ[X], p.coeff 0 = 1 → (Polynomial.derivative (poly_log n p)) % (X ^ n) = ((Polynomial.derivative p) * (poly_inv n p)) % (X ^ n) := by
        exact?;
      -- By definition of $poly\_inv$, we know that $(pq)' (poly\_inv n (pq)) \equiv p' (poly\_inv n p) + q' (poly\_inv n q) \pmod{X^n}$.
      have h_poly_inv : ((Polynomial.derivative (p * q)) * (poly_inv n (p * q))) % (X ^ n) = (((Polynomial.derivative p) * (poly_inv n p)) + ((Polynomial.derivative q) * (poly_inv n q))) % (X ^ n) := by
        have h_deriv_add : (Polynomial.derivative (p * q)) * (poly_inv n (p * q)) % (X ^ n) = ((Polynomial.derivative p) * q * (poly_inv n p) * (poly_inv n q) + p * (Polynomial.derivative q) * (poly_inv n p) * (poly_inv n q)) % (X ^ n) := by
          have h_deriv_add : (Polynomial.derivative (p * q)) * (poly_inv n (p * q)) % (X ^ n) = ((Polynomial.derivative p) * q + p * (Polynomial.derivative q)) * (poly_inv n p) * (poly_inv n q) % (X ^ n) := by
            have h_deriv_add : (poly_inv n (p * q)) % (X ^ n) = (poly_inv n p * poly_inv n q) % (X ^ n) := by
              have h_inv : (poly_inv n (p * q)) % (X ^ (n + 1)) = ((poly_inv n p) * (poly_inv n q)) % (X ^ (n + 1)) := by
                exact?;
              convert mod_pow_succ_implies_mod_pow n _ _ h_inv using 1;
            simp_all +decide [ mul_assoc, Polynomial.mod_def ];
            rw [ Polynomial.modByMonic_eq_of_dvd_sub ];
            · exact Polynomial.monic_X_pow _;
            · rw [ ← mul_sub ];
              refine' dvd_mul_of_dvd_right _ _;
              rw [ Polynomial.modByMonic_eq_sub_mul_div _ ( Polynomial.monic_X_pow _ ) ] at h_deriv_add;
              rw [ Polynomial.modByMonic_eq_sub_mul_div _ ( Polynomial.monic_X_pow _ ) ] at h_deriv_add;
              exact ⟨ poly_inv n ( p * q ) /ₘ X ^ n - ( poly_inv n p * poly_inv n q /ₘ X ^ n ), by linear_combination' h_deriv_add ⟩;
          exact h_deriv_add.trans ( by ring );
        -- By definition of $poly\_inv$, we know that $p * poly\_inv n p \equiv 1 \pmod{X^n}$ and $q * poly\_inv n q \equiv 1 \pmod{X^n}$.
        have h_poly_inv_p : p * poly_inv n p % (X ^ (n + 1)) = 1 % (X ^ (n + 1)) := by
          convert poly_inv_mul_mod n p hp using 1;
          norm_num [ Polynomial.mod_def ];
          erw [ Polynomial.modByMonic_eq_self_iff ] ; norm_num [ Polynomial.natDegree_X_pow ];
          · exact_mod_cast Nat.succ_pos n;
          · exact Polynomial.monic_X_pow _
        have h_poly_inv_q : q * poly_inv n q % (X ^ (n + 1)) = 1 % (X ^ (n + 1)) := by
          convert poly_inv_mul_mod n q hq using 1;
          norm_num [ Polynomial.mod_def ];
          erw [ Polynomial.modByMonic_eq_self_iff ] ; norm_num [ Polynomial.natDegree_X_pow ];
          · exact_mod_cast Nat.succ_pos n;
          · exact Polynomial.monic_X_pow _;
        -- Since $p * poly\_inv n p \equiv 1 \pmod{X^{n+1}}$ and $q * poly\_inv n q \equiv 1 \pmod{X^{n+1}}$, we have $p * poly\_inv n p \equiv 1 \pmod{X^n}$ and $q * poly\_inv n q \equiv 1 \pmod{X^n}$.
        have h_poly_inv_p_mod : p * poly_inv n p % (X ^ n) = 1 % (X ^ n) := by
          convert mod_pow_succ_implies_mod_pow n ( p * poly_inv n p ) 1 h_poly_inv_p using 1
        have h_poly_inv_q_mod : q * poly_inv n q % (X ^ n) = 1 % (X ^ n) := by
          convert mod_pow_succ_implies_mod_pow n ( q * poly_inv n q ) 1 h_poly_inv_q using 1;
        simp_all +decide [ mul_assoc, mul_comm, mul_left_comm, Polynomial.mod_def ];
        rw [ show q * ( poly_inv n p * ( poly_inv n q * derivative p ) ) + p * ( poly_inv n p * ( poly_inv n q * derivative q ) ) = ( q * poly_inv n q ) * ( poly_inv n p * derivative p ) + ( p * poly_inv n p ) * ( poly_inv n q * derivative q ) by ring ];
        rw [ Polynomial.modByMonic_eq_of_dvd_sub ];
        · exact Polynomial.monic_X_pow _;
        · rw [ Polynomial.modByMonic_eq_sub_mul_div _ ( show Polynomial.Monic ( X ^ n ) from Polynomial.monic_X_pow _ ) ] at *;
          rw [ Polynomial.modByMonic_eq_sub_mul_div _ ( show Polynomial.Monic ( X ^ n ) from Polynomial.monic_X_pow _ ) ] at *;
          rw [ show q * poly_inv n q = 1 - X ^ n * ( 1 /ₘ X ^ n ) + X ^ n * ( q * poly_inv n q /ₘ X ^ n ) by linear_combination' h_poly_inv_q_mod ] ; rw [ show p * poly_inv n p = 1 - X ^ n * ( 1 /ₘ X ^ n ) + X ^ n * ( p * poly_inv n p /ₘ X ^ n ) by linear_combination' h_poly_inv_p_mod ] ; ring_nf;
          exact ⟨ - ( 1 /ₘ X ^ n ) * poly_inv n q * derivative q - ( 1 /ₘ X ^ n ) * poly_inv n p * derivative p + poly_inv n q * ( poly_inv n p * p /ₘ X ^ n ) * derivative q + ( q * poly_inv n q /ₘ X ^ n ) * poly_inv n p * derivative p, by ring ⟩;
      simp_all +decide [ Polynomial.mod_def ];
      rw [ Polynomial.add_modByMonic ];
      rw [ Polynomial.add_modByMonic, h_deriv p hp, h_deriv q hq ]

/-
Algebraic identity for logarithmic derivative modulo X^n.
-/
lemma algebraic_identity_mod_n (n : ℕ) (p q : ℝ[X])
    (hp : p.coeff 0 = 1) (hq : q.coeff 0 = 1) :
    ((Polynomial.derivative p * q + p * Polynomial.derivative q) * poly_inv n (p * q)) % (X ^ n) =
    ((Polynomial.derivative p * poly_inv n p) + (Polynomial.derivative q * poly_inv n q)) % (X ^ n) := by
      have h_poly_log_mul_mod : (Polynomial.derivative (poly_log n (p * q))) % (X ^ n) = ((Polynomial.derivative (poly_log n p)) + (Polynomial.derivative (poly_log n q))) % (X ^ n) := by
        convert poly_log_derivative_mul_mod n p q hp hq using 1;
      have h_poly_log_mul_mod : (Polynomial.derivative (poly_log n (p * q))) % (X ^ n) = ((Polynomial.derivative (p * q)) * (poly_inv n (p * q))) % (X ^ n) := by
        convert poly_log_derivative n ( p * q ) _ using 1;
        simp +decide [ hp, hq, Polynomial.coeff_mul ];
      have h_poly_log_mul_mod : (Polynomial.derivative (poly_log n p)) % (X ^ n) = ((Polynomial.derivative p) * (poly_inv n p)) % (X ^ n) := by
        convert poly_log_derivative n p hp using 1
      have h_poly_log_mul_mod' : (Polynomial.derivative (poly_log n q)) % (X ^ n) = ((Polynomial.derivative q) * (poly_inv n q)) % (X ^ n) := by
        convert poly_log_derivative n q hq using 1;
      simp_all +decide [ Polynomial.mod_def ];
      rw [ Polynomial.add_modByMonic, h_poly_log_mul_mod, h_poly_log_mul_mod' ];
      rw [ Polynomial.add_modByMonic ]

/-
The derivative of the truncated logarithm of a product is additive modulo X^n.
-/
lemma poly_log_derivative_mul_mod_final (n : ℕ) (p q : ℝ[X])
    (hp : p.coeff 0 = 1) (hq : q.coeff 0 = 1) :
    (Polynomial.derivative (poly_log n (p * q))) % (X ^ n) = ((Polynomial.derivative (poly_log n p)) + (Polynomial.derivative (poly_log n q))) % (X ^ n) := by
      convert poly_log_derivative_mul_mod n p q hp hq using 1

/-
The normalized hat polynomial of the boxplus convolution is the product of the normalized hat polynomials modulo X^(n+1).
-/
lemma normalized_hat_poly_boxplus (n : ℕ) (p q : ℝ[X])
    (hp : p.natDegree = n) (hq : q.natDegree = n) (hp_monic : p.Monic) (hq_monic : q.Monic) :
    (normalized_hat_poly n (boxplus n p q)) % (X ^ (n + 1)) = ((normalized_hat_poly n p) * (normalized_hat_poly n q)) % (X ^ (n + 1)) := by
  convert polynomial_congruent_of_coeff_eq _ _ _ _ using 2;
  intro k hk; unfold normalized_hat_poly; simp +decide [ Polynomial.coeff_mul ] ;
  have h_boxplus_coeff : ∀ k ≤ n, (hat_poly n (boxplus n p q)).coeff k = (1 / (n.factorial : ℝ)) * ((hat_poly n p) * (hat_poly n q)).coeff k := by
    exact?;
  have h_hat_poly_coeff : (hat_poly n p).coeff 0 = (n.factorial : ℝ) ∧ (hat_poly n q).coeff 0 = (n.factorial : ℝ) := by
    unfold hat_poly; simp +decide [ hp, hq, hp_monic, hq_monic ] ;
    have := hp_monic.coeff_natDegree; have := hq_monic.coeff_natDegree; aesop;
  simp_all +decide [ Polynomial.coeff_C, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk ];
  convert congr_arg ( fun x : ℝ => x / ( n ! : ℝ ) ) ( h_boxplus_coeff k hk ) using 1 <;> norm_num [ Finset.sum_ite, Finset.filter_eq', Finset.filter_ne' ] ; ring;
  · field_simp;
    rw [ Finset.sum_eq_single k ] <;> norm_num [ Nat.factorial_ne_zero ];
    · rw [ mul_div_cancel₀ _ ( by positivity ) ];
    · intros; omega;
  · rw [ Polynomial.coeff_mul ] ; simp +decide [ Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk, Finset.sum_div _ _ _, div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _, Finset.sum_mul _ _ _, h_hat_poly_coeff ] ; ring;
    refine' Finset.sum_congr rfl fun x hx => _ ; simp_all +decide [ Nat.sub_sub, add_comm ] ; ring;
    field_simp;
    rw [ Finset.sum_eq_single ( k - x ) ] <;> norm_num [ Nat.sub_sub, add_comm ] ; ring;
    · rw [ Finset.sum_eq_single x ] <;> norm_num ; ring;
      · simp +decide [ sq, mul_assoc, mul_comm, mul_left_comm, Nat.factorial_ne_zero ];
      · intros; omega;
    · intros; omega;
    · exact fun h => False.elim <| h <| Nat.sub_eq_zero_of_le <| by omega;

/-
Definition of finite_free_cumulant.
-/
noncomputable def finite_free_cumulant (n : ℕ) (p : ℝ[X]) (k : ℕ) : ℝ :=
  (poly_log n (normalized_hat_poly n p)).coeff k

/-
Finite free cumulants depend only on the normalized hat polynomial modulo X^(n+1).
-/
lemma finite_free_cumulant_congruent (n : ℕ) (p q : ℝ[X]) (k : ℕ) (hk : k ≤ n)
    (h : (normalized_hat_poly n p) % (X ^ (n + 1)) = (normalized_hat_poly n q) % (X ^ (n + 1)))
    (hp : (normalized_hat_poly n p).coeff 0 = 1) (hq : (normalized_hat_poly n q).coeff 0 = 1) :
    finite_free_cumulant n p k = finite_free_cumulant n q k := by
      have := poly_log_congruent n ( normalized_hat_poly n p ) ( normalized_hat_poly n q ) hp hq h; simp_all +decide [ Polynomial.mod_def ] ;
      rw [ Polynomial.modByMonic_eq_sub_mul_div _ ( Polynomial.monic_X_pow _ ) ] at this;
      rw [ Polynomial.modByMonic_eq_sub_mul_div _ ( Polynomial.monic_X_pow _ ) ] at this; replace this := congr_arg ( fun q => Polynomial.coeff q k ) this; simp_all +decide [ Polynomial.coeff_eq_zero_of_natDegree_lt ] ;
      simp_all +decide [ Polynomial.coeff_mul, Polynomial.coeff_X_pow, Nat.succ_eq_add_one ];
      rw [ Finset.sum_eq_zero fun x hx => if_neg ( by linarith [ Finset.mem_antidiagonal.mp hx ] ), Finset.sum_eq_zero fun x hx => if_neg ( by linarith [ Finset.mem_antidiagonal.mp hx ] ) ] at this ; linarith!

/-
Finite free cumulants of a product modulo X^(n+1) are additive.
-/
lemma finite_free_cumulant_of_prod_mod (n : ℕ) (A B C : ℝ[X]) (k : ℕ) (hk : k ≤ n)
    (h_cong : A % (X ^ (n + 1)) = (B * C) % (X ^ (n + 1)))
    (hA : A.coeff 0 = 1) (hB : B.coeff 0 = 1) (hC : C.coeff 0 = 1) :
    (poly_log n A).coeff k = (poly_log n B).coeff k + (poly_log n C).coeff k := by
      -- Since $A \equiv BC \pmod{X^{n+1}}$, we have $\log(A) \equiv \log(B) + \log(C) \pmod{X^{n+1}}$.
      have h_log_congr : (poly_log n A) % (X ^ (n + 1)) = ((poly_log n B) + (poly_log n C)) % (X ^ (n + 1)) := by
        have h_log_congr : ∀ p q : ℝ[X], p.coeff 0 = 1 → q.coeff 0 = 1 → (p * q) % (X ^ (n + 1)) = A % (X ^ (n + 1)) → (poly_log n (p * q)) % (X ^ (n + 1)) = ((poly_log n p) + (poly_log n q)) % (X ^ (n + 1)) := by
          intros p q hp hq h_cong
          have h_log_congr : (Polynomial.derivative (poly_log n (p * q))) % (X ^ n) = ((Polynomial.derivative (poly_log n p)) + (Polynomial.derivative (poly_log n q))) % (X ^ n) := by
            convert poly_log_derivative_mul_mod n p q hp hq using 1;
          apply polynomial_congruent_of_derivative_congruent;
          · convert h_log_congr using 1 ; norm_num [ Polynomial.derivative_add ];
          · unfold poly_log; simp +decide [ *, Polynomial.coeff_zero_eq_eval_zero ] ;
            simp +decide [ Polynomial.eval_finset_sum, hp, hq ];
            simp +decide [ Polynomial.coeff_zero_eq_eval_zero ] at hp hq ⊢ ; aesop;
        convert h_log_congr B C hB hC _ using 1;
        · convert poly_log_congruent n A ( B * C ) hA ( by rw [ Polynomial.coeff_mul ] ; aesop ) _ using 1;
          exact h_cong;
        · exact h_cong.symm;
      convert congr_arg ( fun p => p.coeff k ) h_log_congr using 1;
      · rw [ Polynomial.mod_def ];
        rw [ Polynomial.modByMonic_eq_sub_mul_div ];
        · norm_num [ Polynomial.coeff_mul ];
          exact Eq.symm ( sub_eq_self.mpr ( Finset.sum_eq_zero fun x hx => if_neg ( by linarith [ Finset.mem_antidiagonal.mp hx ] ) ) );
        · erw [ Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_X_pow, Polynomial.leadingCoeff_C ] ; norm_num;
      · rw [ eq_comm, Polynomial.mod_def ];
        rw [ Polynomial.modByMonic_eq_sub_mul_div ];
        · norm_num [ Polynomial.coeff_mul ];
          exact Finset.sum_eq_zero fun x hx => if_neg ( by linarith [ Finset.mem_antidiagonal.mp hx ] );
        · erw [ Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_X_pow, Polynomial.leadingCoeff_C ] ; norm_num

/-
Finite free cumulants are additive under boxplus convolution.
-/
lemma finite_free_cumulant_additive (n : ℕ) (p q : ℝ[X]) (k : ℕ) (hk : k ≤ n) (hk0 : 0 < k)
    (hp : p.natDegree = n) (hq : q.natDegree = n) (hp_monic : p.Monic) (hq_monic : q.Monic) :
    finite_free_cumulant n (boxplus n p q) k = finite_free_cumulant n p k + finite_free_cumulant n q k := by
      have h_add : (normalized_hat_poly n (boxplus n p q)) % (X ^ (n + 1)) = ((normalized_hat_poly n p) * (normalized_hat_poly n q)) % (X ^ (n + 1)) := by
        convert normalized_hat_poly_boxplus n p q hp hq hp_monic hq_monic using 1;
      apply finite_free_cumulant_of_prod_mod n (normalized_hat_poly n (boxplus n p q)) (normalized_hat_poly n p) (normalized_hat_poly n q) k hk h_add;
      · cases n <;> simp_all +decide [ normalized_hat_poly, Polynomial.coeff_zero_eq_eval_zero ];
        unfold hat_poly; simp +decide [ Polynomial.eval_finset_sum ] ;
        simp_all +decide [ Finset.sum_range_succ', Polynomial.coeff_natDegree ];
        field_simp;
        rw [ div_self ];
        unfold boxplus; simp +decide [ Polynomial.coeff_natDegree, hp_monic, hq_monic ] ;
        rw [ Finset.sum_eq_single 0 ] <;> simp +decide [ boxplus_coeff ];
        · exact ⟨ ⟨ Nat.factorial_ne_zero _, by rw [ ← hp, hp_monic.coeff_natDegree ] ; aesop ⟩, by rw [ ← hq, hq_monic.coeff_natDegree ] ; aesop ⟩;
        · intros; omega;
      · unfold normalized_hat_poly;
        unfold hat_poly; simp +decide [ Polynomial.coeff_zero_eq_eval_zero ] ;
        simp +decide [ Polynomial.eval_finset_sum, Finset.sum_range_succ' ];
        simp +decide [ ← mul_assoc, Nat.factorial_ne_zero, hp ▸ hp_monic.coeff_natDegree ];
      · unfold normalized_hat_poly;
        unfold hat_poly; simp +decide [ Polynomial.coeff_zero_eq_eval_zero ] ;
        simp +decide [ Polynomial.eval_finset_sum, Finset.sum_range_succ', hq ▸ hq_monic.coeff_natDegree ];
        exact mul_inv_cancel₀ ( by positivity )

/-
Checking finite_free_cumulant.
-/
#check finite_free_cumulant

/-
The constant term of the normalized hat polynomial is 1.
-/
lemma normalized_hat_poly_coeff_zero (n : ℕ) (p : ℝ[X]) (hp : p.natDegree = n) (hp_monic : p.Monic) :
    (normalized_hat_poly n p).coeff 0 = 1 := by
      unfold normalized_hat_poly;
      unfold hat_poly; simp +decide [ Polynomial.coeff_mul ] ;
      simp +decide [ ← mul_assoc, mul_comm, hp_monic, hp.symm, Nat.factorial_ne_zero ]

/-
Phi of a polynomial constructed from roots equals phi of the roots.
-/
lemma Phi_eq_phi (n : ℕ) (roots : Fin n → ℝ) (h_distinct : Function.Injective roots) :
  Phi (∏ i, (X - C (roots i))) = phi n roots := by
  -- By definition of $Phi$, we know that
  simp [Phi];
  rw [ show ( ∏ i, ( X - C ( roots i ) ) |> Polynomial.roots |> Multiset.toFinset ) = Finset.image roots Finset.univ from ?_ ];
  · simp +decide [ Finset.sum_image, h_distinct.eq_iff ];
    exact Finset.sum_congr rfl fun i hi => by rw [ Finset.sum_erase_eq_sub ( Finset.mem_univ i ) ] ; simp +decide [ h_distinct.eq_iff ] ;
  · rw [ Polynomial.roots_prod ] <;> norm_num [ Finset.ext_iff, h_distinct.eq_iff ];
    exact Finset.prod_ne_zero_iff.mpr fun i _ => Polynomial.X_sub_C_ne_zero _

/-
Finite free cumulants are additive under boxplus convolution.
-/
lemma finite_free_cumulant_additive_v2 (n : ℕ) (p q : ℝ[X]) (k : ℕ) (hk : k ≤ n) (hk0 : 0 < k)
    (hp : p.natDegree = n) (hq : q.natDegree = n) (hp_monic : p.Monic) (hq_monic : q.Monic) :
    finite_free_cumulant n (boxplus n p q) k = finite_free_cumulant n p k + finite_free_cumulant n q k := by
      exact?

/-
Finite free cumulants are additive under boxplus convolution.
-/
lemma finite_free_cumulant_additive_proven (n : ℕ) (p q : ℝ[X]) (k : ℕ) (hk : k ≤ n) (hk0 : 0 < k)
    (hp : p.natDegree = n) (hq : q.natDegree = n) (hp_monic : p.Monic) (hq_monic : q.Monic) :
    finite_free_cumulant n (boxplus n p q) k = finite_free_cumulant n p k + finite_free_cumulant n q k := by
      -- Apply the fact that the normalized hat polynomial of the boxplus convolution is the product of the normalized hat polynomials modulo X^(n+1).
      apply finite_free_cumulant_additive_v2 n p q k hk hk0 hp hq hp_monic hq_monic
      skip