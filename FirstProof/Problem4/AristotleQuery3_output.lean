/-
Proving the inequality for the coefficient formula of Phi in degree 3.
-/
noncomputable def invPhi_deg3_coeff (a b : ℝ) : ℝ :=
  (-4 * a^3 - 27 * b^2) / (18 * a^2)

lemma invPhi_deg3_inequality (a c b d : ℝ) (ha : a < 0) (hc : c < 0) :
  invPhi_deg3_coeff (a + c) (b + d) ≥ invPhi_deg3_coeff a b + invPhi_deg3_coeff c d := by
    norm_num [ invPhi_deg3_coeff ];
    rw [ div_add_div, div_le_div_iff₀ ] <;> try nlinarith [ sq_pos_of_neg ha, sq_pos_of_neg hc ];
    -- By AM-GM inequality, we know that $(a^2 * d - c^2 * b)^2 \geq 0$.
    have h_amgm : (a^2 * d - c^2 * b)^2 ≥ 0 := by
      apply sq_nonneg;
    nlinarith [ sq_nonneg ( a * c ), sq_nonneg ( a * d ), sq_nonneg ( b * c ), sq_nonneg ( b * d ), mul_pos ( neg_pos.mpr ha ) ( neg_pos.mpr hc ) ]

